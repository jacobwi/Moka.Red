<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Test dependencies -->
	<ItemGroup>
		<PackageVersion Include="xunit.v3" Version="4.0.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
		<PackageVersion Include="bunit" Version="2.10.3" />
		<!-- Supplies the trx report option for dotnet test under Microsoft.Testing.Platform.
		     Pinned to the MTP version xunit.v3 4.x carries. -->
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
		<!-- ThemeGen tests compile the C# theme export to check it builds and round-trips. -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
	</ItemGroup>

	<!-- Benchmark dependencies -->
	<ItemGroup>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
	</ItemGroup>

	<!-- WASM sample app -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
	</ItemGroup>

</Project>
