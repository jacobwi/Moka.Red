<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Test dependencies -->
	<ItemGroup>
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageVersion Include="bunit" Version="2.14.0" />
		<!-- Supplies the trx report option for dotnet test under Microsoft.Testing.Platform.
		     Pinned to the MTP version xunit.v3 4.x carries. -->
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
		<!-- ThemeGen tests compile the C# theme export to check it builds and round-trips. -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
		<!-- QR tests decode the generated grids, so the encoder is proven against a real reader
		     rather than its own structure. Test-only; nothing in the library ships it. -->
		<PackageVersion Include="ZXing.Net" Version="0.16.11" />
	</ItemGroup>

	<!-- Benchmark dependencies -->
	<ItemGroup>
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
	</ItemGroup>

	<!-- WASM sample app -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
	</ItemGroup>

	<!-- MCP server tool -->
	<ItemGroup>
		<PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
	</ItemGroup>

</Project>
