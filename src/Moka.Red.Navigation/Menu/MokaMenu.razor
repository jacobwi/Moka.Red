@namespace Moka.Red.Navigation.Menu
@inherits MokaVisualComponentBase

<nav class="@CssClass" style="@CssStyle" id="@Id" role="navigation" @attributes="AdditionalAttributes" @ref="_nav">
	<CascadingValue Value="this" IsFixed="true">
		<CascadingValue Value="Collapsed" Name="MenuCollapsed">
			<CascadingValue Value="Adaptive" Name="MenuAdaptive">
				<CascadingValue Value="0" Name="MenuIndent">
					@ChildContent
				</CascadingValue>
			</CascadingValue>
		</CascadingValue>
	</CascadingValue>
</nav>
