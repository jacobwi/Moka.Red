@namespace Moka.Red.Navigation.Menu
@inherits MokaVisualComponentBase

@{
	// Templates, not local functions: a local function writes to this component's own builder, which is the wrong
	// one inside the tooltip's ChildContent. Spans, since the content sits inside a button or a link.
	RenderFragment? pill = Pill is null
		? null
		: @<text>
			<MokaBadge Class="moka-menu-item__pill" Tone="Pill.Tone" Content="@PillCount" aria-hidden="true"/>
			<span class="moka-visually-hidden">, @Pill.Why</span>
		</text>;

	RenderFragment? tag = Pill is null
		? null
		: @<text>@Text<span class="moka-menu-item__why">@Pill.Why</span></text>;

	RenderFragment itemContent =
		@<span class="moka-menu-item__content">
			@if (ShownImage is not null)
			{
				<img class="moka-menu-item__image" src="@ShownImage" alt="" style="@ImageStyle" @onerror="HandleImageError"/>
			}
			else if (Icon is not null)
			{
				<MokaIcon Icon="Icon.Value" Size="MokaSize.Sm" Class="moka-menu-item__icon"/>
			}

			@if (!MenuCollapsed)
			{
				<span class="moka-menu-item__text">@Text</span>

				@if (OpensNewTab)
				{
					<span class="moka-visually-hidden">, @NewTabText</span>
					<span class="moka-menu-item__external" aria-hidden="true">
						<MokaIcon Icon="MokaIcons.Content.ExternalLink" SizeValue="12px"/>
					</span>
				}

				@if (!string.IsNullOrEmpty(Badge))
				{
					<span class="moka-menu-item__badge moka-menu-item__badge--@ColorToKebab(BadgeColor ?? MokaColor.Primary)">@Badge</span>
				}

				@pill

				@if (HasChildren && !ShowsLinkRow)
				{
					<span class="@ChevronClass">
						<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="16px"/>
					</span>
				}
			}
			else if (IsStatic)
			{
				@* A div cannot take an aria-label, so a static item keeps its text for screen readers. *@
				<span class="moka-visually-hidden">@Text</span>
				@pill
			}
			else
			{
				@pill
			}
		</span>;

	// MokaMenu is site navigation, so its items are links and buttons, and a parent is a disclosure
	// button. The ARIA menu roles would hide the links from screen readers and take Tab away. A parent that is also a page
	// is a link with a disclosure button beside it, as in WAI-ARIA's disclosure navigation with top-level links: two
	// controls side by side, since a link can't hold a button.
	RenderFragment item;
	if (ShowsLinkRow)
	{
		item =
			@<div class="moka-menu-item__row">
				<a class="@CssClass" style="@CssStyle" id="@Id"
				   href="@(Disabled ? null : LinkHref)"
				   target="@(Disabled ? null : LinkTarget)"
				   rel="@(Disabled ? null : LinkRel)"
				   role="@(Disabled ? "link" : null)"
				   aria-disabled="@(Disabled ? "true" : null)"
				   aria-current="@(IsActive ? "page" : null)"
				   @attributes="AdditionalAttributes"
				   @onclick="HandleGroupLinkClick"
				   @onclick:preventDefault="ClickStaysHere"
				   @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
				   @oncontextmenu="HandleContextMenu">
					@itemContent
				</a>
				<MokaTooltip Text="@ToggleLabel" Position="MokaTooltipPosition.Right" Class="moka-menu-item__toggle-tip">
					<button type="button" class="moka-menu-item__toggle" disabled="@Disabled"
					        aria-expanded="@(_expanded ? "true" : "false")"
					        aria-controls="@SubmenuId"
					        aria-label="@ToggleLabel"
					        @onclick="HandleToggleClick">
						<span class="@ChevronClass">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="16px"/>
						</span>
					</button>
				</MokaTooltip>
			</div>;
	}
	else if (HasChildren)
	{
		item =
			@<button type="button" class="@CssClass" style="@CssStyle" id="@Id"
			         disabled="@Disabled"
			         aria-expanded="@(GroupShown ? "true" : "false")"
			         aria-controls="@SubmenuId"
			         aria-current="@(IsActive ? "true" : null)"
			         aria-label="@CollapsedLabel"
			         @attributes="AdditionalAttributes"
			         @onclick="HandleClick"
			         @onkeydown:stopPropagation="_flyoutOpen"
			         @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
			         @oncontextmenu="HandleContextMenu"
			         @ref="_button">
				@itemContent
			</button>;
	}
	else if (IsLink)
	{
		item =
			@<a class="@CssClass" style="@CssStyle" id="@Id"
			    href="@(Disabled ? null : LinkHref)"
			    target="@(Disabled ? null : LinkTarget)"
			    rel="@(Disabled ? null : LinkRel)"
			    role="@(Disabled ? "link" : null)"
			    aria-disabled="@(Disabled ? "true" : null)"
			    aria-current="@(IsActive ? "page" : null)"
			    aria-label="@CollapsedLabel"
			    @attributes="AdditionalAttributes"
			    @onclick="HandleClick"
			    @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
			    @oncontextmenu="HandleContextMenu">
				@itemContent
			</a>;
	}
	else if (IsInteractive)
	{
		item =
			@<button type="button" class="@CssClass" style="@CssStyle" id="@Id"
			         disabled="@Disabled"
			         aria-current="@(IsActive ? "true" : null)"
			         aria-label="@CollapsedLabel"
			         @attributes="AdditionalAttributes"
			         @onclick="HandleClick"
			         @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
			         @oncontextmenu="HandleContextMenu">
				@itemContent
			</button>;
	}
	else
	{
		// Nothing handles a click, so nothing takes focus.
		item =
			@<div class="@CssClass" style="@CssStyle" id="@Id"
			      aria-disabled="@(Disabled ? "true" : null)"
			      aria-current="@(IsActive ? "true" : null)"
			      @attributes="AdditionalAttributes">
				@itemContent
			</div>;
	}
}

@* A menu showing only icons is a column, so the name opens beside it, on the side that has room. The tag gives way to
   an open flyout, which names the group itself. *@
@if (TagLabel is not null)
{
	<MokaTooltip Text="@(_flyoutOpen ? null : TagLabel)" Content="@(_flyoutOpen ? null : tag)" Position="MokaTooltipPosition.Right"
	             Delay="TagDelay" Class="moka-menu-item-tooltip">
		@item
	</MokaTooltip>
}
else
{
	@item
}

@if (HasChildren)
{
	@* inert keeps the links of a closed group out of the tab order and away from screen readers. The group stays rendered
	   so it can animate open, and on the rail it's the flyout, shown in the top layer by the menu's script. The clip is
	   what the grid row shrinks. *@
	<div class="@SubmenuClass" id="@SubmenuId" inert="@(!GroupShown)"
	     popover="@(_flyoutOpen ? "manual" : null)" data-moka-popup="@_flyoutOpen" tabindex="@(_flyoutOpen ? "-1" : null)"
	     @onkeydown:stopPropagation="_flyoutOpen" @ref="_submenu">
		<div class="moka-menu-item__submenu-clip">
			@if (OnRail && IsLink)
			{
				@* The parent's icon only opens its flyout on the rail, so its own page is the flyout's first link. Only there,
				   so the page isn't marked current twice while the link beside the arrow shows. *@
				<a class="moka-menu-item__flyout-title moka-menu-item__flyout-link" href="@LinkHref" target="@LinkTarget"
				   rel="@LinkRel" aria-current="@(IsActive ? "page" : null)" @onclick="HandleFlyoutLinkClick">
					@Text
					@if (OpensNewTab)
					{
						<span class="moka-visually-hidden">, @NewTabText</span>
					}
				</a>
			}
			else if (CanFlyout && !IsLink)
			{
				<span class="moka-menu-item__flyout-title" aria-hidden="true">@Text</span>
			}
			<CascadingValue Value="this" IsFixed="true">
				<CascadingValue Value="false" Name="MenuCollapsed" IsFixed="true">
					<CascadingValue Value="false" Name="MenuAdaptive" IsFixed="true">
						<CascadingValue Value="ChildIndent" Name="MenuIndent">
							@ChildContent
						</CascadingValue>
					</CascadingValue>
				</CascadingValue>
			</CascadingValue>
		</div>
	</div>
}
