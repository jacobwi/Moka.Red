@namespace Moka.Red.Navigation.MenuBar
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @onmouseenter="HandleMouseEnter" @attributes="AdditionalAttributes">
	@* role="menuitem" rather than a button role: inside a menubar this is what opens a submenu. *@
	<button class="moka-menubar-menu__trigger"
	        type="button"
	        role="menuitem"
	        aria-haspopup="menu"
	        aria-expanded="@(IsOpen ? "true" : "false")"
	        aria-controls="@(IsOpen ? _menuId : null)"
	        tabindex="@(IsTabStop ? 0 : -1)"
	        disabled="@Disabled"
	        @onclick="HandleTriggerClick"
	        @ref="_triggerRef">
		@if (Icon is not null)
		{
			<MokaIcon Icon="Icon.Value" SizeValue="14px" Class="moka-menubar-menu__icon"/>
		}
		<span class="moka-menubar-menu__label">@Label</span>
	</button>

	@if (IsOpen)
	{
		@* The popup is the trigger's sibling, positioned under it. Items are registered by the children
		   themselves, so the menu knows their order without the consumer repeating it. *@
		<div class="moka-menubar-menu__popup" role="menu" id="@_menuId" aria-label="@Label">
			@* Not IsFixed: every item reads its highlight from here. *@
			<CascadingValue Value="this">
				@ChildContent
			</CascadingValue>
		</div>
	}
</div>
