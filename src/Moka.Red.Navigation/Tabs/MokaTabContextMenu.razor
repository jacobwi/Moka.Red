@namespace Moka.Red.Navigation.Tabs
@typeparam TValue
@implements IAsyncDisposable
@using System.Globalization

@if (Visible && Tab is not null)
{
	<div class="moka-context-menu-overlay" @onclick="Close"></div>
	<div class="@MenuClass" style="@MenuStyle" @ref="_menuRef">
		<button class="moka-context-menu-item" @onclick="HandleClose" type="button"
		        disabled="@(!Tab.IsClosable || Tab.IsPinned)">
			Close
		</button>
		<button class="moka-context-menu-item" @onclick="HandleCloseOthers" type="button">
			Close Others
		</button>
		<button class="moka-context-menu-item" @onclick="HandleCloseToRight" type="button">
			Close to the Right
		</button>
		<button class="moka-context-menu-item" @onclick="HandleCloseAll" type="button">
			Close All
		</button>

		<div class="moka-context-menu-divider"></div>

		<button class="moka-context-menu-item" @onclick="HandleTogglePin" type="button">
			@(Tab.IsPinned ? "Unpin" : "Pin")
		</button>

		@if (Groups is not null && Groups.Count > 0)
		{
			<div class="moka-context-menu-divider"></div>
			@foreach (var group in Groups)
			{
				<button class="moka-context-menu-item" @onclick="() => HandleMoveToGroup(group.Name)" type="button">
					Move to @(group.DisplayTitle ?? group.Name)
				</button>
			}

			@if (Tab.GroupName is not null)
			{
				<button class="moka-context-menu-item" @onclick="() => HandleMoveToGroup(null)" type="button">
					Remove from Group
				</button>
			}
		}

		@if (CustomItems is not null && CustomItems.Count > 0)
		{
			<div class="moka-context-menu-divider"></div>
			@foreach (var item in CustomItems)
			{
				@if (item.DividerBefore)
				{
					<div class="moka-context-menu-divider"></div>
				}

				<button class="moka-context-menu-item" @onclick="() => HandleCustomItem(item)"
				        disabled="@item.Disabled" type="button">
					@if (!string.IsNullOrEmpty(item.IconClass))
					{
						<span class="@item.IconClass"></span>
					}
					@item.Text
				</button>
			}
		}
	</div>
}

@code {

	/// <summary>Whether the context menu is visible.</summary>
	[Parameter]
	public bool Visible { get; set; }

	/// <summary>The tab this context menu is for.</summary>
	[Parameter]
	public TabInfo<TValue>? Tab { get; set; }

	/// <summary>Horizontal position in pixels.</summary>
	[Parameter]
	public double X { get; set; }

	/// <summary>Vertical position in pixels.</summary>
	[Parameter]
	public double Y { get; set; }

	/// <summary>Available groups for the "Move to" option.</summary>
	[Parameter]
	public IReadOnlyList<TabGroupInfo>? Groups { get; set; }

	/// <summary>Custom menu items from plugins or parameters.</summary>
	[Parameter]
	public IReadOnlyList<ContextMenuItem>? CustomItems { get; set; }

	/// <summary>Callback to close the context menu.</summary>
	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>Callback when "Close" is clicked.</summary>
	[Parameter]
	public EventCallback<string> OnTabClose { get; set; }

	/// <summary>Callback when "Close Others" is clicked.</summary>
	[Parameter]
	public EventCallback<string> OnCloseOthers { get; set; }

	/// <summary>Callback when "Close to the Right" is clicked.</summary>
	[Parameter]
	public EventCallback<string> OnCloseToRight { get; set; }

	/// <summary>Callback when "Close All" is clicked.</summary>
	[Parameter]
	public EventCallback OnCloseAll { get; set; }

	/// <summary>Callback when pin is toggled.</summary>
	[Parameter]
	public EventCallback<string> OnTogglePin { get; set; }

	/// <summary>Callback when moving to a group.</summary>
	[Parameter]
	public EventCallback<(string TabId, string? GroupName)> OnMoveToGroup { get; set; }

	[Inject] private IJSRuntime JsRuntime { get; set; } = default!;

	private const string ModulePath = "./_content/Moka.Red.Navigation/moka-tabs.js";

	private ElementReference _menuRef;
	private IJSObjectReference? _module;
	private double _left;
	private double _top;
	private double _positionedForX;
	private double _positionedForY;
	private bool _positionResolved;
	private bool _disposed;

	private string MenuClass => new CssBuilder("moka-context-menu")
		.AddClass("moka-context-menu--measuring", !_positionResolved)
		.Build();

	private string MenuStyle => new StyleBuilder()
		.AddStyle("left", FormatPx(_left))
		.AddStyle("top", FormatPx(_top))
		.Build() ?? string.Empty;

	private static string FormatPx(double value) =>
		value.ToString("0.##", CultureInfo.InvariantCulture) + "px";

	/// <inheritdoc />
	protected override void OnParametersSet()
	{
		if (Visible && _positionResolved && _positionedForX == X && _positionedForY == Y)
		{
			return;
		}

		_positionResolved = false;
		_left = X;
		_top = Y;
	}

	/// <summary>
	///     A right-click near the right or bottom edge would otherwise open the menu off-screen, so the
	///     rendered menu is measured and nudged back into the viewport before it is shown.
	/// </summary>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!Visible || Tab is null || _positionResolved || _disposed)
		{
			return;
		}

		try
		{
			_module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
			MenuPoint? point = await _module.InvokeAsync<MenuPoint?>(
				"MokaTabs.constrainContextMenu", _menuRef, X, Y);

			if (point is not null)
			{
				_left = point.X;
				_top = point.Y;
			}
		}
		catch (JSDisconnectedException)
		{
			// Circuit disconnected.
		}
		catch (ObjectDisposedException)
		{
			// JS runtime torn down mid-call.
		}
		catch (OperationCanceledException)
		{
			// Covers TaskCanceledException - the circuit went away while awaiting.
		}
		catch (InvalidOperationException)
		{
			// JS interop attempted during prerendering.
		}
		finally
		{
			// Never leave the menu stuck in its hidden measuring state.
			_positionedForX = X;
			_positionedForY = Y;
			_positionResolved = true;
			StateHasChanged();
		}
	}

	/// <inheritdoc />
	public async ValueTask DisposeAsync()
	{
		if (_disposed)
		{
			return;
		}

		_disposed = true;

		if (_module is not null)
		{
			try
			{
				await _module.DisposeAsync();
			}
			catch (JSDisconnectedException)
			{
				// Circuit already gone - nothing to release.
			}

			_module = null;
		}

		GC.SuppressFinalize(this);
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}

	private async Task HandleClose()
	{
		if (Tab is not null) await OnTabClose.InvokeAsync(Tab.Id);
		await Close();
	}

	private async Task HandleCloseOthers()
	{
		if (Tab is not null) await OnCloseOthers.InvokeAsync(Tab.Id);
		await Close();
	}

	private async Task HandleCloseToRight()
	{
		if (Tab is not null) await OnCloseToRight.InvokeAsync(Tab.Id);
		await Close();
	}

	private async Task HandleCloseAll()
	{
		await OnCloseAll.InvokeAsync();
		await Close();
	}

	private async Task HandleTogglePin()
	{
		if (Tab is not null) await OnTogglePin.InvokeAsync(Tab.Id);
		await Close();
	}

	private async Task HandleMoveToGroup(string? groupName)
	{
		if (Tab is not null) await OnMoveToGroup.InvokeAsync((Tab.Id, groupName));
		await Close();
	}

	private async Task HandleCustomItem(ContextMenuItem item)
	{
		await item.OnClick();
		await Close();
	}

	/// <summary>A clamped viewport coordinate returned by <c>MokaTabs.constrainContextMenu</c>.</summary>
	internal sealed class MenuPoint
	{
		/// <summary>Clamped horizontal position.</summary>
		public double X { get; set; }

		/// <summary>Clamped vertical position.</summary>
		public double Y { get; set; }
	}

}
