@namespace Moka.Red.Navigation.Breadcrumb
@inherits MokaComponentBase

@{ _place = ParentBreadcrumb?.PlaceOf(this) ?? MokaBreadcrumbPlace.Alone; }
@if (ParentBreadcrumb?.FoldBefore(this) is { } fold)
{
	@fold
}
@if (_place.Show != MokaBreadcrumbShow.None)
{
	<li class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
		@if (ShowsOnlyIcon || MayBeCut)
		{
			<MokaTooltip Text="@Text" Position="TooltipSide" MaxWidth="@(MayBeCut ? "20rem" : null)">
				@Part
			</MokaTooltip>
		}
		else
		{
			@Part
		}
	</li>
	@if (_place.Separator != MokaBreadcrumbShow.None)
	{
		<li class="@SeparatorClass" aria-hidden="true">@ParentBreadcrumb?.SeparatorGlyph</li>
	}
}

@code {

	private RenderFragment Part => IsLink
		? @<a href="@LinkHref" class="@LinkClass" aria-label="@(ShowsOnlyIcon ? Text : null)">@Inner</a>
		: @<span class="moka-breadcrumb-item__text" aria-current="@(_place.Current ? "page" : null)">@Inner</span>;

	private RenderFragment Inner => @<text>
		@if (Icon is { } icon)
		{
			<MokaIcon Icon="icon" Size="MokaSize.Xs" SizeValue="@(ShowsOnlyIcon ? "15px" : null)" Class="moka-breadcrumb-item__icon"/>
		}
		@if (ShowsOnlyIcon)
		{
			@if (!IsLink)
			{
				<span class="moka-visually-hidden">@Text</span>
			}
		}
		else if (ChildContent is not null)
		{
			@ChildContent
		}
		else if (Text is not null)
		{
			<span class="moka-breadcrumb-item__label">@Text</span>
		}
	</text>;

}
