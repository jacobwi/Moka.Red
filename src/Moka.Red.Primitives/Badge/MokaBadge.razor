@namespace Moka.Red.Primitives.Badge
@inherits MokaVisualComponentBase

@if (ChildContent is null)
{
	<span class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">@Indicator</span>
}
else
{
	<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
		@ChildContent
		@Indicator
	</div>
}

@code {

	private RenderFragment Indicator => @<text>
		@if (Visible)
		{
			<span class="@IndicatorClass" style="@IndicatorStyle">
				@if (!Dot)
				{
					@DisplayContent
				}
			</span>
		}
	</text>;

}
