@namespace Moka.Red.Primitives.Utility
@using Moka.Red.Core.Clipboard
@inherits MokaComponentBase

<MokaTooltip Text="@TooltipLabel" Position="TooltipPosition">
	<button class="@CssClass" style="@CssStyle" id="@Id"
	        type="button"
	        aria-label="@(ChildContent is null ? CurrentLabel : null)"
	        data-moka-copy="@OwnText"
	        data-moka-copy-ask="@(Asks ? string.Empty : null)"
	        @onmokacopied="HandleCopied"
	        @onmokacopyask="AskHandler"
	        @ref="_button"
	        @attributes="AdditionalAttributes">
		@if (ChildContent is not null)
		{
			@ChildContent
		}
		else
		{
			<MokaIcon Icon="@(_copied ? MokaIcons.Status.Check : MokaIcons.Content.Copy)"
			          Class="moka-copy-btn__icon" SizeValue="@IconSize"/>
		}
		@if (Quiet && (_copied || _failed))
		{
			<span class="moka-copy-btn__tag">@CurrentLabel</span>
		}
	</button>
</MokaTooltip>
@if (Quiet)
{
	<span class="moka-visually-hidden" role="status">@Announcement</span>
}
