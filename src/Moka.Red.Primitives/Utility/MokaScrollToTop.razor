@namespace Moka.Red.Primitives.Utility
@inherits MokaVisualComponentBase

@if (_visible)
{
	@* Named by its title: the arrow icon is aria-hidden. *@
	<button class="@CssClass" style="@CssStyle" id="@Id"
	        type="button"
	        title="@Label"
	        disabled="@Disabled"
	        @onclick="ScrollToTop"
	        @attributes="AdditionalAttributes">
		<MokaIcon Icon="MokaIcons.Navigation.ArrowUp" SizeValue="18px"/>
	</button>
}
