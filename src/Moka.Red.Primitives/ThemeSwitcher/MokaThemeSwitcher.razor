@namespace Moka.Red.Primitives.ThemeSwitcher
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes" @ref="_root">
	<button type="button" class="moka-theme-switcher__trigger" style="@TriggerStyle" id="@TriggerId"
	        aria-label="@TriggerLabel"
	        aria-haspopup="menu"
	        aria-expanded="@(_isOpen ? "true" : "false")"
	        aria-controls="@(_isOpen ? MenuId : null)"
	        @onclick="ToggleDropdown">
		<span class="moka-theme-switcher__label">@CurrentThemeName</span>
		@if (ShowPreview && _selectedTheme is not null)
		{
			<div class="moka-theme-switcher__swatches">
				@for (var i = 0; i < 4; i++)
				{
					<span class="moka-theme-switcher__swatch" style="@SwatchStyle(_selectedTheme, i)"></span>
				}
			</div>
		}
		<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="14px"/>
	</button>

	@if (_isOpen)
	{
		@* A menu of radio items: one theme is checked, the arrows move between them, and Enter,
		   Space or a click picks one and closes the menu. *@
		<div class="moka-theme-switcher__dropdown" id="@MenuId" role="menu" aria-labelledby="@TriggerId">
			@for (var i = 0; i < Themes.Count; i++)
			{
				var item = Themes[i];
				var descriptionId = string.IsNullOrEmpty(item.Description) ? null : $"{MenuId}-desc-{i}";
				<div class="@ItemCssClass(item)"
				     role="menuitemradio"
				     tabindex="-1"
				     aria-checked="@(IsSelected(item) ? "true" : "false")"
				     aria-label="@item.Name"
				     aria-describedby="@descriptionId"
				     @onclick="() => SelectTheme(item)">
					@if (ShowPreview)
					{
						<div class="moka-theme-switcher__swatches">
							@for (var s = 0; s < 4; s++)
							{
								<span class="moka-theme-switcher__swatch" style="@SwatchStyle(item.Theme, s)"></span>
							}
						</div>
					}
					<div class="moka-theme-switcher__item-text">
						<span class="moka-theme-switcher__item-name">@item.Name</span>
						@if (descriptionId is not null)
						{
							<span class="moka-theme-switcher__item-desc" id="@descriptionId">@item.Description</span>
						}
					</div>
				</div>
			}
		</div>
	}
</div>
