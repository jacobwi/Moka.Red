@namespace Moka.Red.Primitives.SplitButton
@inherits MokaVisualComponentBase

@* Keys stop here while the menu is open, so Escape does not also close a MokaDialog around it. *@
<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes" @ref="_root"
     @onkeydown:stopPropagation="_isOpen">
	@if (IsLink)
	{
		<a class="moka-split-btn__primary"
		   href="@(LinkInert ? null : LinkHref)"
		   target="@(LinkInert ? null : Target)"
		   rel="@(LinkInert ? null : LinkRel)"
		   role="@(LinkInert ? "link" : null)"
		   tabindex="@(LinkInert ? "-1" : null)"
		   aria-disabled="@(LinkInert ? "true" : null)"
		   aria-busy="@(Loading ? "true" : null)"
		   @onclick="PrimaryLinkClick"
		   @onclick:preventDefault="LinkInert">
			@{ RenderPrimaryContent(); }
		</a>
	}
	else
	{
		<button class="moka-split-btn__primary"
		        type="button"
		        disabled="@Disabled"
		        aria-disabled="@(Busy ? "true" : null)"
		        aria-busy="@(Loading ? "true" : null)"
		        @onclick="HandlePrimaryClick">
			@{ RenderPrimaryContent(); }
		</button>
	}

	<span class="moka-split-btn__divider"></span>

	@* Closing when focus leaves the whole button is done in its script: the toggle's own focusout
	   also fired when focus moved into the menu, so the keyboard could never reach the items. *@
	@* Named by a tooltip, except while the menu is open: the menu opens where the tooltip would. *@
	<MokaTooltip Text="@(_isOpen ? null : ToggleLabel)" Position="MokaTooltipPosition.BottomEnd" Class="moka-split-btn__toggle-tip">
		<button class="moka-split-btn__toggle"
		        type="button"
		        id="@ToggleId"
		        disabled="@Disabled"
		        aria-disabled="@(Busy ? "true" : null)"
		        aria-label="@ToggleLabel"
		        aria-haspopup="menu"
		        aria-expanded="@(_isOpen ? "true" : "false")"
		        aria-controls="@(_isOpen ? MenuId : null)"
		        @onclick="ToggleDropdown">
			<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" Size="@IconSize" Class="moka-split-btn__arrow"/>
		</button>
	</MokaTooltip>

	@if (_isOpen && DropdownContent is not null)
	{
		@* A click on an item closes the menu after the item's own handler, which runs first. *@
		<div class="moka-split-btn__dropdown" id="@MenuId" role="menu" aria-labelledby="@ToggleId"
		     tabindex="-1" popover="manual" data-moka-popup @ref="_menu"
		     @onmousedown:preventDefault @onclick="CloseDropdown">
			@DropdownContent
		</div>
	}
</div>

@{
	void RenderPrimaryContent()
	{
		<span class="moka-split-btn__content">@ChildContent</span>

		if (OpensNewTab)
		{
			<span class="moka-visually-hidden">, @NewTabText</span>
		}

		if (Loading)
		{
			<span class="moka-split-btn__spinner" aria-hidden="true">
				<MokaIcon Icon="MokaIcons.Status.Spinner" Size="@IconSize" Class="moka-spin"/>
			</span>
			<span class="moka-visually-hidden" role="status">@(_announcing ? LoadingText : null)</span>
		}
	}
}
