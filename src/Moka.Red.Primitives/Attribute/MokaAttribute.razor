@namespace Moka.Red.Primitives.Attribute
@inherits MokaVisualComponentBase

@if (Dismissible)
{
	<span class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
		@if (HasAction)
		{
			<button type="button" class="moka-attr-action"
			        disabled="@Disabled"
			        aria-pressed="@AriaPressed"
			        @onclick="HandleClick">
				@{ RenderContent(); }
			</button>
		}
		else
		{
			RenderContent();
		}

		<MokaTooltip Text="@DismissName" Position="MokaTooltipPosition.Bottom">
			<button class="moka-attr-dismiss" type="button" aria-label="@DismissName" disabled="@Disabled"
			        @onclick="HandleDismiss" @onclick:stopPropagation="true">
				<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
			</button>
		</MokaTooltip>

		@{ RenderCheck(); }
	</span>
}
else if (HasAction)
{
	<button class="@CssClass" style="@CssStyle" id="@Id"
	        type="button"
	        disabled="@Disabled"
	        aria-pressed="@AriaPressed"
	        @onclick="HandleClick"
	        @attributes="AdditionalAttributes">
		@{
			RenderContent();
			RenderCheck();
		}
	</button>
}
else
{
	<span class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
		@{ RenderContent(); }
	</span>
}

@{
	void RenderContent()
	{
		if (Avatar is not null)
		{
			<img class="moka-attr-avatar" src="@Avatar" alt="" aria-hidden="true"/>
		}

		if (StartIcon is not null)
		{
			<MokaIcon Icon="StartIcon.Value" Size="@IconSize" Class="moka-attr-icon"/>
		}

		if (Label is not null)
		{
			<span class="moka-attr-label">@Label</span>
		}

		if (ChildContent is not null)
		{
			<span class="moka-attr-content">@ChildContent</span>
		}

		if (EndIcon is not null && !Dismissible)
		{
			<MokaIcon Icon="EndIcon.Value" Size="@IconSize" Class="moka-attr-icon"/>
		}
	}

	void RenderCheck()
	{
		if (Selectable && _selected)
		{
			<MokaIcon Icon="MokaIcons.Status.Check" Class="moka-attr-check" SizeValue="12px"/>
		}
	}
}
