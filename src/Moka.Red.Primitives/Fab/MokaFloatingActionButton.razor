@namespace Moka.Red.Primitives.Fab
@inherits MokaVisualComponentBase

@* The root holds the button's place and takes Class, Style and the margin. The tooltip's element inside it is
   what the name is placed against: a fixed button inside the tooltip would leave that element behind. *@
<div class="@CssClass" style="@CssStyle">
	<MokaTooltip Text="@TooltipText" Position="TooltipPosition">
		<button class="@ButtonClass" style="@ButtonStyle" id="@Id"
		        type="button"
		        disabled="@Disabled"
		        aria-disabled="@(Busy ? "true" : null)"
		        aria-busy="@(Loading ? "true" : null)"
		        aria-label="@(Label ?? "Action")"
		        @attributes="AdditionalAttributes"
		        @onclick="HandleClick">
			@if (Loading)
			{
				<MokaIcon Icon="MokaIcons.Status.Spinner" Size="@IconSize" Class="moka-fab-icon moka-spin"/>
			}
			else
			{
				<MokaIcon Icon="Icon" Size="@IconSize" Class="moka-fab-icon"/>
			}
			@if (ShowsLabel)
			{
				<span class="moka-fab-label">@Label</span>
			}
			@if (Loading)
			{
				<span class="moka-visually-hidden" role="status">@(_announcing ? LoadingText : null)</span>
			}
		</button>
	</MokaTooltip>
</div>
