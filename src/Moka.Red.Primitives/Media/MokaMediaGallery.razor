@namespace Moka.Red.Primitives.Media
@inherits MokaVisualComponentBase
@using Moka.Red.Feedback.Loading

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes" @ref="_root">
	@{ object?[] keys = TileKeys(); }
	@for (var i = 0; i < Items.Count; i++)
	{
		var item = Items[i];
		var index = i;
		TileState state = StateOf(item);
		if (TileCaption is { } caption)
		{
			@* The caption sits beside the tile rather than in it, so a control in it is never inside the tile's button. *@
			<figure @key="keys[index]" class="moka-media-gallery-figure">
				@{ RenderTileBox(item, index, state, null); }
				<figcaption class="moka-media-gallery-caption">@caption(item)</figcaption>
			</figure>
		}
		else
		{
			RenderTileBox(item, index, state, keys[index]);
		}
	}
</div>

@if (Lightbox)
{
	<MokaLightbox Items="Items" Open="_lightboxOpen" OpenChanged="LightboxOpenChanged" Index="_lightboxIndex"
	              IndexChanged="_noteLightboxIndex" LoadSource="LoadSource" ReleaseSource="ReleaseSource"
	              Facts="LightboxFacts" Actions="LightboxActions" Text="Text"/>
}

@{
	void RenderTileBox(MokaMediaItem item, int index, TileState state, object? key)
	{
		if (IsInteractive)
		{
			@* A native button, so the tab stop, Enter and Space come from the browser. *@
			<button @key="key" type="button" class="@TileClass(state)" style="@ItemStyle"
			        aria-label="@ItemLabel(item, index, state)"
			        aria-haspopup="@(Lightbox ? "dialog" : null)"
			        @onclick="() => HandleItemClick(item, index)">
				@{ RenderTile(item, state); }
			</button>
		}
		else
		{
			<div @key="key" class="@TileClass(state)" style="@ItemStyle"
			     role="@(state == TileState.Shown ? null : "img")"
			     aria-label="@(state == TileState.Shown ? null : ItemLabel(item, index, state))">
				@{ RenderTile(item, state); }
			</div>
		}
	}

	void RenderTile(MokaMediaItem item, TileState state)
	{
		switch (state)
		{
			case TileState.Loading:
				<MokaSkeleton Shape="MokaSkeletonShape.Rectangle" Width="100%" Height="100%"
				              Class="moka-media-gallery-skeleton"/>
				break;
			case TileState.Failed:
				<span class="moka-media-gallery-failed" aria-hidden="true">
					<MokaIcon Icon="MokaIcons.Content.ImageOff" SizeValue="24px"/>
					<span class="moka-media-gallery-failed__text">@Text.Failed</span>
				</span>
				return;
			default:
				<img src="@ThumbnailOf(item)"
				     alt="@(item.Alt ?? "")"
				     loading="lazy"
				     @onerror="() => ThumbnailFailed(item)"/>
				break;
		}

		if (ShowOverlay)
		{
			<div class="moka-media-gallery-overlay">
				<MokaIcon Icon="MokaIcons.Content.ZoomIn" SizeValue="24px"/>
			</div>
		}
	}
}
