@namespace Moka.Red.Primitives.Gauge
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="meter"
     aria-valuenow="@Value"
     aria-valuemin="@Min"
     aria-valuemax="@ScaleMax"
     aria-valuetext="@ValueText"
     aria-label="@(Label ?? "Gauge")"
     @attributes="AdditionalAttributes">

	<svg class="moka-gauge-svg" viewBox="@ViewBox" xmlns="http://www.w3.org/2000/svg">
		<!-- Background track -->
		<path class="moka-gauge-track"
		      d="@ArcPath"
		      fill="none"
		      stroke-width="@ArcStrokeStr"
		      stroke-linecap="round"/>

		<!-- Filled arc -->
		<path class="moka-gauge-fill"
		      d="@ArcPath"
		      fill="none"
		      stroke-width="@ArcStrokeStr"
		      stroke-linecap="round"
		      stroke-dasharray="@ArcLengthStr"
		      stroke-dashoffset="@DashOffsetStr"/>
	</svg>

	@if (ShowValue || HasDisplay || HasWord || ShowLabel)
	{
		<div class="moka-gauge-center">
			@if (HasDisplay)
			{
				<span class="@DisplayClass" style="@DisplayStyle">@Display</span>
				@if (ShowValue)
				{
					<span class="moka-gauge-figure">@FormattedValue</span>
				}
			}
			else if (ShowValue)
			{
				<span class="moka-gauge-value">@FormattedValue</span>
			}
			@if (HasWord)
			{
				<span class="@WordClass">@Word</span>
			}
			@if (ShowLabel)
			{
				<span class="moka-gauge-label">@Label</span>
			}
		</div>
	}

	@if (AutoScale)
	{
		<div class="moka-gauge-scale" aria-hidden="true">
			<span>@ScaleText(Min)</span>
			<span>@ScaleText(ScaleMax)</span>
		</div>
	}
</div>
