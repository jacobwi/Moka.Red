@namespace Moka.Red.Primitives.Button
@inherits MokaVisualComponentBase

@if (IsLink)
{
	<a class="@CssClass" style="@CssStyle" id="@Id"
	   data-moka-look="@LookName"
	   data-moka-disabled-look="@DisabledLookName"
	   href="@(IsDisabled ? null : LinkHref)"
	   target="@Target"
	   role="button"
	   aria-disabled="@(IsDisabled ? "true" : null)"
	   aria-busy="@(Loading ? "true" : null)"
	   tabindex="@(IsDisabled ? -1 : 0)"
	   @attributes="AdditionalAttributes"
	   @onclick="HandleClick"
	   @onclick:preventDefault="IsDisabled">
		@{ RenderInner(); }
	</a>
}
else
{
	@* While busy the button stays enabled, so it keeps focus, and the click's default action is cancelled: a submit
	   button's click and a form's Enter both submit through it. Until it renders interactively nothing could cancel
	   it, so it's natively disabled until then. *@
	<button class="@CssClass" style="@CssStyle" id="@Id"
	        data-moka-look="@LookName"
	        data-moka-disabled-look="@DisabledLookName"
	        type="@Type"
	        disabled="@NativeDisabled"
	        aria-disabled="@(Busy ? "true" : null)"
	        aria-busy="@(Loading ? "true" : null)"
	        @attributes="AdditionalAttributes"
	        @onclick="HandleClick"
	        @onclick:preventDefault="Busy">
		@{ RenderInner(); }
	</button>
}

@{
	void RenderInner()
	{
		if (SpinnerAt == SpinnerPlace.Start)
		{
			<span class="moka-btn-spinner" aria-hidden="true">
				<MokaIcon Icon="MokaIcons.Status.Spinner" Size="@IconSize" Class="moka-btn-spinner-svg moka-spin"/>
			</span>
		}
		else if (StartIcon is not null)
		{
			<MokaIcon Icon="StartIcon.Value" Size="@IconSize" Class="moka-btn-icon moka-btn-icon--start"/>
		}

		if (ChildContent is not null)
		{
			<span class="moka-btn-content">@ChildContent</span>
		}

		if (SpinnerAt == SpinnerPlace.End)
		{
			<span class="moka-btn-spinner" aria-hidden="true">
				<MokaIcon Icon="MokaIcons.Status.Spinner" Size="@IconSize" Class="moka-btn-spinner-svg moka-spin"/>
			</span>
		}
		else if (EndIcon is not null)
		{
			<MokaIcon Icon="EndIcon.Value" Size="@IconSize" Class="moka-btn-icon moka-btn-icon--end"/>
		}

		if (SpinnerAt == SpinnerPlace.Over)
		{
			<span class="moka-btn-spinner moka-btn-spinner--over" aria-hidden="true">
				<MokaIcon Icon="MokaIcons.Status.Spinner" Size="@IconSize" Class="moka-btn-spinner-svg moka-spin"/>
			</span>
		}

		if (Loading)
		{
			<span class="moka-visually-hidden" role="status">@(_announcing ? LoadingText : null)</span>
		}
	}
}
