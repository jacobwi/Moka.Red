@namespace Moka.Red.Primitives.CodeBlock
@using Moka.Red.Core.Clipboard
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (ShowHeader)
	{
		<div class="moka-code-block__header">
			@if (Language is not null)
			{
				<span class="moka-code-block__language">@Language</span>
			}
			<span class="moka-code-block__spacer"></span>
			@if (ShowCopyButton)
			{
				@* Its label shows, so it needs no tooltip; a title saying the same thing only brought the browser's own hint. *@
				<button type="button"
				        class="@CopyButtonClass"
				        data-moka-copy-from=".moka-code-block__line"
				        @onmokacopied="HandleCopied">
					@(_copied ? "Copied!" : "Copy")
				</button>
			}
		</div>
	}
	@MokaCodeBlockGate.For(_listingVersion, Listing)
</div>

@code {
	private RenderFragment Listing => @<pre class="moka-code-block__pre moka-thin-scrollbar" style="@PreStyle"><code class="moka-code-block__code">@foreach (var (line, index) in _lines.Select((l, i) => (l, i)))
{
@if (ShowLineNumbers)
{
<span class="moka-code-block__line-number">@(index + 1)</span>
}

<span class="moka-code-block__line">@line</span> @if (index < _lines.Length - 1)
{
@("\n")
}
}</code></pre>;
}
