@namespace Moka.Red.Primitives.SegmentedControl
@inherits MokaComponentBase
@typeparam TValue

@* The radio is the real control. It covers the whole segment, invisible, so it takes the clicks, the
   focus and the arrow keys, and attributes passed to the segment land on it: an aria-label names an
   icon-only segment and a title shows as its tooltip. It has no value attribute: its own change handler
   knows the segment's typed value, and the generated group name means a form post carries nothing. *@
<label class="@CssClass" style="@CssStyle">
	<input type="radio"
	       class="moka-segment__input"
	       id="@Id"
	       name="@Parent?.GroupName"
	       checked="@IsChecked"
	       disabled="@IsDisabled"
	       title="@CutTextTitle"
	       @onchange="HandleChange"
	       @attributes="AdditionalAttributes"/>

	@if (Icon is not null)
	{
		<MokaIcon Icon="Icon.Value" SizeValue="14px" Class="moka-segment__icon"/>
	}

	@if (!string.IsNullOrEmpty(Text))
	{
		<span class="moka-segment__text">@Text</span>
	}

	@if (Count is not null)
	{
		<span class="moka-segment__count">@Count</span>
	}
</label>
