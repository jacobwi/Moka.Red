@namespace Moka.Red.Primitives.Tree
@inherits MokaComponentBase

@* Every item takes focus from script (tabindex -1) and the tree module keeps one of them in the tab
   order. The states are strings: Blazor would drop a false boolean attribute altogether. *@
<div class="@CssClass" style="@CssStyle" id="@Id" role="treeitem"
     tabindex="-1"
     aria-expanded="@(_hasChildren ? (_expanded ? "true" : "false") : null)"
     aria-selected="@(TreeSelectable ? (_selected ? "true" : "false") : null)"
     aria-disabled="@(IsDisabled ? "true" : null)"
     @attributes="AdditionalAttributes">
	<div class="@RowCssClass"
	     style="padding-left: @(Depth * 20)px"
	     @onclick="HandleClick"
	     @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
	     @oncontextmenu="HandleContextMenu">
		@if (_hasChildren)
		{
			@* Out of the tab order and hidden from screen readers: Right and Left do this from the
			   keyboard, and aria-expanded on the item carries the state. *@
			<button class="@ToggleCssClass"
			        type="button"
			        tabindex="-1"
			        aria-hidden="true"
			        @onclick="ToggleExpand"
			        @onclick:stopPropagation="true"
			        aria-label="@(_expanded ? "Collapse" : "Expand")">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
			</button>
		}
		else
		{
			<span class="moka-tree-item__toggle-spacer"></span>
		}

		@if (Icon is not null)
		{
			<MokaIcon Icon="Icon.Value" Size="MokaSize.Xs" Class="moka-tree-item__icon"/>
		}

		@if (!string.IsNullOrEmpty(Text))
		{
			<span class="moka-tree-item__text">@Text</span>
		}
	</div>

	@if (_expanded && ChildContent is not null)
	{
		<div class="moka-tree-item__children" role="group">
			<CascadingValue Value="@(Depth + 1)" Name="TreeDepth">
				<CascadingValue Value="IsDisabled" Name="TreeAncestorDisabled">
					@ChildContent
				</CascadingValue>
			</CascadingValue>
		</div>
	}
</div>
