@namespace Moka.Red.Primitives.Tree
@inherits MokaComponentBase

@* Every item takes focus from script (tabindex -1) and the tree module keeps one of them in the tab
   order. The states are strings: Blazor would drop a false boolean attribute altogether. *@
<div class="@CssClass" style="@CssStyle" id="@Id" role="treeitem"
     tabindex="-1"
     aria-expanded="@(_hasChildren ? (_expanded ? "true" : "false") : null)"
     aria-selected="@(TreeSelectable ? (_selected ? "true" : "false") : null)"
     aria-disabled="@(IsDisabled ? "true" : null)"
     @attributes="AdditionalAttributes">
	<div class="@RowCssClass"
	     style="padding-left: @(Depth * 20)px"
	     draggable="@(CanDrag ? "true" : null)"
	     @onclick="HandleClick"
	     @oncontextmenu:preventDefault="OnContextMenu.HasDelegate"
	     @oncontextmenu="HandleContextMenu"
	     @ondragstart="DragStartCallback"
	     @ondragend="DragEndCallback"
	     @ondragenter="DragEnterCallback"
	     @ondragleave="DragLeaveCallback"
	     @ondragover:preventDefault="AcceptsDrop"
	     @ondrop:preventDefault="AcceptsDrop"
	     @ondrop="DropCallback">
		@if (_hasChildren)
		{
			@* Out of the tab order and hidden from screen readers: Right and Left do this from the
			   keyboard, and aria-expanded on the item carries the state. The tooltip is hidden with it,
			   or its text would join the item's name while it shows. The toggles make a column down the
			   tree, so the name opens beside it. *@
			<MokaTooltip Text="@ToggleLabel" Position="MokaTooltipPosition.Right" aria-hidden="true">
				<button class="@ToggleCssClass"
				        type="button"
				        tabindex="-1"
				        aria-hidden="true"
				        @onclick="ToggleExpand"
				        @onclick:stopPropagation="true"
				        aria-label="@ToggleLabel">
					<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
				</button>
			</MokaTooltip>
		}
		else
		{
			<span class="moka-tree-item__toggle-spacer"></span>
		}

		@if (Icon is not null)
		{
			<MokaIcon Icon="Icon.Value" Size="MokaSize.Xs" Class="moka-tree-item__icon" Style="@IconStyle"/>
		}

		@if (!string.IsNullOrEmpty(Text))
		{
			<span class="moka-tree-item__text">@Text</span>
		}

		@if (EndContent is not null)
		{
			<span class="moka-tree-item__end" @onclick:stopPropagation="true">@EndContent</span>
		}
	</div>

	@if (_hasChildren && _expanded && ChildContent is not null)
	{
		<div class="moka-tree-item__children" role="group">
			<CascadingValue Value="@(Depth + 1)" Name="TreeDepth">
				<CascadingValue Value="IsDisabled" Name="TreeAncestorDisabled">
					@ChildContent
				</CascadingValue>
			</CascadingValue>
		</div>
	}
</div>
