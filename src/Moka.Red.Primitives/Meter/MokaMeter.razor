@namespace Moka.Red.Primitives.Meter
@using System.Globalization
@inherits MokaVisualComponentBase

@{
	RenderFragment name = @<span class="moka-meter__name">
		@if (StateIcon is { } icon)
		{
			<MokaIcon Icon="icon" SizeValue="1em" Class="moka-meter__state-icon"/>
		}
		@if (Label is not null)
		{
			<span class="moka-meter__label">@Label</span>
		}
		@if (StateWord is { } word)
		{
			<span class="moka-meter__state">@word</span>
		}
	</span>;
}

<span class="@CssClass" style="@CssStyle" id="@Id"
     role="meter"
     aria-valuenow="@Value"
     aria-valuemin="@Min"
     aria-valuemax="@Max"
     aria-label="@Label"
     aria-valuetext="@ValueText"
     @attributes="AdditionalAttributes">
	@if (Layout == MokaMeterLayout.Row)
	{
		@name
	}
	else if (Label is not null || ShowValue || StateWord is not null)
	{
		<span class="moka-meter__header">
			@if (StateWord is not null)
			{
				@name
			}
			else if (Label is not null)
			{
				<span class="moka-meter__label">@Label</span>
			}
			@if (ShowValue)
			{
				<span class="moka-meter__value">@ShownValue</span>
			}
		</span>
	}
	<span class="@TrackClass" style="@TrackStyle">
		@if (Target.HasValue)
		{
			<span class="moka-meter__bands">
				@foreach (Band band in Bands)
				{
					<span class="@band.Class" style="@band.Style"></span>
				}
			</span>
			<span class="moka-meter__fill moka-meter__fill--bullet" style="@BulletFillStyle"></span>
			<span class="moka-meter__target" style="@TargetStyle"></span>
		}
		else if (HasSegments)
		{
			<span class="moka-meter__segments" style="@SegmentStyle"></span>
			<span class="moka-meter__segments moka-meter__segments--filled" style="@FilledSegmentStyle"></span>
		}
		else
		{
			<span class="moka-meter__fill"
			     style="width: @(FillPercent.ToString(CultureInfo.InvariantCulture))%;">
			</span>
		}
	</span>
	@if (Layout == MokaMeterLayout.Row && ShowValue)
	{
		<span class="moka-meter__value">@ShownValue</span>
	}
</span>
