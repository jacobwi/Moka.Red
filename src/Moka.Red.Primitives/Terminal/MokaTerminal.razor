@namespace Moka.Red.Primitives.Terminal
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (ShowHeader)
	{
		<div class="moka-terminal-header">
			<div class="moka-terminal-dots">
				<span class="moka-terminal-dot moka-terminal-dot--red"></span>
				<span class="moka-terminal-dot moka-terminal-dot--yellow"></span>
				<span class="moka-terminal-dot moka-terminal-dot--green"></span>
			</div>
			<span class="moka-terminal-title">@Title</span>
			<div class="moka-terminal-actions">
				@if (ShowCopyButton)
				{
					<MokaCopyButton Text="" TextSource="AllText" TooltipPosition="MokaTooltipPosition.BottomEnd" class="moka-terminal-copy"/>
				}
			</div>
		</div>
	}

	<div class="moka-terminal-body moka-thin-scrollbar" id="@(Id is null ? null : $"{Id}-body")" style="@BodyStyle" @ref="_bodyRef">
		@if (Commands is { Count: > 0 })
		{
			<div class="moka-terminal-commands">
				@foreach (MokaTerminalCommand command in Commands)
				{
					bool running = command.State == MokaTerminalCommandState.Running;
					<article class="@CommandClass(command)" aria-label="@command.Command">
						<header class="moka-terminal-command-head">
							<MokaStatusDot Size="MokaSize.Sm" Color="@StateColor(command)" Pulse="running" aria-label="@StateName(command)"/>
							<code class="moka-terminal-command-text">@command.Command</code>
							<span class="moka-terminal-command-actions">
								<MokaCopyButton Text="" TextSource="() => CommandText(command)" TooltipText="@CopyLabel" Class="moka-terminal-action">
									@CopyLabel
								</MokaCopyButton>
								@if (OnEdit.HasDelegate && !running)
								{
									<button type="button" class="moka-terminal-action" @onclick="() => OnEdit.InvokeAsync(command)">@EditLabel</button>
								}
								@if (OnRunAgain.HasDelegate && !running)
								{
									<button type="button" class="moka-terminal-action" @onclick="() => OnRunAgain.InvokeAsync(command)">@RunAgainLabel</button>
								}
							</span>
						</header>
						@if (command.Lines is { Count: > 0 })
						{
							<div class="moka-terminal-command-output">
								@Output(command.Lines)
							</div>
						}
					</article>
				}
			</div>
		}
		else if (Lines is { Count: > 0 })
		{
			@Output(Lines)
		}
		else
		{
			@ChildContent
		}
	</div>
</div>
