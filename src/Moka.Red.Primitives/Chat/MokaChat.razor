@namespace Moka.Red.Primitives.Chat
@using Moka.Red.Primitives.Emoji
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes" @ref="_root">
	@if (HeaderContent is not null)
	{
		<div class="moka-chat__header">
			@HeaderContent
		</div>
	}

	<div class="moka-chat__messages" @ref="_messageListRef">
		@foreach (var message in Messages)
		{
			@if (MessageTemplate is not null)
			{
				@MessageTemplate(message)
			}
			else if (message.IsSystem)
			{
				<div class="moka-chat__msg moka-chat__msg--system">
					<span class="moka-chat__msg-text">@message.Text</span>
				</div>
			}
			else if (message.IsOwn)
			{
				<div class="moka-chat__msg moka-chat__msg--own">
					<div class="moka-chat__bubble moka-chat__bubble--own">
						<span class="moka-chat__msg-text">@message.Text</span>
						<div class="moka-chat__msg-meta">
							@if (ShowTimestamps)
							{
								<span class="moka-chat__timestamp">@FormatTimestamp(message.Timestamp)</span>
							}
							@if (ShowStatus)
							{
								<span class="moka-chat__status @(message.Status == MokaChatMessageStatus.Read ? "moka-chat__status--read" : "") @(message.Status == MokaChatMessageStatus.Error ? "moka-chat__status--error" : "")">@GetStatusIcon(message.Status)</span>
							}
						</div>
					</div>
				</div>
			}
			else
			{
				<div class="moka-chat__msg moka-chat__msg--other">
					@if (ShowAvatars)
					{
						<div class="moka-chat__avatar">
							@if (message.AvatarUri is not null)
							{
								<img class="moka-chat__avatar-img" src="@message.AvatarUri" alt="@message.Author"/>
							}
							else
							{
								<span class="moka-chat__avatar-initials">@(message.AvatarInitials ?? message.Author[..1].ToUpperInvariant())</span>
							}
						</div>
					}
					<div class="moka-chat__bubble moka-chat__bubble--other">
						<span class="moka-chat__msg-author">@message.Author</span>
						<span class="moka-chat__msg-text">@message.Text</span>
						@if (ShowTimestamps)
						{
							<span class="moka-chat__timestamp">@FormatTimestamp(message.Timestamp)</span>
						}
					</div>
				</div>
			}
		}

		@if (IsTyping)
		{
			<div class="moka-chat__msg moka-chat__msg--typing">
				<div class="moka-chat__typing">
					<span class="moka-chat__typing-dots">
						<span></span><span></span><span></span>
					</span>
					@if (!string.IsNullOrEmpty(TypingUser))
					{
						<span class="moka-chat__typing-text">@TypingUser is typing...</span>
					}
				</div>
			</div>
		}
	</div>

	@if (ShowInput && ShowEmoji && EmojiDocked)
	{
		<MokaEmojiPanel Class="moka-chat__emoji-dock" Options="@ChatEmojiOptions" OptionsChanged="EmojiOptionsChanged"
		                Open="_emojiOpen" OpenChanged="EmojiOpenChanged" OnPick="InsertEmojiAsync" FocusOnClose="_inputRef"
		                AutoFocus="true" Disabled="@Disabled"/>
	}

	@if (ShowInput)
	{
		<div class="moka-chat__input">
			<textarea class="moka-chat__input-field"
					  placeholder="@Placeholder"
					  @bind="_inputText"
					  @bind:event="oninput"
					  @onkeydown="HandleKeyDown"
					  @ref="_inputRef"
					  rows="1"
					  disabled="@Disabled"></textarea>
			@if (ShowEmoji)
			{
				<MokaTooltip Text="@(_emojiOpen ? null : EmojiLabel)" Position="MokaTooltipPosition.TopEnd">
					<button class="moka-chat__emoji-btn"
					        type="button"
					        aria-label="@EmojiLabel"
					        aria-haspopup="@(EmojiDocked ? null : "dialog")"
					        aria-expanded="@(_emojiOpen ? "true" : "false")"
					        disabled="@Disabled"
					        @ref="_emojiButton"
					        @onclick="ToggleEmoji">
						<MokaIcon Icon="MokaIcons.Content.SmilePlus" SizeValue="18px"/>
					</button>
				</MokaTooltip>
			}
			@* The input row sits at the bottom of the chat, so the name opens above it. *@
			<MokaTooltip Text="Send message" Position="MokaTooltipPosition.TopEnd">
				<button class="moka-chat__send-btn"
				        type="button"
				        disabled="@(Disabled || string.IsNullOrWhiteSpace(_inputText))"
				        @onclick="HandleSend"
				        aria-label="Send message">
					<MokaIcon Icon="MokaIcons.Action.Send" SizeValue="16px"/>
				</button>
			</MokaTooltip>
		</div>

		@if (ShowEmoji && !EmojiDocked)
		{
			<MokaEmojiPanel Anchor="_emojiButton" Placement="MokaTooltipPosition.TopEnd" Options="@ChatEmojiOptions"
			                OptionsChanged="EmojiOptionsChanged" Open="_emojiOpen" OpenChanged="EmojiOpenChanged"
			                OnPick="InsertEmojiAsync" FocusOnClose="_inputRef"/>
		}
	}
</div>
