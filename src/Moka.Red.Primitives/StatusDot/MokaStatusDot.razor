@namespace Moka.Red.Primitives.StatusDot
@inherits MokaVisualComponentBase

<span class="@CssClass" style="@CssStyle" id="@Id" role="@Role" @attributes="AdditionalAttributes">
	<span class="moka-status-dot-dot" style="@DotStyle" aria-hidden="true"></span>
	@if (HasLabel)
	{
		<span class="moka-status-dot-label">@Label</span>
	}
</span>
