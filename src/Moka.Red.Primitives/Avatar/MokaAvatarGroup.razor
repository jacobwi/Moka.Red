@namespace Moka.Red.Primitives.Avatar
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	<CascadingValue Value="this" IsFixed="true">
		<CascadingValue Value="_sizing">
			@_avatars.Collect(ChildContent)
		</CascadingValue>
	</CascadingValue>

	@if (OverflowCount > 0)
	{
		<MokaAvatar Class="moka-avatar-group__overflow" Initials="@($"+{OverflowCount}")" Color="MokaColor.Surface"
		            Size="@Size" SizeValue="@SizeValue"/>
	}
</div>
