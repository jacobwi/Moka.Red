@namespace Moka.Red.Primitives.Countdown
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (_isComplete)
	{
		<span class="moka-countdown-completed">@CompletedText</span>
	}
	else
	{
		bool first = true;
		for (int i = 0; i < _units.Length; i++)
		{
			if (!IsShown(i))
			{
				continue;
			}

			CountdownUnit unit = _units[i];
			if (!first)
			{
				<span class="moka-countdown-sep">@Separator</span>
			}

			first = false;
			<div class="moka-countdown-unit" style="@UnitStyle">
				<span @key="ValueKey(unit)" class="@ValueClass(unit)" style="@ValueStyle">@FormatValue(unit)</span>
				@if (ShowLabels)
				{
					<span class="moka-countdown-label">@LabelFor(unit)</span>
				}
			</div>
		}
	}
</div>
