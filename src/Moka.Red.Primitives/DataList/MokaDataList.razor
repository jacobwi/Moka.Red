@namespace Moka.Red.Primitives.DataList
@using Moka.Red.Primitives.Icon
@inherits MokaVisualComponentBase

<dl class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (Items is not null)
	{
		@foreach (MokaDataListItem item in Items)
		{
			string? copy = item.TextToCopy;
			bool empty = item.Values is null
				? copy is null && item.ValueContent is null && string.IsNullOrEmpty(item.Value)
				: item.Values.Count == 0;
			MokaIconDefinition? termIcon = IconOf(item);
			bool hasHelp = HasHelp(item);
			<div class="@EntryClass(item, copy)"
			     @oncontextmenu="ContextMenuHandler(item)"
			     @oncontextmenu:preventDefault="ListensForContextMenu">
				<dt class="@TermClass(termIcon)">
					@if (termIcon is { } icon)
					{
						<MokaIcon Icon="icon" SizeValue="1.25em" Class="moka-data-list-icon"/>
					}
					@if (termIcon is null && !hasHelp)
					{
						@item.Label
					}
					else
					{
						<span class="moka-data-list-label">@item.Label</span>
					}
					@if (hasHelp)
					{
						<span class="@HelpClass(item)">@item.Help</span>
					}
				</dt>
				<dd class="@DescriptionClass(item, empty)">
					@if (item.HasSeveral)
					{
						@foreach (MokaDataListValue value in item.Values!)
						{
							@SeveralValue(item, value)
						}
						@if (item.EndContent is not null)
						{
							<span class="moka-data-list-end">@item.EndContent</span>
						}
					}
					else if (item.EndContent is null)
					{
						@ValueOf(item, copy, empty)
					}
					else
					{
						<span class="moka-data-list-value">@ValueOf(item, copy, empty)</span>
						<span class="moka-data-list-end">@item.EndContent</span>
					}
				</dd>
			</div>
		}
	}
	else if (ChildContent is not null)
	{
		@ChildContent
	}
</dl>

@code {

	private RenderFragment CopyValue(string tooltip, string name, string copy, RenderFragment shown) =>
		@<MokaCopyButton Text="@copy" Quiet="true" Class="moka-data-list-copy-value"
		                 TooltipText="@tooltip" CopiedText="@CopiedText" FailedText="@CopyFailedText"
		                 aria-label="@name" disabled="@Disabled">
			<span class="moka-data-list-copy-text">@shown</span>
			<span class="moka-data-list-copy-icon moka-data-list-copy-icon--idle"><MokaIcon Icon="MokaIcons.Content.Copy" SizeValue="1em"/></span>
			<span class="moka-data-list-copy-icon moka-data-list-copy-icon--done"><MokaIcon Icon="MokaIcons.Status.Check" SizeValue="1em"/></span>
		</MokaCopyButton>;

	private RenderFragment SeveralValue(MokaDataListItem item, MokaDataListValue value) =>
		@<span class="moka-data-list-value">
			@{
				string? copy = value.TextToCopy(item.Copyable);
				string shown = string.IsNullOrEmpty(value.Text) ? copy ?? string.Empty : value.Text;
			}
			@if (copy is not null && CopyStyle == MokaDataListCopyStyle.ClickValue)
			{
				@CopyValue(value.CopyLabel ?? CopyName(item), ValueCopyName(item, value, shown), copy, Plain(shown))
			}
			else if (copy is not null)
			{
				<MokaCopyable Text="@copy" Label="@item.Label" Mono="false" Wrap="true" CopyLabel="@ValueCopyName(item, value, shown)"
				              CopiedText="@CopiedText" FailedText="@CopyFailedText">@shown</MokaCopyable>
			}
			else
			{
				@shown
			}
			@if (!string.IsNullOrEmpty(value.Note))
			{
				<span class="moka-data-list-note">@value.Note</span>
			}
		</span>;

}
