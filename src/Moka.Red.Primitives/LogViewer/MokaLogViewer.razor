@namespace Moka.Red.Primitives.LogViewer
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Moka.Red.Primitives.Button
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (ShowSearch || ShowLevelFilter)
	{
		<div class="moka-log-viewer__toolbar">
			@if (ShowSearch && SubmitsSearch)
			{
				<form class="moka-log-viewer__search" role="search" @onsubmit="SubmitSearchAsync" @onsubmit:preventDefault>
					<MokaIcon Icon="MokaIcons.Action.Search" SizeValue="14px"/>
					<input type="text"
					       class="moka-log-viewer__search-input"
					       placeholder="@Words.SearchPlaceholder"
					       aria-label="@Words.SearchLabel"
					       enterkeyhint="search"
					       @bind:get="_typed"
					       @bind:set="OnSearchTypedAsync"
					       @bind:event="oninput"/>
					<MokaTooltip Text="@Words.SearchButton" Position="MokaTooltipPosition.BottomEnd">
						<button type="submit" class="moka-log-viewer__submit" aria-label="@Words.SearchButton">
							<MokaIcon Icon="MokaIcons.Navigation.ArrowRight" SizeValue="12px"/>
						</button>
					</MokaTooltip>
				</form>
			}
			else if (ShowSearch)
			{
				<div class="moka-log-viewer__search">
					<MokaIcon Icon="MokaIcons.Action.Search" SizeValue="14px"/>
					<input type="text"
					       class="moka-log-viewer__search-input"
					       placeholder="@Words.SearchPlaceholder"
					       aria-label="@Words.SearchLabel"
					       @bind:get="_typed"
					       @bind:set="OnSearchTypedAsync"
					       @bind:event="oninput"/>
				</div>
			}
			@if (ShowLevelFilter && Thresholds)
			{
				<select class="moka-log-viewer__minimum" aria-label="@Words.MinimumLevelLabel"
				        @bind:get="_minimum" @bind:set="PickMinimumAsync">
					@foreach (MokaLogLevel level in AllLevels)
					{
						<option value="@level.ToString()">@Words.AtLeast(level)</option>
					}
				</select>
			}
			else if (ShowLevelFilter)
			{
				<div class="moka-log-viewer__filters">
					@foreach (var level in Enum.GetValues<MokaLogLevel>())
					{
						var lvl = level;
						<button class="moka-log-viewer__filter-btn moka-log-viewer__filter-btn--@LevelToCssClass(lvl) @(IsLevelEnabled(lvl) ? "moka-log-viewer__filter-btn--active" : "")"
						        aria-pressed="@(IsLevelEnabled(lvl) ? "true" : "false")"
						        @onclick="() => ToggleLevelAsync(lvl)">
							@LevelToLabel(lvl)
						</button>
					}
				</div>
			}
		</div>
	}

	@* Under Virtualize the list is a tab stop of its own, so the keyboard can scroll rows that hold no control. *@
	<div class="moka-log-viewer__body" style="@BodyStyle" @ref="_body"
	     tabindex="@BodyTabIndex"
	     role="@(Virtualizes ? "region" : null)"
	     aria-label="@(Virtualizes ? Words.EntriesLabel : null)"
	     data-moka-above="@_aboveToken">
		@if (HasOlder && !NewestFirst)
		{
			@OlderButton
		}
		@if (ItemsProvider is not null)
		{
			<Virtualize @ref="_virtualize" TItem="MokaLogEntry" ItemsProvider="Provide" ItemContent="VirtualRow"
			            Placeholder="PlaceholderRow" EmptyContent="EmptyState" ItemSize="VirtualRowHeight"/>
		}
		else if (Entries is null or { Count: 0 })
		{
			@EmptyState
		}
		else if (Virtualizes)
		{
			<Virtualize @ref="_virtualize" TItem="MokaLogEntry" Items="_shown" ItemContent="VirtualRow"
			            ItemSize="VirtualRowHeight"/>
		}
		else
		{
			int position = 0;
			@foreach (MokaLogEntry entry in _shown)
			{
				int index = position++;
				bool open = _open.Contains(entry);
				<div class="@RowClass(entry, open)">
					@Cells(entry, false)
					@if (entry.HasDetail)
					{
						@DetailToggle(entry, open, DetailId(index))
					}
				</div>
				@if (open)
				{
					<div class="moka-log-viewer__detail" id="@DetailId(index)">
						@DetailContent(entry, false)
					</div>
				}
			}
		}
		@if (HasOlder && NewestFirst)
		{
			@OlderButton
		}
	</div>

	@if (_paneEntry is { } paneEntry)
	{
		<section class="moka-log-viewer__pane" id="@PaneId" style="@PaneStyle" aria-label="@PaneLabel(paneEntry)">
			<div class="moka-log-viewer__pane-head">
				<span class="moka-log-viewer__pane-title">
					@Timestamp(paneEntry.Timestamp)
					<span class="@LevelClass(paneEntry.Level)">@LevelToLabel(paneEntry.Level)</span>
					@if (paneEntry.Source is not null)
					{
						<span class="moka-log-viewer__source">@paneEntry.Source</span>
					}
				</span>
				<MokaTooltip Text="@Words.CloseDetails" Position="MokaTooltipPosition.BottomEnd">
					<button type="button" class="moka-log-viewer__close" aria-label="@Words.CloseDetails"
					        @onclick="ClosePaneAsync">
						<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
					</button>
				</MokaTooltip>
			</div>
			<div class="moka-log-viewer__pane-body">
				@DetailContent(paneEntry, true)
			</div>
		</section>
	}
</div>

@code {
	// Templates, not local functions: rows render inside Virtualize, and a local function would write the markup into
	// this component's own render tree instead. Virtualize takes VirtualRow as a method group, so its rows share one
	// builder.
	private RenderFragment VirtualRow(MokaLogEntry entry) =>
		@<div class="@RowClass(entry, IsInPane(entry))">
			@Cells(entry, true)
			@if (entry.HasDetail)
			{
				@DetailToggle(entry, IsInPane(entry), PaneId)
			}
		</div>;

	private RenderFragment PlaceholderRow(PlaceholderContext _) =>
		@<div class="moka-log-viewer__row moka-log-viewer__row--loading" aria-hidden="true">
			<MokaSkeleton Width="60%"/>
		</div>;

	private RenderFragment EmptyState => @<div class="moka-log-viewer__empty">@Words.NoEntries</div>;

	// At the old end of the list, inside it, so the reader reaches it by scrolling to the oldest line they have.
	private RenderFragment OlderButton =>
		@<div class="moka-log-viewer__older">
			<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm"
			            StartIcon="@(NewestFirst ? MokaIcons.Navigation.ChevronDown : MokaIcons.Navigation.ChevronUp)"
			            Loading="_loadingOlder" LoadingText="@Words.LoadingOlder" OnClick="LoadOlderAsync">@Words.ShowOlder</MokaButton>
		</div>;

	// A time element only for a timestamp written the app's way, so the default markup stays as it was.
	private RenderFragment Timestamp(DateTime at) =>
		@<text>@if (WritesOwnTimes)
		{
			<time class="moka-log-viewer__timestamp" datetime="@MachineTime(at)">@WriteTimestamp(at)</time>
		}
		else
		{
			<span class="moka-log-viewer__timestamp">@WriteTimestamp(at)</span>
		}</text>;

	// A virtualized row is one line, so its message carries the whole text in a title, and its source too, which a
	// narrow row cuts.
	private RenderFragment Cells(MokaLogEntry entry, bool oneLine) =>
		@<text>
			@if (ShowTimestamp)
			{
				@Timestamp(entry.Timestamp)
			}
			@if (ShowLevel)
			{
				<span class="@LevelClass(entry.Level)">@LevelToLabel(entry.Level)</span>
			}
			@if (entry.Source is not null)
			{
				<span class="moka-log-viewer__source" title="@(oneLine ? entry.Source : null)">@entry.Source</span>
			}
			<span class="moka-log-viewer__message" title="@(oneLine ? entry.Message : null)">@entry.Message</span></text>;

	private RenderFragment DetailToggle(MokaLogEntry entry, bool open, string controls) =>
		@<MokaTooltip Text="@ToggleLabel(open)" Position="MokaTooltipPosition.BottomEnd" Class="moka-log-viewer__toggle-tip">
			<button type="button" class="moka-log-viewer__toggle"
			        aria-expanded="@(open ? "true" : "false")"
			        aria-controls="@(open ? controls : null)"
			        aria-label="@ToggleLabel(open)"
			        @onclick="() => ToggleDetail(entry)">
				<MokaIcon Icon="@(open ? MokaIcons.Navigation.ChevronDown : MokaIcons.Navigation.ChevronRight)" SizeValue="12px"/>
			</button>
		</MokaTooltip>;

	private RenderFragment DetailContent(MokaLogEntry entry, bool withMessage) =>
		@<div class="moka-log-viewer__detail-content">
			@if (withMessage)
			{
				<p class="moka-log-viewer__detail-message">@entry.Message</p>
			}
			@if (DetailTemplate is not null)
			{
				@DetailTemplate(entry)
			}
			else
			{
				@if (!string.IsNullOrEmpty(entry.Exception))
				{
					<pre class="moka-log-viewer__exception">@entry.Exception</pre>
				}
				@if (entry.Properties is { Count: > 0 } properties)
				{
					<dl class="moka-log-viewer__properties">
						@foreach (KeyValuePair<string, string> property in properties)
						{
							<dt>@property.Key</dt>
							<dd>@property.Value</dd>
						}
					</dl>
				}
			}
		</div>;
}
