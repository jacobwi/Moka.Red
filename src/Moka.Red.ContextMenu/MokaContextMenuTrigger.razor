@namespace Moka.Red.ContextMenu

<div class="moka-ctx-trigger"
     @oncontextmenu="HandleRightClick" @oncontextmenu:preventDefault="@PreventDefault"
     @onclick="HandleLeftClick">
	@ChildContent
</div>

@* Without a MokaContextMenuHost in the layout there is nothing to render the shared menu,
   so the trigger keeps its own. *@
@if (!UsesSharedMenu)
{
	<MokaContextMenu Items="Items" Visible="_isOpen" X="_x" Y="_y" OnClose="Close"/>
}
