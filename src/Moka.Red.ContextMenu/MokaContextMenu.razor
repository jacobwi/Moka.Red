@namespace Moka.Red.ContextMenu
@implements IAsyncDisposable

@if (Visible)
{
	@* Only the root menu owns a backdrop: a nested one would paint over its parent's items. *@
	@if (!IsSubmenu)
	{
		<div class="moka-ctx-backdrop" @onclick="HandleBackdropClick" @oncontextmenu:preventDefault></div>
	}

	<div class="@MenuClass" style="@MenuStyle"
	     @ref="_menuRef" tabindex="0" role="menu"
	     @onkeydown="HandleKeyDown"
	     @onmouseenter="HandleMenuMouseEnter"
	     @onmouseleave="HandleMenuMouseLeave">
		@foreach (var entry in BuildEntries())
		{
			@if (entry.IsDivider || entry.Item is null)
			{
				<div class="moka-ctx-divider"></div>
			}
			else
			{
				MokaContextMenuItem item = entry.Item!;
				int index = entry.ActionIndex;

				<div class="@ItemClass(item, index)"
				     data-moka-ctx-index="@index"
				     @onclick="() => HandleItemClick(item)"
				     @onmouseenter="() => HandleMouseEnterItem(item, index)"
				     role="menuitem"
				     aria-disabled="@(item.Disabled ? "true" : null)"
				     aria-haspopup="@(item.HasChildren ? "true" : null)">
					@if (item.Checked)
					{
						<span class="moka-ctx-check">
							<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="12px"/>
						</span>
					}
					else if (item.Icon is not null)
					{
						<MokaIcon Icon="item.Icon.Value" Size="MokaSize.Xs" class="moka-ctx-icon"/>
					}
					else
					{
						<span class="moka-ctx-icon-placeholder"></span>
					}
					<span class="moka-ctx-text">@item.Text</span>
					@if (item.Shortcut is not null)
					{
						<span class="moka-ctx-shortcut">@item.Shortcut</span>
					}
					@if (item.HasChildren)
					{
						<span class="moka-ctx-submenu-arrow">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="10px"/>
						</span>
					}
				</div>

				@* Sub-menu: a DOM child of this menu, so mouseleave here covers both. *@
				@if (item.HasChildren && ReferenceEquals(_openSubmenuParent, item))
				{
					<MokaContextMenu Items="item.Children!"
					                 Visible="true"
					                 X="_submenuX"
					                 Y="_submenuY"
					                 IsSubmenu="true"
					                 ParentLeft="_menuLeft"
					                 OnClose="OnClose"/>
				}
			}
		}
	</div>
}
