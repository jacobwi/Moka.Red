@namespace Moka.Red.ContextMenu

@* Service-driven host. Place once in your layout; renders the single shared context menu
   opened via IMokaContextMenuService.Show(...), and the radial menu opened via ShowRadial(...). *@
<MokaContextMenu Items="Service.Items"
                 Visible="Service.Visible"
                 X="Service.X"
                 Y="Service.Y"
                 OpenedFromKeyboard="Service.OpenedFromKeyboard"
                 AnchorTop="Service.AnchorTop"
                 AnchorToFocus="Service.AnchorToFocus"
                 Look="Look"
                 ItemStyle="ItemStyle"
                 FocusRing="FocusRing"
                 OnClose="Service.Close"/>

@{ MokaRadialMenuRequest? radial = Service.Radial; }
<MokaRadialMenu Spec="radial?.Spec"
                Visible="radial is not null"
                X="radial?.X ?? 0"
                Y="radial?.Y ?? 0"
                OpenedFromKeyboard="radial?.OpenedFromKeyboard ?? false"
                AnchorToFocus="radial?.AnchorToFocus ?? false"
                Flick="radial?.Flick ?? false"
                Shape="radial?.Spec.Shape ?? RadialShape"
                Look="radial?.Spec.Look ?? RadialLook"
                ChoiceStyle="radial?.Spec.ChoiceStyle ?? RadialChoiceStyle"
                AdaptToEdges="radial?.Spec.AdaptToEdges ?? RadialAdaptToEdges"
                OnClose="Service.Close"/>
