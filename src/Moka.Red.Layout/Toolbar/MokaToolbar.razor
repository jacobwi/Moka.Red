@namespace Moka.Red.Layout.Toolbar
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="toolbar" data-moka-expanded="@IsExpanded" @attributes="AdditionalAttributes" @ref="_root">
	@if (Expandable)
	{
		<div class="moka-toolbar__items">
			@ChildContent
		</div>
		<div class="moka-toolbar__more">
			@if (MoreContent is not null)
			{
				<div class="moka-toolbar__more-slot" data-moka-more>@MoreContent(_droppedCount)</div>
			}
			else
			{
				<MokaTooltip Text="@MoreName" Position="MokaTooltipPosition.BottomEnd">
					<button type="button"
					        class="moka-toolbar__more-button"
					        data-moka-more
					        aria-expanded="@AriaExpanded"
					        aria-label="@MoreName"
					        @onclick="ToggleExpanded">
						<MokaIcon Icon="MokaIcons.Navigation.MoreHorizontal" SizeValue="15px"/>
					</button>
				</MokaTooltip>
			}
		</div>
	}
	else
	{
		@ChildContent
	}
</div>
