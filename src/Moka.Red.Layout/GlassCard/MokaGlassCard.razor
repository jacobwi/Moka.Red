@namespace Moka.Red.Layout.GlassCard
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id"
	 @onclick="ButtonClick"
	 role="@(IsButton ? "button" : null)" tabindex="@TabIndex"
	 @attributes="RootAttributes" @ref="_element">
	@if (LinkHref is not null && !TitleIsAction)
	{
		RenderAction(true);
	}
	@if (HasHeader)
	{
		<div class="moka-glass-card__header" id="@HeaderId">
			@if (Header is not null)
			{
				@Header
			}
			else
			{
				@if (Title is not null)
				{
					<div class="moka-glass-card__title">
						@if (TitleIsAction)
						{
							RenderAction(false);
						}
						else
						{
							@Title
						}
					</div>
				}
				@if (Subtitle is not null)
				{
					<div class="moka-glass-card__subtitle">@Subtitle</div>
				}
			}
		</div>
	}
	@if (ChildContent is not null)
	{
		<div class="moka-glass-card__body" id="@BodyId">
			@ChildContent
		</div>
	}
	@if (Footer is not null)
	{
		<div class="moka-glass-card__footer">
			@Footer
		</div>
	}
</div>

@{
	void RenderAction(bool hidden)
	{
		<a class="@ActionCssClass(hidden)" href="@LinkHref" target="@Target" rel="@LinkRel"
		   aria-labelledby="@ActionLabelledBy(hidden)"
		   @onclick="OnClick" @attributes="ActionAttributes">@{ RenderActionText(hidden); }</a>
	}

	void RenderActionText(bool hidden)
	{
		if (!hidden)
		{
			@Title
		}
		else if (HiddenActionName is not null)
		{
			<span class="moka-visually-hidden">@HiddenActionName</span>
		}

		if (OpensNewTab)
		{
			<span class="moka-visually-hidden" id="@NewTabWordsId">, @NewTabText</span>
		}
	}
}
