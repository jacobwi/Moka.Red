@namespace Moka.Red.Layout.Resizable
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @ref="_containerRef" @attributes="AdditionalAttributes">
	@ChildContent

	@* The edge handles are window splitters: focusable, named, and resized with the arrow keys,
	   Home and End by moka-drag.js, which also keeps their aria-valuenow, aria-valuemin and
	   aria-valuemax in px. *@
	@if (HasRightHandle)
	{
		<div class="@HandleClass("right")" @ref="_rightHandleRef"
		     role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize width"
		     aria-controls="@Id"></div>
	}

	@if (HasBottomHandle)
	{
		<div class="@HandleClass("bottom")" @ref="_bottomHandleRef"
		     role="separator" tabindex="0" aria-orientation="horizontal" aria-label="Resize height"
		     aria-controls="@Id"></div>
	}

	@* Pointer only: the two edge handles already cover both axes from the keyboard. *@
	@if (HasCornerHandle)
	{
		<div class="@HandleClass("corner")" @ref="_cornerHandleRef" aria-hidden="true"></div>
	}
</div>
