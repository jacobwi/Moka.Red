@namespace Moka.Red.Layout.StatusBar
@inherits MokaVisualComponentBase

<footer class="@CssClass" style="@CssStyle" id="@Id" data-moka-expanded="@IsExpanded" @attributes="AdditionalAttributes" @ref="_root">
	<div class="moka-statusbar-start">
		@StartContent
		@ChildContent
	</div>
	<div class="moka-statusbar-end">
		@if (Expandable && MoreContent is not null)
		{
			<div class="moka-statusbar-more-slot" data-moka-more>@MoreContent(_droppedCount)</div>
		}
		else if (Expandable)
		{
			<button type="button"
			        class="moka-statusbar-more"
			        data-moka-more
			        aria-expanded="@AriaExpanded"
			        aria-label="@MoreName"
			        @onclick="ToggleExpanded">@MoreText</button>
		}
		@EndContent
	</div>
</footer>
