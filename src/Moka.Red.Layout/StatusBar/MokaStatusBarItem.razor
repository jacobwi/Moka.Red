@namespace Moka.Red.Layout.StatusBar
@inherits MokaComponentBase

<div class="@CssClass"
     style="@CssStyle"
     id="@Id"
     title="@Tooltip"
     role="@(IsClickable ? "button" : null)"
     tabindex="@TabIndex"
     @onclick="HandleClick"
     @attributes="AdditionalAttributes"
     @ref="_element">
	@if (ChildContent is not null)
	{
		@ChildContent
	}
	else
	{
		@if (Icon is not null)
		{
			<MokaIcon Icon="Icon.Value" SizeValue="14px" Class="moka-statusbar-item-icon"/>
		}

		@if (!string.IsNullOrEmpty(Text))
		{
			<span class="moka-statusbar-item-text">@Text</span>
		}
	}
</div>
