@namespace Moka.Red.Layout.DockLayout
@inherits MokaDockPart

@if (Layout is null)
{
	<div class="@CssClass" style="@Style" id="@Id" @attributes="AdditionalAttributes">
		@if (Title is not null || TitleContent is not null || Actions is not null)
		{
			<div class="moka-dock-panel-header">
				@if (TitleContent is not null)
				{
					@TitleContent
				}
				else
				{
					<div class="moka-dock-panel-title">@Title</div>
				}
				@Actions
			</div>
		}
		<div class="@HostClass">@Body</div>
	</div>
}
else
{
	@* The host stays where the markup put it in the render tree, whichever group the state puts the panel in, so its
	   content keeps its component state across every move; the stylesheet draws it over its group's slot. *@
	<div id="@HostId" class="@HostClass" style="@HostStyle" hidden="@(!_placement.Visible)"
	     role="@(_placement.Tabbed ? "tabpanel" : null)" aria-labelledby="@_placement.TabId" tabindex="-1"
	     data-moka-dock-host="@PanelId" data-moka-dock-in="@_placement.Group" data-moka-dock-anchor="@AnchorAttribute"
	     @attributes="AdditionalAttributes">
		@if (RendersContent)
		{
			@MokaDockContentGate.For(_contentVersion, Body)
		}
	</div>
}
