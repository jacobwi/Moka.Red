@namespace Moka.Red.Layout.DockLayout
@inherits MokaComponentBase

<div @ref="_panelRef" class="@CssClass" style="@CssStyle" id="@Id" inert="@IsInert" @attributes="AdditionalAttributes">
	@if (HasHeader)
	{
		<div @ref="_headerRef" class="moka-dock-panel-header">
			<div class="moka-dock-panel-title-area">
				@if (TitleContent is not null)
				{
					@TitleContent
				}
				else if (Title is not null)
				{
					<div class="moka-dock-panel-title">@Title</div>
				}
			</div>
			<div class="moka-dock-panel-actions">
				@* A collapsed header shows only the title and the expand button. Anything else ran past
				   the edge of a strip, out of sight but still in the tab order. The actions stay
				   mounted behind hidden, like the body, so their components keep their state. *@
				@if (Actions is not null)
				{
					<span class="moka-dock-panel-custom-actions" hidden="@IsCollapsed">@Actions</span>
				}
				@if (_floating)
				{
					<MokaTooltip Text="Dock" Position="MokaTooltipPosition.BottomEnd">
						<button class="moka-dock-panel-toggle" @onclick="ToggleFloating" type="button" aria-label="Dock">
							<MokaIcon Icon="MokaIcons.Navigation.Dock" SizeValue="14px" Class="moka-dock-panel-icon"/>
						</button>
					</MokaTooltip>
				}
				else if (!IsCollapsed)
				{
					<MokaTooltip Text="Undock" Position="UndockTooltipPosition">
						<button class="moka-dock-panel-toggle" @onclick="ToggleFloating" type="button" aria-label="Undock">
							<MokaIcon Icon="MokaIcons.Navigation.Undock" SizeValue="14px" Class="moka-dock-panel-icon"/>
						</button>
					</MokaTooltip>
				}
				@if (Collapsible && !_floating)
				{
					<MokaTooltip Text="@CollapseLabel" Position="CollapseTooltipPosition">
						<button class="moka-dock-panel-toggle" @onclick="ToggleCollapse" type="button"
						        aria-label="@CollapseLabel"
						        aria-expanded="@(IsCollapsed ? "false" : "true")">
							<MokaIcon Icon="ChevronIcon" SizeValue="12px"/>
						</button>
					</MokaTooltip>
				}
			</div>
		</div>
	}

	@* Collapsing hides the body instead of removing it, so child components keep their state. *@
	<div class="@BodyClass" hidden="@IsCollapsed">
		@ChildContent
	</div>

	@if (HasSplitter)
	{
		<div @ref="_splitterRef" class="moka-dock-panel-splitter moka-dock-panel-splitter--@SplitterPosition">
			<div class="moka-dock-panel-splitter-handle"></div>
		</div>
	}
</div>
