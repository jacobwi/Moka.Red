@namespace Moka.Red.Layout.Panel
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@if (Title is not null || TitleContent is not null || Actions is not null)
	{
		<div class="moka-panel-header">
			<div class="moka-panel-title-area">
				@if (TitleContent is not null)
				{
					@TitleContent
				}
				else if (Title is not null)
				{
					<div class="moka-panel-title" id="@TitleId">@Title</div>
				}
			</div>
			<div class="moka-panel-actions">
				@Actions
				@if (Collapsible)
				{
					@* Named by the panel's title, the way a disclosure is, with aria-expanded for its state; the
					   tooltip says what a click does. It ends the header's row, so it lines up with the edge. *@
					<MokaTooltip Text="@(_collapsed ? "Expand" : "Collapse")" Position="MokaTooltipPosition.BottomEnd">
						<button class="moka-panel-toggle" @onclick="ToggleCollapse" type="button"
						        aria-expanded="@ToggleExpanded" aria-controls="@BodyId"
						        aria-labelledby="@ToggleLabelledBy" aria-label="@ToggleLabel">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="14px"
							          Class="@ChevronCssClass"/>
						</button>
					</MokaTooltip>
				}
			</div>
		</div>
	}
	@* inert keeps the hidden content out of the tab order and away from screen readers. The
	   clip element is what the grid row shrinks, so the padding below it collapses too. *@
	<div class="moka-panel-body" id="@BodyId" inert="@_collapsed">
		<div class="moka-panel-body-clip">
			<div class="moka-panel-body-inner">
				@ChildContent
			</div>
		</div>
	</div>
</div>
