<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Moka.Red.Diagnostics</PackageId>
		<Description>Development-time diagnostics overlay for Moka.Red - theme token inspector, render tracking, and performance profiling.</Description>
		<!-- A dev tool that reads the app through reflection, so it stays whole. -->
		<IsTrimmable>false</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Moka.Red.Diagnostics.Tests" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Moka.Red.Core\Moka.Red.Core.csproj" />
	</ItemGroup>

</Project>
