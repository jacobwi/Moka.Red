<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Moka.Red.Diagnostics</PackageId>
		<Description>Development-time diagnostics overlay for Moka.Red - theme token inspector, render tracking, and performance profiling.</Description>
		<!-- A dev tool that reads the app through reflection, so it stays whole. -->
		<IsTrimmable>false</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Moka.Red.Diagnostics.Tests" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
	</ItemGroup>

	<!-- IHostEnvironment, read to keep the diagnostics off outside Development. One version per framework, as for
	     Microsoft.AspNetCore.Components.Web, so a .NET 9 app doesn't get a .NET 10 hosting assembly. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="9.0.23" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.15" />
	</ItemGroup>

</Project>
