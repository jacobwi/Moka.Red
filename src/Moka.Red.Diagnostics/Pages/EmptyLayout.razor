@namespace Moka.Red.Diagnostics.Pages
@inherits LayoutComponentBase

@* The page sits outside the app's layout, and with it the app's provider, so it brings one of its own: that links the
   library's stylesheet, whose tokens and utilities the panels and their tooltips read. *@
<MokaThemeProvider Theme="@(Theme ?? MokaTheme.Default)">
	<div class="moka-diag-page-layout">
		@Body
	</div>
</MokaThemeProvider>

@code {

	[CascadingParameter]
	private MokaTheme? Theme { get; set; }

}
