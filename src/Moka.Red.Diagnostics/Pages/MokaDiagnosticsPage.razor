@page "/moka-diagnostics"
@namespace Moka.Red.Diagnostics.Pages
@layout EmptyLayout

@if (_shown)
{
	<div class="moka-diag-page">
		<header class="moka-diag-page-header">
			<h1>Moka.Red Diagnostics</h1>
		</header>
		@if (_diagnosticsService is null)
		{
			<p class="moka-diag-page-notice">
				Diagnostics are not registered. Call <code>AddMokaDiagnostics()</code> in Program.cs to fill this page.
			</p>
		}
		else if (_session is { Ended: true })
		{
			<p class="moka-diag-page-notice">
				The window that opened this page has closed. Showing what it had recorded.
			</p>
		}
		else if (_openerService is not null)
		{
			<p class="moka-diag-page-notice">Showing the window that opened this page.</p>
		}
		else
		{
			<p class="moka-diag-page-notice">
				Showing this window's own data. On Blazor Server, open the page with the overlay's new-window
				button to see the window it was opened from.
			</p>
		}
		@* The script gives the list the tabs pattern's arrow keys, so moving between tabs costs no round trip. *@
		<div class="moka-diag-page-tabs" role="tablist" aria-label="Diagnostics" @ref="_tabListRef">
			@foreach (DiagnosticsTab tab in DiagnosticsTabs.All)
			{
				<button type="button" role="tab" id="@TabId(tab.Key)" class="@TabClass(tab.Key)"
				        aria-selected="@Selected(tab.Key)" aria-controls="@_panelId" tabindex="@TabIndex(tab.Key)"
				        @onclick="() => _activeTab = tab.Key">@tab.Name</button>
			}
		</div>
		<div class="moka-diag-page-content" role="tabpanel" id="@_panelId" aria-labelledby="@TabId(_activeTab)" tabindex="0">
			@* Set once in OnInitialized and never replaced, so IsFixed is safe. *@
			<CascadingValue Value="_openerService" Name="@DiagnosticsServiceResolver.CascadeName" IsFixed="true">
				@DiagnosticsTabs.Panel(_activeTab, _theme)
			</CascadingValue>
		</div>
	</div>
}
