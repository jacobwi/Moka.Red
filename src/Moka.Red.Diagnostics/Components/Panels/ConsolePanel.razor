@if (_buffer is not null)
{
	<div class="moka-diag-console">
		<div class="moka-diag-console-toolbar">
			<label class="moka-diag-console-filter">
				<input type="checkbox" @bind="_showDebug" @bind:after="ApplyFilter"/> Debug
			</label>
			<label class="moka-diag-console-filter">
				<input type="checkbox" @bind="_showInfo" @bind:after="ApplyFilter"/> Info
			</label>
			<label class="moka-diag-console-filter">
				<input type="checkbox" @bind="_showWarning" @bind:after="ApplyFilter"/> Warn
			</label>
			<label class="moka-diag-console-filter">
				<input type="checkbox" @bind="_showError" @bind:after="ApplyFilter"/> Error
			</label>
			<label class="moka-diag-console-filter">
				<input type="checkbox" @bind="_showCritical" @bind:after="ApplyFilter"/> Critical
			</label>
			<input class="moka-diag-console-search" type="text" placeholder="Filter by category..." aria-label="Filter by category" @bind:get="_categoryFilter" @bind:set="HandleCategoryFilter" @bind:event="oninput"/>
			<button type="button" class="moka-diag-console-clear" @onclick="Clear" title="Clear console">Clear</button>
		</div>

		<div class="moka-diag-console-list moka-thin-scrollbar">
			@if (_filteredMessages.Count > 0)
			{
				@foreach (var msg in _filteredMessages)
				{
					bool expanded = _expandedExceptions.Contains(msg);
					<div class="moka-diag-console-entry" @key="_rowKeys.For(msg)">
						<span class="moka-diag-console-time">@msg.Timestamp.ToString("HH:mm:ss.fff")</span>
						<span class="moka-diag-console-badge @LevelBadgeClass(msg.Level)">@LevelText(msg.Level)</span>
						<span class="moka-diag-console-category">@msg.Category</span>
						<span class="moka-diag-console-msg">@msg.Message</span>
						@if (msg.Exception is not null)
						{
							<MokaTooltip Text="Exception details" Position="MokaTooltipPosition.BottomEnd" Class="moka-diag-console-expand-tip">
								<button type="button" class="moka-diag-console-expand" @onclick="() => ToggleException(msg)"
								        aria-label="Exception details" aria-expanded="@(expanded ? "true" : "false")">
									@(expanded ? "\u25BC" : "\u25B6")
								</button>
							</MokaTooltip>
						}
					</div>
					@if (msg.Exception is not null && expanded)
					{
						<pre class="moka-diag-console-exception" @key="_exceptionKeys.For(msg)">@msg.Exception</pre>
					}
				}
			}
			else
			{
				<div class="moka-diag-console-empty">
					No console messages captured yet.
				</div>
			}
		</div>
	</div>
}
