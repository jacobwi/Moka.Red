@if (_diagnosticsService is not null)
{
	<div class="moka-diag-render">
		<div class="moka-diag-render-stats">
			<span class="moka-diag-render-stat">
				<span class="moka-diag-render-stat-value">@_entries.Count</span> tracked
			</span>
			<span class="moka-diag-render-stat">
				<span class="moka-diag-render-stat-value">@_totalRenders</span> renders
			</span>
			<span class="moka-diag-render-stat">
				<span class="moka-diag-render-stat-value moka-diag-render-stat-value--skip">@_totalSkipped</span> skipped
			</span>
			<button type="button" class="moka-diag-render-clear" @onclick="Clear" title="Clear render data">Clear</button>
		</div>

		@if (_sortedEntries.Count > 0)
		{
			@* A table for screen readers, with the sort on each column header. The headers are
			   buttons, so the keyboard reaches them and Enter or Space sorts. *@
			<div class="moka-diag-render-table" role="table" aria-label="Component renders">
				<div class="moka-diag-render-header-row" role="row">
					@SortHeader("moka-diag-render-col-type", "ComponentType", "Component")
					@SortHeader("moka-diag-render-col-count", "RenderCount", "Renders")
					@SortHeader("moka-diag-render-col-skip", "SkipCount", "Skipped")
					@SortHeader("moka-diag-render-col-time", "LastRender", "Last")
					@SortHeader("moka-diag-render-col-dur", "Duration", "ms")
				</div>

				@foreach (var entry in _sortedEntries)
				{
					<div class="moka-diag-render-row @(entry.RenderCount > 10 ? "moka-diag-render-row--hot" : "")" role="row">
						<span class="moka-diag-render-col-type" role="cell" title="@entry.ComponentId">@entry.ComponentType</span>
						<span class="moka-diag-render-col-count @(entry.RenderCount > 10 ? "moka-diag-render-val--hot" : "")" role="cell">@entry.RenderCount</span>
						<span class="moka-diag-render-col-skip @(entry.ShouldRenderSkipCount > 0 ? "moka-diag-render-val--skip" : "")" role="cell">@entry.ShouldRenderSkipCount</span>
						<span class="moka-diag-render-col-time" role="cell">@FormatRelativeTime(entry.LastRenderTime)</span>
						<span class="moka-diag-render-col-dur" role="cell">@entry.LastRenderDuration.TotalMilliseconds.ToString("F1")</span>
					</div>
				}
			</div>

			<details class="moka-diag-section">
				<summary>Component Summary (@_uniqueTypes.Count types)</summary>
				<div class="moka-diag-tree">
					@foreach (var group in _groupedEntries)
					{
						<div class="moka-diag-tree-node">
							<span class="moka-diag-tree-type">@group.Key</span>
							<span class="moka-diag-tree-count">@group.Count() instances</span>
							<span class="moka-diag-tree-renders">@group.Sum(e => e.RenderCount) renders</span>
						</div>
					}
				</div>
			</details>
		}
		else
		{
			<div class="moka-diag-render-empty">
				No render data yet. Use <code>DiagnosticComponentBase</code> to start tracking.
			</div>
		}
	</div>
}

@code {

	private RenderFragment SortHeader(string cellClass, string column, string text) =>
		@<span class="@cellClass" role="columnheader" aria-sort="@AriaSort(column)">
			<button type="button" class="moka-diag-render-sort" @onclick="() => SortBy(column)">
				@text <span aria-hidden="true">@SortIndicator(column)</span>
			</button>
		</span>;

}
