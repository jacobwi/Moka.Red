@if (_diagnosticsService is not null)
{
	<div class="moka-diag-network">
		<div class="moka-diag-network-stats">
			<span class="moka-diag-network-stat">
				<span class="moka-diag-network-stat-value">@_entries.Count</span> functions
			</span>
			<span class="moka-diag-network-stat">
				<span class="moka-diag-network-stat-value">@_totalCalls</span> calls
			</span>
			<span class="moka-diag-network-stat">
				<span class="moka-diag-network-stat-value">@_totalTime.ToString("F1")</span> ms total
			</span>
		</div>

		@if (_sortedEntries.Count > 0)
		{
			@* A table for screen readers, with the sort on each column header. The headers are
			   buttons, so the keyboard reaches them and Enter or Space sorts. *@
			<div class="moka-diag-network-table" role="table" aria-label="JS interop calls">
				<div class="moka-diag-network-header-row" role="row">
					@SortHeader("moka-diag-network-col-id", "Identifier", "Method")
					@SortHeader("moka-diag-network-col-calls", "CallCount", "Calls")
					@SortHeader("moka-diag-network-col-total", "TotalDuration", "Total ms")
					@SortHeader("moka-diag-network-col-avg", "AverageDuration", "Avg ms")
					@SortHeader("moka-diag-network-col-max", "MaxDuration", "Max ms")
				</div>

				@foreach (var entry in _sortedEntries)
				{
					<div class="moka-diag-network-row @RowClass(entry)" role="row">
						<span class="moka-diag-network-col-id" role="cell" title="@entry.Identifier">@entry.Identifier</span>
						<span class="moka-diag-network-col-calls" role="cell">@entry.CallCount</span>
						<span class="moka-diag-network-col-total" role="cell">@entry.TotalDuration.TotalMilliseconds.ToString("F1")</span>
						<span class="moka-diag-network-col-avg" role="cell">@entry.AverageDuration.TotalMilliseconds.ToString("F1")</span>
						<span class="moka-diag-network-col-max @(entry.MaxDuration.TotalMilliseconds > 50 ? "moka-diag-network-val--slow" : "")" role="cell">
							@entry.MaxDuration.TotalMilliseconds.ToString("F1")
						</span>
					</div>
				}
			</div>

			<div class="moka-diag-network-summary">
				<span class="moka-diag-network-summary-label">Avg call time:</span>
				<span class="moka-diag-network-summary-value">@(_totalCalls > 0 ? (_totalTime / _totalCalls).ToString("F2") : "0.00") ms</span>
			</div>
		}
		else
		{
			<div class="moka-diag-network-empty">
				No JS interop calls recorded yet. Components built on <code>MokaComponentBase</code> or
				<code>MokaInputBase</code> report the calls they make through the base's interop helpers, such as
				<code>SafeJsInvokeAsync</code> and <code>GetJsModuleAsync</code>.
			</div>
		}
	</div>
}

@code {

	private RenderFragment SortHeader(string cellClass, string column, string text) =>
		@<span class="@cellClass" role="columnheader" aria-sort="@AriaSort(column)">
			<button type="button" class="moka-diag-network-sort" @onclick="() => SortBy(column)">
				@text <span aria-hidden="true">@SortIndicator(column)</span>
			</button>
		</span>;

}
