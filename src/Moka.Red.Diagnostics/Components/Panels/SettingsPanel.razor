@using System.Globalization

@if (_diagnosticsService is not null && Options is not null)
{
	@* Each setting's text labels its control, so screen readers say what the control sets. *@
	<div class="moka-diag-settings">
		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("position")">Overlay Position</label>
			<select class="moka-diag-settings-select" id="@FieldId("position")" @bind:get="Options.Position" @bind:set="SetPosition">
				<option value="BottomRight">Bottom Right</option>
				<option value="BottomLeft">Bottom Left</option>
				<option value="TopRight">Top Right</option>
				<option value="TopLeft">Top Left</option>
			</select>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("width")">Panel Width</label>
			<div class="moka-diag-settings-range">
				<input type="range" id="@FieldId("width")" min="300" max="600" step="10" @bind:get="Options.PanelWidth" @bind:set="SetPanelWidth" @bind:culture="CultureInfo.InvariantCulture"/>
				<span class="moka-diag-settings-value">@(Options.PanelWidth)px</span>
			</div>
		</div>

		<div class="moka-diag-settings-group">
			<span class="moka-diag-settings-label">Keyboard Shortcut</span>
			<span class="moka-diag-settings-value">@Options.KeyboardShortcut</span>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("expand")">Auto-expand</label>
			<input type="checkbox" class="moka-diag-settings-checkbox" id="@FieldId("expand")" @bind:get="Options.StartExpanded" @bind:set="SetAutoExpand"/>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("pause")">Pause Tracking</label>
			<input type="checkbox" class="moka-diag-settings-checkbox" id="@FieldId("pause")" @bind:get="_diagnosticsService.IsPaused" @bind:set="SetPaused"/>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("log-level")">Console Log Level</label>
			<select class="moka-diag-settings-select" id="@FieldId("log-level")" @bind:get="Options.MinConsoleLogLevel" @bind:set="SetMinLogLevel">
				<option value="Debug">Debug</option>
				<option value="Information">Info</option>
				<option value="Warning">Warning</option>
				<option value="Error">Error</option>
			</select>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("max-events")">Max Event Log Entries</label>
			<input type="number" class="moka-diag-settings-number" id="@FieldId("max-events")" min="100" max="1000" step="50" @bind:get="Options.MaxEventLogEntries" @bind:set="SetMaxEventLog"/>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("render")">Render Tracking</label>
			<input type="checkbox" class="moka-diag-settings-checkbox" id="@FieldId("render")" @bind:get="Options.RenderTrackingEnabled" @bind:set="SetRenderTracking"/>
		</div>

		<div class="moka-diag-settings-group">
			<label class="moka-diag-settings-label" for="@FieldId("js")">JS Interop Tracking</label>
			<input type="checkbox" class="moka-diag-settings-checkbox" id="@FieldId("js")" @bind:get="Options.JsInteropTrackingEnabled" @bind:set="SetJsInteropTracking"/>
		</div>
	</div>
}
