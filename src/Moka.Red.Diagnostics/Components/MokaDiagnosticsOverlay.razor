@if (_diagnosticsService is not null)
{
	@if (_isExpanded)
	{
		<div class="moka-diag-panel" @ref="_panelRef" style="@PanelStyle" role="region" aria-label="Moka Diagnostics" tabindex="-1">
			<div class="moka-diag-header" @ref="_headerRef">
				<span class="moka-diag-drag-handle" title="Drag to move" aria-hidden="true">&#x2261;</span>
				@* The script marks which ends have tabs scrolled out of view (data-moka-more-start, -end), which shows
				   the arrow on that side, and handles the arrows itself, so scrolling the row costs no round trip. *@
				<div class="moka-diag-tabs-row" @ref="_tabsRowRef">
					<button type="button" class="moka-diag-tabs-scroll moka-diag-tabs-scroll--start" data-moka-diag-scroll="-1"
					        title="Scroll tabs left" aria-label="Scroll tabs left">&#x2039;</button>
					<div class="moka-diag-tabs moka-hide-scrollbar">
						<button type="button" class="@TabClass("Console")" aria-pressed="@TabPressed("Console")" @onclick='() => SetActiveTab("Console")'>Console</button>
						<button type="button" class="@TabClass("Theme")" aria-pressed="@TabPressed("Theme")" @onclick='() => SetActiveTab("Theme")'>Theme</button>
						<button type="button" class="@TabClass("Render")" aria-pressed="@TabPressed("Render")" @onclick='() => SetActiveTab("Render")'>Render</button>
						<button type="button" class="@TabClass("Tree")" aria-pressed="@TabPressed("Tree")" @onclick='() => SetActiveTab("Tree")'>Tree</button>
						<button type="button" class="@TabClass("Network")" aria-pressed="@TabPressed("Network")" @onclick='() => SetActiveTab("Network")'>Network</button>
						<button type="button" class="@TabClass("Memory")" aria-pressed="@TabPressed("Memory")" @onclick='() => SetActiveTab("Memory")'>Memory</button>
						<button type="button" class="@TabClass("Perf")" aria-pressed="@TabPressed("Perf")" @onclick='() => SetActiveTab("Perf")'>Perf</button>
						<button type="button" class="@TabClass("Services")" aria-pressed="@TabPressed("Services")" @onclick='() => SetActiveTab("Services")'>Services</button>
						<button type="button" class="@TabClass("Log")" aria-pressed="@TabPressed("Log")" @onclick='() => SetActiveTab("Log")'>Log</button>
						<button type="button" class="@TabClass("Settings")" aria-pressed="@TabPressed("Settings")" @onclick='() => SetActiveTab("Settings")'
						        title="Settings" aria-label="Settings">&#x2699;</button>
					</div>
					<button type="button" class="moka-diag-tabs-scroll moka-diag-tabs-scroll--end" data-moka-diag-scroll="1"
					        title="Scroll tabs right" aria-label="Scroll tabs right">&#x203A;</button>
				</div>
				<div class="moka-diag-header-actions">
					@{
						string pauseText = _diagnosticsService.IsPaused ? "Resume tracking" : "Pause tracking";
						string closeText = $"Close (or press {_diagnosticsService.Options.KeyboardShortcut})";
					}
					<button type="button" class="moka-diag-action-btn @(_diagnosticsService.IsPaused ? "moka-diag-action-btn--active" : "")"
					        @onclick="TogglePause" title="@pauseText" aria-label="@pauseText">
						@(_diagnosticsService.IsPaused ? "▶" : "⏸")
					</button>
					<button type="button" class="moka-diag-action-btn" @onclick="ExportData" title="Export diagnostics data" aria-label="Export diagnostics data">&#x2B07;</button>
					<button type="button" class="moka-diag-action-btn" @onclick="OpenInNewWindow" title="Open in new window" aria-label="Open in new window">&#x2197;</button>
					<button type="button" class="moka-diag-close" @onclick="Toggle" title="@closeText" aria-label="@closeText">&#x2715;</button>
				</div>
			</div>
			<div class="moka-diag-body moka-thin-scrollbar">
				@switch (_activeTab)
				{
					case "Console":
						<ConsolePanel/>
						break;
					case "Theme":
						<ThemeInspectorPanel Theme="Theme"/>
						break;
					case "Render":
						<RenderTrackerPanel/>
						break;
					case "Tree":
						<ComponentTreePanel/>
						break;
					case "Network":
						<NetworkPanel/>
						break;
					case "Memory":
						<MemoryPanel/>
						break;
					case "Perf":
						<PerformancePanel/>
						break;
					case "Services":
						<ServicesPanel/>
						break;
					case "Log":
						<EventLogPanel/>
						break;
					case "Settings":
						<SettingsPanel OnSettingsChanged="StateHasChanged"/>
						break;
				}
			</div>
		</div>
	}
	else
	{
		string badgeText = $"Moka Diagnostics ({_diagnosticsService.Options.KeyboardShortcut})";
		<button type="button" class="moka-diag-badge" @ref="_badgeRef" @onclick="Toggle" style="@PositionStyle"
		        title="@badgeText" aria-label="@badgeText">
			M
		</button>
	}
}
