@if (_diagnosticsService is not null)
{
	@if (_isExpanded)
	{
		<div class="moka-diag-panel" @ref="_panelRef" style="@PanelStyle" role="region" aria-label="Moka Diagnostics" tabindex="-1">
			<div class="moka-diag-header" @ref="_headerRef">
				<MokaTooltip Text="Drag to move" Position="MokaTooltipPosition.BottomStart">
					<span class="moka-diag-drag-handle" aria-hidden="true">&#x2261;</span>
				</MokaTooltip>
				@* The script marks which ends have tabs scrolled out of view (data-moka-more-start, -end), which shows
				   the arrow on that side, runs the arrows and the tab list's arrow keys itself, so neither costs a round
				   trip. The arrows stay out of the tab order: the arrow keys reach every tab and keep it in view. *@
				<div class="moka-diag-tabs-row" @ref="_tabsRowRef">
					<MokaTooltip Text="Scroll tabs left" Position="MokaTooltipPosition.Bottom">
						<button type="button" class="moka-diag-tabs-scroll moka-diag-tabs-scroll--start" data-moka-diag-scroll="-1"
						        tabindex="-1" aria-label="Scroll tabs left"><MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" SizeValue="14px" /></button>
					</MokaTooltip>
					<div class="moka-diag-tabs moka-hide-scrollbar" role="tablist" aria-label="Diagnostics">
						@foreach (DiagnosticsTab tab in DiagnosticsTabs.All)
						{
							@if (tab.Key == DiagnosticsTabs.Settings)
							{
								<MokaTooltip Text="Settings" Position="MokaTooltipPosition.Bottom">
									<button type="button" role="tab" id="@TabId(tab.Key)" class="@TabClass(tab.Key)"
									        aria-selected="@Selected(tab.Key)" aria-controls="@_panelId" tabindex="@TabIndex(tab.Key)"
									        aria-label="Settings" @onclick="() => SetActiveTab(tab.Key)"><MokaIcon Icon="MokaIcons.Action.Settings" SizeValue="12px" /></button>
								</MokaTooltip>
							}
							else
							{
								<button type="button" role="tab" id="@TabId(tab.Key)" class="@TabClass(tab.Key)"
								        aria-selected="@Selected(tab.Key)" aria-controls="@_panelId" tabindex="@TabIndex(tab.Key)"
								        @onclick="() => SetActiveTab(tab.Key)">@tab.ShortName</button>
							}
						}
					</div>
					<MokaTooltip Text="Scroll tabs right" Position="MokaTooltipPosition.Bottom">
						<button type="button" class="moka-diag-tabs-scroll moka-diag-tabs-scroll--end" data-moka-diag-scroll="1"
						        tabindex="-1" aria-label="Scroll tabs right"><MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px" /></button>
					</MokaTooltip>
				</div>
				<div class="moka-diag-header-actions">
					@{
						string pauseText = _diagnosticsService.IsPaused ? "Resume tracking" : "Pause tracking";
						string closeText = $"Close (or press {_diagnosticsService.Options.KeyboardShortcut})";
					}
					<MokaTooltip Text="@pauseText" Position="MokaTooltipPosition.Bottom">
						<button type="button" class="@PauseClass" @onclick="TogglePause" aria-label="@pauseText">
							<MokaIcon Icon="@PauseIcon" SizeValue="14px" />
						</button>
					</MokaTooltip>
					<MokaTooltip Text="Export diagnostics data" Position="MokaTooltipPosition.Bottom">
						<button type="button" class="moka-diag-action-btn" @onclick="ExportData" aria-label="Export diagnostics data"><MokaIcon Icon="MokaIcons.Action.Download" SizeValue="14px" /></button>
					</MokaTooltip>
					<MokaTooltip Text="Open in new window" Position="MokaTooltipPosition.Bottom">
						<button type="button" class="moka-diag-action-btn" @onclick="OpenInNewWindow" aria-label="Open in new window"><MokaIcon Icon="MokaIcons.Content.ExternalLink" SizeValue="14px" /></button>
					</MokaTooltip>
					<MokaTooltip Text="@closeText" Position="MokaTooltipPosition.BottomEnd">
						<button type="button" class="moka-diag-close" @onclick="Toggle" aria-label="@closeText"><MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px" /></button>
					</MokaTooltip>
				</div>
			</div>
			<div class="moka-diag-body moka-thin-scrollbar" role="tabpanel" id="@_panelId" aria-labelledby="@TabId(_activeTab)"
			     tabindex="0">
				@DiagnosticsTabs.Panel(_activeTab, Theme)
			</div>
		</div>
	}
	else
	{
		string badgeText = $"Moka Diagnostics ({_diagnosticsService.Options.KeyboardShortcut})";
		@* The corner holds the badge's place, so the tooltip's element inside it, which the name is placed against,
		   moves with the badge. *@
		<div class="moka-diag-badge-corner" style="@PositionStyle">
			<MokaTooltip Text="@badgeText" Position="BadgeTooltipPosition">
				<button type="button" class="moka-diag-badge" @ref="_badgeRef" @onclick="Toggle" aria-label="@badgeText">M</button>
			</MokaTooltip>
		</div>
	}
}
