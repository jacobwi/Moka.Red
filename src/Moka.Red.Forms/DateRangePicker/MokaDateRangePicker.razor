@namespace Moka.Red.Forms.DateRangePicker
@inherits MokaVisualComponentBase

@* While the popup is open its keys stop here: Escape closes the popup, and a MokaDialog around it
   would otherwise take the same Escape and close as well. *@
<div class="@CssClass" style="@CssStyle"
     @onkeydown="HandlePickerKeyDown" @onkeydown:stopPropagation="_isOpen">
	@if (!string.IsNullOrEmpty(Label))
	{
		<label class="moka-daterange__label" for="@InputId">@Label</label>
	}

	<div class="moka-daterange__input-wrapper">
		<input type="text" class="@InputCssClass" style="@InputStyle"
		       value="@DisplayValue"
		       readonly
		       placeholder="@Placeholder"
		       aria-haspopup="dialog"
		       aria-expanded="@(_isOpen ? "true" : "false")"
		       @ref="_triggerRef"
		       @onclick="ToggleCalendar"
		       @onkeydown="HandleTriggerKeyDown"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="AdditionalAttributes"/>
	</div>

	@if (_isOpen)
	{
		<div class="moka-daterange__backdrop" @onclick="CloseCalendar"></div>
		<div class="moka-daterange__popup">
			<div class="moka-daterange__calendars">
				@{ RenderCalendar(_leftMonth); }
				@{ RenderCalendar(RightMonth); }
			</div>
			@if (_start.HasValue || _end.HasValue)
			{
				<div class="moka-daterange__footer">
					<button class="moka-daterange__clear" @onclick="ClearRange" type="button">Clear</button>
				</div>
			}
		</div>
	}
</div>

@{
	void RenderCalendar(DateTime month)
	{
		<div class="moka-daterange__calendar">
			<div class="moka-daterange__header">
				@* The arrows end the row of the two months' headers, so their names open below it, lined up with
				   its edges. *@
				@if (month == _leftMonth)
				{
					<MokaTooltip Text="Previous month" Position="MokaTooltipPosition.BottomStart">
						<button class="moka-daterange__nav" @onclick="PrevMonth" type="button" aria-label="Previous month">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" Size="MokaSize.Sm"/>
						</button>
					</MokaTooltip>
				}
				else
				{
					<span class="moka-daterange__nav-spacer"></span>
				}
				<span class="moka-daterange__month-year">@month.ToString("MMMM yyyy")</span>
				@if (month != _leftMonth)
				{
					<MokaTooltip Text="Next month" Position="MokaTooltipPosition.BottomEnd">
						<button class="moka-daterange__nav" @onclick="NextMonth" type="button" aria-label="Next month">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" Size="MokaSize.Sm"/>
						</button>
					</MokaTooltip>
				}
				else
				{
					<span class="moka-daterange__nav-spacer"></span>
				}
			</div>
			<div class="moka-daterange__weekdays">
				@foreach (var day in WeekdayHeaders)
				{
					<span>@day</span>
				}
			</div>
			<div class="moka-daterange__days">
				@foreach (var day in GetCalendarDays(month))
				{
					<button class="@DayCssClass(day, month)"
					        disabled="@IsDayDisabled(day)"
					        @onclick="() => SelectDay(day)"
					        @onmouseenter="() => HandleDayHover(day)"
					        type="button">
						@day.Day
					</button>
				}
			</div>
		</div>
	}
}
