@namespace Moka.Red.Forms.TagInput
@inherits MokaVisualComponentBase

<MokaFieldWrapper Label="@Label"
                  HelperText="@HelperText"
                  ErrorText="@ErrorText"
                  HasError="@HasError"
                  InputId="@LabelFor"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@CssStyle" @ref="_root">
		<div class="moka-taginput-container" style="@ContainerStyle">
			@for (var i = 0; i < _tags.Count; i++)
			{
				var index = i;
				var tag = _tags[i];
				<span class="moka-taginput-tag">
					<span class="moka-taginput-tag-text">@tag</span>
					@if (!Disabled)
					{
						string removeName = $"Remove {tag}";
						<MokaTooltip Text="@removeName" Position="MokaTooltipPosition.Bottom">
							<button type="button"
							        class="moka-taginput-tag-dismiss"
							        @onclick="() => RemoveTag(index)"
							        tabindex="-1"
							        aria-label="@removeName">
								<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
							</button>
						</MokaTooltip>
					}
				</span>
			}
			@if (CanAddMore)
			{
				<input class="@InputCssClass"
				       type="text"
				       @bind:get="_inputText"
				       @bind:set="HandleInput"
				       @bind:event="oninput"
				       @onkeydown="HandleKeyDown"
				       @onkeydown:stopPropagation="SuggestionsShown"
				       @onfocus="HandleFocus"
				       @onblur="HandleBlur"
				       placeholder="@(_tags.Count == 0 ? Placeholder : "")"
				       disabled="@Disabled"
				       id="@InputId"
				       @attributes="AdditionalAttributes"/>
			}
		</div>
		@if (Clearable && _tags.Count > 0 && !Disabled)
		{
			@* No tooltip while suggestions show: it would cover the first of them. *@
			<MokaTooltip Text="@(SuggestionsShown ? null : "Clear all tags")" Position="MokaTooltipPosition.BottomEnd"
			             Class="moka-taginput-clear-tip">
				<button type="button"
				        class="moka-taginput-clear"
				        @onclick="HandleClearAll"
				        tabindex="-1"
				        aria-label="Clear all tags">
					<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
				</button>
			</MokaTooltip>
		}

		@if (SuggestionsShown)
		{
			<div class="moka-taginput-suggestions" popover="manual" data-moka-popup @ref="_panel">
				@foreach (var suggestion in FilteredSuggestions)
				{
					<div class="moka-taginput-suggestion" @onmousedown="() => SelectSuggestion(suggestion)">
						@suggestion
					</div>
				}
			</div>
		}
	</div>
</MokaFieldWrapper>
