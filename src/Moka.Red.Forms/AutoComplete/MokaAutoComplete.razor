@namespace Moka.Red.Forms.AutoComplete
@using Moka.Red.Primitives.Typography
@inherits MokaVisualComponentBase
@typeparam TItem

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	@* While the popup is open its keys stop here: Escape closes the popup, and a MokaDialog around it
	   would otherwise take the same Escape and close as well. *@
	<div class="@ComputedCssClass" style="@CssStyle" @ref="_root" @onkeydown:stopPropagation="_isOpen">
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="text"
		       value="@_searchText"
		       @oninput="HandleInput"
		       @onkeydown="HandleKeyDown"
		       @onfocus="HandleFocus"
		       placeholder="@Placeholder"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       role="combobox"
		       aria-expanded="@(_isOpen ? "true" : "false")"
		       aria-controls="@(_isOpen ? ListboxId : null)"
		       aria-activedescendant="@ActiveOptionId"
		       aria-autocomplete="list"
		       aria-haspopup="listbox"
		       autocomplete="off"
		       @attributes="AdditionalAttributes"/>
		@if (Clearable && _value is not null)
		{
			@* No tooltip while the list is open: it would cover the list's first suggestions. *@
			<MokaTooltip Text="@(_isOpen ? null : "Clear")" Position="MokaTooltipPosition.BottomEnd" Class="moka-autocomplete-clear-tip">
				<button type="button"
				        class="moka-autocomplete-clear"
				        @onclick="HandleClear"
				        tabindex="-1"
				        aria-label="Clear">
					<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
				</button>
			</MokaTooltip>
		}

		@if (_isOpen)
		{
			<div class="moka-autocomplete-backdrop" popover="manual" data-moka-popup @ref="_backdrop"
			     @onclick="HandleBackdropClick"></div>
			<div class="moka-autocomplete-dropdown" role="listbox" id="@ListboxId" popover="manual" data-moka-popup
			     @ref="_panel"
			     aria-labelledby="@(Label is null ? null : MokaFieldWrapper.LabelIdFor(InputId))">
				@if (_isLoading)
				{
					<div class="moka-autocomplete-loading">@LoadingText</div>
				}
				else if (_items.Count == 0)
				{
					<div class="moka-autocomplete-empty">@NoResultsText</div>
				}
				else
				{
					@for (var i = 0; i < _items.Count; i++)
					{
						var index = i;
						var item = _items[i];
						<div class="@OptionCssClass(index, item)"
						     id="@OptionId(index)"
						     @onclick="() => SelectItem(item)"
						     role="option"
						     aria-selected="@(index == _focusedIndex ? "true" : "false")">
							@if (ListLook == MokaListLook.Standard)
							{
								@OptionContent(item)
							}
							else
							{
								@if (DrawsMark)
								{
									<span class="@MarkCssClass(item)" aria-hidden="true"></span>
								}
								<span class="moka-autocomplete-option-content">@OptionContent(item)</span>
								@if (!DrawsMark)
								{
									<span class="moka-autocomplete-check">
										@if (IsChosen(item))
										{
											<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="14px"/>
										}
									</span>
								}
							}
						</div>
					}

					@if (ListLook == MokaListLook.Compact)
					{
						@* Hidden from screen readers, which have their own way round a list, and so no part of the listbox. *@
						<div class="moka-autocomplete-hints" aria-hidden="true">
							<span class="moka-autocomplete-hint"><MokaKbd>&uarr;</MokaKbd><MokaKbd>&darr;</MokaKbd>@MoveHintText</span>
							<span class="moka-autocomplete-hint"><MokaKbd>Enter</MokaKbd>@PickHintText</span>
							<span class="moka-autocomplete-hint"><MokaKbd>Esc</MokaKbd>@CloseHintText</span>
						</div>
					}
				}
			</div>
		}
	</div>
</MokaFieldWrapper>
