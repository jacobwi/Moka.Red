@namespace Moka.Red.Forms.AutoComplete
@inherits MokaVisualComponentBase
@typeparam TItem

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	@* While the popup is open its keys stop here: Escape closes the popup, and a MokaDialog around it
	   would otherwise take the same Escape and close as well. *@
	<div class="@ComputedCssClass" style="@CssStyle" @ref="_root" @onkeydown:stopPropagation="_isOpen">
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="text"
		       value="@_searchText"
		       @oninput="HandleInput"
		       @onkeydown="HandleKeyDown"
		       @onfocus="HandleFocus"
		       placeholder="@Placeholder"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       role="combobox"
		       aria-expanded="@(_isOpen ? "true" : "false")"
		       aria-controls="@(_isOpen ? ListboxId : null)"
		       aria-activedescendant="@ActiveOptionId"
		       aria-autocomplete="list"
		       aria-haspopup="listbox"
		       autocomplete="off"
		       @attributes="AdditionalAttributes"/>
		@if (Clearable && _value is not null)
		{
			<button type="button"
			        class="moka-autocomplete-clear"
			        @onclick="HandleClear"
			        tabindex="-1"
			        aria-label="Clear">
				<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
			</button>
		}

		@if (_isOpen)
		{
			<div class="moka-autocomplete-backdrop" @onclick="HandleBackdropClick"></div>
			<div class="moka-autocomplete-dropdown" role="listbox" id="@ListboxId"
			     aria-labelledby="@(Label is null ? null : MokaFieldWrapper.LabelIdFor(InputId))">
				@if (_isLoading)
				{
					<div class="moka-autocomplete-loading">@LoadingText</div>
				}
				else if (_items.Count == 0)
				{
					<div class="moka-autocomplete-empty">@NoResultsText</div>
				}
				else
				{
					@for (var i = 0; i < _items.Count; i++)
					{
						var index = i;
						var item = _items[i];
						<div class="moka-autocomplete-option @(index == _focusedIndex ? "moka-autocomplete-option--focused" : "")"
						     id="@OptionId(index)"
						     @onclick="() => SelectItem(item)"
						     role="option"
						     aria-selected="@(index == _focusedIndex ? "true" : "false")">
							@if (ItemTemplate is not null)
							{
								@ItemTemplate(item)
							}
							else
							{
								@GetDisplayText(item)
							}
						</div>
					}
				}
			</div>
		}
	</div>
</MokaFieldWrapper>
