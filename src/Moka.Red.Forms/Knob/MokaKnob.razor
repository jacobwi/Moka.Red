@namespace Moka.Red.Forms.Knob
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="slider"
     tabindex="@TabIndex"
     aria-valuenow="@AriaNumber(_value)"
     aria-valuemin="@AriaNumber(Min)"
     aria-valuemax="@AriaNumber(Max)"
     aria-valuetext="@FormattedValue"
     aria-label="@(Label ?? "Knob")"
     aria-disabled="@(Disabled ? "true" : null)"
     @onkeydown="HandleKeyDown"
     @onpointerdown="OnPointerDown"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onwheel="OnWheel"
     @onwheel:preventDefault
     @attributes="AdditionalAttributes"
     @ref="_slider">

	<svg class="moka-knob__svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<!-- Background track -->
		<path class="moka-knob__track"
		      d="@ArcPath"
		      fill="none"
		      stroke-width="@TrackWidthStr"
		      stroke-linecap="round"/>

		<!-- Filled arc -->
		<path class="moka-knob__fill"
		      d="@ArcPath"
		      fill="none"
		      stroke-width="@TrackWidthStr"
		      stroke-linecap="round"
		      stroke-dasharray="@ArcLengthStr"
		      stroke-dashoffset="@DashOffsetStr"/>

		<!-- Indicator dot -->
		<circle class="moka-knob__indicator"
		        cx="@IndicatorX"
		        cy="@IndicatorY"
		        r="@IndicatorRadiusStr"
		        fill="currentColor"/>
	</svg>

	@if (ShowValue || Label is not null)
	{
		@* The slider already reads its name and value text, so this copy of them stays silent. *@
		<div class="moka-knob__center" aria-hidden="true">
			@if (ShowValue)
			{
				<span class="moka-knob__value">@FormattedValue</span>
			}
			@if (Label is not null)
			{
				<span class="moka-knob__label">@Label</span>
			}
		</div>
	}
</div>
