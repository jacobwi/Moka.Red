@namespace Moka.Red.Forms.MacAddressInput
@inherits MokaSegmentedInputBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="group" aria-labelledby="@LabelId" @ref="RootRef" data-moka-separator="@SeparatorAttribute" @attributes="AdditionalAttributes">
	@if (HasLabel)
	{
		<label class="moka-mac-label" id="@LabelId">
			@Label
			@if (Required)
			{
				<span class="moka-mac-required" aria-hidden="true">*</span>
			}
		</label>
	}
	<div class="moka-mac-inputs">
		@for (var i = 0; i < 6; i++)
		{
			var index = i;
			@if (i > 0)
			{
				<span class="moka-mac-separator">@MacSeparator</span>
			}

			<input @ref="InputRefs[index]" data-moka-accept="@AcceptPattern"
			       class="moka-mac-octet moka-mac-octet--@SizeToKebab(Size)" style="@SegmentStyle"
			       type="text"
			       inputmode="@InputMode"
			       maxlength="2"
			       value="@Segments[index]"
			       placeholder="00"
			       @oninput="e => HandleSegmentInput(index, e)"
			       @onkeydown="e => HandleSegmentKeyDown(index, e)"
			       @onpaste="e => HandleSegmentPaste(index, e)"
			       @onpaste:preventDefault="true"
			       disabled="@Disabled"
			       autocomplete="off"
			       aria-label="@($"MAC octet {index + 1} of 6")"
			       aria-invalid="@AriaInvalid"
			       aria-required="@AriaRequired"
			       aria-describedby="@DescribedBy"/>
		}
	</div>
	@if (HasMessage)
	{
		<div class="@MessageCssClass" id="@MessageId">@MessageText</div>
	}
</div>
