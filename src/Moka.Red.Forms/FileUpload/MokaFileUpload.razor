@namespace Moka.Red.Forms.FileUpload
@inherits MokaVisualComponentBase

<MokaFieldWrapper Label="@Label"
                  HelperText="@HelperText"
                  ErrorText="@ErrorText"
                  HasError="@(_errors.Count > 0 || !string.IsNullOrEmpty(ErrorText))"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Class="@CssClass"
                  Style="@CssStyle">
	@* The file input covers the zone, so a drop lands on it. With DragDrop the zone lets the browser
	   handle the drop, which fills the input the way the dialog does. Without it, or while disabled,
	   the zone cancels the drop, so nothing is added and the file does not open in the tab. *@
	<div class="@DropzoneCssClass" style="@DropzoneStyle"
	     @ondragenter="HandleDragEnter" @ondragleave="HandleDragLeave" @ondrop="HandleDrop"
	     @ondragover:preventDefault="!AcceptsDrops" @ondrop:preventDefault="!AcceptsDrops">
		@if (DragDrop && !Compact)
		{
			<div class="moka-fileupload-dropzone-content">
				<MokaIcon Icon="MokaIcons.Action.Upload" SizeValue="24px" Class="moka-fileupload-icon"/>
				<span class="moka-fileupload-text">Drag files here or</span>
				<label class="moka-fileupload-browse" for="@InputId">Browse</label>
			</div>
		}
		else
		{
			<label class="moka-fileupload-browse-compact" for="@InputId">Choose file(s)</label>
		}
		<InputFile id="@InputId"
		           OnChange="HandleFileSelected"
		           accept="@Accept"
		           multiple="@Multiple"
		           class="moka-fileupload-native"
		           disabled="@Disabled"
		           @attributes="AdditionalAttributes"/>
	</div>

	@if (ShowFileList && _files.Count > 0)
	{
		<div class="moka-fileupload-list">
			@foreach (var file in _files)
			{
				<div class="moka-fileupload-file">
					<span class="moka-fileupload-filename">@file.Name</span>
					<span class="moka-fileupload-filesize">@FormatSize(file.Size)</span>
					<button class="moka-fileupload-remove" @onclick="() => RemoveFile(file)" type="button"
					        disabled="@Disabled" aria-label="@($"Remove {file.Name}")">
						<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
					</button>
				</div>
			}
		</div>
	}

	@if (_errors.Count > 0)
	{
		<div class="moka-fileupload-errors">
			@foreach (var error in _errors)
			{
				<div class="moka-fileupload-error">@error</div>
			}
		</div>
	}
</MokaFieldWrapper>
