@namespace Moka.Red.Forms.FormBuilder
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	<div class="moka-form-builder__layout">
		@* Left panel: Field palette *@
		<div class="moka-form-builder__palette">
			<div class="moka-form-builder__panel-header">Field Types</div>
			<div class="moka-form-builder__palette-list">
				@foreach (var fieldType in _fieldTypes)
				{
					<button class="moka-form-builder__palette-item"
					        @onclick="() => AddField(fieldType.Type)"
					        title="Click to add @fieldType.Label">
						<MokaIcon Icon="@fieldType.Icon" SizeValue="14px"/>
						<span>@fieldType.Label</span>
					</button>
				}
			</div>
		</div>

		@* Center panel: Canvas *@
		<div class="moka-form-builder__canvas">
			<div class="moka-form-builder__panel-header">
				<span>Form Canvas</span>
				<div class="moka-form-builder__canvas-actions">
					@if (ShowExport)
					{
						<button class="moka-form-builder__action-btn" @onclick="HandleExport" title="Export form">
							<MokaIcon Icon="MokaIcons.Action.Download" SizeValue="14px"/>
							Export
						</button>
					}
				</div>
			</div>

			@if (ShownFields.Count == 0)
			{
				<div class="moka-form-builder__empty">
					<MokaIcon Icon="MokaIcons.Action.Add" SizeValue="32px"/>
					<span>Click a field type to add it here</span>
				</div>
			}
			else
			{
				<div class="moka-form-builder__field-list">
					@{
						object?[] keys = FieldKeys();
					}
					@foreach (var (field, index) in ShownFields.Select((f, i) => (f, i)))
					{
						<div class="@FieldItemCssClass(field)"
						     @key="keys[index]"
						     @onclick="() => SelectField(field)">
							@* The move buttons make a column at the start of each row, and the remove buttons one at
							   the end, so their names open beside them, never over the button above or below. *@
							<div class="moka-form-builder__field-drag">
								@if (index > 0)
								{
									<MokaTooltip Text="Move up" Position="MokaTooltipPosition.Left">
										<button class="moka-form-builder__move-btn" type="button" aria-label="Move up"
										        @onclick="() => MoveField(index, -1)" @onclick:stopPropagation="true">
											<MokaIcon Icon="MokaIcons.Navigation.ChevronUp" SizeValue="12px"/>
										</button>
									</MokaTooltip>
								}
								@if (index < ShownFields.Count - 1)
								{
									<MokaTooltip Text="Move down" Position="MokaTooltipPosition.Left">
										<button class="moka-form-builder__move-btn" type="button" aria-label="Move down"
										        @onclick="() => MoveField(index, 1)" @onclick:stopPropagation="true">
											<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="12px"/>
										</button>
									</MokaTooltip>
								}
							</div>
							<div class="moka-form-builder__field-info">
								<span class="moka-form-builder__field-type">@field.Type</span>
								<span class="moka-form-builder__field-label">@field.Label</span>
								@if (field.Required)
								{
									<span class="moka-form-builder__field-required">*</span>
								}
							</div>
							<MokaTooltip Text="Remove field" Position="MokaTooltipPosition.Left">
								<button class="moka-form-builder__remove-btn" type="button" aria-label="Remove field"
								        @onclick="() => RemoveField(field)" @onclick:stopPropagation="true">
									<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
								</button>
							</MokaTooltip>
						</div>
					}
				</div>
			}

			@if (ShowPreview && ShownFields.Count > 0)
			{
				<div class="moka-form-builder__preview-section">
					<div class="moka-form-builder__panel-header">Live Preview</div>
					<div class="moka-form-builder__preview-content" style="@PreviewGridStyle">
						@foreach (var field in ShownFields)
						{
							<div style="@GetFieldColStyle(field)">
								@RenderFieldPreview(field)
							</div>
						}
					</div>
				</div>
			}
		</div>

		@* Right panel: Property editor *@
		<div class="moka-form-builder__properties">
			<div class="moka-form-builder__panel-header">Properties</div>
			@if (_selectedField is not null)
			{
				<div class="moka-form-builder__property-list">
					<div class="moka-form-builder__property">
						<label class="moka-form-builder__property-label">Label</label>
						<input class="moka-form-builder__property-input"
						       type="text"
						       @bind:get="_selectedField.Label"
						       @bind:set="value => UpdateSelected(field => field.Label = value ?? string.Empty)"/>
					</div>

					@if (!IsLayoutType(_selectedField.Type))
					{
						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Placeholder</label>
							<input class="moka-form-builder__property-input"
							       type="text"
							       @bind:get="_selectedField.Placeholder"
							       @bind:set="value => UpdateSelected(field => field.Placeholder = value)"/>
						</div>

						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Helper Text</label>
							<input class="moka-form-builder__property-input"
							       type="text"
							       @bind:get="_selectedField.HelperText"
							       @bind:set="value => UpdateSelected(field => field.HelperText = value)"/>
						</div>

						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">
								<input type="checkbox"
								       @bind:get="_selectedField.Required"
								       @bind:set="value => UpdateSelected(field => field.Required = value)"/>
								Required
							</label>
						</div>

						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">
								<input type="checkbox"
								       @bind:get="_selectedField.Disabled"
								       @bind:set="value => UpdateSelected(field => field.Disabled = value)"/>
								Disabled
							</label>
						</div>
					}

					@if (IsTextType(_selectedField.Type))
					{
						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Max Length</label>
							<input class="moka-form-builder__property-input"
							       type="number"
							       @bind:get="InvariantNumber(_selectedField.MaxLength)"
							       @bind:set="value => UpdateSelected(field => field.MaxLength = ParseNumber(value))"/>
						</div>
					}

					@if (IsNumericType(_selectedField.Type))
					{
						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Min</label>
							<input class="moka-form-builder__property-input"
							       type="number"
							       @bind:get="InvariantNumber(_selectedField.Min)"
							       @bind:set="value => UpdateSelected(field => field.Min = ParseNumber(value))"/>
						</div>

						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Max</label>
							<input class="moka-form-builder__property-input"
							       type="number"
							       @bind:get="InvariantNumber(_selectedField.Max)"
							       @bind:set="value => UpdateSelected(field => field.Max = ParseNumber(value))"/>
						</div>
					}

					@if (HasOptions(_selectedField.Type))
					{
						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Options (one per line)</label>
							<textarea class="moka-form-builder__property-textarea"
									  rows="4"
									  @bind:get="OptionsToText(_selectedField.Options)"
									  @bind:set="UpdateOptions"></textarea>
						</div>
					}

					@if (Columns > 1)
					{
						<div class="moka-form-builder__property">
							<label class="moka-form-builder__property-label">Column Span</label>
							<select class="moka-form-builder__property-input"
							        @bind:get="InvariantNumber(_selectedField.ColSpan)"
							        @bind:set="value => UpdateSelected(field => field.ColSpan = ParseNumber(value) ?? 1)">
								@for (var c = 1; c <= Columns; c++)
								{
									<option value="@c">@c</option>
								}
							</select>
						</div>
					}

					<div class="moka-form-builder__property">
						<label class="moka-form-builder__property-label">Default Value</label>
						<input class="moka-form-builder__property-input"
						       type="text"
						       @bind:get="_selectedField.DefaultValue"
						       @bind:set="value => UpdateSelected(field => field.DefaultValue = value)"/>

					</div>
				</div>
			}
			else
			{
				<div class="moka-form-builder__no-selection">
					Select a field to edit its properties
				</div>
			}
		</div>
	</div>
</div>
