@namespace Moka.Red.Forms.Slider
@using System.Globalization
@inherits MokaVisualComponentBase

<MokaFieldWrapper Label="@Label"
                  InputId="@_startId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@CssClass" style="@CssStyle" id="@Id"
	     role="group"
	     aria-labelledby="@GroupLabelledBy"
	     @attributes="AdditionalAttributes">
		<div class="moka-range-slider-track" style="@TrackStyle">
			<input class="@StartInputCssClass"
			       type="range"
			       id="@_startId"
			       min="@Min.ToString(CultureInfo.InvariantCulture)"
			       max="@Max.ToString(CultureInfo.InvariantCulture)"
			       step="@Step.ToString(CultureInfo.InvariantCulture)"
			       value="@StartInputValue"
			       disabled="@Disabled"
			       @oninput="HandleStartInput"
			       aria-label="@StartName"/>
			<input class="moka-range-slider-input moka-range-slider-input--end"
			       type="range"
			       min="@Min.ToString(CultureInfo.InvariantCulture)"
			       max="@Max.ToString(CultureInfo.InvariantCulture)"
			       step="@Step.ToString(CultureInfo.InvariantCulture)"
			       value="@EndInputValue"
			       disabled="@Disabled"
			       @oninput="HandleEndInput"
			       aria-label="@EndName"/>
		</div>
		@if (ShowValues)
		{
			<div class="moka-range-slider-values">
				<span class="moka-range-slider-value">@_valueStart.ToString("G", CultureInfo.CurrentCulture)</span>
				<span class="moka-range-slider-separator">to</span>
				<span class="moka-range-slider-value">@_valueEnd.ToString("G", CultureInfo.CurrentCulture)</span>
			</div>
		}
	</div>
</MokaFieldWrapper>
