@namespace Moka.Red.Forms.TextField
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		@if (StartIcon is not null)
		{
			<span class="moka-textfield-start-icon">
				<MokaIcon Icon="@StartIcon.Value" Size="MokaSize.Xs"/>
			</span>
		}
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="@InputType"
		       value="@CurrentValueAsString"
		       @oninput="HandleInput"
		       @onfocus="HandleFocusAsync"
		       @onblur="HandleBlurAsync"
		       placeholder="@Placeholder"
		       maxlength="@MaxLength"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="AdditionalAttributes"/>
		@if (Clearable && !string.IsNullOrEmpty(CurrentValueAsString))
		{
			<button type="button"
			        class="moka-textfield-clear"
			        @onclick="HandleClear"
			        tabindex="-1"
			        aria-label="Clear">
				<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
			</button>
		}
		else if (EndIcon is not null)
		{
			<span class="moka-textfield-end-icon">
				<MokaIcon Icon="@EndIcon.Value" Size="MokaSize.Xs"/>
			</span>
		}
	</div>
</MokaFieldWrapper>
