@namespace Moka.Red.Forms.TextField
@using Moka.Red.Primitives.Emoji
@using Moka.Red.Primitives.Typography
@inherits MokaTextInputBase<string>

@{
	RenderFragment field =
		@<text>
			@if (StartIcon is not null)
			{
				<span class="moka-textfield-start-icon">
					<MokaIcon Icon="@StartIcon.Value" Size="MokaSize.Xs"/>
				</span>
			}
			<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
			       aria-describedby="@DescribedBy"
			       spellcheck="@(Mono ? "false" : null)"
			       type="@InputType"
			       name="@FieldName"
			       @bind:get="InputText"
			       @bind:set="HandleTyped"
			       @bind:event="oninput"
			       @onfocus="HandleFocusAsync"
			       @onblur="HandleBlurAsync"
			       @onkeydown="SuggestionKeys"
			       placeholder="@Placeholder"
			       maxlength="@MaxLength"
			       readonly="@ReadOnly"
			       disabled="@Disabled"
			       id="@InputId"
			       role="@(HasSuggestions ? "combobox" : null)"
			       aria-autocomplete="@(HasSuggestions ? "list" : null)"
			       aria-haspopup="@(HasSuggestions ? "listbox" : null)"
			       aria-expanded="@(HasSuggestions ? (SuggestionsShown ? "true" : "false") : null)"
			       aria-controls="@(SuggestionsShown ? ListboxId : null)"
			       aria-activedescendant="@HighlightedOptionId"
			       autocomplete="@(HasSuggestions ? "off" : null)"
			       @attributes="InputAttributes"/>
			@if (HasSuffix)
			{
				<span class="moka-field-suffix" id="@SuffixId">@Suffix</span>
			}
			@if (Clearable && !string.IsNullOrEmpty(CurrentValueAsString))
			{
				<MokaTooltip Text="@(SuggestionsShown ? null : "Clear")" Position="MokaTooltipPosition.BottomEnd" Class="moka-textfield-clear-tip">
					<button type="button"
					        class="moka-textfield-clear"
					        @onclick="HandleClear"
					        tabindex="-1"
					        aria-label="Clear">
						<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
					</button>
				</MokaTooltip>
			}
			else if (EndIcon is not null)
			{
				<span class="moka-textfield-end-icon">
					<MokaIcon Icon="@EndIcon.Value" Size="MokaSize.Xs"/>
				</span>
			}
			@if (EmojiButton)
			{
				<MokaTooltip Text="@(_emojiOpen ? null : EmojiButtonLabel)" Position="MokaTooltipPosition.BottomEnd"
				             Class="moka-textfield-emoji-tip">
					<button type="button"
					        class="moka-textfield-emoji"
					        aria-label="@EmojiButtonLabel"
					        aria-haspopup="dialog"
					        aria-expanded="@(_emojiOpen ? "true" : "false")"
					        disabled="@(Disabled || ReadOnly)"
					        @ref="_emojiButton"
					        @onclick="ToggleEmoji">
						<MokaIcon Icon="MokaIcons.Content.SmilePlus" SizeValue="16px"/>
					</button>
				</MokaTooltip>
				<MokaEmojiPanel Anchor="_emojiButton" Placement="MokaTooltipPosition.BottomEnd" Open="_emojiOpen"
				                OpenChanged="EmojiOpenChanged" OnPick="InsertEmojiAsync" FocusAfterPick="false"
				                Options="@EmojiPanelOptions" OptionsChanged="EmojiOptionsChanged"/>
			}
		</text>;
}

<MokaFieldWrapper Label="@Label"
                  Actions="@Actions"
                  Required="@Required"
                  Optional="@Optional"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	@if (HasSuggestions)
	{
		@* While the list is open its keys stop here: Escape closes the list, and a MokaDialog around the field would
		   otherwise take the same Escape and close as well. A field without suggestions keeps its markup as it was. *@
		<div class="@ComputedCssClass" style="@ComponentStyle" @ref="_root" @onkeydown:stopPropagation="SuggestionsShown">
			@field
			@if (SuggestionsShown)
			{
				<div class="moka-textfield-backdrop" popover="manual" data-moka-popup @ref="_backdrop"
				     @onclick="CloseSuggestions"></div>
				@* A press on a row keeps focus in the box, where the keys still work. *@
				<div class="moka-textfield-suggestions" role="listbox" id="@ListboxId" popover="manual" data-moka-popup
				     aria-labelledby="@(Label is null ? null : MokaFieldWrapper.LabelIdFor(InputId))"
				     aria-label="@(Label is null ? AppLabel : null)"
				     @ref="_panel" @onmousedown:preventDefault>
					@for (var i = 0; i < _matches.Count; i++)
					{
						var index = i;
						var suggestion = _matches[i];
						<div class="@OptionCssClass(index, suggestion)"
						     id="@OptionId(index)"
						     role="option"
						     data-moka-index="@index"
						     aria-selected="@(index == _highlighted ? "true" : null)"
						     @onclick="() => PickSuggestion(suggestion)">
							@if (ListLook == MokaListLook.Standard)
							{
								@suggestion
							}
							else
							{
								@if (DrawsMark)
								{
									<span class="@MarkCssClass(suggestion)" aria-hidden="true"></span>
								}
								<span class="moka-textfield-option-content">@suggestion</span>
								@if (!DrawsMark)
								{
									<span class="moka-textfield-check">
										@if (IsChosen(suggestion))
										{
											<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="14px"/>
										}
									</span>
								}
							}
						</div>
					}

					@if (ListLook == MokaListLook.Compact)
					{
						@* Hidden from screen readers, which have their own way round a list, and so no part of the listbox. *@
						<div class="moka-textfield-hints" aria-hidden="true">
							<span class="moka-textfield-hint"><MokaKbd>&uarr;</MokaKbd><MokaKbd>&darr;</MokaKbd>@MoveHintText</span>
							<span class="moka-textfield-hint"><MokaKbd>Enter</MokaKbd>@PickHintText</span>
							<span class="moka-textfield-hint"><MokaKbd>Esc</MokaKbd>@CloseHintText</span>
						</div>
					}
				</div>
			}
		</div>
	}
	else
	{
		<div class="@ComputedCssClass" style="@ComponentStyle">
			@field
		</div>
	}
</MokaFieldWrapper>
