@namespace Moka.Red.Forms.TextField
@using Moka.Red.Primitives.Emoji
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  Optional="@Optional"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		@if (StartIcon is not null)
		{
			<span class="moka-textfield-start-icon">
				<MokaIcon Icon="@StartIcon.Value" Size="MokaSize.Xs"/>
			</span>
		}
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       aria-describedby="@SuffixDescribedBy"
		       spellcheck="@(Mono ? "false" : null)"
		       type="@InputType"
		       name="@FieldName"
		       @bind:get="InputText"
		       @bind:set="HandleInputWithDebounce"
		       @bind:event="oninput"
		       @onfocus="HandleFocusAsync"
		       @onblur="HandleBlurAsync"
		       placeholder="@Placeholder"
		       maxlength="@MaxLength"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="InputAttributes"/>
		@if (HasSuffix)
		{
			<span class="moka-field-suffix" id="@SuffixId">@Suffix</span>
		}
		@if (Clearable && !string.IsNullOrEmpty(CurrentValueAsString))
		{
			<MokaTooltip Text="Clear" Position="MokaTooltipPosition.BottomEnd" Class="moka-textfield-clear-tip">
				<button type="button"
				        class="moka-textfield-clear"
				        @onclick="HandleClear"
				        tabindex="-1"
				        aria-label="Clear">
					<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="14px"/>
				</button>
			</MokaTooltip>
		}
		else if (EndIcon is not null)
		{
			<span class="moka-textfield-end-icon">
				<MokaIcon Icon="@EndIcon.Value" Size="MokaSize.Xs"/>
			</span>
		}
		@if (EmojiButton)
		{
			<MokaTooltip Text="@(_emojiOpen ? null : EmojiButtonLabel)" Position="MokaTooltipPosition.BottomEnd"
			             Class="moka-textfield-emoji-tip">
				<button type="button"
				        class="moka-textfield-emoji"
				        aria-label="@EmojiButtonLabel"
				        aria-haspopup="dialog"
				        aria-expanded="@(_emojiOpen ? "true" : "false")"
				        disabled="@(Disabled || ReadOnly)"
				        @ref="_emojiButton"
				        @onclick="ToggleEmoji">
					<MokaIcon Icon="MokaIcons.Content.SmilePlus" SizeValue="16px"/>
				</button>
			</MokaTooltip>
			<MokaEmojiPanel Anchor="_emojiButton" Placement="MokaTooltipPosition.BottomEnd" Open="_emojiOpen"
			                OpenChanged="EmojiOpenChanged" OnPick="InsertEmojiAsync" FocusAfterPick="false"
			                Options="@EmojiPanelOptions" OptionsChanged="EmojiOptionsChanged"/>
		}
	</div>
</MokaFieldWrapper>
