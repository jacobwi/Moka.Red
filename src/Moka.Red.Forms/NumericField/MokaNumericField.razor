@namespace Moka.Red.Forms.NumericField
@inherits MokaTextInputBase<TValue>
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  Optional="@Optional"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		@if (StartIcon is not null)
		{
			<span class="moka-field-start-icon">
				<MokaIcon Icon="@StartIcon.Value" Size="MokaSize.Xs"/>
			</span>
		}
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       aria-describedby="@SuffixDescribedBy"
		       type="text"
		       inputmode="numeric"
		       name="@FieldName"
		       @bind:get="InputText"
		       @bind:set="HandleInputWithDebounce"
		       @bind:event="oninput"
		       @onfocus="HandleFocusAsync"
		       @onblur="HandleBlurAsync"
		       placeholder="@Placeholder"
		       maxlength="@MaxLength"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="InputAttributes"/>
		@if (HasSuffix)
		{
			<span class="moka-field-suffix" id="@SuffixId">@Suffix</span>
		}
	</div>
</MokaFieldWrapper>
