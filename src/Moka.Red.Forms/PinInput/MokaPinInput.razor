@namespace Moka.Red.Forms.PinInput
@inherits MokaCodeInputBase

<div class="@RootCssClass" style="@ComponentStyle">
	@if (HasLabel)
	{
		<label class="moka-pin-label" for="@InputId">
			@Label
			@if (Required)
			{
				<span class="moka-pin-required" aria-hidden="true">*</span>
			}
		</label>
	}
	<div class="moka-pin-inputs" style="@BoxesStyle" data-moka-boxes>
		@for (var i = 0; i < BoxCount; i++)
		{
			<div class="moka-pin-digit" style="@BoxStyle" data-moka-box></div>
		}
		<span class="moka-pin-window">
			<input @ref="Field" id="@InputId" class="moka-pin-field"
			       type="@FieldType"
			       inputmode="numeric"
			       autocomplete="@AutocompleteToken"
			       spellcheck="false"
			       name="@FieldName"
			       data-moka-length="@BoxCount"
			       @bind:get="CodeText"
			       @bind:set="HandleTypedAsync"
			       @bind:event="oninput"
			       disabled="@Disabled"
			       aria-label="@AccessibleName"
			       @attributes="InputAttributes"
			       aria-invalid="@AriaInvalid"
			       aria-required="@AriaRequired"
			       aria-describedby="@DescribedBy"/>
		</span>
	</div>
	@if (HasMessage)
	{
		<div class="@MessageCssClass" id="@MessageId">@MessageText</div>
	}
</div>
