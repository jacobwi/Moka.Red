@namespace Moka.Red.Forms.PasswordField
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="@ResolvedInputType"
		       value="@CurrentValueAsString"
		       @oninput="HandleInput"
		       @onfocus="HandleFocusAsync"
		       @onblur="HandleBlurAsync"
		       placeholder="@Placeholder"
		       maxlength="@MaxLength"
		       readonly="@ReadOnly"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="AdditionalAttributes"/>
		@if (ShowToggle)
		{
			string toggleName = _showPassword ? "Hide password" : "Show password";
			<MokaTooltip Text="@toggleName" Position="MokaTooltipPosition.BottomEnd" Class="moka-passwordfield-toggle-tip">
				<button type="button"
				        class="moka-passwordfield-toggle"
				        @onclick="ToggleVisibility"
				        tabindex="-1"
				        aria-label="@toggleName">
					<MokaIcon Icon="@(_showPassword ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)" Size="MokaSize.Xs"/>
				</button>
			</MokaTooltip>
		}
	</div>
</MokaFieldWrapper>
