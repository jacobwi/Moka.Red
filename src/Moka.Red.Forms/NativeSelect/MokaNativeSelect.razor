@namespace Moka.Red.Forms.NativeSelect
@inherits MokaVisualInputBase<TValue>
@typeparam TValue

<MokaFieldWrapper Label="@Label"
                  Actions="@Actions"
                  Required="@Required"
                  Optional="@Optional"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComponentCssClass" style="@ComponentStyle">
		<select class="@SelectCssClass" style="@SelectStyle" aria-required="@(Required ? "true" : null)"
		        aria-invalid="@(HasError ? "true" : null)"
		        name="@PostedName"
		        value="@CurrentValueAsString"
		        @onchange="HandleChange"
		        disabled="@Disabled"
		        id="@InputId"
		        aria-describedby="@DescribedBy"
		        @attributes="ControlAttributes">
			@if (Placeholder is not null)
			{
				<option value="" disabled>@Placeholder</option>
			}
			@for (int index = 0; index < Items.Count; index++)
			{
				<option value="@OptionValue(index)">@OptionText(Items[index])</option>
			}
		</select>
	</div>
</MokaFieldWrapper>
