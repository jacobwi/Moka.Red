@namespace Moka.Red.Forms.SelectField
@using Moka.Red.Primitives.Typography
@inherits MokaSelectBase<TValue>
@typeparam TValue

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  Optional="@Optional"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  CustomControl="true"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	@* While the popup is open its keys stop here: Escape closes the popup, and a MokaDialog around it
	   would otherwise take the same Escape and close as well. *@
	<div class="@ComputedCssClass" style="@ComponentStyle" @ref="_root" @onkeydown:stopPropagation="DropdownOpen">
		<div class="moka-select-trigger @TriggerCssClass"
		     style="@TriggerStyle"
		     id="@InputId"
		     @ref="_triggerRef"
		     @onclick="HandleTriggerClick"
		     @onkeydown="HandleKeyDown"
		     tabindex="@TriggerTabIndex"
		     role="combobox"
		     aria-required="@(Required ? "true" : null)"
		     aria-labelledby="@LabelledBy"
		     aria-label="@AccessibleName"
		     aria-expanded="@(DropdownOpen ? "true" : "false")"
		     aria-controls="@(DropdownOpen ? ListboxId : null)"
		     aria-activedescendant="@(Searchable ? null : ActiveOptionId)"
		     aria-disabled="@(Disabled ? "true" : null)"
		     aria-haspopup="listbox"
		     @attributes="TriggerAttributes">
			@if (Multiple && SelectedValues is not null && SelectedValues.Count > 0)
			{
				<div class="moka-select-chips">
					@foreach (var item in SelectedValues)
					{
						<span class="moka-select-chip">
							@if (ChipTemplate is not null)
							{
								@ChipTemplate(item)
							}
							else
							{
								@GetDisplayText(item)
							}
							@{ string removeName = $"Remove {GetDisplayText(item)}"; }
							@* No tooltips while the list is open: they would cover the top of it. *@
							<MokaTooltip Text="@(DropdownOpen ? null : removeName)" Position="MokaTooltipPosition.Bottom">
								<button class="moka-select-chip-remove" type="button"
								        disabled="@Disabled"
								        aria-label="@removeName"
								        @onclick="() => RemoveSelectedItem(item)"
								        @onclick:stopPropagation="true"
								        @onkeydown="MarkInnerKey">
									<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="10px"/>
								</button>
							</MokaTooltip>
						</span>
					}
				</div>
			}
			else
			{
				<span class="@ValueCssClass">
					@if (ShowsValue && ValueTemplate is not null)
					{
						@ValueTemplate(CurrentValue!)
					}
					else if (!ShowsValue && PlaceholderTemplate is not null)
					{
						@PlaceholderTemplate
					}
					else
					{
						@(ShowsValue ? GetDisplayText(CurrentValue!) : Placeholder ?? "Select...")
					}
				</span>
			}
			<div class="moka-select-actions">
				@if (Clearable && (CurrentValue is not null || (Multiple && SelectedValues is not null && SelectedValues.Count > 0)))
				{
					<MokaTooltip Text="@(DropdownOpen ? null : "Clear selection")" Position="MokaTooltipPosition.Bottom">
						<button class="moka-select-clear" type="button"
						        disabled="@Disabled"
						        aria-label="Clear selection"
						        @onclick="HandleClear"
						        @onclick:stopPropagation="true"
						        @onkeydown="MarkInnerKey">
							<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
						</button>
					</MokaTooltip>
				}
				<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="14px" Class="@ChevronCssClass"/>
			</div>
		</div>

		@if (DropdownOpen)
		{
			<div class="moka-select-backdrop" popover="manual" data-moka-popup @ref="_backdrop"
			     @onclick="HandleBackdropClick"></div>
			<div class="moka-select-dropdown" popover="manual" data-moka-popup @ref="_panel">
				@if (Searchable)
				{
					@* Outside the listbox on purpose: a listbox may only contain options. *@
					<input class="moka-select-search"
					       placeholder="@SearchPlaceholder"
					       aria-label="@SearchLabel"
					       aria-controls="@ListboxId"
					       aria-activedescendant="@ActiveOptionId"
					       aria-autocomplete="list"
					       @oninput="HandleSearch"
					       @onkeydown="HandleDropdownKeyDown"
					       @onclick:stopPropagation="true"
					       @ref="_searchInputRef"/>
				}
				<div class="moka-select-options" role="listbox" id="@ListboxId"
				     aria-labelledby="@LabelledBy" aria-label="@AccessibleName"
				     aria-multiselectable="@(Multiple ? "true" : null)"
				     @ref="_optionsRef">
					@if (Multiple && SelectAll)
					{
						<div class="moka-select-option moka-select-option--select-all"
						     role="option"
						     aria-selected="@(AllSelected ? "true" : "false")"
						     @onclick="HandleSelectAll" @onclick:stopPropagation="true">
							@if (DrawsMark)
							{
								@MarkTemplate(AllSelected)
							}
							else
							{
								<input type="checkbox" checked="@AllSelected" tabindex="-1" aria-hidden="true"/>
							}
							<span>Select All</span>
						</div>
					}
					@if (Loading)
					{
						<div class="moka-select-loading">
							<div class="moka-select-spinner"></div>
							<span>Loading...</span>
						</div>
					}
					else
					{
						@if (Grouped)
						{
							// Options are numbered in display order, which is what the arrow keys walk.
							var displayIndex = 0;
							@foreach (var group in GroupedItems)
							{
								<div role="group" aria-label="@(string.IsNullOrEmpty(group.Key) ? null : group.Key)">
									@if (!string.IsNullOrEmpty(group.Key))
									{
										<div class="moka-select-group-header" aria-hidden="true">@group.Key</div>
									}

									@foreach (var item in group)
									{
										var idx = displayIndex++;
										@OptionTemplate(item, idx)
									}
								</div>
							}
						}
						else
						{
							foreach (var (item, idx) in FilteredItems.Select((v, i) => (v, i)))
							{
								@OptionTemplate(item, idx)
							}
						}

						@if (!FilteredItems.Any())
						{
							<div class="moka-select-empty">@NoResultsText</div>
						}
					}
				</div>
				@if (DrawsHints)
				{
					@* Outside the listbox, and hidden from screen readers, which have their own way round a list. *@
					<div class="moka-select-hints" aria-hidden="true">
						<span class="moka-select-hint"><MokaKbd>&uarr;</MokaKbd><MokaKbd>&darr;</MokaKbd>@MoveHintText</span>
						<span class="moka-select-hint"><MokaKbd>Enter</MokaKbd>@PickHintText</span>
						<span class="moka-select-hint"><MokaKbd>Esc</MokaKbd>@CloseHintText</span>
					</div>
				}
			</div>
		}
		@if (JumpsOnKeys)
		{
			@* Typing changes the choice without opening the list, so a screen reader hears it here. *@
			<span class="moka-visually-hidden" role="status">@_jumpAnnouncement</span>
		}
	</div>
</MokaFieldWrapper>
@HiddenField

@code {
	// A template, not a local function: a local function writes to the builder of the scope that
	// declares it, and the options render inside MokaFieldWrapper's ChildContent, which has its
	// own. Written the other way the options landed in the wrong render tree and broke the page.
	private RenderFragment OptionTemplate(TValue item, int idx) =>
		@<div class="moka-select-option @OptionCssClass(item, idx)"
		      id="@OptionId(idx)"
		      data-moka-index="@idx"
		      @onclick="() => HandleSelectItem(item)"
		      role="option"
		      aria-selected="@(IsSelected(item) ? "true" : "false")"
		      aria-disabled="@(IsItemDisabled(item) ? "true" : null)">
			@if (DrawsMark)
			{
				@MarkTemplate(IsSelected(item))
			}
			<div class="moka-select-option-content">
				@if (ItemTemplate is not null)
				{
					@ItemTemplate(item)
				}
				else
				{
					@GetDisplayText(item)
				}
			</div>
			@if (TagFor(item) is { } tag)
			{
				<span class="moka-select-option-tag">@tag</span>
			}
			@* Always drawn, transparent when not chosen, so a chosen row is the same width as its neighbours. The looks
			   that start a row with a mark show the choice there instead. *@
			@if (!DrawsMark)
			{
				<span class="moka-select-check @(IsSelected(item) ? null : "moka-select-check--empty")">
					@if (IsSelected(item))
					{
						<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="14px"/>
					}
				</span>
			}
		</div>;

	private RenderFragment MarkTemplate(bool on) =>
		@<span class="@MarkCssClass(on)" aria-hidden="true">
			@if (on && Multiple && ListLook == MokaListLook.Radio)
			{
				<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="10px"/>
			}
		</span>;
}
