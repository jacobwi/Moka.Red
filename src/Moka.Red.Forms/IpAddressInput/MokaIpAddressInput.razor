@namespace Moka.Red.Forms.IpAddressInput
@inherits MokaSegmentedInputBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="group" aria-labelledby="@LabelId" @ref="RootRef" data-moka-separator="@SeparatorAttribute" @attributes="AdditionalAttributes">
	@if (HasLabel)
	{
		<label class="moka-ip-label" id="@LabelId">
			@Label
			@if (Required)
			{
				<span class="moka-ip-required" aria-hidden="true">*</span>
			}
		</label>
	}
	<div class="moka-ip-inputs">
		@if (AllowIPv6)
		{
			@for (var i = 0; i < 8; i++)
			{
				var index = i;
				@if (i > 0)
				{
					<span class="moka-ip-separator">:</span>
				}

				<input @ref="InputRefs[index]" data-moka-accept="@AcceptPattern"
				       class="moka-ip-octet moka-ip-octet--ipv6" style="@SegmentStyle"
				       type="text"
				       inputmode="@InputMode"
				       maxlength="4"
				       value="@Segments[index]"
				       placeholder="0000"
				       @oninput="e => HandleSegmentInput(index, e)"
				       @onkeydown="e => HandleSegmentKeyDown(index, e)"
				       @onpaste="e => HandleSegmentPaste(index, e)"
				       @onpaste:preventDefault="true"
				       disabled="@Disabled"
				       autocomplete="off"
				       aria-label="@($"Group {index + 1} of 8")"
				       aria-invalid="@AriaInvalid"
				       aria-required="@AriaRequired"
				       aria-describedby="@DescribedBy"/>
			}
		}
		else
		{
			@for (var i = 0; i < 4; i++)
			{
				var index = i;
				@if (i > 0)
				{
					<span class="moka-ip-separator">.</span>
				}

				<input @ref="InputRefs[index]" data-moka-accept="@AcceptPattern"
				       class="moka-ip-octet" style="@SegmentStyle"
				       type="text"
				       inputmode="@InputMode"
				       maxlength="3"
				       value="@Segments[index]"
				       placeholder="0"
				       @oninput="e => HandleSegmentInput(index, e)"
				       @onkeydown="e => HandleSegmentKeyDown(index, e)"
				       @onpaste="e => HandleSegmentPaste(index, e)"
				       @onpaste:preventDefault="true"
				       disabled="@Disabled"
				       autocomplete="off"
				       aria-label="@($"Octet {index + 1} of 4")"
				       aria-invalid="@AriaInvalid"
				       aria-required="@AriaRequired"
				       aria-describedby="@DescribedBy"/>
			}
		}
	</div>
	@if (HasMessage)
	{
		<div class="@MessageCssClass" id="@MessageId">@MessageText</div>
	}
</div>
