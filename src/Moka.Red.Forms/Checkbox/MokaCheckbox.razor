@namespace Moka.Red.Forms.Checkbox
@inherits MokaToggleBase

<MokaFieldWrapper HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	@if (DisplayOnly)
	{
		@* A picture of a checkbox for a row that is clickable itself: with no label and no input the
		   row gets the click once, and screen readers read the row's own state instead. *@
		<span class="@ComputedCssClass" style="@ComponentStyle" id="@Id" aria-hidden="true" @attributes="AdditionalAttributes">
			@if (LabelPlacement == LabelPosition.Before && Label is not null)
			{
				<span class="moka-checkbox-label">@Label</span>
			}
			@BoxTemplate
			@if (LabelPlacement == LabelPosition.After && Label is not null)
			{
				<span class="moka-checkbox-label">@Label</span>
			}
		</span>
	}
	else
	{
		<label class="@ComputedCssClass" style="@ComponentStyle">
			@if (LabelPlacement == LabelPosition.Before && Label is not null)
			{
				<span class="moka-checkbox-label">@Label</span>
			}
			<input type="checkbox"
			       class="moka-checkbox-input"
			       id="@Id"
			       checked="@CurrentValue"
			       disabled="@Disabled"
			       @onchange="HandleChange"
			       @attributes="AdditionalAttributes"/>
			@BoxTemplate
			@if (LabelPlacement == LabelPosition.After && Label is not null)
			{
				<span class="moka-checkbox-label">@Label</span>
			}
		</label>
	}
</MokaFieldWrapper>

@code {
	// A template, not a local function: this markup renders inside MokaFieldWrapper's ChildContent,
	// and a local function would write it into this component's own render tree instead.
	private RenderFragment BoxTemplate =>
		@<span class="moka-checkbox-box" style="@BoxStyle">
			@if (CurrentValue && !Indeterminate)
			{
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 6L9 17l-5-5"/>
				</svg>
			}
			else if (Indeterminate)
			{
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14"/>
				</svg>
			}
		</span>;
}
