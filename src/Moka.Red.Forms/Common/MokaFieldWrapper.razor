@namespace Moka.Red.Forms.Common

<div class="@WrapperClass" style="@Style">
	@if (Label is not null)
	{
		<label class="moka-field-label" for="@LabelFor" id="@LabelId">
			@Label
			@if (Required)
			{
				<span class="moka-field-required" aria-hidden="true">*</span>
			}
			else if (Optional)
			{
				<span class="moka-field-optional">@OptionalText</span>
			}
		</label>
	}
	@if (Actions is null)
	{
		<div class="moka-field-input-wrapper">
			@ChildContent
		</div>
	}
	else
	{
		<div class="moka-field-input-wrapper moka-field-input-wrapper--actions">
			<div class="moka-field-box">
				@ChildContent
			</div>
			<div class="moka-field-actions">
				@Actions
			</div>
		</div>
	}
	@if (ShowsHelper(HelperText, ErrorText))
	{
		<div class="@HelperClass" id="@HelperId">
			@(HasError ? ErrorText : HelperText)
		</div>
	}
</div>
