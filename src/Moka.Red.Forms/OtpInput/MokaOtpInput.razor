@namespace Moka.Red.Forms.OtpInput
@inherits MokaSegmentedInputBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="group" aria-labelledby="@LabelId" @ref="RootRef" data-moka-separator="@SeparatorAttribute" @attributes="AdditionalAttributes">
	@if (HasLabel)
	{
		<label class="moka-otp-label" id="@LabelId">
			@Label
			@if (Required)
			{
				<span class="moka-otp-required" aria-hidden="true">*</span>
			}
		</label>
	}
	<div class="moka-otp-inputs">
		@for (var i = 0; i < Length; i++)
		{
			var index = i;
			<input @ref="InputRefs[index]" data-moka-accept="@AcceptPattern"
			       class="moka-otp-digit" style="@SegmentStyle"
			       type="@GetInputType()"
			       inputmode="@InputMode"
			       maxlength="1"
			       value="@Segments[index]"
			       @oninput="e => HandleSegmentInput(index, e)"
			       @onkeydown="e => HandleSegmentKeyDown(index, e)"
			       disabled="@Disabled"
			       autocomplete="one-time-code"
			       autofocus="@(AutoFocus && index == 0)"
			       aria-label="@($"Digit {index + 1} of {Length}")"
			       aria-invalid="@AriaInvalid"
			       aria-required="@AriaRequired"
			       aria-describedby="@DescribedBy"/>
		}
	</div>
	@if (HasMessage)
	{
		<div class="@MessageCssClass" id="@MessageId">@MessageText</div>
	}
</div>
