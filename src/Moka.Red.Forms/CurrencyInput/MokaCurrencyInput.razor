@namespace Moka.Red.Forms.CurrencyInput
@inherits MokaTextInputBase<decimal?>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		<span class="moka-currency-symbol">@CurrencySymbol</span>
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="text"
		       inputmode="decimal"
		       value="@_displayValue"
		       @oninput="HandleInput"
		       @onfocus="HandleFocus"
		       @onblur="HandleBlur"
		       placeholder="@ResolvedPlaceholder"
		       disabled="@Disabled"
		       id="@InputId"
		       @attributes="AdditionalAttributes"/>
		@if (CurrencyCode is not null)
		{
			<span class="moka-currency-code">@CurrencyCode</span>
		}
	</div>
</MokaFieldWrapper>
