@namespace Moka.Red.Forms.RadioGroup
@inherits MokaVisualInputBase<TValue>
@typeparam TValue

<MokaFieldWrapper Label="@Label"
                  HelperText="@HelperText"
                  Disabled="@Disabled"
                  Size="@Size">
	@* Not IsFixed: every item reads the selection from the group, so all of them have to
	   re-render when it changes. *@
	<CascadingValue Value="this">
		<div class="@ComputedCssClass" style="@Style" role="radiogroup" aria-label="@Label">
			@ChildContent
		</div>
	</CascadingValue>
</MokaFieldWrapper>
