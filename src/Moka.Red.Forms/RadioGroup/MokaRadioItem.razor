@namespace Moka.Red.Forms.RadioGroup
@inherits MokaComponentBase
@typeparam TValue

@* The native radio is the real control: it takes focus, the arrow keys move between radios that
   share a name, and screen readers read its checked state. The label around it makes the whole row
   clickable, and the browser forwards that click to the input once, so one click selects once. *@
<label class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	<input type="radio"
	       class="moka-radio-native"
	       name="@ParentGroup?.GroupName"
	       checked="@IsSelected"
	       disabled="@IsDisabled"
	       @onchange="HandleChange"/>
	<span class="moka-radio-circle" aria-hidden="true">
		@if (IsSelected)
		{
			<span class="moka-radio-dot"></span>
		}
	</span>
	@if (ChildContent is not null)
	{
		<span class="moka-radio-label">@ChildContent</span>
	}
	else if (Label is not null)
	{
		<span class="moka-radio-label">@Label</span>
	}
</label>
