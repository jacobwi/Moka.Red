@namespace Moka.Red.Forms.PhoneInput
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		<span class="moka-phone-prefix">@CountryCode</span>
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="tel"
		       value="@_displayValue"
		       @oninput="HandleInput"
		       @onfocus="HandleFocus"
		       @onblur="HandleBlur"
		       placeholder="@Placeholder"
		       disabled="@Disabled"
		       id="@InputId"
		       autocomplete="tel"
		       @attributes="AdditionalAttributes"/>
	</div>
</MokaFieldWrapper>
