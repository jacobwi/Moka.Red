@namespace Moka.Red.Forms.PhoneInput
@using Moka.Red.Forms.CountrySelect
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		@if (UsesPicker)
		{
			<MokaCountrySelect Shape="MokaCountrySelectShape.Prefix"
			                   Value="@_country"
			                   ValueChanged="HandleCountryChanged"
			                   Countries="@Countries"
			                   Suggested="@SuggestedCountries"
			                   Label="@CountryLabel"
			                   Disabled="@Disabled"
			                   Size="@Size"
			                   TooltipPosition="MokaTooltipPosition.BottomStart"
			                   Class="moka-phone-country"/>
			<span class="moka-phone-separator" aria-hidden="true"></span>
		}
		else
		{
			<span class="moka-phone-prefix">@CountryCode</span>
		}
		<input class="@InputCssClass" style="@InputStyle" aria-required="@(Required ? "true" : null)"
		       type="tel"
		       name="@FieldName"
		       @bind:get="_displayValue"
		       @bind:set="HandleInput"
		       @bind:event="oninput"
		       @onfocus="HandleFocus"
		       @onblur="HandleBlur"
		       placeholder="@ShownPlaceholder"
		       disabled="@Disabled"
		       id="@InputId"
		       autocomplete="@(UsesPicker ? "tel-national" : "tel")"
		       @attributes="AdditionalAttributes"/>
	</div>
</MokaFieldWrapper>
