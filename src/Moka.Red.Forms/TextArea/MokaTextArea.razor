@namespace Moka.Red.Forms.TextArea
@inherits MokaTextInputBase<string>

<MokaFieldWrapper Label="@Label"
                  Required="@Required"
                  HelperText="@HelperText"
                  ErrorText="@ResolvedErrorText"
                  HasError="@HasError"
                  InputId="@InputId"
                  Disabled="@Disabled"
                  Size="@Size"
                  Style="@WrapperStyle">
	<div class="@ComputedCssClass" style="@ComponentStyle">
		<textarea class="@TextAreaCssClass" style="@TextAreaStyle" aria-required="@(Required ? "true" : null)"
				  value="@CurrentValueAsString"
				  @oninput="HandleInput"
				  placeholder="@Placeholder"
				  rows="@Rows"
				  maxlength="@MaxLength"
				  readonly="@ReadOnly"
				  disabled="@Disabled"
				  id="@InputId"
				  @attributes="AdditionalAttributes"></textarea>
	</div>
</MokaFieldWrapper>
