<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Moka.Red.ThemeGen</PackageId>
		<Description>Theme studio and generator for Moka.Red: derive a theme from a few seed colors, pick every style choice, pin any token, check contrast, preview it on real components and export it as C#, JSON or CSS.</Description>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
		<ProjectReference Include="..\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\Moka.Red.Forms\Moka.Red.Forms.csproj" />
		<ProjectReference Include="..\Moka.Red.Layout\Moka.Red.Layout.csproj" />
		<ProjectReference Include="..\Moka.Red.Feedback\Moka.Red.Feedback.csproj" />
		<ProjectReference Include="..\Moka.Red.Navigation\Moka.Red.Navigation.csproj" />
		<ProjectReference Include="..\Moka.Red.Data\Moka.Red.Data.csproj" />
	</ItemGroup>

</Project>
