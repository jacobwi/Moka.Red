@namespace Moka.Red.ThemeGen.Appearance
@inherits MokaVisualComponentBase
@using Moka.Red.Forms.RadioGroup
@using Moka.Red.Layout.StatusBar
@using Moka.Red.Primitives.Button
@using Moka.Red.Primitives.ColorSwatch
@using Moka.Red.Primitives.SegmentedControl
@using Moka.Red.Primitives.Utility

@{
	List<ChoiceRow> rows = ChoiceRows();
	List<ChoiceRow> styleSections = rows.FindAll(row => row.IsSection && !row.IsComponent);
	List<ChoiceRow> styleRows = rows.FindAll(row => !row.IsSection && !row.IsComponent);
	List<ChoiceRow> componentSections = rows.FindAll(row => row.IsSection && row.IsComponent);
	List<ChoiceRow> componentRows = rows.FindAll(row => !row.IsSection && row.IsComponent);

	bool hasColors = ShowsModes || ShowsPalettes || ShowsAccents;
	bool hasStyle = StyleIsFixed || styleSections.Count > 0 || styleRows.Count > 0;
	bool hasComponents = componentSections.Count > 0 || componentRows.Count > 0;
	bool appRowsWithStyle = ChildContent is not null && !hasComponents;
	bool showHeadings = !Compact && (hasColors ? 1 : 0) + (hasStyle ? 1 : 0) + (hasComponents ? 1 : 0) > 1;
}

<div class="@CssClass" style="@CssStyle" id="@Id" inert="@Disabled" @attributes="AdditionalAttributes">
	@if (hasColors)
	{
		<div class="moka-appearance-panel__group">
			@if (showHeadings)
			{
				<span class="moka-appearance-panel__heading">@Text.ColorsHeading</span>
			}

			@if (ShowsModes)
			{
				<div class="moka-appearance-panel__section">
					<span class="moka-micro-label">@Text.ColorMode</span>
					@if (ModeToggleLook is { } toggleLook)
					{
						<MokaThemeToggle Look="toggleLook" Mode="_value.Mode" ModeChanged="SetModeAsync" ShowSystem="ModeShows(MokaColorMode.System)" IsDark="IsDarkNow"
						                 Size="Size" Disabled="Disabled"
						                 LightText="@Text.ColorModeLight" DarkText="@Text.ColorModeDark" SystemText="@Text.ColorModeSystem"
						                 LightModeLabel="@Text.ColorModeToLight" DarkModeLabel="@Text.ColorModeToDark" SystemModeLabel="@Text.ColorModeToSystem"
						                 GroupLabel="@Text.ColorMode" SwitchLabel="@Text.ColorModeDark"/>
					}
					else
					{
						<MokaRadioGroup TValue="MokaColorMode" Value="_value.Mode" ValueChanged="SetModeAsync" AriaLabel="@Text.ColorMode" Cards MinColumn="var(--_appearance-card)" Disabled="Disabled">
							@if (ModeShows(MokaColorMode.Light))
							{
								<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.Light" Label="@Text.ColorModeLight" Disabled="ModeDisabled(MokaColorMode.Light)">
									<Preview>@Mock(PreviewTheme(CurrentPalette, dark: false))</Preview>
								</MokaRadioItem>
							}
							@if (ModeShows(MokaColorMode.Dark))
							{
								<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.Dark" Label="@Text.ColorModeDark" Disabled="ModeDisabled(MokaColorMode.Dark)">
									<Preview>@Mock(PreviewTheme(CurrentPalette, dark: true))</Preview>
								</MokaRadioItem>
							}
							@if (ModeShows(MokaColorMode.System))
							{
								<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.System" Label="@Text.ColorModeSystem" Hint="@Text.ColorModeSystemHint" Disabled="ModeDisabled(MokaColorMode.System)">
									<Preview>
										<span class="moka-appearance-panel__split">
											@Mock(PreviewTheme(CurrentPalette, dark: false))
											@Mock(PreviewTheme(CurrentPalette, dark: true))
										</span>
									</Preview>
								</MokaRadioItem>
							}
						</MokaRadioGroup>
					}
				</div>
			}

			@if (ShowsPalettes)
			{
				<div class="moka-appearance-panel__section">
					<span class="moka-micro-label">@Text.Palette</span>
					<MokaRadioGroup TValue="string" Value="@CurrentPalette.Id" ValueChanged="SetPaletteAsync" AriaLabel="@Text.Palette" Cards MinColumn="var(--_appearance-card)" Disabled="Disabled">
						@foreach (MokaAppearancePalette palette in ShownPalettes)
						{
							<MokaRadioItem TValue="string" Value="@palette.Id" Label="@palette.Name" Hint="@palette.Hint" Disabled="OptionDisabled(MokaAppearanceRows.Palette, palette.Id)">
								<Preview>@Mock(PreviewTheme(palette, IsDarkNow))</Preview>
							</MokaRadioItem>
						}
					</MokaRadioGroup>
				</div>
			}

			@if (ShowsAccents)
			{
				<div class="moka-appearance-panel__section">
					<span class="moka-micro-label">@Text.Accent</span>
					<div class="moka-appearance-panel__accent">
						<MokaColorSwatch Colors="AccentColors" SelectedColor="@SelectedAccentColor" SelectedColorChanged="SetAccentColorAsync" ColorLabel="AccentName" ColorDisabled="AccentDisabled"
						                 AllowClear role="group" aria-label="@Text.Accent"/>
						@if (SelectedAccent is null)
						{
							<span class="moka-appearance-panel__said">@Text.AccentFromPalette</span>
						}
						else
						{
							<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" OnClick="UsePaletteAccentAsync">@Text.UsePaletteAccent</MokaButton>
						}
					</div>
				</div>
			}
		</div>
	}

	@if (hasStyle || appRowsWithStyle)
	{
		<div class="moka-appearance-panel__group">
			@if (showHeadings)
			{
				<span class="moka-appearance-panel__heading">@Text.StyleHeading</span>
			}

			@if (StyleIsFixed)
			{
				<p class="moka-appearance-panel__said">@Text.StyleFixed</p>
			}

			@foreach (ChoiceRow row in styleSections)
			{
				<div @key="row.Flag" class="@SectionClass(row)">
					<span class="moka-micro-label">@row.Label</span>
					@Pictures(row)
				</div>
			}

			@if (styleRows.Count > 0 || appRowsWithStyle)
			{
				@RowList(styleRows, appRowsWithStyle)
			}
		</div>
	}

	@if (hasComponents)
	{
		<div class="moka-appearance-panel__group">
			@if (showHeadings)
			{
				<span class="moka-appearance-panel__heading">@Text.ComponentsHeading</span>
			}

			@foreach (ChoiceRow row in componentSections)
			{
				<div @key="row.Flag" class="@SectionClass(row)">
					<span class="moka-micro-label">@row.Label</span>
					@Pictures(row)
				</div>
			}

			@if (componentRows.Count > 0 || ChildContent is not null)
			{
				@RowList(componentRows, ChildContent is not null)
			}
		</div>
	}

	@if (ShowsResetButton)
	{
		<div class="moka-appearance-panel__foot">
			<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" OnClick="ResetAsync">@Text.Reset</MokaButton>
		</div>
	}
</div>

@code {
	private RenderFragment Mock(MokaTheme theme) =>@<MokaThemeProvider Theme="theme" LoadFonts="false" Nonce="@Nonce">
		<span class="moka-appearance-panel__window">
			<span class="moka-appearance-panel__rail">
				<span class="moka-appearance-panel__dot moka-appearance-panel__dot--on"></span>
				<span class="moka-appearance-panel__dot"></span>
				<span class="moka-appearance-panel__dot"></span>
			</span>
			<span class="moka-appearance-panel__main">
				<span class="moka-appearance-panel__title"></span>
				<span class="moka-appearance-panel__card">
					<span class="moka-appearance-panel__accent-line"></span>
					<span class="moka-appearance-panel__line"></span>
				</span>
			</span>
		</span>
	</MokaThemeProvider>;

	private RenderFragment RowList(List<ChoiceRow> rows, bool withAppRows) =>@<div class="moka-appearance-panel__rows">
		@foreach (ChoiceRow row in rows)
		{
			<MokaAppearanceRow @key="row.Flag" Label="@row.Label">
				@if (row.HasPictures)
				{
					<div class="moka-appearance-panel__mini" style="@MiniStyle(row)">
						@Pictures(row)
					</div>
				}
				else
				{
					<MokaSegmentedControl Value="@row.Current" ValueChanged="row.Pick" AriaLabel="@row.Label" Size="Size" Disabled="Disabled">
						@foreach (ChoiceOption option in row.Options)
						{
							<MokaSegment Value="@option.Value" Text="@option.Text" Disabled="option.Disabled"/>
						}
					</MokaSegmentedControl>
				}
			</MokaAppearanceRow>
		}
		@if (withAppRows)
		{
			@ChildContent
		}
	</div>;

	private RenderFragment Pictures(ChoiceRow row) =>@<MokaRadioGroup TValue="string" Value="@row.Current" ValueChanged="row.Pick" AriaLabel="@row.Label" Cards MinColumn="var(--_appearance-card)" Disabled="Disabled">
		@foreach (ChoiceOption option in row.Options)
		{
			<MokaRadioItem @key="option.Value" TValue="string" Value="@option.Value" Label="@option.Text" Disabled="option.Disabled">
				<Preview>@option.Preview</Preview>
			</MokaRadioItem>
		}
	</MokaRadioGroup>;

	private RenderFragment StatusBarMock(MokaStatusBarLook look) =>@<span class="moka-appearance-panel__status">
		<MokaStatusBar Fixed="false" Look="look">
			<StartContent><MokaStatusBarItem Text="@Text.StatusBarSampleStart"/></StartContent>
			<EndContent><MokaStatusBarItem Text="@Text.StatusBarSampleEnd"/></EndContent>
		</MokaStatusBar>
	</span>;

	private RenderFragment DensityMock(MokaTheme theme) =>@<MokaThemeProvider Theme="theme" LoadFonts="false" Nonce="@Nonce">
		<span class="moka-appearance-panel__art moka-appearance-panel__art--density">
			<span class="moka-appearance-panel__density-row"></span>
			<span class="moka-appearance-panel__density-row"></span>
			<span class="moka-appearance-panel__density-row"></span>
		</span>
	</MokaThemeProvider>;

	private RenderFragment CornersMock(MokaTheme theme) =>@<MokaThemeProvider Theme="theme" LoadFonts="false" Nonce="@Nonce">
		<span class="moka-appearance-panel__art">
			<span class="moka-appearance-panel__corner"></span>
		</span>
	</MokaThemeProvider>;

	private RenderFragment MainButtonMock(MokaTheme theme) =>@<MokaThemeProvider Theme="theme" LoadFonts="false" Nonce="@Nonce">
		<span class="moka-appearance-panel__art moka-appearance-panel__art--centered">
			<span class="moka-appearance-panel__main-button">
				<span class="moka-appearance-panel__main-button-line"></span>
			</span>
		</span>
	</MokaThemeProvider>;

	private static RenderFragment Lines() =>@<span class="moka-appearance-panel__lines">
		<span class="moka-appearance-panel__bar moka-appearance-panel__bar--strong"></span>
		<span class="moka-appearance-panel__bar"></span>
	</span>;

	private static RenderFragment Toast(MokaColor tone) =>@<span class="@ToneClass("moka-appearance-panel__toast", tone)">
		<span class="moka-appearance-panel__toast-icon"></span>
		@Lines()
		<span class="moka-appearance-panel__toast-action"></span>
	</span>;

	private static RenderFragment ButtonRow() =>@<span class="moka-appearance-panel__button-row">
		<span class="moka-appearance-panel__button moka-appearance-panel__button--primary"><span class="moka-appearance-panel__bar"></span></span>
		<span class="moka-appearance-panel__button moka-appearance-panel__button--secondary"><span class="moka-appearance-panel__bar"></span></span>
		<span class="moka-appearance-panel__button moka-appearance-panel__button--danger"><span class="moka-appearance-panel__bar"></span></span>
	</span>;

	private static RenderFragment ComponentStyleArt(MokaComponentStyle style) =>@<span class="@LookClass("pack", style)">
		<span class="@RowClass("toasts", PackOf(style).Toasts)">@Toast(MokaColor.Error)</span>
		<span class="@RowClass("buttons", PackOf(style).Buttons)">@ButtonRow()</span>
	</span>;

	private static RenderFragment ToastArt(MokaToastLook look) =>@<span class="@LookClass("toasts", look)">@Toast(MokaColor.Error)</span>;

	private static RenderFragment ToastStackingArt(MokaToastStacking stacking) =>@<span class="@LookClass("stacking", stacking)">
		@Toast(MokaColor.Success)
		@Toast(MokaColor.Info)
		@Toast(MokaColor.Warning)
	</span>;

	private static RenderFragment Note(MokaColor tone, bool unread, bool extra = false) =>@<span class="@NoteClass(tone, unread, extra)">
		<span class="moka-appearance-panel__note-dot"></span>
		<span class="moka-appearance-panel__note-icon"></span>
		@Lines()
	</span>;

	private static RenderFragment NotificationsArt(MokaNotificationLook look) =>@<span class="@LookClass("notifications", look)">
		<span class="moka-appearance-panel__notes">
			<span class="moka-appearance-panel__group-mark"></span>
			@Note(MokaColor.Info, unread: true)
			@Note(MokaColor.Warning, unread: true)
			<span class="moka-appearance-panel__group-mark"></span>
			@Note(MokaColor.Success, unread: false)
			@Note(MokaColor.Error, unread: false, extra: true)
		</span>
	</span>;

	private static RenderFragment PopupsArt(MokaPopupLook look) =>@<span class="@LookClass("popups", look)">
		<span class="moka-appearance-panel__scenery"><span></span><span></span><span></span></span>
		<span class="@PopupMenuClass(look)">
			<span class="moka-appearance-panel__item"><span class="moka-appearance-panel__item-icon"></span><span class="moka-appearance-panel__bar"></span></span>
			<span class="moka-appearance-panel__item moka-appearance-panel__item--lit"><span class="moka-appearance-panel__item-icon"></span><span class="moka-appearance-panel__bar"></span></span>
			<span class="moka-appearance-panel__divider"></span>
			<span class="moka-appearance-panel__item moka-appearance-panel__item--danger"><span class="moka-appearance-panel__item-icon"></span><span class="moka-appearance-panel__bar"></span></span>
		</span>
	</span>;

	private static RenderFragment Option(bool chosen, bool lit) =>@<span class="@OptionClass(chosen, lit)">
		<span class="moka-appearance-panel__option-mark"></span>
		<span class="moka-appearance-panel__bar"></span>
		<span class="moka-appearance-panel__option-check"></span>
	</span>;

	private static RenderFragment ListsArt(MokaListLook look) =>@<span class="@LookClass("lists", look)">
		<span class="moka-appearance-panel__field"><span class="moka-appearance-panel__bar moka-appearance-panel__bar--strong"></span></span>
		<span class="moka-appearance-panel__options">
			@Option(chosen: false, lit: false)
			@Option(chosen: true, lit: false)
			@Option(chosen: false, lit: true)
			<span class="moka-appearance-panel__keys"><span></span><span></span><span></span></span>
		</span>
	</span>;

	private static RenderFragment DialogsArt(MokaDialogLook look) =>@<span class="@LookClass("dialogs", look)">
		<span class="moka-appearance-panel__dialog">
			<span class="moka-appearance-panel__dialog-head">
				<span class="moka-appearance-panel__dialog-icon"></span>
				<span class="moka-appearance-panel__bar moka-appearance-panel__bar--strong"></span>
				<span class="moka-appearance-panel__dialog-close"></span>
			</span>
			<span class="moka-appearance-panel__dialog-body">
				<span class="moka-appearance-panel__bar"></span>
				<span class="moka-appearance-panel__bar moka-appearance-panel__bar--short"></span>
			</span>
			<span class="moka-appearance-panel__dialog-actions">
				<span class="moka-appearance-panel__dialog-button"></span>
				<span class="moka-appearance-panel__dialog-button moka-appearance-panel__dialog-button--danger"></span>
			</span>
		</span>
	</span>;

	private static RenderFragment ButtonsArt(MokaButtonLook look) =>@<span class="@LookClass("buttons", look)">@ButtonRow()</span>;
}
