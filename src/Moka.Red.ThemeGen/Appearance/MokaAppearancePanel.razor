@namespace Moka.Red.ThemeGen.Appearance
@inherits MokaVisualComponentBase
@using Moka.Red.Forms.RadioGroup
@using Moka.Red.Primitives.Button
@using Moka.Red.Primitives.ColorSwatch
@using Moka.Red.Primitives.SegmentedControl

<div class="@CssClass" style="@CssStyle" id="@Id" inert="@Disabled" @attributes="AdditionalAttributes">
	@if (Shows(MokaAppearanceRows.ColorMode))
	{
		<div class="moka-appearance-panel__section">
			<span class="moka-micro-label">@Text.ColorMode</span>
			<MokaRadioGroup TValue="MokaColorMode" Value="_value.Mode" ValueChanged="SetModeAsync" AriaLabel="@Text.ColorMode" Cards MinColumn="var(--_appearance-card)" Disabled="Disabled">
				<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.Light" Label="@Text.ColorModeLight">
					<Preview>@Mock(PreviewTheme(CurrentPalette, dark: false))</Preview>
				</MokaRadioItem>
				<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.Dark" Label="@Text.ColorModeDark">
					<Preview>@Mock(PreviewTheme(CurrentPalette, dark: true))</Preview>
				</MokaRadioItem>
				<MokaRadioItem TValue="MokaColorMode" Value="MokaColorMode.System" Label="@Text.ColorModeSystem" Hint="@Text.ColorModeSystemHint">
					<Preview>
						<span class="moka-appearance-panel__split">
							@Mock(PreviewTheme(CurrentPalette, dark: false))
							@Mock(PreviewTheme(CurrentPalette, dark: true))
						</span>
					</Preview>
				</MokaRadioItem>
			</MokaRadioGroup>
		</div>
	}

	@if (ShowsPalettes)
	{
		<div class="moka-appearance-panel__section">
			<span class="moka-micro-label">@Text.Palette</span>
			<MokaRadioGroup TValue="string" Value="@CurrentPalette.Id" ValueChanged="SetPaletteAsync" AriaLabel="@Text.Palette" Cards MinColumn="var(--_appearance-card)" Disabled="Disabled">
				@foreach (MokaAppearancePalette palette in Palettes)
				{
					<MokaRadioItem TValue="string" Value="@palette.Id" Label="@palette.Name" Hint="@palette.Hint">
						<Preview>@Mock(PreviewTheme(palette, IsDarkNow))</Preview>
					</MokaRadioItem>
				}
			</MokaRadioGroup>
		</div>
	}

	@if (ShowsAccents)
	{
		<div class="moka-appearance-panel__section">
			<span class="moka-micro-label">@Text.Accent</span>
			<div class="moka-appearance-panel__accent">
				<MokaColorSwatch Colors="AccentColors" SelectedColor="@SelectedAccentColor" SelectedColorChanged="SetAccentColorAsync" ColorLabel="AccentName"
				                 AllowClear role="group" aria-label="@Text.Accent"/>
				@if (SelectedAccent is null)
				{
					<span class="moka-appearance-panel__said">@Text.AccentFromPalette</span>
				}
				else
				{
					<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" OnClick="UsePaletteAccentAsync">@Text.UsePaletteAccent</MokaButton>
				}
			</div>
		</div>
	}

	@if (StyleIsFixed)
	{
		<p class="moka-appearance-panel__said">@Text.StyleFixed</p>
	}

	@{
		List<ChoiceRow> rows = ChoiceRows();
	}
	@if (rows.Count > 0 || ChildContent is not null)
	{
		<div class="moka-appearance-panel__rows">
			@foreach (ChoiceRow row in rows)
			{
				<MokaAppearanceRow @key="row.Flag" Label="@row.Label">
					<MokaSegmentedControl Value="@row.Current" ValueChanged="row.Pick" AriaLabel="@row.Label" Size="Size" Disabled="Disabled">
						@foreach (ChoiceOption option in row.Options)
						{
							<MokaSegment Value="@option.Value" Text="@option.Text"/>
						}
					</MokaSegmentedControl>
				</MokaAppearanceRow>
			}
			@ChildContent
		</div>
	}
</div>

@code {
	private RenderFragment Mock(MokaTheme theme) =>@<MokaThemeProvider Theme="theme" LoadFonts="false" Nonce="@Nonce">
		<span class="moka-appearance-panel__window">
			<span class="moka-appearance-panel__rail">
				<span class="moka-appearance-panel__dot moka-appearance-panel__dot--on"></span>
				<span class="moka-appearance-panel__dot"></span>
				<span class="moka-appearance-panel__dot"></span>
			</span>
			<span class="moka-appearance-panel__main">
				<span class="moka-appearance-panel__title"></span>
				<span class="moka-appearance-panel__card">
					<span class="moka-appearance-panel__accent-line"></span>
					<span class="moka-appearance-panel__line"></span>
				</span>
			</span>
		</span>
	</MokaThemeProvider>;
}
