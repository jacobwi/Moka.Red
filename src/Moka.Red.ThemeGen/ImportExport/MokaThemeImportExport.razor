@namespace Moka.Red.ThemeGen.ImportExport
@using Moka.Red.Forms.TextArea
@using Moka.Red.Primitives.Button
@using Moka.Red.Primitives.CodeBlock
@using Moka.Red.Primitives.SegmentedControl
@using Moka.Red.Primitives.Typography

<div class="moka-theme-import-export">
	<div class="moka-theme-import-export__section">
		<div class="moka-theme-import-export__bar">
			<MokaHeading Level="3" Micro>@Text.ExportHeading</MokaHeading>
			<MokaSegmentedControl Value="@FormatValue" ValueChanged="SetFormatAsync" AriaLabel="@Text.FormatLabel" Size="MokaSize.Sm">
				<MokaSegment Value="@nameof(MokaThemeExportFormat.CSharp)" Text="@Text.CSharp"/>
				<MokaSegment Value="@nameof(MokaThemeExportFormat.Json)" Text="@Text.Json"/>
				<MokaSegment Value="@nameof(MokaThemeExportFormat.Css)" Text="@Text.Css"/>
			</MokaSegmentedControl>
		</div>

		<MokaCodeBlock Code="@ExportOutput" Language="@Language" Highlighter="Highlighter" MaxHeight="@MaxHeight" ShowLineNumbers="false"/>
		<MokaCaption>@Hint</MokaCaption>

		@if (OnExport.HasDelegate)
		{
			<div>
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" OnClick="HandleExport">@Text.Export</MokaButton>
			</div>
		}
	</div>

	@if (ShowImport)
	{
		<div class="moka-theme-import-export__section">
			<MokaHeading Level="3" Micro>@Text.ImportHeading</MokaHeading>
			<MokaTextArea Label="@Text.ImportLabel" Placeholder="@Text.ImportPlaceholder" Rows="4" Mono @bind-Value="_importJson" ErrorText="@_importError"/>
			<div>
				<MokaButton Size="MokaSize.Sm" OnClick="HandleImport">@Text.Apply</MokaButton>
			</div>
		</div>
	}
</div>
