@namespace Moka.Red.Feedback.Wizard
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">

	@if (Rail)
	{
		@if (ShowStepIndicator && _steps.Count > 0)
		{
			<div class="moka-wizard-progress">
				<div class="moka-wizard-progress-top">
					<strong class="moka-wizard-progress-count">@ProgressCountText()</strong>
					<span class="moka-wizard-progress-title">@ActiveStepTitle</span>
				</div>
				<MokaProgress Thin Value="@ProgressValue" aria-label="@RailLabel"/>
			</div>

			<div class="moka-wizard-rail">
				<ol class="moka-wizard-rail-steps moka-thin-scrollbar" aria-label="@RailLabel">
					@for (var i = 0; i < _steps.Count; i++)
					{
						var index = i;
						var step = _steps[i];
						var state = RailStateOf(index, step);

						<li class="@RailStepClass(state)">
							<button type="button"
							        class="moka-wizard-rail-button"
							        disabled="@(index > _reached)"
							        aria-current="@(state == RailState.Now ? "step" : null)"
							        @onclick="() => GoToReachedStep(index)">
								<span class="moka-wizard-rail-mark" aria-hidden="true">
									@if (state == RailState.Done)
									{
										<MokaIcon Icon="MokaIcons.Status.Check" SizeValue="14px"/>
									}
									else if (state == RailState.Problem)
									{
										@("!")
									}
									else if (step.Icon is not null)
									{
										<MokaIcon Icon="step.Icon.Value" SizeValue="14px"/>
									}
									else
									{
										@(index + 1)
									}
								</span>
								<span class="moka-wizard-rail-title">
									@if (state == RailState.Problem)
									{
										<span class="moka-visually-hidden">@ProblemText: </span>
									}
									@step.Title
								</span>
								@if (!string.IsNullOrEmpty(step.Decided))
								{
									<span class="moka-wizard-rail-decided">@step.Decided</span>
								}
							</button>
						</li>
					}
				</ol>
			</div>
		}
	}
	else if (ShowStepIndicator && _steps.Count > 0)
	{
		@* Step indicator *@
		<div class="moka-wizard-indicator">
			@for (var i = 0; i < _steps.Count; i++)
			{
				var index = i;
				var step = _steps[i];

				@if (i > 0)
				{
					<div class="@ConnectorClass(index)"></div>
				}

				<button type="button"
				        class="@StepIndicatorClass(index)"
				        disabled="@(!CanClickStep(index))"
				        @onclick="() => GoToStep(index)">
					<span class="moka-wizard-indicator-circle">
						@if (index < _activeStep)
						{
							<MokaIcon Icon="MokaIcons.Status.Check" Size="MokaSize.Xs"/>
						}
						else if (step.Icon is not null)
						{
							<MokaIcon Icon="step.Icon.Value" Size="MokaSize.Xs"/>
						}
						else
						{
							@(index + 1)
						}
					</span>
					<span class="moka-wizard-indicator-title">@step.Title</span>
				</button>
			}
		</div>
	}

	@* Step content area *@
	<div class="moka-wizard-content">
		<CascadingValue Value="this" IsFixed="false">
			@ChildContent
		</CascadingValue>
	</div>

	@* Navigation buttons *@
	@if (ShowNavigation)
	{
		@if (Rail)
		{
			<div class="moka-wizard-bar">
				<MokaButton Variant="MokaVariant.Outlined"
				            Color="MokaColor.Secondary"
				            Disabled="@IsFirstStep"
				            OnClick="PreviousStep">
					@ResolvedPreviousText
				</MokaButton>

				<div class="moka-wizard-nav-spacer"></div>

				@if (ShowSkip && !IsLastStep)
				{
					<MokaButton Variant="MokaVariant.Text"
					            Color="MokaColor.Secondary"
					            OnClick="Skip">
						@SkipText
					</MokaButton>
				}

				@if (IsLastStep)
				{
					<MokaButton Color="MokaColor.Primary"
					            Disabled="@(!CurrentStepValid)"
					            OnClick="Finish">
						@FinishText
					</MokaButton>
				}
				else
				{
					<MokaButton Color="MokaColor.Primary"
					            Disabled="@(!CurrentStepValid)"
					            OnClick="NextStep">
						@ResolvedNextText
					</MokaButton>
				}
			</div>
		}
		else
		{
			<div class="moka-wizard-nav">
				<MokaButton Variant="MokaVariant.Outlined"
				            Size="MokaSize.Sm"
				            Disabled="@IsFirstStep"
				            OnClick="PreviousStep">
					@ResolvedPreviousText
				</MokaButton>

				<div class="moka-wizard-nav-spacer"></div>

				@if (IsLastStep)
				{
					<MokaButton Color="MokaColor.Primary"
					            Size="MokaSize.Sm"
					            Disabled="@(!CurrentStepValid)"
					            OnClick="Finish">
						@FinishText
					</MokaButton>
				}
				else
				{
					<MokaButton Color="MokaColor.Primary"
					            Size="MokaSize.Sm"
					            Disabled="@(!CurrentStepValid)"
					            OnClick="NextStep">
						@ResolvedNextText
					</MokaButton>
				}
			</div>
		}
	}
</div>
