@namespace Moka.Red.Feedback.Drawer
@inherits MokaComponentBase

@if (_open)
{
	@if (Overlay)
	{
		<div class="moka-drawer-backdrop" @onclick="HandleBackdropClick"></div>
	}

	@* Only a drawer with Overlay is modal: without it the page behind stays usable. Keys stop here,
	   so the Escape that closes the drawer does not also reach a dialog or drawer around it. *@
	<div class="@CssClass" style="@CssStyle" id="@Id"
	     role="dialog"
	     aria-modal="@(Overlay ? "true" : null)"
	     aria-labelledby="@TitleId"
	     aria-label="@(Title is null ? AriaLabel : null)"
	     @onkeydown="HandleKeyDown"
	     @onkeydown:stopPropagation="true"
	     @attributes="AdditionalAttributes"
	     tabindex="-1"
	     @ref="_drawerRef">

		@if (Title is not null || ShowCloseButton)
		{
			<div class="moka-drawer-header">
				@if (Title is not null)
				{
					<div class="moka-drawer-title" id="@TitleId">@Title</div>
				}
				@if (ShowCloseButton)
				{
					<MokaTooltip Text="@CloseLabel" Position="MokaTooltipPosition.BottomEnd">
						<button class="moka-drawer-close" type="button" @onclick="CloseAsync" aria-label="@CloseLabel">
							<MokaIcon Icon="MokaIcons.Navigation.Close" Size="MokaSize.Sm"/>
						</button>
					</MokaTooltip>
				}
			</div>
		}

		<div class="moka-drawer-body">
			@ChildContent
		</div>
	</div>
}
