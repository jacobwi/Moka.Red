@namespace Moka.Red.Feedback.EmptyState
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="@(Live ? "status" : null)" aria-live="@(Live ? "polite" : null)"
     @attributes="AdditionalAttributes">
	@if (!string.IsNullOrEmpty(ImageSrc))
	{
		<img class="moka-empty-state__image" src="@ImageSrc" alt="" aria-hidden="true"/>
	}
	else if (Icon is not null)
	{
		<div class="moka-empty-state__icon">
			<MokaIcon Icon="Icon.Value" SizeValue="var(--_empty-icon, 48px)"/>
		</div>
	}

	@if (Compact)
	{
		<div class="moka-empty-state__text">
			@{ RenderText(); }
		</div>
	}
	else
	{
		RenderText();
	}

	@if (ChildContent is not null)
	{
		<div class="moka-empty-state__actions">
			@ChildContent
		</div>
	}
</div>

@{
	void RenderText()
	{
		if (!string.IsNullOrEmpty(Title))
		{
			<div class="moka-empty-state__title">@Title</div>
		}

		if (!string.IsNullOrEmpty(Description))
		{
			<div class="moka-empty-state__description">@Description</div>
		}
	}
}
