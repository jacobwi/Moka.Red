@namespace Moka.Red.Feedback.Dropdown
@inherits MokaComponentBase

@if (Divider)
{
	<div class="moka-dropdown-divider" role="separator"></div>
}
else
{
	@* The dropdown's script moves focus between items, so an enabled item takes focus without
	   joining the tab order. A disabled item is skipped and swallows its click, so it cannot
	   close the menu either. *@
	<div class="@CssClass" style="@CssStyle" role="menuitem"
	     tabindex="@(Disabled ? null : "-1")"
	     aria-disabled="@(Disabled ? "true" : null)"
	     @onclick="HandleClick"
	     @onclick:stopPropagation="Disabled">
		@if (Icon is not null)
		{
			<MokaIcon Icon="Icon.Value" Size="MokaSize.Xs" Class="moka-dropdown-item-icon"/>
		}
		@if (ChildContent is not null)
		{
			@ChildContent
		}
		else if (!string.IsNullOrEmpty(Text))
		{
			<span class="moka-dropdown-item-text">@Text</span>
		}
	</div>
}
