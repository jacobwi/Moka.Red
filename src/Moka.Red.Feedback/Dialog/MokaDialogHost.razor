@namespace Moka.Red.Feedback.Dialog
@using Microsoft.AspNetCore.Components.Sections

@* One dialog per open request, bottom first, so a dialog opened from another one's action sits on
   top of it. The key keeps each dialog's own state (focus trap, entered text) with its request.
   A request whose dialog is exiting renders after them, still on top, until the exit finishes. *@
@foreach (MokaDialogRequest request in RenderedRequests)
{
	<MokaDialog @key="request"
	            Open="@(OpenFor(request))"
	            Title="@request.Title"
	            Icon="request.Options.Icon"
	            IconColor="request.Options.IconColor ?? request.Options.ConfirmColor"
	            Look="request.Options.Look"
	            HeaderActions="request.Options.HeaderActions"
	            DialogSize="request.Options.Size"
	            Position="request.Options.Position"
	            Backdrop="request.Options.Backdrop"
	            BodyPadding="request.Options.BodyPadding"
	            ScrollBody="request.Options.ScrollBody"
	            Width="@request.Options.Width"
	            MaxWidth="@request.Options.MaxWidth"
	            Height="@request.Options.Height"
	            ShowCloseButton="request.Options.ShowCloseButton"
	            CloseOnBackdropClick="request.Options.CloseOnBackdropClick"
	            CloseOnEscape="request.Options.CloseOnEscape"
	            PreventScroll="request.Options.PreventScroll"
	            InitialFocus="request.Options.InitialFocus"
	            Busy="IsWorking(request)"
	            OnClose="() => Cancel(request)"
	            OnExited="() => Exited(request)">
		<ChildContent>
			@if (request.Type == MokaDialogType.Component && request.ComponentType is not null)
			{
				<CascadingValue Value="ContextFor(request)">
					@ComponentContent(request)
				</CascadingValue>
			}
			else if (request.Content is not null)
			{
				@request.Content
			}
			else if (!string.IsNullOrEmpty(request.Message))
			{
				<p>@request.Message</p>

				@if (request.Type == MokaDialogType.Prompt)
				{
					@* Bound straight to the request, so a consumer confirming the prompt through
					   the service still gets the entered text. In a form of its own, so Enter submits it the
					   browser's way, which also leaves Enter alone while an IME is composing. *@
					<form class="moka-dialog-prompt-form" @onsubmit="() => ConfirmAsync(request)">
						<input type="text"
						       class="moka-dialog-prompt-input"
						       aria-label="@(request.Message ?? request.Title)"
						       data-autofocus
						       @bind="request.CurrentValue"
						       @bind:event="oninput"/>
					</form>
				}
			}
			@if (FailureOf(request) is { } failure)
			{
				<div class="moka-dialog-failure">
					<MokaAlert Severity="MokaToastSeverity.Error" Dense="true">@failure</MokaAlert>
				</div>
			}
		</ChildContent>
		<Actions>
			@if (request.Type == MokaDialogType.Component)
			{
				<SectionOutlet SectionId="ContextFor(request).ActionsSection"/>
			}
			else if (request.Type == MokaDialogType.Show)
			{
				<MokaButton Variant="MokaVariant.Filled"
				            Color="request.Options.ConfirmColor"
				            Size="MokaSize.Sm"
				            OnClick="() => ConfirmAsync(request)">
					@request.Options.ConfirmText
				</MokaButton>
			}
			else
			{
				<MokaButton Variant="MokaVariant.Text"
				            Size="MokaSize.Sm"
				            Disabled="IsCancelling(request)"
				            OnClick="() => Cancel(request)">
					@request.Options.CancelText
				</MokaButton>
				<MokaButton Variant="MokaVariant.Filled"
				            Color="request.Options.ConfirmColor"
				            Size="MokaSize.Sm"
				            Loading="IsWorking(request)"
				            OnClick="() => ConfirmAsync(request)">
					@request.Options.ConfirmText
				</MokaButton>
			}
		</Actions>
	</MokaDialog>
}
