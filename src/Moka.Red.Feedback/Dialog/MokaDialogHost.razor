@namespace Moka.Red.Feedback.Dialog

@* One dialog per open request, bottom first, so a dialog opened from another one's action sits on
   top of it. The key keeps each dialog's own state (focus trap, entered text) with its request. *@
@foreach (MokaDialogRequest request in _open)
{
	<MokaDialog @key="request"
	            Open="true"
	            Title="@request.Title"
	            DialogSize="request.Options.Size"
	            ShowCloseButton="request.Options.ShowCloseButton"
	            CloseOnBackdropClick="request.Options.CloseOnBackdropClick"
	            CloseOnEscape="request.Options.CloseOnEscape"
	            PreventScroll="request.Options.PreventScroll"
	            OnClose="() => Cancel(request)">
		<ChildContent>
			@if (request.Type == MokaDialogType.Component && request.ComponentType is not null)
			{
				<CascadingValue Value="ContextFor(request)">
					<DynamicComponent Type="request.ComponentType"
					                  Parameters="request.ComponentParameters"/>
				</CascadingValue>
			}
			else if (request.Content is not null)
			{
				@request.Content
			}
			else if (!string.IsNullOrEmpty(request.Message))
			{
				<p>@request.Message</p>

				@if (request.Type == MokaDialogType.Prompt)
				{
					@* Bound straight to the request, so a consumer confirming the prompt through
					   the service still gets the entered text. *@
					<input type="text"
					       class="moka-dialog-prompt-input"
					       aria-label="@(request.Message ?? request.Title)"
					       data-autofocus
					       @bind="request.CurrentValue"
					       @bind:event="oninput"/>
				}
			}
		</ChildContent>
		<Actions>
			@if (request.Type == MokaDialogType.Component)
			{
				@* Component dialogs manage their own actions via MokaDialogContext *@
			}
			else if (request.Type == MokaDialogType.Show)
			{
				<MokaButton Variant="MokaVariant.Filled"
				            Color="request.Options.ConfirmColor"
				            Size="MokaSize.Sm"
				            OnClick="() => Confirm(request)">
					@request.Options.ConfirmText
				</MokaButton>
			}
			else
			{
				<MokaButton Variant="MokaVariant.Text"
				            Size="MokaSize.Sm"
				            OnClick="() => Cancel(request)">
					@request.Options.CancelText
				</MokaButton>
				<MokaButton Variant="MokaVariant.Filled"
				            Color="request.Options.ConfirmColor"
				            Size="MokaSize.Sm"
				            OnClick="() => Confirm(request)">
					@request.Options.ConfirmText
				</MokaButton>
			}
		</Actions>
	</MokaDialog>
}
