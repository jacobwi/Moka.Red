@namespace Moka.Red.Feedback.Loading
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes">
	@* Inert while loading, since the layer only stops the mouse and Tab would reach the controls under it. *@
	<div class="@ContentCss" style="@ContentStyle" inert="@Loading" aria-busy="@(Loading ? "true" : "false")">
		@ChildContent
	</div>

	@if (Loading)
	{
		<div class="@OverlayCss" style="@OverlayStyle"
		     role="alert"
		     aria-label="@(Message ?? "Loading")">
			<div class="@IndicatorCss">
				@if (ShowSkeleton)
				{
					<MokaSkeleton Shape="@SkeletonShape" Lines="@SkeletonLines"/>
				}
				else
				{
					<MokaSpinner SpinnerStyle="@SpinnerStyle"
					             Size="@Size"
					             Color="@Color"
					             Label="@Message"/>
				}
			</div>
		</div>
	}
</div>
