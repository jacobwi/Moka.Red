@namespace Moka.Red.Feedback.NotificationBell
@inherits MokaVisualComponentBase
@using Moka.Red.Feedback.Internal

@* Keys from the open panel stop here, so the Escape that closes it does not also reach the Blazor
   handler of a dialog around it. *@
<div class="@CssClass" style="@CssStyle" id="@Id" @ref="_root" @attributes="AdditionalAttributes"
     @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="_isOpen">
	<button type="button" class="moka-notification-bell__trigger" @ref="_trigger" @onclick="ToggleDropdown"
	        aria-label="@TriggerLabel"
	        aria-expanded="@(_isOpen ? "true" : "false")"
	        aria-controls="@(_isOpen ? PanelId : null)">
		<MokaIcon Icon="MokaIcons.Status.Bell" SizeValue="@ResolvedSize"/>
		@if (UnreadCount > 0)
		{
			<span class="moka-notification-bell__badge">@BadgeText</span>
		}
	</button>

	@if (_isOpen)
	{
		@* tabindex -1 lets a click on the panel's blank space keep focus inside the component,
		   which the script reads as "still open". *@
		<div class="@DropdownClass" style="@DropdownStyle" id="@PanelId" tabindex="-1" role="group" aria-labelledby="@TitleId">
			<div class="moka-notification-bell__header">
				<span class="moka-notification-bell__title" id="@TitleId">Notifications</span>
				@if (Notifications is { Count: > 0 })
				{
					<button type="button" class="moka-notification-bell__action" @onclick="HandleMarkAllRead">Mark all read</button>
					<button type="button" class="moka-notification-bell__action" @onclick="HandleClear">Clear</button>
				}
			</div>

			<div class="moka-notification-bell__list">
				@if (Notifications is null or { Count: 0 })
				{
					<div class="moka-notification-bell__empty">
						<MokaIcon Icon="MokaIcons.Status.Bell" SizeValue="28px" Style="opacity: 0.3"/>
						<span>No notifications</span>
					</div>
				}
				else
				{
					IReadOnlyList<MokaNotificationBellItem> visible = VisibleNotifications;
					object?[] keys = MokaUniqueKeys.For(visible, item => item.Id);

					<span id="@UnreadId" hidden>Unread</span>
					<div role="list">
						@for (int i = 0; i < visible.Count; i++)
						{
							MokaNotificationBellItem item = visible[i];
							<div class="@ItemCss(item)" role="listitem" @key="keys[i]"
							     aria-describedby="@(Clickable || item.Read ? null : UnreadId)">
								@if (Clickable)
								{
									<button type="button" class="moka-notification-bell__item-main"
									        aria-describedby="@(item.Read ? null : UnreadId)"
									        @onclick="() => HandleItemClick(item)">
										@ItemContent(item)
									</button>
								}
								else
								{
									<div class="moka-notification-bell__item-main">
										@ItemContent(item)
									</div>
								}
							</div>
						}
					</div>

					@if (RemainingCount > 0)
					{
						<div class="moka-notification-bell__more">
							+@RemainingCount more
						</div>
					}
				}
			</div>
		</div>
	}
</div>

@code {

	// Spans, since the content sits inside a button when the item can be clicked.
	private RenderFragment ItemContent(MokaNotificationBellItem item) => @<text>
		<span class="moka-notification-bell__item-icon">
			<MokaIcon Icon="@(item.Icon ?? MokaIcons.Status.Bell)" SizeValue="16px"/>
		</span>
		<span class="moka-notification-bell__item-content">
			<span class="moka-notification-bell__item-title">@item.Title</span>
			<span class="moka-notification-bell__item-message">@item.Message</span>
			<span class="moka-notification-bell__item-time">@FormatTime(item.Timestamp)</span>
		</span>
	</text>;

}
