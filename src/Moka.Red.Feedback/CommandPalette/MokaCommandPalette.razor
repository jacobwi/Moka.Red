@namespace Moka.Red.Feedback.CommandPalette
@inherits MokaComponentBase

@if (_isOpen)
{
	<div class="moka-command-palette-backdrop" @onclick="HandleBackdropClick"></div>
	<div class="@CssClass" style="@CssStyle" id="@Id" @attributes="AdditionalAttributes"
	     @onkeydown="HandleKeyDown" tabindex="-1">
		<div class="moka-command-palette__search">
			<MokaIcon Icon="MokaIcons.Action.Search" Size="MokaSize.Sm"
			          Class="moka-command-palette__search-icon"/>
			<input @ref="_inputRef"
			       class="moka-command-palette__input"
			       type="text"
			       placeholder="@Placeholder"
			       @bind="_searchText"
			       @bind:event="oninput"
			       @bind:after="OnSearchChanged"/>
		</div>

		<div class="moka-command-palette__results" @ref="_resultsRef">
			@if (_filteredCommands.Count == 0)
			{
				<div class="moka-command-palette__empty">@NoResultsText</div>
			}
			else if (ShowGroups)
			{
				var itemIndex = 0;
				foreach (var group in GroupedCommands())
				{
					if (!string.IsNullOrEmpty(group.Key))
					{
						<div class="moka-command-palette__group">@group.Key</div>
					}

					foreach (var command in group)
					{
						@CommandRow(command, itemIndex)
						itemIndex++;
					}
				}
			}
			else
			{
				var itemIndex = 0;
				foreach (var command in _filteredCommands)
				{
					@CommandRow(command, itemIndex)
					itemIndex++;
				}
			}
		</div>

		<div class="moka-command-palette__footer">
			<span><MokaKbd>&#8593;&#8595;</MokaKbd> Navigate</span>
			<span><MokaKbd>&#9166;</MokaKbd> Select</span>
			<span><MokaKbd>Esc</MokaKbd> Close</span>
		</div>
	</div>
}

@code {
	// A command that opens another tab is a link, so a click, Ctrl+click and a middle click are the browser's own. Focus
	// stays in the search box, as for every row, so the link isn't a tab stop.
	private RenderFragment CommandRow(MokaCommand command, int index)
	{
		RenderFragment content =
			@<text>
				@if (command.Icon.HasValue)
				{
					<MokaIcon Icon="command.Icon.Value" Size="MokaSize.Sm"
					          Class="moka-command-palette__item-icon"/>
				}
				<div class="moka-command-palette__item-content">
					<div class="moka-command-palette__item-title">
						@command.Title
						@if (OpensNewTab(command))
						{
							<span class="moka-visually-hidden">, @NewTabText</span>
						}
					</div>
					@if (!string.IsNullOrEmpty(command.Description))
					{
						<div class="moka-command-palette__item-desc">@command.Description</div>
					}
				</div>
				@if (OpensNewTab(command))
				{
					<span class="moka-command-palette__item-external" aria-hidden="true">
						<MokaIcon Icon="MokaIcons.Content.ExternalLink" SizeValue="12px"/>
					</span>
				}
				@if (ShowShortcuts && !string.IsNullOrEmpty(command.Shortcut))
				{
					<span class="moka-command-palette__item-shortcut">
						@foreach (string key in ShortcutKeys.Split(command.Shortcut))
						{
							<MokaKbd>@key</MokaKbd>
						}
					</span>
				}
			</text>;

		if (OpensNewTab(command))
		{
			return @<a class="@ItemCss(command, index)"
			           data-moka-index="@index"
			           href="@(command.Disabled ? null : HrefOf(command))"
			           target="@(command.Disabled ? null : command.Target)"
			           rel="@(command.Disabled ? null : UrlValues.RelFor(command.Target))"
			           tabindex="-1"
			           role="@(command.Disabled ? "link" : null)"
			           aria-disabled="@(command.Disabled ? "true" : null)"
			           @onclick="() => ExecuteCommand(command, false)">
				@content
			</a>;
		}

		return @<div class="@ItemCss(command, index)"
		            data-moka-index="@index"
		            @onclick="() => ExecuteCommand(command, false)">
			@content
		</div>;
	}
}
