@namespace Moka.Red.Data.Chart
@inherits MokaCartesianChartBase

@if (!IsClassic)
{
	<div class="@CssClass" style="@CssStyle" id="@Id" role="@RootRole" aria-label="@AccessibleLabel"
	     @ref="RootElement" @attributes="AdditionalAttributes">
		<MokaChartFrame Chart="this">
			@if (Horizontal)
			{
				<MokaChartPlot Chart="this" Row="@RowMarks"/>
			}
			else
			{
				<MokaChartPlot Chart="this" Marks="@ColumnMarks"/>
			}
		</MokaChartFrame>
	</div>
	return;
}

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@(Label ?? "Bar chart")"
     @attributes="AdditionalAttributes">
	<div class="@FrameClass" style="@FrameStyle">
		<div class="moka-barchart-yaxis" aria-hidden="true">
			@if (_categoryCount > 0)
			{
				@* In the flow, so the column is as wide as the longest label; the labels themselves are placed. *@
				<span class="moka-barchart-ysizer">@_widestTick</span>
				@foreach (YTick tick in _grid)
				{
					<span class="moka-barchart-tick moka-barchart-ytick" style="@tick.Style">@tick.Text</span>
				}
			}
		</div>

		<svg class="moka-barchart-plot" viewBox="@PlotViewBox" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
			@if (_categoryCount > 0)
			{
				@foreach (YTick tick in _grid)
				{
					<line class="moka-barchart-grid" x1="@Num(PadLeft)" x2="@Num(PadLeft + PlotWidth)" y1="@tick.Y" y2="@tick.Y"/>
				}

				@foreach (BarGeometry bar in _bars)
				{
					<path class="moka-barchart-bar @bar.ColorClass" d="@bar.Path">
						<title>@bar.Title</title>
					</path>
				}
			}
		</svg>

		@if (ShowXLabels)
		{
			<div class="moka-barchart-xaxis" aria-hidden="true">
				@foreach (XTick label in _xLabels)
				{
					<span class="@label.Class" style="@label.Style">@label.Text</span>
				}
			</div>
		}
	</div>

	@if (ShowLegend && _visible.Count > 0)
	{
		<div class="moka-barchart-legend">
			@foreach (SeriesLegend series in _legend)
			{
				<span class="moka-barchart-legend-item">
					<span class="moka-barchart-legend-dot @series.ColorClass"></span>
					@series.Name
				</span>
			}
		</div>
	}
</div>
