@namespace Moka.Red.Data.Chart
@inherits MokaCartesianChartBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@(Label ?? "Bar chart")"
     @attributes="AdditionalAttributes">
	<svg class="moka-barchart-svg" viewBox="0 0 600 260" xmlns="http://www.w3.org/2000/svg">
		@if (CategoryCount > 0)
		{
			@* Grid lines with the y-axis tick labels beside them. The g wrapper keeps Razor from
			   taking the svg text element for its own literal text tag. *@
			@foreach (GridLine gridLine in Grid)
			{
				<g>
					<line class="moka-barchart-grid" x1="@Num(PadLeft)" x2="@Num(PadLeft + PlotWidth)"
					      y1="@gridLine.Y" y2="@gridLine.Y"/>
					<text class="moka-barchart-tick" x="@Num(PadLeft - 6)" y="@gridLine.BaselineY"
					      text-anchor="end">@gridLine.Text</text>
				</g>
			}

			@if (ShowXLabels)
			{
				foreach (XLabel label in XLabels)
				{
					<g>
						<text class="moka-barchart-tick" x="@label.X" y="@Num(ViewHeight - 6)"
						      text-anchor="middle">@label.Text</text>
					</g>
				}
			}

			@foreach (IReadOnlyList<BarGeometry> group in Bars)
			{
				foreach (BarGeometry bar in group)
				{
					<path class="moka-barchart-bar @bar.ColorClass" d="@bar.Path">
						<title>@bar.Title</title>
					</path>
				}
			}
		}
	</svg>

	@if (ShowLegend && Visible.Count > 0)
	{
		<div class="moka-barchart-legend">
			@foreach (SeriesLegend series in Legend)
			{
				<span class="moka-barchart-legend-item">
					<span class="moka-barchart-legend-dot @series.ColorClass"></span>
					@series.Name
				</span>
			}
		</div>
	}
</div>
