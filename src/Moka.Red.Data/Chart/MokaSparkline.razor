@namespace Moka.Red.Data.Chart
@inherits MokaVisualComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@(Label ?? "Sparkline")"
     @attributes="AdditionalAttributes">
	@if (HasLine)
	{
		<svg class="moka-sparkline-svg" viewBox="0 0 120 36" xmlns="http://www.w3.org/2000/svg"
		     preserveAspectRatio="none">
			@if (ShowArea)
			{
				<path class="moka-sparkline-area" d="@AreaPath"/>
			}
			<path class="moka-sparkline-line" d="@LinePath" stroke-width="@StrokeWidth"
			      stroke-linecap="round" stroke-linejoin="round"/>
			@if (ShowLastPoint)
			{
				<circle class="moka-sparkline-point" cx="@LastPoint.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
				        cy="@LastPoint.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)" r="@Radius.ToString(System.Globalization.CultureInfo.InvariantCulture)">
					<title>@Values![^1].ToString(System.Globalization.CultureInfo.CurrentCulture)</title>
				</circle>
			}
		</svg>
	}
</div>
