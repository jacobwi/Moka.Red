@namespace Moka.Red.Data.Chart
@inherits MokaCartesianChartBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@(Label ?? "Line chart")"
     @attributes="AdditionalAttributes">
	<svg class="moka-linechart-svg" viewBox="0 0 600 260" xmlns="http://www.w3.org/2000/svg">
		@if (CategoryCount > 0)
		{
			@* Grid lines with the y-axis tick labels beside them. The g wrapper keeps Razor from
			   taking the svg text element for its own literal text tag. *@
			@foreach (GridLine gridLine in Grid)
			{
				<g>
					<line class="moka-linechart-grid" x1="@Num(PadLeft)" x2="@Num(PadLeft + PlotWidth)"
					      y1="@gridLine.Y" y2="@gridLine.Y"/>
					<text class="moka-linechart-tick" x="@Num(PadLeft - 6)" y="@gridLine.BaselineY"
					      text-anchor="end">@gridLine.Text</text>
				</g>
			}

			@if (ShowXLabels)
			{
				foreach (XLabel label in XLabels)
				{
					<g>
						<text class="moka-linechart-tick" x="@label.X" y="@Num(ViewHeight - 6)"
						      text-anchor="middle">@label.Text</text>
					</g>
				}
			}

			@* The series, each painted from the palette in rotation *@
			@foreach (SeriesGeometry series in Geometry)
			{
				<g class="@series.ColorClass">
					@if (series.Area is not null)
					{
						<path class="moka-linechart-area" d="@series.Area"/>
					}
					@if (series.Line.Length > 0)
					{
						<path class="moka-linechart-line" d="@series.Line"/>
					}
					@foreach (PointGeometry point in series.Points)
					{
						<circle class="moka-linechart-point" r="3" cx="@point.Cx" cy="@point.Cy">
							<title>@point.Title</title>
						</circle>
					}
				</g>
			}
		}
	</svg>

	@if (ShowLegend && Visible.Count > 0)
	{
		<div class="moka-linechart-legend">
			@foreach (SeriesGeometry series in Geometry)
			{
				<span class="moka-linechart-legend-item">
					<span class="moka-linechart-legend-dot @series.ColorClass"></span>
					@series.Series.Name
				</span>
			}
		</div>
	}
</div>
