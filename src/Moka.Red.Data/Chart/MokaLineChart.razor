@namespace Moka.Red.Data.Chart
@inherits MokaCartesianChartBase

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@_summary"
     @attributes="AdditionalAttributes">
	<div class="@FrameClass" style="@FrameStyle">
		<div class="moka-linechart-yaxis" aria-hidden="true">
			@if (_categoryCount > 0)
			{
				@* In the flow, so the column is as wide as the longest label; the labels themselves are placed. *@
				<span class="moka-linechart-ysizer">@_widestTick</span>
				@foreach (YTick tick in _grid)
				{
					<span class="moka-linechart-tick moka-linechart-ytick" style="@tick.Style">@tick.Text</span>
				}
			}
		</div>

		<svg class="moka-linechart-plot" viewBox="@PlotViewBox" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
			@if (_categoryCount > 0)
			{
				@foreach (YTick tick in _grid)
				{
					<line class="moka-linechart-grid" x1="@Num(PlotLeft)" x2="@Num(PlotLeft + PlotSpan)" y1="@tick.Y" y2="@tick.Y"/>
				}

				@if (Live)
				{
					@* The clip keeps a sliding line inside the plot. The slide is on an inner group, so the clip itself
					   stays put. *@
					<defs>
						<clipPath id="@_clipId">
							<rect x="@Num(PlotLeft)" y="0" width="@Num(PlotBoxWidth)" height="@Num(PlotBoxHeight)"/>
						</clipPath>
					</defs>
					<g clip-path="url(#@_clipId)">
						<g class="@_slideClass" style="@_slideStyle">
							@Lines
						</g>
					</g>
				}
				else
				{
					@Lines
				}

				@foreach (PointGeometry point in _lastPoints)
				{
					<g class="@point.ColorClass">
						<line class="moka-linechart-last-ring" x1="@point.Cx" y1="@point.Cy" x2="@point.Cx" y2="@point.Cy"/>
						<line class="moka-linechart-last" x1="@point.Cx" y1="@point.Cy" x2="@point.Cx" y2="@point.Cy">
							<title>@point.Title</title>
						</line>
					</g>
				}
			}
		</svg>

		@if (ShowXLabels)
		{
			<div class="moka-linechart-xaxis" aria-hidden="true">
				@foreach (XTick label in _xLabels)
				{
					<span class="@label.Class" style="@label.Style">@label.Text</span>
				}
			</div>
		}

		@if (!_hasValues && !string.IsNullOrEmpty(EmptyText))
		{
			<div class="moka-linechart-empty">@EmptyText</div>
		}
	</div>

	@if (ShowLegend && _visible.Count > 0)
	{
		<div class="moka-linechart-legend">
			@foreach (LegendEntry entry in _legend)
			{
				<span class="moka-linechart-legend-item">
					<span class="moka-linechart-legend-dot @entry.ColorClass"></span>
					@entry.Name
					@if (entry.Value is not null)
					{
						<span class="moka-linechart-legend-value">@entry.Value</span>
					}
				</span>
			}
			@if (_peakText is not null)
			{
				<span class="moka-linechart-legend-item moka-linechart-legend-item--peak">
					@PeakLabel
					<span class="moka-linechart-legend-value">@_peakText</span>
				</span>
			}
		</div>
	}
</div>

@code {
	// Points are zero-length strokes with round caps: the plot stretches, and a stroke that doesn't scale keeps them
	// round where a circle would turn into an ellipse.
	private RenderFragment Lines => __builder =>
	{
		foreach (SeriesGeometry series in _geometry)
		{
			<g class="@series.ColorClass">
				@if (series.Area is not null)
				{
					<path class="moka-linechart-area" d="@series.Area"/>
				}
				@if (series.Line.Length > 0)
				{
					<path class="moka-linechart-line" d="@series.Line"/>
				}
				@foreach (PointGeometry point in series.Points)
				{
					<line class="moka-linechart-point" x1="@point.Cx" y1="@point.Cy" x2="@point.Cx" y2="@point.Cy">
						<title>@point.Title</title>
					</line>
				}
			</g>
		}
	};
}
