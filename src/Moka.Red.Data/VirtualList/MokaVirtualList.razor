@typeparam TItem
@namespace Moka.Red.Data.VirtualList
@inherits MokaVisualComponentBase

@* With OnItemClick the list is a listbox with one tab stop: focus stays on the list and
   aria-activedescendant names the active item. Focus on the items themselves would be lost each
   time Virtualize drops the focused one, and a tab stop per item would make Tab walk every item. *@
<div class="@CssClass" style="@CssStyle" id="@Id" @ref="_container"
     tabindex="@(Interactive ? "0" : null)"
     role="@(Interactive ? "listbox" : null)"
     aria-activedescendant="@ActiveDescendant"
     data-item-height="@(Interactive ? ItemHeightValue : null)"
     @attributes="AdditionalAttributes">
	@if (ItemsProvider is null)
	{
		<Virtualize @ref="_virtualize" TItem="MokaVirtualListRow<TItem>" Items="_rows" ItemSize="ItemHeight"
		            OverscanCount="OverscanCount">
			<ItemContent Context="row">@RowTemplate(row)</ItemContent>
		</Virtualize>
	}
	else
	{
		<Virtualize @ref="_virtualize" TItem="MokaVirtualListRow<TItem>" ItemsProvider="LoadRowsAsync" ItemSize="ItemHeight"
		            OverscanCount="OverscanCount">
			<ItemContent Context="row">@RowTemplate(row)</ItemContent>
			<Placeholder Context="loading">@LoadingTemplate(loading)</Placeholder>
		</Virtualize>
	}
</div>

@code {
	// Templates, not local functions: these render inside Virtualize, and a local function would write the
	// markup into this component's own render tree instead.
	private RenderFragment RowTemplate(MokaVirtualListRow<TItem> row) => Interactive
		? @<div class="@ItemClass(row.Index)" style="@ItemStyle"
		        id="@ItemId(row.Index)"
		        role="option"
		        aria-selected="@(row.Index == _activeIndex ? "true" : "false")"
		        aria-setsize="@SetSize"
		        aria-posinset="@PositionOf(row.Index)"
		        @onclick="() => HandleClick(row)">
			@ItemTemplate(row.Item)
		</div>
		: @<div class="moka-virtual-list__item" style="@ItemStyle">
			@ItemTemplate(row.Item)
		</div>;

	// aria-activedescendant can point at an item the provider hasn't answered for yet, so it has the same id.
	private RenderFragment LoadingTemplate(PlaceholderContext loading) => Interactive
		? @<div class="@ItemClass(loading.Index)" style="@ItemStyle"
		        id="@ItemId(loading.Index)"
		        role="option"
		        aria-busy="true"
		        aria-selected="@(loading.Index == _activeIndex ? "true" : "false")"
		        aria-setsize="@SetSize"
		        aria-posinset="@PositionOf(loading.Index)">
			@LoadingContent(loading)
		</div>
		: @<div class="moka-virtual-list__item" style="@ItemStyle">
			@LoadingContent(loading)
		</div>;

	private RenderFragment LoadingContent(PlaceholderContext loading) =>
		Placeholder is null ? DefaultLoadingContent : Placeholder(loading);

	private RenderFragment DefaultLoadingContent => @<MokaSkeleton Width="40%"/>;
}
