@namespace Moka.Red.Data.FileBrowser
@typeparam TItem
@inherits MokaVisualComponentBase
@using Microsoft.AspNetCore.Components.Forms
@using Moka.Red.ContextMenu
@using Moka.Red.Feedback.Alert
@using Moka.Red.Feedback.Toast
@using Moka.Red.Feedback.Dialog
@using Moka.Red.Feedback.Drawer
@using Moka.Red.Feedback.Progress
@using Moka.Red.Forms.InlineEdit
@using Moka.Red.Forms.SearchInput
@using Moka.Red.Layout.StatusBar
@using Moka.Red.Layout.Toolbar
@using Moka.Red.Navigation.Breadcrumb
@using Moka.Red.Primitives.Callout
@using Moka.Red.Primitives.RelativeTime
@using Moka.Red.Primitives.SegmentedControl
@using Moka.Red.Primitives.Tree

@{ _rendersBuilt++; }
<section class="@CssClass" style="@CssStyle" id="@Id" aria-label="@Text.Label" aria-busy="@(IsBusy ? "true" : null)"
         data-moka-file-browser data-moka-file-keys="@KeysAttribute" data-moka-file-key-scope="@KeyScopeAttribute" data-moka-fit-medium="@FitMedium" data-moka-fit-wide="@FitWide"
         @ref="_root" @attributes="AdditionalAttributes">
	<MokaToolbar Bordered="false" Wrap Rounded="MokaRounding.None" Class="moka-file-browser__bar">
		@if (HasSidePane)
		{
			<span class="moka-file-browser__side-toggle">
				@ToolButton(MokaIcons.File.FolderTree, SideLabel, true, OpenSide, MokaTooltipPosition.BottomStart)
			</span>
		}
		@ToolbarStart
		@BuiltIn(MokaFileControls.Back, _history.CanGoBack, GoBackAsync,
			ToolButton(MokaIcons.Navigation.ArrowLeft, Text.Back, _history.CanGoBack, GoBackAsync, MokaTooltipPosition.BottomStart))
		@BuiltIn(MokaFileControls.Forward, _history.CanGoForward, GoForwardAsync,
			ToolButton(MokaIcons.Navigation.ArrowRight, Text.Forward, _history.CanGoForward, GoForwardAsync))
		@BuiltIn(MokaFileControls.Up, ParentFolder is not null, GoUpAsync,
			ToolButton(MokaIcons.Navigation.ArrowUp, Text.Up, ParentFolder is not null, GoUpAsync))
		@if (HasControl(MokaFileControls.Path))
		{
			<div class="moka-file-browser__path">@BuiltIn(MokaFileControls.Path, true, null, Breadcrumb)</div>
		}
		else
		{
			<span class="moka-file-browser__grow"></span>
		}
		@BuiltIn(MokaFileControls.Refresh, true, RefreshAsync, ToolButton(MokaIcons.Action.Refresh, Text.Refresh, true, RefreshAsync))
		@if (HasControl(MokaFileControls.Filter))
		{
			<div class="moka-file-browser__filter">@BuiltIn(MokaFileControls.Filter, true, null, FilterBox)</div>
		}
	</MokaToolbar>

	@if (ShowsActionRow)
	{
		<MokaToolbar Bordered="false" Wrap Rounded="MokaRounding.None" Class="moka-file-browser__bar">
			@if (CreateFolder is not null)
			{
				@BuiltIn(MokaFileControls.NewFolder, true, BeginCreateFolderAsync, NewFolderButton)
			}
			@if (Upload is not null)
			{
				@BuiltIn(MokaFileControls.Upload, true, PickFilesAsync, UploadButton)
			}
			<span class="moka-file-browser__grow"></span>
			@ToolbarEnd
			@if (ShowsGroupByControl)
			{
				@BuiltIn(MokaFileControls.GroupBy, true, null, GroupByChoice)
			}
			@BuiltIn(MokaFileControls.Sort, true, null, SortChoice)
			@BuiltIn(MokaFileControls.ViewMode, true, null, ViewButtons)
			@if (ShowsPreviewControl)
			{
				@BuiltIn(MokaFileControls.Preview, true, TogglePreviewAsync, PreviewButton)
			}
			@if (Details is not null)
			{
				<span class="moka-file-browser__details-toggle">
					@ToolButton(MokaIcons.Status.Info, Text.Details, true, OpenDetails, MokaTooltipPosition.BottomEnd)
				</span>
			}
		</MokaToolbar>
	}

	<div class="moka-file-browser__progress">
		@if (IsBusy)
		{
			<MokaProgress Thin/>
		}
	</div>

	<div class="moka-file-browser__body">
		@if (HasSidePane)
		{
			<aside class="moka-file-browser__side moka-thin-scrollbar" aria-label="@SideLabel">@SideContent</aside>
		}

		<div class="moka-file-browser__main" style="@ColumnWidthVariables" @oncontextmenu="HandleBackgroundMenu" @oncontextmenu:preventDefault="true">
			@if (_failure is { } failure)
			{
				<MokaAlert Severity="MokaToastSeverity.Error" Title="@(FailureTitle?.Invoke(failure) ?? failure.Title)" Dense Closable OnClose="DismissFailure"
				           FixAction="@FailureActions?.Invoke(failure)"
				           Class="moka-file-browser__failure">@failure.Error.Message</MokaAlert>
			}

			@if (_problem is { } problem)
			{
				<div class="moka-file-browser__state">
					@if (Problem is not null)
					{
						@Problem(new MokaFileProblem(problem, RetryAsync))
					}
					else
					{
						<MokaCallout Type="MokaCalloutType.Caution" Title="@Text.LoadFailed">
							<ChildContent>@problem.Message</ChildContent>
							<FixAction>
								<MokaButton Variant="MokaVariant.Soft" Size="MokaSize.Sm" OnClick="RetryAsync">@Text.TryAgain</MokaButton>
							</FixAction>
						</MokaCallout>
					}
				</div>
			}
			else if (_loading && _rows.Count == 0)
			{
				<div class="moka-file-browser__loading" role="status">
					<span class="moka-visually-hidden">@Text.Loading</span>
					<MokaSkeleton Lines="6"/>
				</div>
			}
			else if (_visible.Count == 0 && !_creating)
			{
				<div class="moka-file-browser__state">
					@if (Empty is not null)
					{
						@Empty(new MokaFileEmptyContext(FilterNeedle, HiddenCount, Redrawing(ClearFilterAsync), EmptyDefault))
					}
					else
					{
						@EmptyDefault
					}
				</div>
			}
			else
			{
				@if (ShowsColumnHead)
				{
					<div class="moka-file-browser__head">
						<button type="button" class="moka-file-browser__heading moka-file-browser__name-cell"
						        @onclick="() => HeadingClickAsync(MokaFileSort.Name)">
							@Text.SortName
							@SortMark(MokaFileSort.Name)
						</button>
						@for (int i = 0; i < _columns.Count; i++)
						{
							MokaFileColumn<TItem> column = _columns[i];
							@if (ResizableColumns)
							{
								<div class="@HeadingWrapClass(column)" style="@WidthStyle(column, i)">
									<span class="moka-file-browser__column-edge" role="separator" tabindex="0" aria-orientation="vertical"
									      aria-label="@Text.ResizeColumn(ColumnTitle(column))" data-moka-column="@column.Id"
									      data-moka-column-var="@ColumnVariable(i)" data-moka-column-min="@ColumnMinimum"></span>
									@Heading(column, null)
								</div>
							}
							else
							{
								@Heading(column, WidthStyle(column, i))
							}
						}
					</div>
				}
				else if (DrawsLsList)
				{
					<div class="moka-file-browser__term-top" aria-hidden="true">
						<span class="moka-file-browser__term-command"><b>$</b> ls -lh @FolderTitle</span>
						<span>total @TerminalTotal()</span>
					</div>
				}
				@if (_view.Mode == MokaFileViewMode.Columns)
				{
					<div class="@MillerClass">
						@if (ParentFolder is { } parent)
						{
							<div class="moka-file-browser__miller-up moka-thin-scrollbar" aria-hidden="true">@MillerUp(parent)</div>
						}
						@ItemList
						<div class="moka-file-browser__miller-peek moka-thin-scrollbar" role="region" aria-label="@Text.Preview">@MillerPeek</div>
					</div>
				}
				else
				{
					@ItemList
				}
			}
		</div>

		@if (ShowsPreviewPane)
		{
			<aside class="moka-file-browser__preview moka-thin-scrollbar" aria-label="@Text.Preview">@PreviewBody</aside>
		}

		@if (Details is not null)
		{
			<aside class="moka-file-browser__details moka-thin-scrollbar" aria-label="@Text.Details">@Details(SelectedItems)</aside>
		}
	</div>

	<MokaStatusBar Fixed="false" Class="moka-file-browser__status">
		<StartContent>
			@if (FullStatus)
			{
				<MokaStatusBarItem Text="@(IsFiltering ? CountText : FolderFileText())" Priority="1"/>
				@if (FolderBytesText() is { } folderSize)
				{
					<MokaStatusBarItem Text="@folderSize" Class="moka-file-browser__status-number"/>
				}
			}
			else
			{
				<MokaStatusBarItem Text="@CountText" Priority="1"/>
				@if (_selection.Count > 0)
				{
					<MokaStatusBarItem Text="@Text.SelectedCount(_selection.Count)" Priority="1"/>
				}
			}
			@if (_held is { } held)
			{
				<MokaStatusBarItem Text="@Text.HeldCount(held.Rows.Count, held.Cut)"/>
			}
		</StartContent>
		<EndContent>
			@if (FullStatus)
			{
				@FullStatusSelection
			}
			else if (SizeText is { } size)
			{
				<MokaStatusBarItem Text="@size"/>
			}
			@StatusEnd
		</EndContent>
	</MokaStatusBar>

	<span class="moka-visually-hidden" role="status">@AnnouncedText</span>

	@if (Upload is not null)
	{
		@* The layer stays up for a moment after a drag that ends off the page. With an app's file picker a click
		   then mustn't open the browser's dialog. *@
		<div class="moka-file-browser__drop" data-moka-file-drop @onclick:preventDefault="ActivePicker is not null">
			<InputFile @key="_inputKey" class="moka-file-browser__drop-input" multiple tabindex="-1" aria-label="@Text.Upload"
			           OnChange="HandleFilesAsync"/>
			<div class="moka-file-browser__drop-panel" aria-hidden="true">
				<MokaIcon Icon="MokaIcons.Action.Upload" SizeValue="1.5rem"/>
				<span>@Text.DropTitle</span>
			</div>
		</div>
	}
</section>

@if (_pendingDelete is { } pending)
{
	<MokaDialog Open="true" OpenChanged="HandleDeleteDialog" Title="@Text.DeleteTitle(pending.Count)" DialogSize="MokaDialogSize.Small">
		<ChildContent>@Text.DeleteMessage(pending.Select(row => row.Info.Name).ToList())</ChildContent>
		<Actions>
			<MokaButton Variant="MokaVariant.Text" OnClick="() => HandleDeleteDialog(false)">@Text.Cancel</MokaButton>
			<MokaButton Color="MokaColor.Error" OnClick="ConfirmPendingDeleteAsync">@Text.Delete</MokaButton>
		</Actions>
	</MokaDialog>
}

@if (HasSidePane)
{
	<MokaDrawer Open="_sideOpen" OpenChanged="value => _sideOpen = value" Title="@SideLabel" Position="MokaDrawerPosition.Left">
		@if (_sideOpen)
		{
			@SideContent
		}
	</MokaDrawer>
}

@if (ShowsPreviewControl)
{
	<MokaDrawer Open="_previewDrawerOpen" OpenChanged="value => _previewDrawerOpen = value" Title="@Text.Preview" Position="MokaDrawerPosition.Right">
		@if (_previewDrawerOpen)
		{
			@PreviewBody
		}
	</MokaDrawer>
}

@if (Details is not null)
{
	<MokaDrawer Open="_detailsOpen" OpenChanged="value => _detailsOpen = value" Title="@Text.Details" Position="MokaDrawerPosition.Right">
		@if (_detailsOpen)
		{
			@Details(SelectedItems)
		}
	</MokaDrawer>
}

@if (!UsesSharedMenu)
{
	<MokaContextMenu Items="_menuItems" Visible="_menuOpen" X="_menuX" Y="_menuY" OpenedFromKeyboard="_menuFromKeyboard" OnClose="CloseMenu"/>
}

@code {

	private static readonly RenderFragment NoControl = _ => { };

	private RenderFragment BuiltIn(MokaFileControls which, bool enabled, Func<Task>? run, RenderFragment builtIn)
	{
		if (!HasControl(which))
		{
			return NoControl;
		}

		return ToolbarControl is null
			? builtIn
			: ToolbarControl(new MokaFileControlContext(which, enabled, run is null ? null : Redrawing(run), builtIn));
	}

	private RenderFragment ToolButton(MokaIconDefinition icon, string label, bool enabled, Func<Task> run,
		MokaTooltipPosition position = MokaTooltipPosition.Bottom) =>
		@<MokaTooltip Text="@label" Position="position">
			<MokaButton Quiet StartIcon="icon" aria-label="@label" Disabled="!enabled" OnClick="run"/>
		</MokaTooltip>;

	private RenderFragment Breadcrumb => PathField ? PathWell : Crumbline;

	private RenderFragment Crumbline => @<div class="moka-file-browser__crumbs moka-hide-scrollbar">
		<MokaBreadcrumb>
			@for (int i = 0; i < Crumbs.Count; i++)
			{
				MokaFileCrumb crumb = Crumbs[i];
				if (i == Crumbs.Count - 1)
				{
					<MokaBreadcrumbItem Text="@crumb.Title"/>
				}
				else
				{
					<MokaBreadcrumbItem Text="@crumb.Title">
						<button type="button" class="moka-file-browser__crumb" data-moka-file-target="@crumb.FolderKey"
						        @onclick="() => GoToAsync(crumb.FolderKey)">@crumb.Title</button>
					</MokaBreadcrumbItem>
				}
			}
		</MokaBreadcrumb>
	</div>;

	private RenderFragment FilterBox => @<MokaSearchInput Value="@_filter" OnSearch="ApplyFilterAsync" Debounce="FilterDelay" Size="MokaSize.Sm"
	                                                       Placeholder="@Text.FilterPlaceholder" Label="@Text.FilterLabel" HideLabel
	                                                       data-moka-file-filter="" spellcheck="false" autocomplete="off"/>;

	private RenderFragment NewFolderButton => IconOnlyActions
		? ToolButton(MokaIcons.File.FolderPlus, Text.NewFolder, true, BeginCreateFolderAsync, MokaTooltipPosition.BottomStart)
		: @<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokaIcons.File.FolderPlus"
		               OnClick="BeginCreateFolder">@Text.NewFolder</MokaButton>;

	private RenderFragment UploadButton => IconOnlyActions
		? ToolButton(MokaIcons.Action.Upload, Text.Upload, true, PickFilesAsync)
		: @<MokaButton Size="MokaSize.Sm" StartIcon="MokaIcons.Action.Upload" OnClick="PickFilesAsync">@Text.Upload</MokaButton>;

	private RenderFragment SortChoice => @<text>
		<MokaSegmentedControl Size="MokaSize.Sm" AriaLabel="@Text.SortLabel" Value="@_view.SortBy" ValueChanged="SortByAsync">
			<MokaSegment Value="@MokaFileSort.Name" Text="@Text.SortName"/>
			@if (Shows(MokaFileSort.Modified))
			{
				<MokaSegment Value="@MokaFileSort.Modified" Text="@Text.SortModified"/>
			}
			@if (Shows(MokaFileSort.Size))
			{
				<MokaSegment Value="@MokaFileSort.Size" Text="@Text.SortSize"/>
			}
		</MokaSegmentedControl>
		@ToolButton(_view.Descending ? MokaIcons.Navigation.ArrowDown : MokaIcons.Navigation.ArrowUp,
			_view.Descending ? Text.SortDescending : Text.SortAscending, true, ReverseSortAsync)
	</text>;

	private RenderFragment ViewButtons => @<span class="moka-file-browser__modes">
		@for (int i = 0; i < OfferedViews.Count; i++)
		{
			MokaFileViewMode mode = OfferedViews[i];
			<MokaTooltip Text="@ViewLabel(mode)" Position="@(i == OfferedViews.Count - 1 ? MokaTooltipPosition.BottomEnd : MokaTooltipPosition.Bottom)">
				<MokaButton Quiet StartIcon="ViewIcon(mode)" aria-label="@ViewLabel(mode)" Class="@ModeClass(mode)"
				            aria-pressed="@(_view.Mode == mode ? "true" : "false")"
				            OnClick="() => SetModeAsync(mode)"/>
			</MokaTooltip>
		}
	</span>;

	private RenderFragment GroupByChoice => @<MokaSegmentedControl Size="MokaSize.Sm" AriaLabel="@Text.GroupByLabel" Value="@GroupByValue" ValueChanged="SetGroupByAsync">
		<MokaSegment Value="kind" Text="@Text.GroupKind"/>
		<MokaSegment Value="date" Text="@Text.GroupDate"/>
	</MokaSegmentedControl>;

	private RenderFragment PreviewButton => @<span class="moka-file-browser__preview-control">
		<span class="moka-file-browser__preview-toggle">
			<MokaTooltip Text="@Text.Preview" Position="MokaTooltipPosition.BottomEnd">
				<MokaButton Quiet StartIcon="MokaIcons.Navigation.PanelRight" aria-label="@Text.Preview" Class="@PreviewToggleClass"
				            aria-pressed="@(_previewOpen ? "true" : "false")" OnClick="TogglePreviewAsync"/>
			</MokaTooltip>
		</span>
		<span class="moka-file-browser__preview-open">
			@ToolButton(MokaIcons.Navigation.PanelRight, Text.Preview, true, OpenPreviewDrawer, MokaTooltipPosition.BottomEnd)
		</span>
	</span>;

	private RenderFragment EmptyDefault => @<text>
		@if (IsFiltering)
		{
			<MokaEmptyState Icon="MokaIcons.Content.Filter" Title="@Text.NoMatchesTitle" Description="@Text.NoMatches(_filter)" Live>
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" OnClick="ClearFilterAsync">@Text.ClearFilter</MokaButton>
			</MokaEmptyState>
		}
		else
		{
			<MokaEmptyState Icon="MokaIcons.File.FolderOpen" Title="@Text.EmptyTitle"
			                Description="@(Upload is null ? null : Text.EmptyHint)" Live/>
		}
	</text>;

	private RenderFragment SortMark(string id) => @<text>
		@if (string.Equals(_view.SortBy, id, StringComparison.Ordinal))
		{
			<MokaIcon Icon="@(_view.Descending ? MokaIcons.Navigation.ArrowDown : MokaIcons.Navigation.ArrowUp)" SizeValue="0.9em"/>
			<span class="moka-visually-hidden">@(_view.Descending ? Text.SortDescending : Text.SortAscending)</span>
		}
	</text>;

	private RenderFragment Heading(MokaFileColumn<TItem> column, string? style) => IsSortable(column)
		? @<button type="button" class="@HeadingClass(column)" style="@style" @onclick="() => HeadingClickAsync(column.Id)">
			@ColumnTitle(column)
			@SortMark(column.Id)
		</button>
		: @<span class="@HeadingClass(column)" style="@style">@ColumnTitle(column)</span>;

	private RenderFragment Option(MokaFileRow<TItem> row, string baseClass, RenderFragment content) =>
		@<div @key="row.Key" class="@ItemClass(row, baseClass)" id="@OptionId(row.Index)" role="option"
		      aria-selected="@(_selection.Contains(row.Key) ? "true" : "false")"
		      aria-setsize="@_visible.Count" aria-posinset="@(row.Index + 1)"
		      data-moka-key="@row.Key" data-moka-line="@LineAttribute(row)"
		      data-moka-file-target="@(row.Info.IsFolder ? row.Key : null)"
		      draggable="@((Move is null && DragText is null) || IsEditing(row) ? null : "true")"
		      data-moka-drag-text="@DragText?.Invoke(row.Item)"
		      data-moka-drag-only="@(Move is null && DragText is not null ? "" : null)"
		      @onclick="args => HandleItemClick(row, args)"
		      @onclick:stopPropagation="true"
		      @ondblclick="() => HandleItemDoubleClickAsync(row)"
		      @oncontextmenu="args => HandleItemMenu(row, args)"
		      @oncontextmenu:preventDefault="true"
		      @oncontextmenu:stopPropagation="true">
			@content
		</div>;

	private RenderFragment ItemList => @<div class="@ListClass" style="@ListStyle" role="listbox" tabindex="0"
	                                         aria-label="@Text.ItemsLabel" aria-multiselectable="true" aria-activedescendant="@ActiveOptionId"
	                                         data-moka-list @onclick="HandleListClick">
		@if (_creating)
		{
			<div class="moka-file-browser__new-row">
				<MokaIcon Icon="MokaIcons.File.Folder" Color="MokaColor.Warning" SizeValue="1.15em"/>
				<MokaInlineEdit Value="@_newFolderName" Editing Trigger="MokaInlineEditTrigger.Manual" SaveUnchanged
				                Label="@Text.NewFolderLabel" BlankText="@Text.NameRequired" Validate="ValidateName"
				                Save="SaveNewFolderAsync" EditingChanged="NewFolderClosedAsync"/>
			</div>
		}
		@if (IsGrouped)
		{
			@GroupedBlocks
		}
		else if (!IsGridView)
		{
			@if (_visible.Count >= VirtualizeFrom)
			{
				<Virtualize Items="_visible" ItemContent="RowFor" ItemSize="RowEstimate" OverscanCount="Overscan"/>
			}
			else
			{
				@ListRows
			}
		}
		else if (_lines.Count >= VirtualizeFrom)
		{
			<Virtualize Items="_lines" ItemContent="GridLine" ItemSize="LineEstimate" OverscanCount="Overscan"/>
		}
		else
		{
			@TileRows
		}
		@if (BoxSelect)
		{
			<div class="moka-box-select" data-moka-box aria-hidden="true" hidden></div>
		}
	</div>;

	private RenderFragment ListRow(MokaFileRow<TItem> row) => Option(row, "moka-file-browser__row",
		@<text>
			<span class="moka-file-browser__name-cell">
				@ItemIcon(row, "1.15em")
				@if (NameCell is not null && !IsEditing(row))
				{
					@NameCell(new MokaFileNameContext<TItem>(row.Item, NameOf(row)))
				}
				else
				{
					@NameOf(row)
				}
				@Tag(row)
			</span>
			@for (int i = 0; i < _columns.Count; i++)
			{
				MokaFileColumn<TItem> column = _columns[i];
				<span class="@RowCellClass(column, row)" style="@CellStyle(column, i, row)">@CellContent(column, row)</span>
			}
		</text>);

	// The row a line of the list draws in the view showing. Virtualize takes it as a method group, so the rows it draws
	// share one builder and their keys meet.
	private RenderFragment RowFor(MokaFileRow<TItem> row) =>
		_view.Mode == MokaFileViewMode.Columns ? MillerRow(row) : DrawsLsList ? TermRow(row) : ListRow(row);

	// Each item is written straight into one builder, because @key only compares siblings in one region and every
	// @Fragment(item) in markup gets a region of its own (the reason Virtualize takes the method directly, too).
	private RenderFragment ListRows => builder =>
	{
		foreach (MokaFileRow<TItem> row in _visible)
		{
			RowFor(row)(builder);
		}
	};

	private RenderFragment TileRows => builder =>
	{
		foreach (FileLine line in _lines)
		{
			GridLine(line)(builder);
		}
	};

	private RenderFragment GridLine(FileLine line) => _view.Mode == MokaFileViewMode.Tiles && !IsTerminal
		? @<div @key="TileLineKey(line.Rows)" class="moka-file-browser__tile-row" data-moka-line="@(LineNumber(line) ?? "")">
			@Cells(line)
		</div>
		: @<div @key="TileLineKey(line.Rows)" class="@GridLineClass(line)" data-moka-line="@LineNumber(line)">
			@Cells(line)
		</div>;

	private RenderFragment Cells(FileLine line) => builder =>
	{
		foreach (MokaFileRow<TItem> row in line.Rows)
		{
			Cell(row)(builder);
		}
	};

	private RenderFragment Cell(MokaFileRow<TItem> row) => _view.Mode switch
	{
		MokaFileViewMode.Compact => Option(row, "moka-file-browser__compact", CompactContent(row)),
		MokaFileViewMode.Cards => Option(row, "moka-file-browser__card", CardContent(row)),
		MokaFileViewMode.Gallery when row.Info.IsFolder => Option(row, "moka-file-browser__chip", ChipContent(row)),
		MokaFileViewMode.Gallery => Option(row, "moka-file-browser__shot", ShotContent(row)),
		_ when IsTerminal => Option(row, "moka-file-browser__ls", LsContent(row)),
		_ => Option(row, "moka-file-browser__tile", TileContent(row))
	};

	private RenderFragment GroupedBlocks => builder =>
	{
		foreach (FileGroup group in _groups)
		{
			GroupBlock(group)(builder);
		}
	};

	private RenderFragment GroupBlock(FileGroup group) =>
		@<div @key="group.Id" class="moka-file-browser__group" role="group" aria-labelledby="@GroupHeadId(group)">
			<button type="button" class="moka-file-browser__group-head" id="@GroupHeadId(group)" aria-expanded="@(group.Folded ? "false" : "true")"
			        @onclick="() => ToggleGroupAsync(group)" @onclick:stopPropagation="true">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="0.95em" Class="moka-file-browser__group-chevron"/>
				<span class="moka-file-browser__group-name">@group.Title</span>
				<span class="moka-file-browser__group-count">@group.Count</span>
				@if (group.HasBytes)
				{
					<span class="moka-file-browser__group-size">@BytesText(group.Bytes)</span>
				}
			</button>
			@if (IsGridView)
			{
				@GroupLines(group)
			}
			else
			{
				@GroupRows(group)
			}
		</div>;

	private RenderFragment GroupLines(FileGroup group) => builder =>
	{
		foreach (FileLine line in group.Lines)
		{
			GridLine(line)(builder);
		}
	};

	private RenderFragment GroupRows(FileGroup group) => builder =>
	{
		foreach (MokaFileRow<TItem> row in group.Rows)
		{
			RowFor(row)(builder);
		}
	};

	private RenderFragment TileContent(MokaFileRow<TItem> row) => @<text>
		@ItemIcon(row, "1.75rem")
		@NameOf(row)
		@if (SizeOf(row) is { } size)
		{
			@if (TagOf(row) is not null)
			{
				<span class="moka-file-browser__tile-meta">@Tag(row)@size</span>
			}
			else
			{
				<span class="moka-file-browser__tile-meta">@size</span>
			}
		}
		@SizeBar(row)
	</text>;

	private RenderFragment CompactContent(MokaFileRow<TItem> row) => @<text>
		@ItemIcon(row, "1.05em")
		@NameOf(row)
		@Tag(row)
	</text>;

	private RenderFragment CardContent(MokaFileRow<TItem> row) => @<text>
		<span class="moka-file-browser__card-icon">@ItemIcon(row, "1.1rem")</span>
		<span class="moka-file-browser__card-top">
			@NameOf(row)
			@if (row.Info.Modified is { } modified)
			{
				<span class="moka-file-browser__card-date">
					<MokaRelativeTime Value="modified" Live="false" ShowTooltip="false" AbsoluteAfter="AbsoluteDatesAfter"/>
				</span>
			}
		</span>
		<span class="moka-file-browser__card-detail">@CardDetail(row)</span>
		@SizeBar(row)
	</text>;

	private RenderFragment ChipContent(MokaFileRow<TItem> row) => @<text>
		@ItemIcon(row, "1.05em")
		@NameOf(row)
		@if (ItemCountOf(row.Key) is { } count)
		{
			<span class="moka-file-browser__chip-count">@count</span>
		}
	</text>;

	private RenderFragment ShotContent(MokaFileRow<TItem> row) => @<text>
		<span class="moka-file-browser__thumb">
			@if (ThumbnailOf(row) is { } source)
			{
				<img src="@source" alt="" loading="lazy" decoding="async"/>
			}
			else
			{
				@ItemIcon(row, "1.9rem")
				@if (TypeOf(row).Tag is { } tag)
				{
					<span class="moka-file-browser__thumb-tag">@tag</span>
				}
			}
		</span>
		@NameOf(row)
		@if (SizeOf(row) is { } size)
		{
			<span class="moka-file-browser__shot-meta">@size</span>
		}
		@SizeBar(row)
	</text>;

	private RenderFragment LsContent(MokaFileRow<TItem> row) => @<text>
		@NameOf(row)
		@if (row.Info.IsFolder)
		{
			<span class="moka-file-browser__term-slash">/</span>
		}
	</text>;

	private RenderFragment TermRow(MokaFileRow<TItem> row) => Option(row, "moka-file-browser__term-row",
		@<text>
			<span class="moka-file-browser__term-caret" aria-hidden="true">&rsaquo;</span>
			@foreach (MokaFileColumn<TItem> column in _columns)
			{
				@if (!IsBuiltIn(column))
				{
					<span class="moka-file-browser__term-cell">@CellContent(column, row)</span>
				}
			}
			@if (ShowsBuiltIn(MokaFileSort.Size))
			{
				<span class="@TermSizeClass(row)" style="@SizeBarStyle(row)">@TerminalSize(row)</span>
			}
			@if (ShowsBuiltIn(MokaFileSort.Modified))
			{
				<span class="moka-file-browser__term-date">@TerminalDate(row.Info.Modified)</span>
			}
			<span class="@(row.Info.IsFolder ? "moka-file-browser__term-name moka-file-browser__term-name--folder" : "moka-file-browser__term-name")">
				@NameOf(row)
				@if (row.Info.IsFolder)
				{
					<span class="moka-file-browser__term-slash">/</span>
				}
			</span>
		</text>);

	private RenderFragment MillerRow(MokaFileRow<TItem> row) => Option(row, "moka-file-browser__mrow",
		@<text>
			@ItemIcon(row, "1.05em")
			@NameOf(row)
			@Tag(row)
			@if (row.Info.IsFolder)
			{
				<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="0.9em" Class="moka-file-browser__mrow-go"/>
			}
		</text>);

	private RenderFragment MillerUp(string parent) => @<text>
		@if (ListingOf(parent) is { } listing)
		{
			@foreach (MokaFileInfo info in PeekRows(listing))
			{
				<div @key="info.Key" class="@UpRowClass(info)" data-moka-file-target="@(info.IsFolder ? info.Key : null)" @onclick="UpRowClick(info)">
					<MokaIcon Icon="@InfoIcon(info)" Color="@InfoColor(info)" SizeValue="1.05em"/>
					<span class="moka-file-browser__up-name">@info.Name</span>
					@if (info.IsFolder)
					{
						<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="0.9em" Class="moka-file-browser__mrow-go"/>
					}
				</div>
			}
		}
		else
		{
			<MokaSkeleton Lines="4"/>
		}
	</text>;

	private RenderFragment MillerPeek => @<text>
		@if (_selectedRows.Count == 1 && _selectedRows[0].Info.IsFolder)
		{
			string folder = _selectedRows[0].Key;
			@if (ListingOf(folder) is { } listing)
			{
				@if (listing.Count == 0)
				{
					<p class="moka-file-browser__peek-note">@Text.EmptyTitle</p>
				}
				@foreach (MokaFileInfo info in PeekRows(listing))
				{
					<div @key="info.Key" class="moka-file-browser__peek-row">
						<MokaIcon Icon="@InfoIcon(info)" Color="@InfoColor(info)" SizeValue="1.05em"/>
						<span class="moka-file-browser__up-name">@info.Name</span>
					</div>
				}
				@if (listing.Count > MostPeekRows)
				{
					<p class="moka-file-browser__peek-note">@Text.MoreItems(listing.Count - MostPeekRows)</p>
				}
			}
			else
			{
				<MokaSkeleton Lines="4"/>
			}
		}
		else if (_selectedRows.Count == 0)
		{
			<p class="moka-file-browser__peek-note">@Text.NothingSelected</p>
		}
		else
		{
			@PreviewBody
		}
	</text>;

	private RenderFragment PreviewBody => @<text>
		@if (_selectedRows.Count == 1)
		{
			MokaFileRow<TItem> only = _selectedRows[0];
			@if (Preview is not null)
			{
				@Preview(only.Item)
			}
			else
			{
				@DefaultPreview(only)
			}
		}
		else if (_selectedRows.Count > 1)
		{
			<div class="moka-file-browser__peek">
				<div class="moka-file-browser__peek-art">
					<MokaIcon Icon="MokaIcons.File.Files" SizeValue="2.25rem"/>
				</div>
				<div class="moka-file-browser__peek-title">
					<span class="moka-file-browser__peek-name">@Text.SelectedCount(_selectedRows.Count)</span>
					<span class="moka-file-browser__peek-kind">@SelectionTotalText()</span>
				</div>
			</div>
		}
		else
		{
			<div class="moka-file-browser__peek">
				<div class="moka-file-browser__peek-art">
					<MokaIcon Icon="MokaIcons.File.FolderOpen" Color="MokaColor.Warning" SizeValue="2.25rem"/>
				</div>
				<div class="moka-file-browser__peek-title">
					<span class="moka-file-browser__peek-name">@FolderTitle</span>
					<span class="moka-file-browser__peek-kind">@FolderSummaryText()</span>
				</div>
			</div>
		}
	</text>;

	private RenderFragment DefaultPreview(MokaFileRow<TItem> row) => @<div class="moka-file-browser__peek">
		<div class="moka-file-browser__peek-art">
			@if (ThumbnailOf(row) is { } source)
			{
				<img src="@source" alt="" decoding="async"/>
			}
			else
			{
				@ItemIcon(row, "2.25rem")
			}
		</div>
		<div class="moka-file-browser__peek-title">
			<span class="moka-file-browser__peek-name" title="@row.Info.Name">@row.Info.Name</span>
			<span class="moka-file-browser__peek-kind">@Text.TypeName(TypeOf(row))</span>
		</div>
		<dl class="moka-file-browser__peek-facts">
			@if (row.Info.IsFolder && ItemCountOf(row.Key) is { } count)
			{
				<dt>@Text.PreviewItems</dt>
				<dd>@count</dd>
			}
			@if (SizeOf(row) is { } size)
			{
				<dt>@Text.PreviewSize</dt>
				<dd>@size</dd>
			}
			@if (row.Info.Modified is { } modified)
			{
				<dt>@Text.PreviewModified</dt>
				<dd><MokaRelativeTime Value="modified" Live="false" ShowTooltip="false" AbsoluteAfter="TimeSpan.Zero" Format="g"/></dd>
			}
		</dl>
	</div>;

	private RenderFragment SideContent => FolderTree ? TreeSide : Side!;

	private RenderFragment TreeSide => @<text>
		<MokaTree Selectable Class="moka-file-browser__tree" aria-label="@Text.FolderTree">
			@TreeNodes(_roots)
		</MokaTree>
		@if (Side is not null)
		{
			<div class="moka-file-browser__side-more">@Side</div>
		}
	</text>;

	private RenderFragment TreeNodes(IReadOnlyList<string> folders) => builder =>
	{
		foreach (string folder in folders)
		{
			TreeNode(folder)(builder);
		}
	};

	private RenderFragment TreeNode(string folder) =>
		@<MokaTreeItem @key="folder" Text="@TitleOf(folder)" Icon="MokaIcons.File.Folder" IconColor="var(--moka-color-warning)"
		               HasChildren="@TreeHasChildren(folder)" Expanded="@_treeOpen.Contains(folder)" ExpandedChanged="open => SetTreeOpen(folder, open)"
		               Selected="@TreeSelected(folder)" SelectedChanged="selected => TreePickedAsync(folder, selected)"
		               data-moka-file-target="@folder">
			@if (_treeOpen.Contains(folder))
			{
				@TreeNodes(TreeChildren(folder))
			}
		</MokaTreeItem>;

	private RenderFragment PathWell => _pathOpen
		? @<div class="moka-file-browser__path-field" data-moka-path-area @ref="_pathAnchor">
			<input class="moka-file-browser__path-input" @bind:get="_pathText" @bind:set="TypePath" @bind:event="oninput" data-moka-file-path
			       role="combobox" aria-label="@Text.PathLabel" aria-expanded="true" aria-controls="@PathListId" aria-autocomplete="list"
			       aria-activedescendant="@PathHighlightId" aria-invalid="@(_pathMissing ? "true" : null)" spellcheck="false" autocomplete="off"/>
			@PathSuggestionList
		</div>
		: @<div class="moka-file-browser__path-well">
			@Crumbline
			<MokaTooltip Text="@Text.EditPath" Position="MokaTooltipPosition.Bottom" Class="moka-file-browser__path-edit-tip">
				<button type="button" class="moka-file-browser__path-edit" aria-label="@Text.EditPath" data-moka-path-edit @onclick="OpenPath">
					<MokaIcon Icon="MokaIcons.Action.Pencil" SizeValue="0.9em"/>
				</button>
			</MokaTooltip>
		</div>;

	private RenderFragment PathSuggestionList => @<ul id="@PathListId" class="moka-file-browser__path-suggest" role="listbox" aria-label="@Text.PathSuggestions"
	                                                popover="manual" data-moka-popup @ref="_pathPanel">
		@{
			ParsedPath parsed = ParsePath(_pathText);
			IReadOnlyList<PathSuggestion> suggestions = Suggestions(parsed);
		}
		@for (int i = 0; i < suggestions.Count; i++)
		{
			PathSuggestion suggestion = suggestions[i];
			<li id="@PathOptionId(i)" role="option" aria-selected="@(i == _pathHighlight ? "true" : "false")"
			    class="@(i == _pathHighlight ? "moka-file-browser__path-option moka-file-browser__path-option--on" : "moka-file-browser__path-option")"
			    data-moka-path-suggestion @onclick="() => FillPath(suggestion)">
				<MokaIcon Icon="MokaIcons.File.Folder" Color="MokaColor.Warning" SizeValue="1em"/>
				<span class="moka-file-browser__path-words">
					@if (suggestion.Parent is not null)
					{
						<span>@(suggestion.Parent)/</span>
					}
					<b>@(suggestion.Name)/</b>
				</span>
			</li>
		}
		@if (suggestions.Count == 0 && PathNoneText(parsed) is { } none)
		{
			<li class="moka-file-browser__path-none" role="presentation">@none</li>
		}
	</ul>;

	private RenderFragment FullStatusSelection => @<text>
		@if (_selectedRows.Count == 0)
		{
			<MokaStatusBarItem Text="@Text.NothingSelected" Class="moka-file-browser__status-dim"/>
		}
		else if (_selectedRows.Count == 1 && _selectedRows[0].Info.IsFolder)
		{
			<MokaStatusBarItem Text="@_selectedRows[0].Info.Name" Priority="1" Class="moka-file-browser__status-strong"/>
			@if (ItemCountOf(_selectedRows[0].Key) is { } count)
			{
				<MokaStatusBarItem Text="@Text.ItemCount(count)"/>
			}
		}
		else
		{
			<MokaStatusBarItem Text="@(_selectedRows.Count == 1 ? _selectedRows[0].Info.Name : Text.SelectedCount(_selectedRows.Count))" Priority="1"
			                   Class="moka-file-browser__status-strong"/>
			@if (SelectedBytesText() is { } bytes)
			{
				<MokaStatusBarItem Text="@bytes" Class="moka-file-browser__status-number"/>
			}
			@if (SelectionShare() is { } share)
			{
				<MokaStatusBarItem Class="moka-file-browser__status-share">
					<span class="moka-file-browser__meter" aria-hidden="true"><span class="moka-file-browser__meter-fill" style="@MeterStyle(share.Width)"></span></span>
					<span class="moka-file-browser__share-text">@Text.FolderShare(share.Percent)</span>
				</MokaStatusBarItem>
			}
		}
	</text>;

	private RenderFragment ItemIcon(MokaFileRow<TItem> row, string size) =>
		@<MokaIcon Icon="@IconFor(row)" Color="@ColorFor(row)" SizeValue="@size"/>;

	private RenderFragment Tag(MokaFileRow<TItem> row) => @<text>
		@if (TagOf(row) is { } tag)
		{
			<span class="@TagClass(TypeOf(row))">@tag</span>
		}
	</text>;

	private RenderFragment SizeBar(MokaFileRow<TItem> row) => @<text>
		@if (SizeBarStyle(row) is { } style)
		{
			<span class="moka-file-browser__size-bar" style="@style" aria-hidden="true"></span>
		}
	</text>;

	private RenderFragment NameOf(MokaFileRow<TItem> row) => IsEditing(row)
		? @<MokaInlineEdit @key="row.Key" Value="@row.Info.Name" Editing Trigger="MokaInlineEditTrigger.Manual"
		                   Label="@Text.RenameLabel" BlankText="@Text.NameRequired" Validate="ValidateName"
		                   Selection="@(row.Info.IsFolder ? MokaInlineEditSelection.All : MokaInlineEditSelection.Stem)"
		                   Save="name => SaveRenameAsync(row, name)" EditingChanged="RenameClosedAsync"/>
		: @<span class="moka-file-browser__name" title="@row.Info.Name">@row.Info.Name</span>;

	private RenderFragment CellContent(MokaFileColumn<TItem> column, MokaFileRow<TItem> row) => @<text>
		@if (column.Cell is not null)
		{
			@column.Cell(row.Item)
		}
		else if (column.Text is not null)
		{
			@column.Text(row.Item)
		}
		else if (column.Id == MokaFileSort.Size)
		{
			@SizeOf(row)
		}
		else if (column.Id == MokaFileSort.Modified && row.Info.Modified is { } modified)
		{
			<MokaRelativeTime Value="modified" Live="false" ShowTooltip="false" AbsoluteAfter="AbsoluteDatesAfter"/>
		}
	</text>;

}
