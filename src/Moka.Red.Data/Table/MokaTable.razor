@namespace Moka.Red.Data.Table
@inherits MokaVisualComponentBase
@typeparam TItem

@* Row markup lives in one template so the plain and virtualized body paths cannot drift apart. *@
@{
	// One list per render, so the header, the filter row and every body row agree on the columns
	// and their positions.
	var columns = VisibleColumnsInOrder();

	// The drop marker under the pointer comes from moka-table.js, which also allows the drop. The
	// row and cell handlers are attached only when something listens: every event that reaches a
	// handler goes to .NET and renders the whole table again.
	RenderFragment<MokaTableRow<TItem>> rowTemplate = row =>
		@<tr class="@RowCssClass(row)" style="@RowStyle?.Invoke(row.Item)"
		     data-row-index="@(row.Index.ToString(CultureInfo.InvariantCulture))"
		     @key="row.Key"
		     @onclick="RowClickHandler(row.Item)"
		     @oncontextmenu:preventDefault="OnRowContextMenu.HasDelegate"
		     @oncontextmenu="RowContextMenuHandler(row.Item)"
		     @ondrop="RowDropHandler(row)">
			@if (Expandable)
			{
				<td class="moka-table-cell--expand">
					<button class="@ExpandButtonClass(row.Item)" type="button" aria-label="Toggle detail"
					        @onclick="() => ToggleExpand(row.Item)" @onclick:stopPropagation="true">
						<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="12px"/>
					</button>
				</td>
			}
			@if (Selectable)
			{
				<td class="moka-table-cell--checkbox">
					<input type="checkbox" checked="@_selectedItems.Contains(row.Item)"
					       @onclick:stopPropagation="true"
					       @onchange="() => HandleRowSelect(row.Item)"/>
				</td>
			}
			@if (RowReorderable)
			{
				<td class="@ReorderCellClass" draggable="@RowDraggable" title="@ReorderCellTitle"
				    @onclick:stopPropagation="true"
				    @ondragstart="() => HandleRowDragStart(row)"
				    @ondragend="HandleRowDragEnd">
					<MokaIcon Icon="MokaIcons.Action.GripVertical" SizeValue="14" Class="moka-table-drag-grip"/>
				</td>
			}
			@foreach (var (col, colIdx) in columns)
			{
				<td class="@DataCellClass(col)" style="@DataCellStyle(col)"
				    data-col-index="@(colIdx.ToString(CultureInfo.InvariantCulture))"
				    data-activates-row="@(ActivatesRow(col) ? "true" : null)"
				    tabindex="@CellTabIndex(row.Index, colIdx)"
				    @onfocusin="() => HandleCellFocus(row.Index, colIdx)"
				    @onkeydown="e => HandleCellKeyDown(e, row.Index, colIdx, row.Item, col)"
				    @ondblclick="CellDoubleClickHandler(row.Item, col)">
					@if (IsEditing(row.Item, col))
					{
						<input type="text" class="moka-table-edit-input" value="@_editValue"
						       @oninput="HandleEditInput"
						       @onblur="() => CommitEdit(row.Item, col)"
						       @onkeydown="e => HandleEditKeyDown(row.Item, col, e)"
						       @onkeydown:stopPropagation="true"
						       @onclick:stopPropagation="true"
						       @ondblclick:stopPropagation="true"/>
					}
					else if (col.CellTemplate is not null)
					{
						@* The cell's key handler would also get the keys of controls in the template:
						   arrows typed in an input moved to another cell, Enter on a button started an
						   edit and Space selected the row. The keys stop here and stay with the control. *@
						<div class="moka-table-cell-template" @onkeydown:stopPropagation="true">
							@col.CellTemplate(row.Item)
						</div>
					}
					else
					{
						@GetCellValue(col, row.Item)
					}
				</td>
			}
			@if (RowActions is not null)
			{
				<td class="moka-table-cell--actions" @onclick:stopPropagation="true">
					<div class="moka-table-row-actions">
						@RowActions(row.Item)
					</div>
				</td>
			}
		</tr>;

	RenderFragment<MokaTableRow<TItem>> detailTemplate = row =>
		@<tr class="moka-table-detail-row" @key="DetailRowKey(row)">
			<td colspan="@ColSpan">
				@if (DetailTemplate is not null)
				{
					@DetailTemplate(row.Item)
				}
			</td>
		</tr>;

	// Writes a row, and its detail row when open, straight into the builder it is given. Calling a
	// template as @rowTemplate(row) would wrap each row in its own render-tree region, and @key only
	// compares siblings inside one region, so a row that changed position would be rebuilt instead
	// of moved.
	RenderFragment<MokaTableRow<TItem>> rowGroup = row => builder =>
	{
		rowTemplate(row)(builder);
		if (Expandable && IsExpanded(row.Item))
		{
			detailTemplate(row)(builder);
		}
	};

	RenderFragment bodyRows = builder =>
	{
		foreach (var row in _displayRows)
		{
			rowGroup(row)(builder);
		}
	};
}

<CascadingValue Value="this" IsFixed="true">
	@* Hidden - column definitions are captured via CascadingParameter *@
	<div style="display:none">@ChildContent</div>
</CascadingValue>

<div class="@CssClass" style="@CssStyle" id="@Id" @ref="_wrapperRef" @attributes="AdditionalAttributes">
@* Selection action bar - replaces toolbar when items are selected *@
@if (_selectedItems.Count > 0 && SelectionActions is not null)
{
	<div class="moka-table-selection-bar">
		<span class="moka-table-selection-count">@_selectedItems.Count selected</span>
		<div class="moka-table-selection-actions">
			@SelectionActions(SelectionCopy)
		</div>
		<button type="button" class="moka-table-selection-clear" @onclick="ClearSelection">Clear</button>
	</div>
}
else if (ShowToolbar && (Title is not null || Searchable || ToolbarContent is not null || Exportable || ShowColumnToggle || ShowRefresh || ShowDensityToggle))
{
	@* Toolbar *@
	<div class="moka-table-toolbar">
		@if (Title is not null)
		{
			<span class="moka-table-title">@Title</span>
		}
		<div class="moka-table-toolbar-spacer"></div>
		@if (Searchable)
		{
			<div class="moka-table-search">
				<input type="text" class="@SearchInputClass"
				       placeholder="@SearchPlaceholder"
				       value="@_searchTerm"
				       @oninput="HandleSearchInput"/>
				@if (!string.IsNullOrEmpty(_searchTerm))
				{
					<button class="moka-table-search-clear" @onclick="ClearSearch" type="button" aria-label="Clear search">
						<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
					</button>
				}
			</div>
			@if (!string.IsNullOrEmpty(_searchTerm))
			{
				<span class="moka-table-search-count">@_totalItems results</span>
			}
		}
		@if (ShowColumnToggle)
		{
			<div class="moka-table-column-toggle">
				<button type="button" class="moka-table-column-toggle-btn" @onclick="() => _showColumnMenu = !_showColumnMenu" title="Toggle columns">
					<MokaIcon Icon="MokaIcons.Content.Columns" SizeValue="14px"/>
				</button>
				@if (_showColumnMenu)
				{
					<div class="moka-table-column-menu">
						@foreach (var col in _columns)
						{
							<label class="moka-table-column-menu-item" @key="col">
								<input type="checkbox" checked="@IsColumnVisible(col)" @onchange="() => ToggleColumnVisibilityAsync(col)"/>
								@(col.Title ?? "Unnamed")
							</label>
						}
					</div>
				}
			</div>
		}
		@if (Exportable)
		{
			<button type="button" class="moka-table-toolbar-btn" @onclick="HandleExport" title="Export">
				<MokaIcon Icon="MokaIcons.Action.Download" SizeValue="14px"/>
			</button>
		}
		@if (ShowRefresh)
		{
			<button type="button" class="moka-table-toolbar-btn" @onclick="HandleRefresh" title="Refresh">
				<MokaIcon Icon="MokaIcons.Action.Refresh" SizeValue="14px"/>
			</button>
		}
		@if (ShowDensityToggle)
		{
			<button type="button" class="moka-table-toolbar-btn" @onclick="ToggleDensity" title="@(_dense ? "Comfortable" : "Dense")">
				<MokaIcon Icon="@(_dense ? MokaIcons.Content.RowsComfortable : MokaIcons.Content.RowsDense)" SizeValue="14px"/>
			</button>
		}
		@if (ToolbarContent is not null)
		{
			<div class="moka-table-toolbar-actions">
				@ToolbarContent
			</div>
		}
	</div>
}

@* Top pagination *@
@if (ShowTopPagination)
{
	<MokaPagination TotalItems="_totalItems" PageSize="_pageSize" CurrentPage="_currentPage"
	                CurrentPageChanged="HandlePageChange" PageSizeChanged="HandlePageSizeChange"
	                PageSizeOptions="PageSizeOptions" Compact="true"
	                Sticky="StickyPagination" StickyPosition="MokaPaginationStickyPosition.Top"/>
}

@* Table *@
<div class="@ContainerClass" style="@ContainerStyle">
	<table class="@TableClasses">
		<thead class="@HeadClass">
		<tr>
			@if (Expandable)
			{
				<th class="moka-table-cell--expand"></th>
			}
			@if (Selectable)
			{
				<th class="moka-table-cell--checkbox">
					@if (!SingleSelect)
					{
						<input type="checkbox" @ref="_selectAllRef" aria-label="@SelectAllLabel"
						       checked="@AllDisplayedRowsSelected"
						       @onchange="e => HandleSelectAll((bool)(e.Value ?? false))"/>
					}
				</th>
			}
			@if (RowReorderable)
			{
				<th class="moka-table-cell--reorder"></th>
			}
			@* The drag handlers exist only while ColumnReorderable is on. The drop marker under the
			   pointer comes from moka-table.js, which also allows the drop. A sortable header holds a
			   button, so the keyboard reaches the sort; the click, from the mouse anywhere in the
			   header or from the button's Enter or Space, is handled on the header cell. *@
			@foreach (var (col, colIdx) in columns)
			{
				<th class="@HeaderCellClass(col)"
				    style="@HeaderCellStyle(col)"
				    aria-sort="@AriaSort(col)"
				    draggable="@ColumnDraggable"
				    @ondragstart="ColumnDragStartHandler(col)"
				    @ondrop="ColumnDropHandler(col)"
				    @ondragend="ColumnDragEndHandler"
				    @onclick="SortClickHandler(col)">
					@if (col.HeaderTemplate is not null)
					{
						@col.HeaderTemplate
					}
					@if (CanSort(col))
					{
						var sortDesc = GetSortDescriptor(col.Title);
						@* With a HeaderTemplate the button holds only the icon, so no control from the
						   template ends up inside it. *@
						<button type="button" class="moka-table-sort-button" aria-label="@SortButtonLabel(col)">
							@if (col.HeaderTemplate is null)
							{
								<span class="moka-table-header-text">@col.Title</span>
							}
							<span class="@SortIconClass(sortDesc)">
								@if (sortDesc?.Direction == MokaSortDirection.Ascending)
								{
									<MokaIcon Icon="MokaIcons.Navigation.ChevronUp" SizeValue="12px"/>
								}
								else if (sortDesc?.Direction == MokaSortDirection.Descending)
								{
									<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="12px"/>
								}
								else
								{
									<MokaIcon Icon="MokaIcons.Content.SortNeutral" SizeValue="12px" Class="moka-table-sort-neutral"/>
								}
							</span>
							@if (MultiSort && sortDesc is not null && _sortDescriptors.Count > 1)
							{
								<span class="moka-table-sort-priority" aria-hidden="true">@sortDesc.Priority</span>
							}
						</button>
					}
					else if (col.HeaderTemplate is null)
					{
						<span class="moka-table-header-text">@col.Title</span>
					}
					@if (col.Resizable)
					{
						<span class="moka-table-resize-handle"
						      data-col-index="@(colIdx.ToString(CultureInfo.InvariantCulture))"></span>
					}
				</th>
			}
			@if (RowActions is not null)
			{
				<th class="moka-table-cell--actions" style="@ActionsHeaderStyle">@ActionsColumnTitle</th>
			}
		</tr>
		@if (ShowFilters)
		{
			<tr class="moka-table-filter-row">
				@if (Expandable)
				{
					<td class="moka-table-cell--expand"></td>
				}
				@if (Selectable)
				{
					<td class="moka-table-cell--checkbox"></td>
				}
				@if (RowReorderable)
				{
					<td class="moka-table-cell--reorder"></td>
				}
				@foreach (var (col, _) in columns)
				{
					<td class="@FilterCellClass(col)" style="@DataCellStyle(col)">
						@if (col.Filterable && col.Title is not null)
						{
							@if (col.FilterType == MokaColumnFilterType.Select)
							{
								<select class="moka-table-filter-select" value="@GetColumnFilter(col)"
								        aria-label="@($"Filter by {col.Title}")"
								        @onchange="e => HandleColumnFilter(col, e)">
									<option value="">All</option>
									@foreach (string option in GetDistinctValues(col))
									{
										<option value="@option">@option</option>
									}
								</select>
							}
							else
							{
								<input type="text" class="moka-table-filter-input" value="@GetColumnFilter(col)"
								       placeholder="Filter"
								       aria-label="@($"Filter by {col.Title}")"
								       @oninput="e => HandleColumnFilter(col, e)"/>
							}
						}
					</td>
				}
				@if (RowActions is not null)
				{
					<td class="moka-table-cell--actions"></td>
				}
			</tr>
		}
		</thead>
		<tbody>
		@if (_isLoading)
		{
			@if (LoadingContent is not null)
			{
				<tr>
					<td colspan="@ColSpan" class="moka-table-state-cell">
						@LoadingContent
					</td>
				</tr>
			}
			else if (SkeletonRows > 0)
			{
				@for (var i = 0; i < SkeletonRows; i++)
				{
					var rowIdx = i;
					<tr class="moka-table-skeleton-row">
						@if (Expandable)
						{
							<td class="moka-table-cell--expand">
								<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
							</td>
						}
						@if (Selectable)
						{
							<td class="moka-table-cell--checkbox">
								<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
							</td>
						}
						@if (RowReorderable)
						{
							<td class="moka-table-cell--reorder">
								<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
							</td>
						}
						@foreach (var (col, colIdx) in columns)
						{
							<td class="@SkeletonCellClass(col)" style="@DataCellStyle(col)">
								<div class="moka-table-skeleton-box moka-table-skeleton-box--bar"
								     style="@SkeletonBarStyle(rowIdx, colIdx)"></div>
							</td>
						}
						@if (RowActions is not null)
						{
							<td class="moka-table-cell--actions">
								<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
							</td>
						}
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="@ColSpan" class="moka-table-state-cell">
						<div class="moka-table-loading">
							<MokaSpinner Size="MokaSize.Sm"/>
							<span>Loading...</span>
						</div>
					</td>
				</tr>
			}
		}
		else if (_displayRows.Count == 0)
		{
			<tr>
				<td colspan="@ColSpan" class="moka-table-state-cell">
					@if (EmptyContent is not null)
					{
						@EmptyContent
					}
					else
					{
						<div class="moka-table-empty">No data available</div>
					}
				</td>
			</tr>
		}
		else if (Virtualize)
		{
			@* Virtualize writes each item straight into its own builder, so the rows stay siblings. *@
			<Virtualize TItem="MokaTableRow<TItem>" Items="_displayRows" ItemContent="rowGroup"
			            ItemSize="VirtualRowHeight" SpacerElement="tr"/>
		}
		else
		{
			@bodyRows
		}
		</tbody>
		@if (FooterContent is not null)
		{
			<tfoot class="moka-table-footer">
			@FooterContent
			</tfoot>
		}
		else if (HasAggregates)
		{
			<tfoot class="moka-table-footer">
			<tr>
				@if (Expandable)
				{
					<td class="moka-table-cell--expand"></td>
				}
				@if (Selectable)
				{
					<td class="moka-table-cell--checkbox"></td>
				}
				@if (RowReorderable)
				{
					<td class="moka-table-cell--reorder"></td>
				}
				@foreach (var (col, _) in columns)
				{
					<td class="@AggregateCellClass(col)" style="@DataCellStyle(col)">
						@if (col.Aggregate != MokaAggregateType.None)
						{
							<span class="moka-table-aggregate-label">@AggregateLabel(col)</span>
							<span class="moka-table-aggregate-value">@ComputeAggregate(col)</span>
						}
					</td>
				}
				@if (RowActions is not null)
				{
					<td class="moka-table-cell--actions"></td>
				}
			</tr>
			</tfoot>
		}
	</table>
</div>

@* Bottom pagination *@
@if (ShowBottomPagination)
{
	<MokaPagination TotalItems="_totalItems" PageSize="_pageSize" CurrentPage="_currentPage"
	                CurrentPageChanged="HandlePageChange" PageSizeChanged="HandlePageSizeChange"
	                PageSizeOptions="PageSizeOptions"
	                Sticky="StickyPagination" StickyPosition="MokaPaginationStickyPosition.Bottom"/>
}
</div>
