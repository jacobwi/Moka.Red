@namespace Moka.Red.Data.Table
@inherits MokaVisualComponentBase
@typeparam TItem

@* Row markup lives in one template so the plain and virtualized body paths cannot drift apart. *@
@{
	// One list per render, so the header, the filter row and every body row agree on the columns
	// and their positions.
	var columns = VisibleColumnsInOrder();

	// Null until a column names a phone slot, so a table with none renders as it always did.
	_phoneSlots = PhoneSlots();
	_firstTabColumn = FirstTabColumn(columns);
	var rowColumns = RowColumns(columns);

	// The drop marker under the pointer comes from moka-table.js, which also allows the drop. The
	// row and cell handlers are attached only when something listens: every event that reaches a
	// handler goes to .NET and renders the whole table again. Focus and keys on a cell go through
	// one listener in moka-table.js, since a handler per cell made every render replace them all.
	RenderFragment<MokaTableRow<TItem>> rowTemplate = row =>
		@<tr class="@RowCssClass(row)" style="@RowStyle?.Invoke(row.Item)" role="@AriaRole("row")"
		     data-row-index="@(row.Index.ToString(CultureInfo.InvariantCulture))"
		     @key="row.Key"
		     @onclick="RowClickHandler(row.Index)"
		     @oncontextmenu:preventDefault="OnRowContextMenu.HasDelegate"
		     @oncontextmenu="RowContextMenuHandler(row.Index)"
		     @ondrop="RowDropHandler(row.Index)">
			@if (ExpandAtStart)
			{
				<td class="moka-table-cell--expand" role="@AriaRole("cell")">
					@* The toggles make a column, so the name opens beside it, over the row. *@
					<MokaTooltip Text="Toggle detail" Position="MokaTooltipPosition.Right">
						<button class="@ExpandButtonClass(row.Item)" type="button" aria-label="Toggle detail"
						        @onclick="HandlersFor(row.Index).Expand" @onclick:stopPropagation="true">
							<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="12px"/>
						</button>
					</MokaTooltip>
				</td>
			}
			@if (Selectable)
			{
				<td class="moka-table-cell--checkbox" role="@AriaRole("cell")">
					<input type="checkbox" checked="@_selectedItems.Contains(row.Item)"
					       aria-label="@RowBoxLabel(row.Item)"
					       @onclick="RowBoxClickHandler"
					       @onclick:stopPropagation="true"
					       @onchange="HandlersFor(row.Index).Select"/>
				</td>
			}
			@if (RowReorderable)
			{
				<td class="@ReorderCellClass" draggable="@RowDraggable" aria-description="@ReorderOffReason"
				    role="@AriaRole("cell")"
				    @onclick:stopPropagation="true"
				    @ondragstart="HandlersFor(row.Index).DragStart"
				    @ondragend="HandleRowDragEnd">
					@if (CanReorderRows)
					{
						<MokaIcon Icon="MokaIcons.Action.GripVertical" SizeValue="14px" Class="moka-table-drag-grip"/>
					}
					else
					{
						@* Only while reordering is off: a tooltip shown as a drag starts would ride along in the drag
						   image. The handles make a column, so the reason opens beside it, over the row. *@
						<MokaTooltip Text="@ReorderOffReason" Position="MokaTooltipPosition.Right" MaxWidth="20rem">
							<MokaIcon Icon="MokaIcons.Action.GripVertical" SizeValue="14px" Class="moka-table-drag-grip"/>
						</MokaTooltip>
					}
				</td>
			}
			@foreach (var (col, colIdx) in rowColumns)
			{
				<td class="@DataCellClass(col, colIdx)" style="@DataCellStyle(col)" role="@AriaRole("cell")"
				    data-col-index="@(colIdx >= 0 ? colIdx.ToString(CultureInfo.InvariantCulture) : null)"
				    data-activates-row="@(ActivatesRow(col) ? "true" : null)"
				    data-editable="@(col.Editable ? "true" : null)"
				    tabindex="@(colIdx >= 0 ? CellTabIndex(row.Index, colIdx) : null)"
				    @ondblclick="CellDoubleClickHandler(row.Index, col)">
					@if (IsEditing(row.Item, col))
					{
						<input type="text" class="moka-table-edit-input" value="@_editValue"
						       @oninput="HandleEditInput"
						       @onblur="() => CommitEdit(row.Item, col)"
						       @onkeydown="e => HandleEditKeyDown(row.Item, col, e)"
						       @onkeydown:stopPropagation="true"
						       @onclick:stopPropagation="true"
						       @ondblclick:stopPropagation="true"/>
					}
					else if (col.CellTemplate is not null)
					{
						<div class="moka-table-cell-template">
							@col.CellTemplate(row.Item)
						</div>
					}
					else
					{
						@GetCellValue(col, row.Item)
					}
				</td>
			}
			@if (RowActions is not null)
			{
				<td class="moka-table-cell--actions" role="@AriaRole("cell")" @onclick:stopPropagation="true">
					<div class="moka-table-row-actions">
						@RowActions(row.Item)
					</div>
				</td>
			}
			@if (ExpandAtEnd)
			{
				@* No tooltip on purpose: a chevron at every row's end that turns when the row opens says what it does, and a
				   tooltip per row was asked against. The name carries the row's own name. *@
				<td class="moka-table-cell--more" role="@AriaRole("cell")">
					<button type="button" class="moka-table-more-btn"
					        aria-expanded="@(IsExpanded(row.Item) ? "true" : "false")" aria-label="@ExpandLabel(row.Item)"
					        @onclick="HandlersFor(row.Index).Expand" @onclick:stopPropagation="true">
						<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="16px"/>
					</button>
				</td>
			}
		</tr>;

	RenderFragment<MokaTableRow<TItem>> detailTemplate = row =>
		@<tr class="moka-table-detail-row" role="@AriaRole("row")" @key="DetailRowKey(row)">
			<td colspan="@ColSpan" role="@AriaRole("cell")">
				@if (DetailTemplate is not null)
				{
					@DetailTemplate(row.Item)
				}
			</td>
		</tr>;

	// Writes a row, and its detail row when open, straight into the builder it is given. Calling a
	// template as @rowTemplate(row) would wrap each row in its own render-tree region, and @key only
	// compares siblings inside one region, so a row that changed position would be rebuilt instead
	// of moved.
	RenderFragment<MokaTableRow<TItem>> rowGroup = row => builder =>
	{
		rowTemplate(row)(builder);
		if (Expandable && IsExpanded(row.Item))
		{
			detailTemplate(row)(builder);
		}
	};

	RenderFragment<MokaTableGroupRows> groupHeaderContent = group => builder =>
	{
		@if (GroupHeaderTemplate is not null)
		{
			@GroupHeaderTemplate(GroupContext(group))
		}
		else
		{
			<span class="moka-table-group-key">@group.Key</span>
			<span class="moka-table-group-count">@group.Rows.Count</span>
		}
	};

	RenderFragment<MokaTableGroupRows> groupHeaderRow = group => builder =>
	{
		<tr class="moka-table-group-row" role="@AriaRole("row")">
			<td colspan="@ColSpan" class="moka-table-group-cell" role="@AriaRole("cell")">
				@if (GroupsCollapsible)
				{
					@* The button carries the whole heading, so the row is one target rather than a label
					   beside a small chevron. *@
					<button type="button"
					        class="moka-table-group-toggle"
					        aria-expanded="@(IsGroupCollapsed(group.Key) ? "false" : "true")"
					        @onclick="() => ToggleGroupAsync(group.Key)">
						<MokaIcon Icon="@(IsGroupCollapsed(group.Key) ? MokaIcons.Navigation.ChevronRight : MokaIcons.Navigation.ChevronDown)"
						          SizeValue="14px"
						          Class="moka-table-group-chevron"/>
						@groupHeaderContent(group)
					</button>
				}
				else
				{
					<span class="moka-table-group-static">@groupHeaderContent(group)</span>
				}
			</td>
		</tr>
	};

	RenderFragment bodyRows = builder =>
	{
		foreach (var row in _displayRows)
		{
			rowGroup(row)(builder);
		}
	};

	RenderFragment groupedBodyRows = builder =>
	{
		foreach (var group in _displayGroups)
		{
			groupHeaderRow(group)(builder);

			if (IsGroupCollapsed(group.Key))
			{
				continue;
			}

			foreach (var row in group.Rows)
			{
				rowGroup(row)(builder);
			}
		}
	};

	// The part a Framed table draws its card around. It is the same markup either way, and a table that isn't framed
	// gets no extra element around it.
	RenderFragment tableArea = builder =>
	{
		@* Top pagination *@
		@if (ShowTopPagination)
		{
			<MokaPagination TotalItems="_totalItems" PageSize="_pageSize" CurrentPage="_currentPage"
			                CurrentPageChanged="HandlePageChange" PageSizeChanged="HandlePageSizeChange"
			                PageSizeOptions="PageSizeOptions" Compact="true"
			                Sticky="StickyPagination" StickyPosition="MokaPaginationStickyPosition.Top"/>
		}

		@if (BulkActions is not null)
		{
			@* There from the start, or a bar that appears already filled isn't announced. *@
			<span class="moka-visually-hidden" role="status">@BulkStatusText</span>
			@if (ShowBulkBar)
			{
				var picked = PickedInDisplayOrder();
				var names = BulkNames(picked);
				<div class="moka-table-bulk" role="group" aria-label="@BulkBarLabel">
					<div class="moka-table-bulk-count">
						<div class="moka-table-bulk-total">@BulkCountText</div>
						@if (names is not null)
						{
							<div class="moka-table-bulk-names" title="@names">@names</div>
						}
					</div>
					<div class="moka-table-bulk-actions">
						@BulkActions(picked)
					</div>
					@if (BulkClearIcon)
					{
						<MokaTooltip Text="Clear the selection" Position="MokaTooltipPosition.BottomEnd">
							<MokaButton Quiet StartIcon="MokaIcons.Navigation.Close" aria-label="Clear the selection"
							            OnClick="ClearSelection"/>
						</MokaTooltip>
					}
					else
					{
						<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary"
						            OnClick="ClearSelection">Clear</MokaButton>
					}
				</div>
			}
		}

		@if (Loading && LoadingContent is null)
		{
			<span class="moka-visually-hidden" role="status">@LoadingStatusText</span>
		}

		@* Table *@
		<div class="@ContainerClass" style="@ContainerStyle">
			<table class="@TableClasses" style="@TableStyle" role="@AriaRole("table")" aria-label="@Label"
			       aria-busy="@(Loading ? "true" : null)">
				<thead class="@HeadClass" role="@AriaRole("rowgroup")">
				<tr role="@AriaRole("row")">
					@if (ExpandAtStart)
					{
						<th class="moka-table-cell--expand" role="@AriaRole("columnheader")"></th>
					}
					@if (Selectable)
					{
						<th class="moka-table-cell--checkbox" role="@AriaRole("columnheader")">
							@if (!SingleSelect)
							{
								<input type="checkbox" @ref="_selectAllRef" aria-label="@SelectAllLabel"
								       checked="@AllDisplayedRowsSelected"
								       @onchange="e => HandleSelectAll((bool)(e.Value ?? false))"/>
							}
						</th>
					}
					@if (RowReorderable)
					{
						<th class="moka-table-cell--reorder" role="@AriaRole("columnheader")"></th>
					}
					@* The drag handlers exist only while ColumnReorderable is on. The drop marker under the
					   pointer comes from moka-table.js, which also allows the drop. A sortable header holds a
					   button, so the keyboard reaches the sort; the click, from the mouse anywhere in the
					   header or from the button's Enter or Space, is handled on the header cell. *@
					@foreach (var (col, colIdx) in rowColumns)
					{
						if (colIdx < 0)
						{
							<th class="@PhoneOnlyHeaderClass(col)" role="columnheader">@col.Title</th>
							continue;
						}

						<th class="@HeaderCellClass(col)"
						    style="@HeaderCellStyle(col)"
						    role="@AriaRole("columnheader")"
						    aria-sort="@AriaSort(col)"
						    draggable="@ColumnDraggableFor(col)"
						    @ondragstart="ColumnDragStartHandler(col)"
						    @ondrop="ColumnDropHandler(col)"
						    @ondragend="ColumnDragEndHandler"
						    @onclick="SortClickHandler(col)">
							@if (col.HeaderTemplate is not null)
							{
								@col.HeaderTemplate
							}
							@if (CanSort(col))
							{
								var sortDesc = GetSortDescriptor(col.Title);
								@* With a HeaderTemplate the button holds only the icon, so no control from the
								   template ends up inside it. *@
								<button type="button" class="moka-table-sort-button" aria-label="@SortButtonLabel(col)">
									@if (col.HeaderTemplate is null)
									{
										<span class="moka-table-header-text">@col.Title</span>
									}
									<span class="@SortIconClass(sortDesc)">
										@if (sortDesc?.Direction == MokaSortDirection.Ascending)
										{
											<MokaIcon Icon="MokaIcons.Navigation.ChevronUp" SizeValue="12px"/>
										}
										else if (sortDesc?.Direction == MokaSortDirection.Descending)
										{
											<MokaIcon Icon="MokaIcons.Navigation.ChevronDown" SizeValue="12px"/>
										}
										else
										{
											<MokaIcon Icon="MokaIcons.Content.SortNeutral" SizeValue="12px" Class="moka-table-sort-neutral"/>
										}
									</span>
									@if (MultiSort && sortDesc is not null && _sortDescriptors.Count > 1)
									{
										<span class="moka-table-sort-priority" aria-hidden="true">@sortDesc.Priority</span>
									}
								</button>
							}
							else if (col.HeaderTemplate is null)
							{
								<span class="moka-table-header-text">@col.Title</span>
							}
							@if (col.Resizable)
							{
								<span class="moka-table-resize-handle"
								      role="@ResizeRole" tabindex="@ResizeTabIndex" aria-orientation="@ResizeOrientation"
								      aria-label="@ResizeLabel(col)" aria-valuenow="@ResizeValue(col)"
								      data-col-index="@(colIdx.ToString(CultureInfo.InvariantCulture))"></span>
							}
						</th>
					}
					@if (RowActions is not null)
					{
						<th class="moka-table-cell--actions" style="@ActionsHeaderStyle" role="@AriaRole("columnheader")">@ActionsColumnTitle</th>
					}
					@if (ExpandAtEnd)
					{
						<th class="moka-table-cell--more" role="@AriaRole("columnheader")">
							<span class="moka-visually-hidden">More</span>
						</th>
					}
				</tr>
				@if (ShowFilters)
				{
					<tr class="moka-table-filter-row" role="@AriaRole("row")">
						@if (ExpandAtStart)
						{
							<td class="moka-table-cell--expand" role="@AriaRole("cell")"></td>
						}
						@if (Selectable)
						{
							<td class="moka-table-cell--checkbox" role="@AriaRole("cell")"></td>
						}
						@if (RowReorderable)
						{
							<td class="moka-table-cell--reorder" role="@AriaRole("cell")"></td>
						}
						@foreach (var (col, _) in columns)
						{
							<td class="@FilterCellClass(col)" style="@DataCellStyle(col)" role="@AriaRole("cell")">
								@if (col.Filterable && col.Title is not null)
								{
									@if (col.FilterType == MokaColumnFilterType.Select)
									{
										<select class="moka-table-filter-select" value="@GetColumnFilter(col)"
										        aria-label="@($"Filter by {col.Title}")"
										        @onchange="NonRendering.Callback<ChangeEventArgs>(e => HandleColumnFilter(col, e))">
											<option value="">All</option>
											@foreach (string option in GetDistinctValues(col))
											{
												<option value="@option">@option</option>
											}
										</select>
									}
									else
									{
										<input type="text" class="moka-table-filter-input" value="@GetColumnFilter(col)"
										       placeholder="Filter"
										       aria-label="@($"Filter by {col.Title}")"
										       @oninput="NonRendering.Callback<ChangeEventArgs>(e => HandleColumnFilter(col, e))"/>
									}
								}
							</td>
						}
						@if (RowActions is not null)
						{
							<td class="moka-table-cell--actions" role="@AriaRole("cell")"></td>
						}
						@if (ExpandAtEnd)
						{
							<td class="moka-table-cell--more" role="@AriaRole("cell")"></td>
						}
					</tr>
				}
				</thead>
				<tbody role="@AriaRole("rowgroup")">
				@if (Loading && LoadingContent is null)
				{
					@for (var i = 0; i < LoadingRows; i++)
					{
						var rowIdx = i;
						<tr class="@SkeletonRowClass" role="@AriaRole("row")" aria-hidden="true">
							@if (ExpandAtStart)
							{
								<td class="moka-table-cell--expand" role="@AriaRole("cell")">
									<MokaSkeleton Shape="MokaSkeletonShape.Rectangle" Width="1.125rem" Height="1.125rem"/>
								</td>
							}
							@if (Selectable)
							{
								<td class="moka-table-cell--checkbox" role="@AriaRole("cell")">
									<MokaSkeleton Shape="MokaSkeletonShape.Rectangle" Width="1.125rem" Height="1.125rem"/>
								</td>
							}
							@if (RowReorderable)
							{
								<td class="moka-table-cell--reorder" role="@AriaRole("cell")"></td>
							}
							@foreach (var (col, colIdx) in rowColumns)
							{
								<td class="@SkeletonCellClass(col, colIdx)" style="@DataCellStyle(col)" role="@AriaRole("cell")">
									<MokaSkeleton Width="@LoadingCellWidth(rowIdx)"/>
								</td>
							}
							@if (RowActions is not null)
							{
								<td class="moka-table-cell--actions" role="@AriaRole("cell")"></td>
							}
							@if (ExpandAtEnd)
							{
								<td class="moka-table-cell--more" role="@AriaRole("cell")"></td>
							}
						</tr>
					}
				}
				else if (_isLoading || Loading)
				{
					@if (LoadingContent is not null)
					{
						<tr role="@AriaRole("row")">
							<td colspan="@ColSpan" class="moka-table-state-cell" role="@AriaRole("cell")">
								@LoadingContent
							</td>
						</tr>
					}
					else if (SkeletonRows > 0)
					{
						@for (var i = 0; i < SkeletonRows; i++)
						{
							var rowIdx = i;
							<tr class="@SkeletonRowClass" role="@AriaRole("row")">
								@if (ExpandAtStart)
								{
									<td class="moka-table-cell--expand" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
									</td>
								}
								@if (Selectable)
								{
									<td class="moka-table-cell--checkbox" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
									</td>
								}
								@if (RowReorderable)
								{
									<td class="moka-table-cell--reorder" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
									</td>
								}
								@foreach (var (col, colIdx) in rowColumns)
								{
									<td class="@SkeletonCellClass(col, colIdx)" style="@DataCellStyle(col)" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--bar"
										     style="@SkeletonBarStyle(rowIdx, Math.Max(colIdx, 0))"></div>
									</td>
								}
								@if (RowActions is not null)
								{
									<td class="moka-table-cell--actions" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
									</td>
								}
								@if (ExpandAtEnd)
								{
									<td class="moka-table-cell--more" role="@AriaRole("cell")">
										<div class="moka-table-skeleton-box moka-table-skeleton-box--icon"></div>
									</td>
								}
							</tr>
						}
					}
					else
					{
						<tr role="@AriaRole("row")">
							<td colspan="@ColSpan" class="moka-table-state-cell" role="@AriaRole("cell")">
								<div class="moka-table-loading">
									<MokaSpinner Size="MokaSize.Sm"/>
									<span>Loading...</span>
								</div>
							</td>
						</tr>
					}
				}
				else if (_displayRows.Count == 0)
				{
					<tr role="@AriaRole("row")">
						<td colspan="@ColSpan" class="@EmptyCellClass" role="@AriaRole("cell")">
							@if (Empty is not null)
							{
								@Empty
							}
							else if (EmptyContent is not null)
							{
								@EmptyContent
							}
							else if (HasEmptyState)
							{
								<MokaEmptyState Icon="EmptyIcon" Title="@EmptyTitle" Description="@EmptyText" Live="true"/>
							}
							else
							{
								<div class="moka-table-empty">No data available</div>
							}
						</td>
					</tr>
				}
				else if (IsGrouped)
				{
					@groupedBodyRows
				}
				else if (Virtualize)
				{
					@* Virtualize writes each item straight into its own builder, so the rows stay siblings. *@
					<Virtualize TItem="MokaTableRow<TItem>" Items="_displayRows" ItemContent="rowGroup"
					            ItemSize="VirtualRowHeight" SpacerElement="tr"/>
				}
				else
				{
					@bodyRows
				}
				</tbody>
				@if (FooterContent is not null)
				{
					<tfoot class="moka-table-footer" role="@AriaRole("rowgroup")">
					@FooterContent
					</tfoot>
				}
				else if (HasAggregates)
				{
					<tfoot class="moka-table-footer" role="@AriaRole("rowgroup")">
					<tr role="@AriaRole("row")">
						@if (ExpandAtStart)
						{
							<td class="moka-table-cell--expand" role="@AriaRole("cell")"></td>
						}
						@if (Selectable)
						{
							<td class="moka-table-cell--checkbox" role="@AriaRole("cell")"></td>
						}
						@if (RowReorderable)
						{
							<td class="moka-table-cell--reorder" role="@AriaRole("cell")"></td>
						}
						@foreach (var (col, _) in columns)
						{
							<td class="@AggregateCellClass(col)" style="@DataCellStyle(col)" role="@AriaRole("cell")">
								@if (col.Aggregate != MokaAggregateType.None)
								{
									<span class="moka-table-aggregate-label">@AggregateLabel(col)</span>
									<span class="moka-table-aggregate-value">@ComputeAggregate(col)</span>
								}
							</td>
						}
						@if (RowActions is not null)
						{
							<td class="moka-table-cell--actions" role="@AriaRole("cell")"></td>
						}
						@if (ExpandAtEnd)
						{
							<td class="moka-table-cell--more" role="@AriaRole("cell")"></td>
						}
					</tr>
					</tfoot>
				}
			</table>
		</div>

		@* Bottom pagination *@
		@if (ShowBottomPagination)
		{
			<MokaPagination TotalItems="_totalItems" PageSize="_pageSize" CurrentPage="_currentPage"
			                CurrentPageChanged="HandlePageChange" PageSizeChanged="HandlePageSizeChange"
			                PageSizeOptions="PageSizeOptions"
			                Sticky="StickyPagination" StickyPosition="MokaPaginationStickyPosition.Bottom"/>
		}

		@if (ShowMoreFoot)
		{
			<div class="moka-table-foot">
				<span class="moka-table-foot-count" aria-live="polite">@ShowMoreCountText</span>
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary"
				            OnClick="ShowMoreRowsAsync">@ShowMoreButtonText</MokaButton>
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary"
				            OnClick="ShowAllRowsAsync">@ShowAllButtonText</MokaButton>
			</div>
		}

		@if (FootContent is not null)
		{
			<div class="moka-table-foot-content">@FootContent</div>
		}
	};

	// The toolbar, the selection bar and the chooser: above the frame, or its first rows with ToolbarInFrame.
	RenderFragment toolbarArea = builder =>
	{
		@* Selection action bar - replaces toolbar when items are selected *@
		@if (_selectedItems.Count > 0 && SelectionActions is not null && BulkActions is null)
		{
			<div class="moka-table-selection-bar">
				<span class="moka-table-selection-count">@_selectedItems.Count selected</span>
				<div class="moka-table-selection-actions">
					@SelectionActions(SelectionCopy)
				</div>
				<button type="button" class="moka-table-selection-clear" @onclick="ClearSelection">Clear</button>
			</div>
		}
		else if (ShowToolbar && (Title is not null || Searchable || ToolbarContent is not null || Exportable || ShowColumnToggle || ShowRefresh || ShowDensityToggle || ShowColumnChooser || ShowViews))
		{
			@* Toolbar *@
			<div class="@ToolbarClass">
				@if (Title is not null)
				{
					<span class="moka-table-title">@Title</span>
				}
				<div class="moka-table-toolbar-spacer"></div>
				@if (Searchable)
				{
					<div class="moka-table-search">
						<input type="text" class="@SearchInputClass"
						       placeholder="@SearchPlaceholder"
						       value="@_searchTerm"
						       @oninput="NonRendering.Callback<ChangeEventArgs>(HandleSearchInput)"/>
						@if (!string.IsNullOrEmpty(_searchTerm))
						{
							<MokaTooltip Text="Clear search" Position="MokaTooltipPosition.Bottom" Class="moka-table-search-clear-tip">
								<button class="moka-table-search-clear" @onclick="ClearSearch" type="button" aria-label="Clear search">
									<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
								</button>
							</MokaTooltip>
						}
					</div>
					@if (!string.IsNullOrEmpty(_searchTerm))
					{
						<span class="moka-table-search-count">@_totalItems results</span>
					}
				}
				@if (ShowViews)
				{
					<div class="moka-table-views" role="group" aria-label="Saved views">
						@foreach (MokaTableView view in Views ?? [])
						{
							<span class="@ViewClass(view)">
								<button type="button" class="moka-table-view-pick" title="@ViewTitle(view)"
								        aria-pressed="@(IsActiveView(view) ? "true" : "false")"
								        @onclick="() => PickViewAsync(view)">@view.Name</button>
								@if (CanForgetView(view))
								{
									<MokaTooltip Text="@($"Forget the view {view.Name}")" Position="MokaTooltipPosition.Bottom">
										<button type="button" class="moka-table-view-forget" aria-label="@($"Forget the view {view.Name}")"
										        @onclick="() => ForgetViewAsync(view)">
											<MokaIcon Icon="MokaIcons.Navigation.Close" SizeValue="12px"/>
										</button>
									</MokaTooltip>
								}
							</span>
						}
						@if (_namingView)
						{
							<span class="moka-table-view-new">
								<input type="text" class="moka-table-view-name" value="@_viewName"
								       maxlength="@MaxViewNameLength" placeholder="Name this view" aria-label="Name for this view"
								       aria-invalid="@(_viewNameProblem is null ? null : "true")"
								       @ref="_viewNameRef"
								       @oninput="NonRendering.Callback<ChangeEventArgs>(e => _viewName = e.Value?.ToString())"
								       @onkeydown="NonRendering.Callback<KeyboardEventArgs>(HandleViewNameKey)"
								       @onkeydown:stopPropagation="true"/>
								<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary"
								            OnClick="SaveViewAsync">Save</MokaButton>
								<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary"
								            OnClick="CancelNamingView">Cancel</MokaButton>
								@if (_viewNameProblem is not null)
								{
									<span class="moka-table-view-problem" role="alert">@_viewNameProblem</span>
								}
							</span>
						}
						else if (ViewSaved.HasDelegate)
						{
							<button type="button" class="moka-table-view-save" title="@SaveViewHint"
							        disabled="@(!CanSaveView)" @onclick="StartNamingView">Save this view</button>
						}
					</div>
				}
				@if (ShowColumnChooser)
				{
					<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary"
					            StartIcon="MokaIcons.Content.Columns" Class="moka-table-chooser-toggle"
					            aria-expanded="@(_chooserOpen ? "true" : "false")"
					            aria-controls="@(_chooserOpen ? _chooserId : null)"
					            OnClick="ToggleChooser">@ColumnsButtonText</MokaButton>
				}
				@if (ShowColumnToggle)
				{
					<div class="moka-table-column-toggle" @ref="_columnToggleRef">
						@* No tooltip while the menu is open: it would cover the menu under the pointer. *@
						<MokaTooltip Text="@(_showColumnMenu ? null : "Toggle columns")" Position="ToolbarTooltip(ToolbarButton.Columns)">
							<button type="button" class="moka-table-column-toggle-btn" @onclick="() => _showColumnMenu = !_showColumnMenu"
							        aria-label="Toggle columns" aria-expanded="@(_showColumnMenu ? "true" : "false")">
								<MokaIcon Icon="MokaIcons.Content.Columns" SizeValue="14px"/>
							</button>
						</MokaTooltip>
						@if (_showColumnMenu)
						{
							<div class="moka-table-column-menu" popover="manual" data-moka-popup @ref="_columnMenuRef">
								@foreach (var col in _columns.Where(static c => !c.Fixed))
								{
									<label class="moka-table-column-menu-item" @key="col">
										<input type="checkbox" checked="@IsColumnVisible(col)" @onchange="() => ToggleColumnVisibilityAsync(col)"/>
										@(col.Title ?? "Unnamed")
									</label>
								}
							</div>
						}
					</div>
				}
				@if (Exportable)
				{
					<MokaTooltip Text="Export" Position="ToolbarTooltip(ToolbarButton.Export)">
						<button type="button" class="moka-table-toolbar-btn" @onclick="HandleExport" aria-label="Export">
							<MokaIcon Icon="MokaIcons.Action.Download" SizeValue="14px"/>
						</button>
					</MokaTooltip>
				}
				@if (ShowRefresh)
				{
					<MokaTooltip Text="Refresh" Position="ToolbarTooltip(ToolbarButton.Refresh)">
						<button type="button" class="moka-table-toolbar-btn" @onclick="HandleRefresh" aria-label="Refresh">
							<MokaIcon Icon="MokaIcons.Action.Refresh" SizeValue="14px"/>
						</button>
					</MokaTooltip>
				}
				@if (ShowDensityToggle)
				{
					<MokaTooltip Text="@DensityLabel" Position="ToolbarTooltip(ToolbarButton.Density)">
						<button type="button" class="moka-table-toolbar-btn" @onclick="ToggleDensity" aria-label="@DensityLabel">
							<MokaIcon Icon="@(_dense ? MokaIcons.Content.RowsComfortable : MokaIcons.Content.RowsDense)" SizeValue="14px"/>
						</button>
					</MokaTooltip>
				}
				@if (ToolbarContent is not null)
				{
					<div class="moka-table-toolbar-actions">
						@ToolbarContent
					</div>
				}
			</div>
		}

		@if (ShowColumnChooser && _chooserOpen)
		{
			var chooserColumns = ChooserColumns();
			<div class="moka-table-chooser" id="@_chooserId" role="group" aria-label="Columns"
			     @onkeydown="HandleChooserKey" @onkeydown:stopPropagation="true">
				<span class="moka-table-chooser-note">Show, hide and order the columns. On the table itself, a heading's right edge drags to resize it, and the left and right arrow keys move a focused edge.</span>
				<ol class="moka-table-chooser-list">
					@for (var i = 0; i < chooserColumns.Count; i++)
					{
						var col = chooserColumns[i];
						var earlier = i > 0 ? chooserColumns[i - 1] : null;
						var later = i < chooserColumns.Count - 1 ? chooserColumns[i + 1] : null;
						var widthText = ColumnWidthText(col);
						<li class="moka-table-chooser-item" @key="col">
							<label class="moka-table-chooser-show">
								<input type="checkbox" checked="@IsColumnVisible(col)" aria-label="@($"Show {col.Title}")"
								       @onchange="() => ToggleColumnVisibilityAsync(col)"/>
								<span>@col.Title</span>
							</label>
							@if (widthText is not null)
							{
								<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Text" Color="MokaColor.Secondary"
								            OnClick="() => ResetColumnWidthAsync(col)">@widthText</MokaButton>
							}
							<span class="moka-table-chooser-moves">
								<MokaTooltip Text="@($"Move {col.Title} earlier")" Position="MokaTooltipPosition.Top">
									<MokaButton Quiet StartIcon="MokaIcons.Navigation.ArrowUp" aria-label="@($"Move {col.Title} earlier")"
									            Disabled="@(earlier is null)" OnClick="() => MoveInChooserAsync(col, earlier!, earlier: true)"/>
								</MokaTooltip>
								<MokaTooltip Text="@($"Move {col.Title} later")" Position="MokaTooltipPosition.Top">
									<MokaButton Quiet StartIcon="MokaIcons.Navigation.ArrowDown" aria-label="@($"Move {col.Title} later")"
									            Disabled="@(later is null)" OnClick="() => MoveInChooserAsync(col, later!, earlier: false)"/>
								</MokaTooltip>
							</span>
						</li>
					}
				</ol>
				<div class="moka-table-chooser-foot">
					<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary"
					            Disabled="@(!CanResetLayout)" OnClick="ResetArrangementAsync">Put the columns back as they were</MokaButton>
					<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary"
					            OnClick="CloseChooser">Done</MokaButton>
				</div>
			</div>
		}
	};
}

<CascadingValue Value="this" IsFixed="true">
	@* Hidden - column definitions are captured via CascadingParameter *@
	<div style="display:none">@ChildContent</div>
</CascadingValue>

<div class="@CssClass" style="@CssStyle" id="@Id" @ref="_wrapperRef" @attributes="AdditionalAttributes">
@if (ToolbarInsideFrame)
{
	<div class="moka-table-frame">
		@toolbarArea
		@tableArea
	</div>
}
else
{
	@toolbarArea
	@if (Framed)
	{
		<div class="moka-table-frame">@tableArea</div>
	}
	else
	{
		@tableArea
	}
}
</div>
