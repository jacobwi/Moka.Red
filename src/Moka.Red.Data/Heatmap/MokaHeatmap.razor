@namespace Moka.Red.Data.Heatmap
@inherits MokaVisualComponentBase

@{
	RenderFragment scale = @<div class="moka-heatmap__scale" aria-hidden="true">
		<span>@LessText</span>
		@foreach (string step in ScaleClasses)
		{
			<span class="@step"></span>
		}
		<span>@MoreText</span>
	</div>;
}

@if (Layout == MokaHeatmapLayout.Grid)
{
	<div class="@GridClass" style="@GridStyle" id="@Id" role="img" aria-label="@(Label ?? "Heatmap")"
	     @attributes="AdditionalAttributes">
		<div class="moka-heatmap__scroller">
			<div class="moka-heatmap__matrix">
				<span class="moka-heatmap__corner"></span>
				@foreach (GridLabel column in _columnLabels)
				{
					<span class="@column.Class" style="@column.Style">@column.Text</span>
				}
				@foreach (GridLabel row in _rowLabels)
				{
					<span class="@row.Class" style="@row.Style">@row.Text</span>
				}
				@foreach (GridCell cell in _gridCells)
				{
					<span class="@cell.Class" style="@cell.Style" title="@cell.Title"></span>
				}
			</div>
		</div>
		@if (ShowScale)
		{
			@scale
		}
	</div>
	return;
}

<div class="@CssClass" style="@CssStyle" id="@Id"
     role="img" aria-label="@(Label ?? "Calendar heatmap")"
     @attributes="AdditionalAttributes">
	@if (ShowMonthLabels)
	{
		<div class="moka-heatmap-months">
			<span class="moka-heatmap-corner"></span>
			<div class="moka-heatmap-month-row">
				@foreach (MonthLabel month in Months)
				{
					<span class="moka-heatmap-month">@month.Text</span>
				}
			</div>
		</div>
	}

	<div class="moka-heatmap-body">
		@if (ShowWeekdayLabels)
		{
			<div class="moka-heatmap-weekdays">
				@foreach (WeekdayLabel weekday in Weekdays)
				{
					<span class="moka-heatmap-weekday">@weekday.Text</span>
				}
			</div>
		}

		@* Days flow down each week column, Monday at its top *@
		<div class="moka-heatmap-grid">
			@foreach (Cell cell in Cells)
			{
				<span class="@cell.CssClass" title="@cell.Title"></span>
			}
		</div>
	</div>
	@if (ShowScale)
	{
		@scale
	}
</div>
