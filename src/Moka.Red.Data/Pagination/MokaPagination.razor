@namespace Moka.Red.Data.Pagination
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="navigation" aria-label="@Words.Label" @attributes="AdditionalAttributes">
	@if (Compact)
	{
		<MokaTooltip Text="@Words.PreviousPage" Position="TooltipPosition">
			<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(CurrentPageShown - 1)" aria-label="@Words.PreviousPage">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" SizeValue="14px"/>
			</button>
		</MokaTooltip>
		<span class="moka-pagination-compact-info">@CompactText</span>
		<MokaTooltip Text="@Words.NextPage" Position="TooltipPosition">
			<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(CurrentPageShown + 1)" aria-label="@Words.NextPage">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
			</button>
		</MokaTooltip>
	}
	else
	{
		@if (ShowPageSizeSelector)
		{
			<div class="moka-pagination-size">
				<select class="moka-pagination-size-select" @bind:get="PageSizeShown" @bind:set="PickPageSize" aria-label="@Words.RowsPerPage">
					@foreach (var opt in PageSizeOptions)
					{
						<option value="@opt">@opt</option>
					}
				</select>
			</div>
		}

		@if (ShowPageInfo)
		{
			<span class="moka-pagination-info">@RangeText</span>
		}

		<div class="moka-pagination-nav">
			@if (ShowFirstLast)
			{
				<MokaTooltip Text="@Words.FirstPage" Position="TooltipPosition">
					<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(1)" aria-label="@Words.FirstPage">
						<MokaIcon Icon="MokaIcons.Navigation.ChevronsLeft" SizeValue="14px"/>
					</button>
				</MokaTooltip>
			}

			<MokaTooltip Text="@Words.PreviousPage" Position="TooltipPosition">
				<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(CurrentPageShown - 1)" aria-label="@Words.PreviousPage">
					<MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" SizeValue="14px"/>
				</button>
			</MokaTooltip>

			<button type="button" class="@EdgePageCssClass(ShowStartEllipsis)" tabindex="@EdgePageTabIndex(ShowStartEllipsis)" aria-current="@(CurrentPageShown == 1 ? "page" : null)" @onclick="() => GoToPage(1)">1</button>
			<span class="@EllipsisCssClass(ShowStartEllipsis)" aria-hidden="true">…</span>

			@foreach (var pageNum in _visiblePages)
			{
				<button type="button" class="@PageCssClass(pageNum)"
				        aria-current="@(pageNum == CurrentPageShown ? "page" : null)"
				        @onclick="() => GoToPage(pageNum)">
					@pageNum
				</button>
			}

			@if (ShowLastPage)
			{
				<span class="@EllipsisCssClass(ShowEndEllipsis)" aria-hidden="true">…</span>
				<button type="button" class="@EdgePageCssClass(ShowEndEllipsis)" tabindex="@EdgePageTabIndex(ShowEndEllipsis)" aria-current="@(CurrentPageShown == TotalPages ? "page" : null)" @onclick="() => GoToPage(TotalPages)">@TotalPages</button>
			}

			<MokaTooltip Text="@Words.NextPage" Position="TooltipPosition">
				<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(CurrentPageShown + 1)" aria-label="@Words.NextPage">
					<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
				</button>
			</MokaTooltip>

			@if (ShowFirstLast && ShowLastPage)
			{
				<MokaTooltip Text="@Words.LastPage" Position="TooltipPosition">
					<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(TotalPages)" aria-label="@Words.LastPage">
						<MokaIcon Icon="MokaIcons.Navigation.ChevronsRight" SizeValue="14px"/>
					</button>
				</MokaTooltip>
			}
		</div>
	}
</div>
