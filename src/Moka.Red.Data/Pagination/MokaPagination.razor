@namespace Moka.Red.Data.Pagination
@inherits MokaComponentBase

<div class="@CssClass" style="@CssStyle" id="@Id" role="navigation" aria-label="Pagination" @attributes="AdditionalAttributes">
	@if (Compact)
	{
		<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(_currentPage - 1)" aria-label="Previous page">
			<MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" SizeValue="14px"/>
		</button>
		<span class="moka-pagination-compact-info">@_currentPage / @TotalPages</span>
		<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(_currentPage + 1)" aria-label="Next page">
			<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
		</button>
	}
	else
	{
		@if (ShowPageSizeSelector)
		{
			<div class="moka-pagination-size">
				<select class="moka-pagination-size-select" value="@_pageSize" @onchange="HandlePageSizeChange" aria-label="Rows per page">
					@foreach (var opt in PageSizeOptions)
					{
						<option value="@opt">@opt</option>
					}
				</select>
			</div>
		}

		@if (ShowPageInfo)
		{
			<span class="moka-pagination-info">@StartItem-@EndItem of @TotalItems</span>
		}

		<div class="moka-pagination-nav">
			@if (ShowFirstLast)
			{
				<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(1)" title="First page" aria-label="First page">
					<MokaIcon Icon="MokaIcons.Navigation.ChevronsLeft" SizeValue="14px"/>
				</button>
			}

			<button type="button" class="moka-pagination-btn" disabled="@IsFirstPage" @onclick="() => GoToPage(_currentPage - 1)" title="Previous page" aria-label="Previous page">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronLeft" SizeValue="14px"/>
			</button>

			<button type="button" class="@EdgePageCssClass(ShowStartEllipsis)" tabindex="@EdgePageTabIndex(ShowStartEllipsis)" aria-current="@(_currentPage == 1 ? "page" : null)" @onclick="() => GoToPage(1)">1</button>
			<span class="@EllipsisCssClass(ShowStartEllipsis)" aria-hidden="true">…</span>

			@foreach (var pageNum in _visiblePages)
			{
				<button type="button" class="@PageCssClass(pageNum)"
				        aria-current="@(pageNum == _currentPage ? "page" : null)"
				        @onclick="() => GoToPage(pageNum)">
					@pageNum
				</button>
			}

			<span class="@EllipsisCssClass(ShowEndEllipsis)" aria-hidden="true">…</span>
			<button type="button" class="@EdgePageCssClass(ShowEndEllipsis)" tabindex="@EdgePageTabIndex(ShowEndEllipsis)" aria-current="@(_currentPage == TotalPages ? "page" : null)" @onclick="() => GoToPage(TotalPages)">@TotalPages</button>

			<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(_currentPage + 1)" title="Next page" aria-label="Next page">
				<MokaIcon Icon="MokaIcons.Navigation.ChevronRight" SizeValue="14px"/>
			</button>

			@if (ShowFirstLast)
			{
				<button type="button" class="moka-pagination-btn" disabled="@IsLastPage" @onclick="() => GoToPage(TotalPages)" title="Last page" aria-label="Last page">
					<MokaIcon Icon="MokaIcons.Navigation.ChevronsRight" SizeValue="14px"/>
				</button>
			}
		</div>
	}
</div>
