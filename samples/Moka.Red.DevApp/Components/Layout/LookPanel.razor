@using Moka.Red.Feedback.Popover

<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs" Wrap>
	<MokaSegmentedControl Value="@_colors" ValueChanged="SetColors" Size="MokaSize.Xs" AriaLabel="Colors">
		<MokaSegment Value="red" Text="Red"/>
		<MokaSegment Value="gate" Text="Gate"/>
		<MokaSegment Value="crisp" Text="Crisp"/>
		<MokaSegment Value="matrix" Text="Matrix"/>
		<MokaSegment Value="original" Text="Original"/>
	</MokaSegmentedControl>

	<MokaPopover Open="_styleOpen" OpenChanged="v => _styleOpen = v" Position="MokaPopoverPosition.BottomEnd" AriaLabel="Style">
		<ChildContent>
			<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" Size="MokaSize.Xs">Style</MokaButton>
		</ChildContent>
		<PopoverContent>
			<div class="look-panel">
				@if (_colors == "original")
				{
					<MokaCaption>Original is the design as it has always been, so these choices do nothing on it.</MokaCaption>
				}
				<div class="look-row">
					<MokaLabel>Density</MokaLabel>
					<MokaSegmentedControl Value="@_density.ToString()" ValueChanged="v => Set(ref _density, v)" Size="MokaSize.Xs" AriaLabel="Density">
						<MokaSegment Value="Comfortable" Text="Comfortable"/>
						<MokaSegment Value="Compact" Text="Compact"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Text size</MokaLabel>
					<MokaSegmentedControl Value="@_textSize.ToString()" ValueChanged="v => Set(ref _textSize, v)" Size="MokaSize.Xs" AriaLabel="Text size">
						<MokaSegment Value="Normal" Text="14 px"/>
						<MokaSegment Value="Small" Text="13 px"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Corners</MokaLabel>
					<MokaSegmentedControl Value="@_corners.ToString()" ValueChanged="v => Set(ref _corners, v)" Size="MokaSize.Xs" AriaLabel="Corners">
						<MokaSegment Value="Soft" Text="Soft"/>
						<MokaSegment Value="Medium" Text="Medium"/>
						<MokaSegment Value="Tight" Text="Tight"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Main button</MokaLabel>
					<MokaSegmentedControl Value="@_mainButton.ToString()" ValueChanged="v => Set(ref _mainButton, v)" Size="MokaSize.Xs" AriaLabel="Main button">
						<MokaSegment Value="Solid" Text="Solid"/>
						<MokaSegment Value="Tinted" Text="Tinted"/>
						<MokaSegment Value="Outline" Text="Outline"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Buttons and titles</MokaLabel>
					<MokaSegmentedControl Value="@_letterCase.ToString()" ValueChanged="v => Set(ref _letterCase, v)" Size="MokaSize.Xs" AriaLabel="Buttons and titles">
						<MokaSegment Value="Sentence" Text="Sentence"/>
						<MokaSegment Value="Uppercase" Text="Uppercase"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Title font</MokaLabel>
					<MokaSegmentedControl Value="@_titleFont.ToString()" ValueChanged="v => Set(ref _titleFont, v)" Size="MokaSize.Xs" AriaLabel="Title font">
						<MokaSegment Value="SpaceGrotesk" Text="Space Grotesk"/>
						<MokaSegment Value="Inter" Text="Inter"/>
						<MokaSegment Value="JetBrainsMono" Text="JetBrains Mono"/>
					</MokaSegmentedControl>
				</div>
				<div class="look-row">
					<MokaLabel>Selected and focused</MokaLabel>
					<MokaSegmentedControl Value="@_selection.ToString()" ValueChanged="v => Set(ref _selection, v)" Size="MokaSize.Xs" AriaLabel="Selected and focused">
						<MokaSegment Value="Ring" Text="Thin ring"/>
						<MokaSegment Value="Flat" Text="Flat tint"/>
						<MokaSegment Value="Glow" Text="Strong glow"/>
					</MokaSegmentedControl>
				</div>
			</div>
		</PopoverContent>
	</MokaPopover>

	<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" Size="MokaSize.Xs" OnClick="ToggleDark">
		<MokaIcon Icon="MokaIcons.Toggle.Eye" SizeValue="14px"/>
		@(_isDark ? "Light" : "Dark")
	</MokaButton>
</MokaFlexbox>

@code {
	private string _colors = "red";
	private bool _isDark = true;
	private bool _styleOpen;
	private MokaDensity _density = MokaDensity.Comfortable;
	private MokaTextSize _textSize = MokaTextSize.Normal;
	private MokaCorners _corners = MokaCorners.Soft;
	private MokaMainButton _mainButton = MokaMainButton.Solid;
	private MokaLetterCase _letterCase = MokaLetterCase.Sentence;
	private MokaTitleFont _titleFont = MokaTitleFont.SpaceGrotesk;
	private MokaSelection _selection = MokaSelection.Ring;

	[Parameter]
	public EventCallback<MokaTheme> ThemeChanged { get; set; }

	private Task SetColors(string colors)
	{
		_colors = colors;

		// Crisp has Gate's colors. What makes it Crisp is these choices, so it sets them, and they stay for
		// whichever colors come next.
		if (colors == "crisp")
		{
			_density = MokaDensity.Compact;
			_textSize = MokaTextSize.Small;
			_corners = MokaCorners.Tight;
			_titleFont = MokaTitleFont.Inter;
			_selection = MokaSelection.Flat;
		}

		return Publish();
	}

	private Task ToggleDark()
	{
		_isDark = !_isDark;
		return Publish();
	}

	private Task Set<TChoice>(ref TChoice field, string value) where TChoice : struct, Enum
	{
		field = Enum.Parse<TChoice>(value);
		return Publish();
	}

	private Task Publish() => ThemeChanged.InvokeAsync(Build());

	private MokaTheme Build()
	{
		if (_colors == "original")
		{
			return _isDark ? MokaTheme.Dark : MokaTheme.Light;
		}

		MokaTheme colors = _colors switch
		{
			"gate" or "crisp" => _isDark ? MokaTheme.Gate : MokaTheme.GateLight,
			"matrix" => _isDark ? MokaTheme.Matrix : MokaTheme.MatrixLight,
			_ => _isDark ? MokaTheme.Default : MokaTheme.DefaultLight
		};

		return colors
			.WithDensity(_density)
			.WithTextSize(_textSize)
			.WithCorners(_corners)
			.WithMainButton(_mainButton)
			.WithLetterCase(_letterCase)
			.WithTitleFont(_titleFont)
			.WithSelection(_selection);
	}
}
