@using Moka.Red.Feedback.Popover

@{
	RenderFragment styleRows =
		@<text>
			@if (Choices.IsOriginal)
			{
				<MokaCaption>Original is the design as it has always been, so these choices do nothing on it.</MokaCaption>
			}
			<div class="look-row">
				<MokaLabel>Density</MokaLabel>
				<MokaSegmentedControl Value="@Choices.Density.ToString()" ValueChanged="v => Set<MokaDensity>(v, x => Choices.Density = x)" Size="MokaSize.Xs" AriaLabel="Density">
					<MokaSegment Value="Comfortable" Text="Comfortable"/>
					<MokaSegment Value="Compact" Text="Compact"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Text size</MokaLabel>
				<MokaSegmentedControl Value="@Choices.TextSize.ToString()" ValueChanged="v => Set<MokaTextSize>(v, x => Choices.TextSize = x)" Size="MokaSize.Xs" AriaLabel="Text size">
					<MokaSegment Value="Normal" Text="14 px"/>
					<MokaSegment Value="Small" Text="13 px"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Corners</MokaLabel>
				<MokaSegmentedControl Value="@Choices.Corners.ToString()" ValueChanged="v => Set<MokaCorners>(v, x => Choices.Corners = x)" Size="MokaSize.Xs" AriaLabel="Corners">
					<MokaSegment Value="Soft" Text="Soft"/>
					<MokaSegment Value="Medium" Text="Medium"/>
					<MokaSegment Value="Tight" Text="Tight"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Main button</MokaLabel>
				<MokaSegmentedControl Value="@Choices.MainButton.ToString()" ValueChanged="v => Set<MokaMainButton>(v, x => Choices.MainButton = x)" Size="MokaSize.Xs" AriaLabel="Main button">
					<MokaSegment Value="Solid" Text="Solid"/>
					<MokaSegment Value="Tinted" Text="Tinted"/>
					<MokaSegment Value="Outline" Text="Outline"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Buttons and titles</MokaLabel>
				<MokaSegmentedControl Value="@Choices.LetterCase.ToString()" ValueChanged="v => Set<MokaLetterCase>(v, x => Choices.LetterCase = x)" Size="MokaSize.Xs" AriaLabel="Buttons and titles">
					<MokaSegment Value="Sentence" Text="Sentence"/>
					<MokaSegment Value="Uppercase" Text="Uppercase"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Title font</MokaLabel>
				<MokaSegmentedControl Value="@Choices.TitleFont.ToString()" ValueChanged="v => Set<MokaTitleFont>(v, x => Choices.TitleFont = x)" Size="MokaSize.Xs" AriaLabel="Title font">
					<MokaSegment Value="SpaceGrotesk" Text="Space Grotesk"/>
					<MokaSegment Value="Inter" Text="Inter"/>
					<MokaSegment Value="JetBrainsMono" Text="JetBrains Mono"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Selected and focused</MokaLabel>
				<MokaSegmentedControl Value="@Choices.Selection.ToString()" ValueChanged="v => Set<MokaSelection>(v, x => Choices.Selection = x)" Size="MokaSize.Xs" AriaLabel="Selected and focused">
					<MokaSegment Value="Ring" Text="Thin ring"/>
					<MokaSegment Value="Flat" Text="Flat tint"/>
					<MokaSegment Value="Glow" Text="Strong glow"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Current page</MokaLabel>
				<MokaSegmentedControl Value="@Choices.CurrentPlace.ToString()" ValueChanged="v => Set<MokaCurrentPlace>(v, x => Choices.CurrentPlace = x)" Size="MokaSize.Xs" AriaLabel="Current page">
					<MokaSegment Value="Ring" Text="Ring"/>
					<MokaSegment Value="Solid" Text="Solid"/>
				</MokaSegmentedControl>
			</div>
			<div class="look-row">
				<MokaLabel>Descriptions</MokaLabel>
				<MokaSegmentedControl Value="@(Choices.Descriptions ? "Shown" : "Hidden")" ValueChanged="SetDescriptions" Size="MokaSize.Xs" AriaLabel="Descriptions">
					<MokaSegment Value="Shown" Text="Shown"/>
					<MokaSegment Value="Hidden" Text="Hidden"/>
				</MokaSegmentedControl>
			</div>
		</text>;
}

<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xs" Wrap>
	<MokaSegmentedControl Value="@Choices.Colors" ValueChanged="SetColors" Size="MokaSize.Xs" AriaLabel="Colors">
		<MokaSegment Value="red" Text="Red"/>
		<MokaSegment Value="gate" Text="Gate"/>
		<MokaSegment Value="crisp" Text="Crisp"/>
		<MokaSegment Value="matrix" Text="Matrix"/>
		<MokaSegment Value="original" Text="Original"/>
	</MokaSegmentedControl>

	@if (!Inline)
	{
		<MokaPopover Open="_styleOpen" OpenChanged="v => _styleOpen = v" Position="MokaPopoverPosition.BottomEnd" AriaLabel="Style">
			<ChildContent>
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" Size="MokaSize.Xs">Style</MokaButton>
			</ChildContent>
			<PopoverContent>
				<div class="look-panel">@styleRows</div>
			</PopoverContent>
		</MokaPopover>
	}

	<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" Size="MokaSize.Xs" OnClick="ToggleDark">
		<MokaIcon Icon="MokaIcons.Toggle.Eye" SizeValue="14px"/>
		@(Choices.IsDark ? "Light" : "Dark")
	</MokaButton>
</MokaFlexbox>

@if (Inline)
{
	<div class="look-panel look-panel--inline">@styleRows</div>
}

@code {
	private bool _styleOpen;

	[Parameter, EditorRequired]
	public LookChoices Choices { get; set; } = default!;

	// Draws the style choices under the colors rather than in a popover, for a phone's sheet: a popover inside another
	// overlay would cover the screen's bottom edge and fight it for clicks.
	[Parameter]
	public bool Inline { get; set; }

	[Parameter]
	public EventCallback<MokaTheme> ThemeChanged { get; set; }

	private Task SetColors(string colors)
	{
		Choices.PickColors(colors);
		return Publish();
	}

	private Task ToggleDark()
	{
		Choices.IsDark = !Choices.IsDark;
		return Publish();
	}

	private Task Set<TChoice>(string value, Action<TChoice> apply) where TChoice : struct, Enum
	{
		apply(Enum.Parse<TChoice>(value));
		return Publish();
	}

	private Task SetDescriptions(string value)
	{
		Choices.Descriptions = value == "Shown";
		return Publish();
	}

	private Task Publish() => ThemeChanged.InvokeAsync(Choices.Build());
}
