@implements IDisposable
@using Moka.Red.ThemeGen.Appearance
@inject DevAppLook Look

<div class="look-popover">
	<MokaAppearancePanel Value="Look.Settings.Appearance" ValueChanged="Look.SetAppearanceAsync" Rows="Rows" Palettes="DevAppLook.Palettes"
	                     Compact ShowReset="false"/>
	<MokaLink Class="look-popover__more" Href="appearance" OnClick="() => OnLeave.InvokeAsync()" Underline="MokaLinkUnderline.None">
		<span>All appearance settings</span>
		<MokaIcon Icon="MokaIcons.Navigation.ArrowRight" SizeValue="14px"/>
	</MokaLink>
</div>

@code {
	private const MokaAppearanceRows Rows = MokaAppearanceRows.Palette | MokaAppearanceRows.ColorMode | MokaAppearanceRows.ComponentStyle;

	[Parameter]
	public EventCallback OnLeave { get; set; }

	protected override void OnInitialized() => Look.Changed += StateHasChanged;

	public void Dispose() => Look.Changed -= StateHasChanged;
}
