@inherits LayoutComponentBase
@implements IDisposable
@using Moka.Red.Navigation.AppShell
@inject IMokaCommandPaletteService Palette
@inject NavigationManager Navigation

<MokaThemeProvider Theme="_theme">
	<MokaHotkeyHost/>
	<MokaAppShell Class="devapp-shell" Entries="DevAppCatalog.Entries" NavLabel="Pages">
		<Brand>
			<span class="app-logo" aria-hidden="true">M</span>
			<span class="moka-app-shell__brand-text">
				<span class="moka-app-shell__brand-name">Moka.Red</span>
				<span class="moka-app-shell__brand-line">v@(Version)</span>
			</span>
		</Brand>
		<Status>.NET 9 + 10</Status>
		<TopBarEnd>
			<MokaTooltip Text="Search (Ctrl+K)" Position="MokaTooltipPosition.Bottom">
				<MokaButton Quiet StartIcon="MokaIcons.Action.Search" aria-label="Search (Ctrl+K)" OnClick="Palette.Open"/>
			</MokaTooltip>
			<MokaTooltip Text="Look" Position="MokaTooltipPosition.BottomEnd">
				<MokaButton Quiet StartIcon="MokaIcons.Toggle.Eye" aria-label="Look" OnClick="OpenLook"/>
			</MokaTooltip>
		</TopBarEnd>
		<ChildContent>
			<MokaAppBar Class="devapp-pagebar" Title="@CurrentPage" Dense Fixed Bordered Elevated="false">
				<EndContent>
					<MokaTooltip Text="Search (Ctrl+K)" Position="MokaTooltipPosition.Bottom">
						<MokaButton Quiet StartIcon="MokaIcons.Action.Search" aria-label="Search (Ctrl+K)" OnClick="Palette.Open"/>
					</MokaTooltip>
					<LookPanel Choices="_look" ThemeChanged="SetTheme"/>
				</EndContent>
			</MokaAppBar>
			<div class="devapp-page">
				@Body
			</div>
		</ChildContent>
	</MokaAppShell>

	<MokaBottomSheet Open="_lookOpen" OpenChanged="open => _lookOpen = open">
		<Header>Look</Header>
		<ChildContent>
			<LookPanel Choices="_look" Inline ThemeChanged="SetTheme"/>
		</ChildContent>
	</MokaBottomSheet>

	<MokaToastHost OffsetTop="var(--moka-appbar-space, 0px)"/>
	<MokaDialogHost/>
	<MokaContextMenuHost/>
	<MokaCommandPalette/>
	<MokaDiagnosticsOverlay Theme="_theme"/>
</MokaThemeProvider>

@code {
	private static readonly string? Version = typeof(MokaTheme).Assembly.GetName().Version?.ToString(3);

	private readonly LookChoices _look = new();
	private readonly List<string> _commands = [];
	private bool _lookOpen;
	private MokaTheme _theme = MokaTheme.Default;

	// A layout gets a new Body on every page change, so this is read again then.
	private string? CurrentPage => MokaNavEntry.Find(DevAppCatalog.Entries, Navigation.ToBaseRelativePath(Navigation.Uri))?.Label;

	protected override void OnInitialized()
	{
		MokaCommand[] commands =
		[
			.. DevAppCatalog.Entries.Select(entry => new MokaCommand
			{
				Id = $"devapp-page-{entry.Route}",
				Title = entry.Label,
				Description = entry.Group,
				Group = "Pages",
				Icon = entry.Icon,
				Href = entry.Href,
				Keywords = entry.Keywords
			}),
			.. DevAppCatalog.Components.Select(component => new MokaCommand
			{
				Id = $"devapp-component-{component.Name}",
				Title = component.Name,
				Description = DevAppCatalog.PageName(component.Href),
				Group = "Components",
				Href = component.Href,
				Keywords = $"Moka{component.Name}"
			})
		];

		Palette.RegisterMany(commands);
		_commands.AddRange(commands.Select(command => command.Id));
	}

	public void Dispose()
	{
		foreach (string id in _commands)
		{
			Palette.Unregister(id);
		}
	}

	private void OpenLook() => _lookOpen = true;

	private void SetTheme(MokaTheme theme) => _theme = theme;
}
