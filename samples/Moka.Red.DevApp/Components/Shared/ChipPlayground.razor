<DemoPlayground Code="@Code">
	<Example>
		<MokaChip Text="@_text" Variant="_variant" Size="_size" Color="_color" @bind-Selected="_selected" Closable="_closable"
		          Icon="Icon"/>
	</Example>
	<Controls>
		<DemoChoice Label="Variant" Options="_variants" @bind-Value="_variant"/>
		<DemoChoice Label="Size" Options="_sizes" @bind-Value="_size"/>
		<DemoOptional TValue="MokaColor" Label="Color" Options="_colors" @bind-Value="_color"/>
		<DemoText Label="Text" @bind-Value="_text"/>
		<DemoToggle Label="Icon" @bind-Value="_icon"/>
		<DemoToggle Label="Selected" @bind-Value="_selected"/>
		<DemoToggle Label="Closable" @bind-Value="_closable"/>
	</Controls>
</DemoPlayground>

@code {
	private static readonly MokaVariant[] _variants = [MokaVariant.Soft, MokaVariant.Filled, MokaVariant.Outlined, MokaVariant.Text];
	private static readonly MokaSize[] _sizes = [MokaSize.Xs, MokaSize.Sm, MokaSize.Md, MokaSize.Lg];
	private static readonly MokaColor[] _colors = [MokaColor.Primary, MokaColor.Success, MokaColor.Warning, MokaColor.Error];

	private bool _closable;
	private MokaColor? _color;
	private bool _icon = true;
	private bool _selected;
	private MokaSize _size = MokaSize.Md;
	private string _text = "Blazor";
	private MokaVariant _variant = MokaVariant.Soft;

	private MokaIconDefinition? Icon => _icon ? MokaIcons.File.Code : default(MokaIconDefinition?);

	private string Code => new RazorTag("MokaChip")
		.Text("Text", _text)
		.Set("Variant", _variant, MokaVariant.Soft)
		.Set("Size", _size, MokaSize.Md)
		.Set("Color", _color)
		.Set("Icon", _icon ? "MokaIcons.File.Code" : null)
		.Flag("Selected", _selected)
		.Flag("Closable", _closable)
		.ToString();
}
