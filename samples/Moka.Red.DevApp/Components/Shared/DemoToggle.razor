<DemoControl Label="@Label">
	<MokaSwitch Value="@Value" ValueChanged="ValueChanged" aria-label="@Label"/>
</DemoControl>

@code {

	[Parameter]
	[EditorRequired]
	public string Label { get; set; } = string.Empty;

	[Parameter]
	public bool Value { get; set; }

	[Parameter]
	public EventCallback<bool> ValueChanged { get; set; }

}
