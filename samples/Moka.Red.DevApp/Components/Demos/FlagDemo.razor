<MokaCard Title="Flag" Outlined Margin="MokaSpacingScale.Md" id="Flag">
	<ChildContent>
		<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Lg" Align="MokaAlign.Center" Wrap="true">
			@foreach ((string Code, string Name) country in Countries)
			{
				<MokaFlag Code="@country.Code" Name="@country.Name" ShowTooltip="true" Size="MokaSize.Lg"/>
			}
			<MokaFlag ShowTooltip="true" Size="MokaSize.Lg"/>
			<MokaFlag Code="SE" Name="Sweden" ShowTooltip="true" SizeValue="40px"/>
		</MokaFlexbox>
		<p class="flag-demo-line">
			<MokaFlag Code="se" Name="Sweden"/> Stockholm, 12 ms
			<span class="flag-demo-gap"></span>
			<MokaFlag Code="jp" Name="Japan"/> Tokyo, 241 ms
			<span class="flag-demo-gap"></span>
			<MokaFlag Code="ZZ"/> Unknown
		</p>
	</ChildContent>
</MokaCard>

@code {
	private static readonly (string Code, string Name)[] Countries =
	[
		("US", "United States"), ("SE", "Sweden"), ("DE", "Germany"), ("JP", "Japan"), ("BR", "Brazil"),
		("NL", "Netherlands"), ("CH", "Switzerland"), ("EU", "European Union"), ("GB-ENG", "England"),
		("GB-SCT", "Scotland"), ("GB-WLS", "Wales")
	];
}
