	// Two service dialogs at once: the second opens on top, and each returns its own result.
	private async Task ShowStackedDialogs()
	{
		Task<bool> first = DialogService.ConfirmAsync(
			"This one opened first. The dialog on top has to close before you can reach it.",
			"First Dialog");
		string? name = await DialogService.PromptAsync("Opened on top of the first dialog.", "Second Dialog", "Moka");
		bool confirmed = await first;

		_dialogResult = $"Second: {name ?? "cancelled"}. First: {(confirmed ? "confirmed" : "cancelled")}.";
	}

	private async Task ShowThenCloseAll()
	{
		Task<bool> first = DialogService.ConfirmAsync("Both dialogs close in three seconds.", "First Dialog");
		Task<bool> second = DialogService.ConfirmAsync("IMokaDialogService.CloseAll() runs in three seconds.", "Second Dialog");
		await Task.Delay(3000);
		DialogService.CloseAll();

		_dialogResult = $"CloseAll cancelled both: {!await first && !await second}";
	}

