	// Keys, a filled body and work
	private static readonly string[] ViewerColors =
	[
		"--moka-label-teal-bg", "--moka-label-cyan-bg", "--moka-label-indigo-bg", "--moka-label-violet-bg",
		"--moka-label-pink-bg", "--moka-label-orange-bg"
	];

	private int? _viewerAt;
	private int _shownPicture;
	private bool _logOpen;
	private int _deleteTries;
	private string? _workResult;

	private void MoveViewerTo(int index)
	{
		if (index >= 0 && index < ViewerColors.Length)
		{
			_viewerAt = index;
			_shownPicture = index;
		}
	}

	private Task StepViewerAsync(KeyboardEventArgs key)
	{
		if (_viewerAt is null || key.AltKey || key.CtrlKey || key.MetaKey)
		{
			return Task.CompletedTask;
		}

		switch (key.Key)
		{
			case "ArrowLeft":
				MoveViewerTo(_shownPicture - 1);
				break;
			case "ArrowRight":
				MoveViewerTo(_shownPicture + 1);
				break;
			case "Home":
				MoveViewerTo(0);
				break;
			case "End":
				MoveViewerTo(ViewerColors.Length - 1);
				break;
		}

		return Task.CompletedTask;
	}

	// Fails the first time it runs, then works, so the failure and the second try both show.
	private async Task DeleteWithWorkAsync()
	{
		_deleteTries = 0;
		bool deleted = await DialogService.ConfirmAsync(
			"This deletes 9 items for everyone in the library.",
			"Delete 9 items?",
			o =>
			{
				o.ConfirmText = "Delete";
				o.ConfirmColor = MokaColor.Error;
				o.Icon = MokaIcons.Action.Delete;
				o.OnConfirmAsync = async token =>
				{
					await Task.Delay(1200, token);
					if (++_deleteTries == 1)
					{
						throw new InvalidOperationException("The library is read-only for a moment. Try again.");
					}
				};
			});

		_workResult = deleted ? $"Deleted after {_deleteTries} tries" : "Cancelled";
	}

	private async Task SaveWithFactsAsync()
	{
		bool saved = await DialogService.ConfirmAsync(
			@<div>
				<p style="margin: 0 0 var(--moka-spacing-sm);">A plugin wants to save a file.</p>
				<MokaKeyValue Label="Name" Value="report.pdf" Mono/>
				<MokaKeyValue Label="Size" Value="2.4 MB" Mono/>
			</div>,
			"Save file?",
			o =>
			{
				o.ConfirmText = "Save";
				o.OnConfirmAsync = token => Task.Delay(1200, token);
			});

		_workResult = saved ? "Saved report.pdf" : "Cancelled";
	}

	private async Task SaveWithComponentAsync()
	{
		object? saved = await DialogService.ShowComponentAsync<DemoSaveDialog>("Save file?", p => p["FileName"] = "report.pdf");
		_workResult = saved is string name ? $"Saved {name}" : "Cancelled";
	}

