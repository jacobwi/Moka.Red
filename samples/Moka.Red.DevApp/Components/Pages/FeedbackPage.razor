@page "/feedback"

<PageTitle>Feedback - Moka.Red</PageTitle>

<h1>Feedback</h1>
<p class="page-desc">Toast, Dialog, Alert, Tooltip, Progress, Loading, Popover, Dropdown, BottomSheet, NotificationCenter, EmptyState, CommandPalette, Wizard, CookieConsent, and Onboarding.</p>

@inject IMokaToastService ToastService
@inject IMokaDialogService DialogService
@inject IMokaNotificationService NotificationService
@inject IMokaCommandPaletteService CommandPalette
@inject IJSRuntime JS
@implements IAsyncDisposable

<DemoSection Id="Toast" Title="Toast" Component="MokaToastHost" Description="A short message that comes and goes, sent through IMokaToastService." Tip="AddMokaRed registers the service. The layout still needs one MokaToastHost to draw the toasts.">
	<ChildContent>
		<div class="button-row">
			<MokaButton OnClick="@(() => ToastService.ShowInfo("This is an informational message."))" Color="MokaColor.Info" Variant="MokaVariant.Soft">Info Toast</MokaButton>
			<MokaButton OnClick="@(() => ToastService.ShowSuccess("Operation completed successfully!"))" Color="MokaColor.Success" Variant="MokaVariant.Soft">Success Toast</MokaButton>
			<MokaButton OnClick="@(() => ToastService.ShowWarning("Please check your input."))" Color="MokaColor.Warning" Variant="MokaVariant.Soft">Warning Toast</MokaButton>
			<MokaButton OnClick="@(() => ToastService.ShowError("Something went wrong!"))" Color="MokaColor.Error" Variant="MokaVariant.Soft">Error Toast</MokaButton>
		</div>
		<div class="button-row" style="margin-top: var(--moka-spacing-sm);">
			<MokaButton OnClick="ShowTitledToast" Variant="MokaVariant.Outlined">Toast with Title</MokaButton>
			<MokaButton OnClick="ShowActionToast" Variant="MokaVariant.Outlined">Toast with Action</MokaButton>
			<MokaButton OnClick="ShowPersistentToast" Variant="MokaVariant.Outlined">Persistent Toast</MokaButton>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="ShowInfo, ShowSuccess">And ShowWarning and ShowError: the quick calls</DemoParam>
		<DemoParam Name="Title">Set in the options callback</DemoParam>
		<DemoParam Name="ActionText, OnAction">A button in the toast, like Undo</DemoParam>
		<DemoParam Name="DurationMs">0 keeps it until it is closed</DemoParam>
		<DemoParam Name="MokaToastHost">One in the layout, with Position and offsets</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="Dialog" Title="Dialog" Description="A modal box over the page, declared in markup or opened through IMokaDialogService." Tip="For a yes or no question, await IMokaDialogService.ConfirmAsync instead of declaring a dialog.">
	<ChildContent>
		<div class="button-row">
			<MokaButton OnClick="@(() => _showDialog = true)">Open Dialog</MokaButton>
			<MokaButton OnClick="ShowConfirmDialog" Variant="MokaVariant.Outlined">Confirm Dialog</MokaButton>
			<MokaButton OnClick="ShowPromptDialog" Variant="MokaVariant.Soft">Prompt Dialog</MokaButton>
			<MokaButton OnClick="ShowStackedDialogs" Variant="MokaVariant.Outlined">Stacked Dialogs</MokaButton>
			<MokaButton OnClick="ShowThenCloseAll" Variant="MokaVariant.Text">CloseAll After 3s</MokaButton>
		</div>
		<div class="button-row" style="margin-top: var(--moka-spacing-sm);">
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogSize = MokaDialogSize.Small;
				                     _showSizedDialog = true;
			                     })" Variant="MokaVariant.Outlined" Size="MokaSize.Sm">
				Small
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogSize = MokaDialogSize.Medium;
				                     _showSizedDialog = true;
			                     })" Variant="MokaVariant.Outlined" Size="MokaSize.Sm">
				Medium
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogSize = MokaDialogSize.Large;
				                     _showSizedDialog = true;
			                     })" Variant="MokaVariant.Outlined" Size="MokaSize.Sm">
				Large
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogSize = MokaDialogSize.FullScreen;
				                     _showSizedDialog = true;
			                     })" Variant="MokaVariant.Outlined" Size="MokaSize.Sm">
				Full Screen
			</MokaButton>
		</div>
		@if (!string.IsNullOrEmpty(_dialogResult))
		{
			<p style="font-size: var(--moka-font-size-sm); margin-top: var(--moka-spacing-sm);">Result: <strong>@_dialogResult</strong></p>
		}

		<div class="button-row" style="margin-top: var(--moka-spacing-sm);">
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogPosition = MokaDialogPosition.Left;
				                     _showPositionedDialog = true;
			                     })" Variant="MokaVariant.Soft" Size="MokaSize.Sm">
				Left Panel
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogPosition = MokaDialogPosition.Right;
				                     _showPositionedDialog = true;
			                     })" Variant="MokaVariant.Soft" Size="MokaSize.Sm">
				Right Panel
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogPosition = MokaDialogPosition.Top;
				                     _showPositionedDialog = true;
			                     })" Variant="MokaVariant.Soft" Size="MokaSize.Sm">
				Top Panel
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogPosition = MokaDialogPosition.Bottom;
				                     _showPositionedDialog = true;
			                     })" Variant="MokaVariant.Soft" Size="MokaSize.Sm">
				Bottom Panel
			</MokaButton>
		</div>

		<div class="button-row" style="margin-top: var(--moka-spacing-sm);">
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogBackdrop = MokaDialogBackdrop.Dim;
				                     _showBackdropDialog = true;
			                     })" Variant="MokaVariant.Text" Size="MokaSize.Sm">
				Dim Backdrop
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogBackdrop = MokaDialogBackdrop.Frosted;
				                     _showBackdropDialog = true;
			                     })" Variant="MokaVariant.Text" Size="MokaSize.Sm">
				Frosted Backdrop
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogBackdrop = MokaDialogBackdrop.Dark;
				                     _showBackdropDialog = true;
			                     })" Variant="MokaVariant.Text" Size="MokaSize.Sm">
				Dark Backdrop
			</MokaButton>
			<MokaButton OnClick="@(() =>
			                     {
				                     _dialogBackdrop = MokaDialogBackdrop.None;
				                     _showBackdropDialog = true;
			                     })" Variant="MokaVariant.Text" Size="MokaSize.Sm">
				No Backdrop
			</MokaButton>
		</div>

		<MokaDialog @bind-Open="_showDialog" Title="Example Dialog">
			<ChildContent>
				<p>This is a declarative dialog with rich content support.</p>
				<p>Close it by clicking the X, pressing Escape, or clicking the backdrop.</p>
			</ChildContent>
			<Actions>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" OnClick="@(() => _showDialog = false)">Cancel</MokaButton>
				<MokaButton Size="MokaSize.Sm" OnClick="@(() => _showDialog = false)">OK</MokaButton>
			</Actions>
		</MokaDialog>

		<MokaDialog @bind-Open="_showSizedDialog" Title="@($"{_dialogSize} Dialog")" DialogSize="_dialogSize">
			<ChildContent>
				<p>This dialog uses the <strong>@_dialogSize</strong> size preset.</p>
			</ChildContent>
			<Actions>
				<MokaButton Size="MokaSize.Sm" OnClick="@(() => _showSizedDialog = false)">Close</MokaButton>
			</Actions>
		</MokaDialog>

		<MokaDialog @bind-Open="_showPositionedDialog" Title="@($"{_dialogPosition} panel")" Position="_dialogPosition" Width="420px">
			<ChildContent>
				<p>A dialog anchored to the <strong>@_dialogPosition</strong> edge. It fills its edge,
					slides in from it, and slides back out when it closes.</p>
				@if (_dialogPosition is MokaDialogPosition.Left or MokaDialogPosition.Right)
				{
					<p>The panel's width comes from the size presets or <code>Width</code>; its height is
						the whole window.</p>
				}
				else
				{
					<p>The panel's height defaults to half the window; <code>Height</code> overrides it.</p>
				}
			</ChildContent>
			<Actions>
				<MokaButton Size="MokaSize.Sm" OnClick="@(() => _showPositionedDialog = false)">Close</MokaButton>
			</Actions>
		</MokaDialog>

		<MokaDialog @bind-Open="_showBackdropDialog" Title="@($"{_dialogBackdrop} backdrop")" Backdrop="_dialogBackdrop">
			<ChildContent>
				<p>The page behind this dialog is painted with the <strong>@_dialogBackdrop</strong>
					backdrop effect.</p>
			</ChildContent>
			<Actions>
				<MokaButton Size="MokaSize.Sm" OnClick="@(() => _showBackdropDialog = false)">Close</MokaButton>
			</Actions>
		</MokaDialog>
	</ChildContent>
	<Notes>
		<DemoParam Name="@@bind-Open">Shows and hides it</DemoParam>
		<DemoParam Name="Title, Icon, HeaderActions">The header</DemoParam>
		<DemoParam Name="Actions">The buttons along the bottom</DemoParam>
		<DemoParam Name="DialogSize, Width, Height">Small to FullScreen, or your own size</DemoParam>
		<DemoParam Name="Position">Anchors it to an edge as a panel</DemoParam>
		<DemoParam Name="Backdrop">Dim, Frosted, Dark or None</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="DialogWork" Title="Dialog keys, a filled body and work" Description="A viewer that steps with the arrow keys, a view that fills the body and scrolls itself, and a confirm that stays open while its work runs." Tip="Hand ConfirmAsync its work through OnConfirmAsync: the dialog shows a failure and stays open for another try.">
	<ChildContent>
		<div class="button-row">
			<MokaButton OnClick="@(() => MoveViewerTo(0))" StartIcon="MokaIcons.Content.Image">Picture viewer</MokaButton>
			<MokaButton OnClick="@(() => _logOpen = true)" Variant="MokaVariant.Outlined">Log that fills the body</MokaButton>
			<MokaButton OnClick="DeleteWithWorkAsync" Variant="MokaVariant.Soft" Color="MokaColor.Error">Delete, failing once</MokaButton>
			<MokaButton OnClick="SaveWithFactsAsync" Variant="MokaVariant.Outlined" data-demo="confirm-markup">Confirm with facts</MokaButton>
			<MokaButton OnClick="SaveWithComponentAsync" Variant="MokaVariant.Outlined" data-demo="component-actions">Component with footer buttons</MokaButton>
		</div>
		@if (!string.IsNullOrEmpty(_workResult))
		{
			<p style="font-size: var(--moka-font-size-sm); margin-top: var(--moka-spacing-sm);">Result: <strong>@_workResult</strong></p>
		}

		<MokaDialog Open="@(_viewerAt is not null)" OpenChanged="@(open => _viewerAt = open ? _viewerAt : null)"
		            Title="@($"Picture {_shownPicture + 1}")" DialogSize="MokaDialogSize.Large" Height="70vh"
		            BodyPadding="false" ScrollBody="false" OnKeyDown="StepViewerAsync">
			<HeaderActions>
				<span class="demo-viewer-count" aria-live="polite" aria-atomic="true">@(_shownPicture + 1) / @ViewerColors.Length</span>
			</HeaderActions>
			<ChildContent>
				<div class="demo-viewer" tabindex="-1" data-autofocus>
					<MokaTooltip Text="Previous" Shortcut="←">
						<MokaButton Quiet StartIcon="MokaIcons.Navigation.ChevronLeft" aria-label="Previous"
						            Disabled="@(_shownPicture == 0)" OnClick="() => MoveViewerTo(_shownPicture - 1)"/>
					</MokaTooltip>
					<span class="demo-viewer-picture" style="@($"background: var({ViewerColors[_shownPicture]});")">@(_shownPicture + 1)</span>
					<MokaTooltip Text="Next" Shortcut="→">
						<MokaButton Quiet StartIcon="MokaIcons.Navigation.ChevronRight" aria-label="Next"
						            Disabled="@(_shownPicture == ViewerColors.Length - 1)" OnClick="() => MoveViewerTo(_shownPicture + 1)"/>
					</MokaTooltip>
				</div>
			</ChildContent>
		</MokaDialog>

		<MokaDialog @bind-Open="_logOpen" Title="Build log" DialogSize="MokaDialogSize.Medium" Height="60vh"
		            BodyPadding="false" ScrollBody="false">
			<ChildContent>
				<ol class="demo-log">
					@for (int line = 1; line <= 120; line++)
					{
						<li>@($"{line:000}  Compiled step {line} of 120")</li>
					}
				</ol>
			</ChildContent>
			<Actions>
				<MokaButton Size="MokaSize.Sm" OnClick="@(() => _logOpen = false)">Close</MokaButton>
			</Actions>
		</MokaDialog>
	</ChildContent>
	<Notes>
		<DemoParam Name="OnKeyDown">Every key pressed in the dialog, before Escape closes it</DemoParam>
		<DemoParam Name="ScrollBody=&quot;false&quot;">The body clips, so the one child fills it and the arrows scroll nothing</DemoParam>
		<DemoParam Name="Busy">Escape, the backdrop and the close button can't close it</DemoParam>
		<DemoParam Name="OnConfirmAsync, FailedText">A confirm that runs its work and shows a failure</DemoParam>
		<DemoParam Name="InitialFocus">Content by default: the body, then the actions, never the close button</DemoParam>
		<DemoParam Name="ConfirmAsync(RenderFragment)">A confirm whose body is markup, with the same footer and work</DemoParam>
		<DemoParam Name="MokaDialogActions">A component dialog's buttons in the dialog's own footer</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="Alert" Title="Alert" Description="A message in the page about something that happened." Tip="Give an alert the person can resolve a FixAction, so the fix sits next to the problem.">
	<ChildContent>
		<h3>Severities</h3>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm); max-width: 600px;">
			<MokaAlert Severity="MokaToastSeverity.Info" Title="Information">This is an informational alert.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Success" Title="Success">Operation completed successfully.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Warning" Title="Warning">Please review before continuing.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Error" Title="Error">An error occurred while processing.</MokaAlert>
		</div>

		<h3>Outlined</h3>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm); max-width: 600px;">
			<MokaAlert Severity="MokaToastSeverity.Info" Outlined="true">Outlined info alert.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Success" Outlined="true">Outlined success alert.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Warning" Outlined="true">Outlined warning alert.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Error" Outlined="true">Outlined error alert.</MokaAlert>
		</div>

		<h3>Closable & Dense</h3>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm); max-width: 600px;">
			<MokaAlert Severity="MokaToastSeverity.Info" Closable="true">This alert can be dismissed.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Success" Dense="true">Dense alert with reduced padding.</MokaAlert>
			<MokaAlert Severity="MokaToastSeverity.Warning" Closable="true" Dense="true" Outlined="true">Dense, outlined, closable alert.</MokaAlert>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="Severity">Info, Success, Warning or Error</DemoParam>
		<DemoParam Name="Title">A heading over the text</DemoParam>
		<DemoParam Name="Outlined, Dense">A border instead of a fill, and less padding</DemoParam>
		<DemoParam Name="Closable, OnClose">A close button</DemoParam>
		<DemoParam Name="FixAction">The button that fixes the problem</DemoParam>
		<DemoParam Name="Accent">The accent's tint, whatever the severity</DemoParam>
	</Notes>
	<Playground>
		<AlertPlayground/>
	</Playground>
</DemoSection>

<DemoSection Id="Tooltip" Title="Tooltip" Description="A short name or hint on hover and keyboard focus, in pure CSS." Tip="It shows on hover and on keyboard focus, never after a click, and runs no JavaScript.">
	<ChildContent>
		<div class="button-row">
			<MokaTooltip Text="Tooltip on top" Position="MokaTooltipPosition.Top">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Top</MokaButton>
			</MokaTooltip>
			<MokaTooltip Text="Tooltip on bottom" Position="MokaTooltipPosition.Bottom">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Bottom</MokaButton>
			</MokaTooltip>
			<MokaTooltip Text="Tooltip on left" Position="MokaTooltipPosition.Left">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Left</MokaButton>
			</MokaTooltip>
			<MokaTooltip Text="Tooltip on right" Position="MokaTooltipPosition.Right">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Right</MokaButton>
			</MokaTooltip>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="Text">What it says</DemoParam>
		<DemoParam Name="Content">Rich content in place of the text</DemoParam>
		<DemoParam Name="Position">Top, Bottom, Left, Right, and the Start and End corners</DemoParam>
		<DemoParam Name="Delay">How long before it shows, 300 ms by default</DemoParam>
		<DemoParam Name="MaxWidth">Wraps long text</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="TooltipLooks" Title="Tooltip looks" Description="Seven looks, an arrow, four motions, three sizes, and rich content: a title, an icon or a dot, mono text and key caps." Tip="Pick them for the whole app with WithTooltips, WithTooltipArrows, WithTooltipMotion and WithTooltipSize; a tooltip's own Look, Arrow, Motion and Size win. The original design draws none of them.">
	<ChildContent>
		<h3>Looks</h3>
		<div class="button-row">
			@foreach (MokaTooltipLook look in Enum.GetValues<MokaTooltipLook>())
			{
				<MokaTooltip Id="@($"tt-look-{look}")" Text="@($"{look} tooltip")" Look="look">
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">@look</MokaButton>
				</MokaTooltip>
			}
		</div>

		<h3>Arrow</h3>
		<div class="button-row">
			@foreach (MokaTooltipPosition position in Enum.GetValues<MokaTooltipPosition>())
			{
				<MokaTooltip Id="@($"tt-arrow-{position}")" Text="@($"Arrow, {position}")" Position="position" Arrow="true">
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">@position</MokaButton>
				</MokaTooltip>
			}
			<MokaTooltip Id="tt-arrow-icon" Text="Settings" Position="MokaTooltipPosition.BottomEnd" Arrow="true">
				<MokaButton Quiet StartIcon="MokaIcons.Action.Settings" aria-label="Settings"/>
			</MokaTooltip>
		</div>
		<div class="button-row" style="justify-content: flex-end">
			<MokaTooltip Id="tt-arrow-edge" Text="Near the window's right edge, so the browser slides me along it" Arrow="true" MaxWidth="14rem">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">At the edge</MokaButton>
			</MokaTooltip>
		</div>

		<h3>Motion</h3>
		<div class="button-row">
			@foreach (MokaTooltipMotion motion in Enum.GetValues<MokaTooltipMotion>())
			{
				<MokaTooltip Id="@($"tt-motion-{motion}")" Text="@($"{motion} in")" Motion="motion" Arrow="true">
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">@motion</MokaButton>
				</MokaTooltip>
			}
		</div>

		<h3>Size</h3>
		<div class="button-row">
			@foreach (MokaTooltipSize size in Enum.GetValues<MokaTooltipSize>())
			{
				<MokaTooltip Id="@($"tt-size-{size}")" Text="@($"{size} tooltip")" Size="size">
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">@size</MokaButton>
				</MokaTooltip>
			}
		</div>

		<h3>Rich content</h3>
		<div class="button-row">
			<MokaTooltip Id="tt-rich-shortcut" Text="Command palette" Shortcut="Ctrl+K">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Shortcut</MokaButton>
			</MokaTooltip>
			<MokaTooltip Id="tt-rich-title" Title="Save changes" Text="Writes the draft to disk and keeps a copy of the last version.">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Title</MokaButton>
			</MokaTooltip>
			<MokaTooltip Id="tt-rich-icon" Text="Synced a minute ago" Icon="MokaIcons.Status.CheckCircle">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Icon</MokaButton>
			</MokaTooltip>
			<MokaTooltip Id="tt-rich-dot" Text="web01 is online" Dot="MokaColor.Success">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Dot</MokaButton>
			</MokaTooltip>
			<MokaTooltip Id="tt-rich-mono" Text="192.168.10.24 · 00:1A:2B:3C:4D:5E" Mono>
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">Mono</MokaButton>
			</MokaTooltip>
			<MokaTooltip Id="tt-rich-all" Title="Deploy to production" Text="Runs the checks first, then ships the build." Icon="MokaIcons.Action.Upload" Shortcut="Ctrl+Shift+D" Arrow="true" Position="MokaTooltipPosition.Bottom">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm">All of them</MokaButton>
			</MokaTooltip>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="Look">Standard, Flat, Elevated, Glass, AccentTint, Contrast, Terminal. Null takes the theme's</DemoParam>
		<DemoParam Name="Arrow">An arrow at the trigger. It follows a tooltip the browser moves to another side, and isn't drawn where the browser can't say which side that is</DemoParam>
		<DemoParam Name="Motion">Fade, Slide, Grow, Instant. Slide and Grow fade with reduced motion</DemoParam>
		<DemoParam Name="Size">Compact, Standard, Roomy</DemoParam>
		<DemoParam Name="Title">A bold first line, with Text under it; it wraps at 20rem</DemoParam>
		<DemoParam Name="Shortcut">Key caps after the text, one per key</DemoParam>
		<DemoParam Name="Icon, Dot">A leading icon, or a glowing status dot</DemoParam>
		<DemoParam Name="Mono">Monospace text with figures of one width</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="Progress" Title="Progress" Description="How far along something is, as a bar or a ring." Tip="Leave Value unset until you know how far along it is: an indeterminate bar promises less.">
	<ChildContent>
		<h3>Linear - Determinate</h3>
		<div style="max-width: 400px; display: flex; flex-direction: column; gap: var(--moka-spacing-sm);">
			<MokaProgress Value="25"/>
			<MokaProgress Value="60" ShowValue="true"/>
			<MokaProgress Value="85" ShowValue="true" Striped="true"/>
		</div>

		<h3>Linear - Indeterminate</h3>
		<div style="max-width: 400px;">
			<MokaProgress/>
		</div>

		<h3>Circular - Determinate</h3>
		<div class="button-row">
			<MokaProgress Value="25" ProgressType="MokaProgressType.Circular"/>
			<MokaProgress Value="60" ProgressType="MokaProgressType.Circular" ShowValue="true"/>
			<MokaProgress Value="100" ProgressType="MokaProgressType.Circular" ShowValue="true"/>
		</div>

		<h3>Circular - Indeterminate</h3>
		<MokaProgress ProgressType="MokaProgressType.Circular"/>
	</ChildContent>
	<Notes>
		<DemoParam Name="Value">0 to 100. Leave it out while you do not know</DemoParam>
		<DemoParam Name="ProgressType">Linear or Circular</DemoParam>
		<DemoParam Name="ShowValue">The percent beside or inside it</DemoParam>
		<DemoParam Name="Striped, Thin">Stripes, and a 6 px bar</DemoParam>
		<DemoParam Name="Segments">Several colored parts in one bar</DemoParam>
	</Notes>
	<Playground>
		<ProgressPlayground/>
	</Playground>
</DemoSection>

<DemoSection Id="Spinner" Title="Spinner" Description="Something is loading, in five styles.">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Xl" Align="MokaAlign.Center" Wrap="true">
		<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Circular" Label="Circular"/>
		<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Label="Dots"/>
		<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Pulse" Label="Pulse"/>
		<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Bars" Label="Bars"/>
		<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Ring" Label="Ring"/>
	</MokaFlexbox>

	<h3>Spinner Sizes &amp; Colors</h3>
