<DemoSection Id="SlashMenu" Title="Slash menu" Description="Editor-anchored '/' insertion palette with delegated keyboard handling (arrows, Enter, Esc). Type '/' in the textarea below.">
	<div @ref="_slashEditor" style="position: relative; max-width: 480px;">
		<textarea rows="6" style="width: 100%;" placeholder="Type / to insert..."
		          value="@_slashText"
		          aria-controls="@(_slashOpen ? _slashMenu?.ListboxId : null)"
		          aria-activedescendant="@_slashActiveOption"
		          @oninput="HandleSlashInput"
		          @onkeydown="HandleSlashKeyDown"
		          @onblur="@(() => _slashOpen = false)"></textarea>

		<MokaSlashMenu @ref="_slashMenu"
		               @bind-Open="_slashOpen"
		               Items="_slashItems"
		               Query="@_slashQuery"
		               OnSelect="HandleSlashSelect"
		               Style="left: 0; top: 100%; margin-top: 4px;"/>
	</div>
</DemoSection>

@code {

	// Cheatsheet demo
	private bool _cheatsheetOpen;

	private static readonly IReadOnlyList<MokaCheatsheetGroup> _shortcutGroups =
	[
		new("General",
		[
			new MokaCheatsheetItem("Command palette", ["Ctrl", "K"]),
			new MokaCheatsheetItem("Cheatsheet", ["?"]),
			new MokaCheatsheetItem("Close overlay", ["Esc"])
		]),
		new("Create",
		[
			new MokaCheatsheetItem("New item", ["Ctrl", "N"]),
			new MokaCheatsheetItem("New from template", ["Ctrl", "Shift", "N"])
		]),
		new("Navigate",
		[
			new MokaCheatsheetItem("Go home", ["g", "h"]),
			new MokaCheatsheetItem("Go to settings", ["g", "s"])
		])
	];

	// Slash menu demo
	private MokaSlashMenu? _slashMenu;
	private ElementReference _slashEditor;
	private IJSObjectReference? _slashKeys;
	private string? _slashActiveOption;
	private bool _slashOpen;
	private string _slashText = string.Empty;
	private string _slashQuery = string.Empty;

	private static readonly IReadOnlyList<MokaSlashMenuItem> _slashItems =
	[
		new() { Title = "Heading 1", Description = "# Heading", Category = "struct", Icon = MokaIcons.Action.Edit, Keywords = "h1 title", Value = "# " },
		new() { Title = "Bullet list", Description = "- Item", Category = "struct", Icon = MokaIcons.File.FileText, Keywords = "ul bullets", Value = "- " },
		new() { Title = "Checklist", Description = "- [ ] Item", Category = "struct", Icon = MokaIcons.Status.Check, Keywords = "todo task", Value = "- [ ] " },
		new() { Title = "Code block", Description = "fenced code", Category = "code", Icon = MokaIcons.File.Code, Keywords = "fence pre", Value = "```\n\n```" },
		new() { Title = "Link", Description = "[text](url)", Category = "inline", Icon = MokaIcons.Content.Link, Keywords = "url href", Value = "[text](https://)" }
	];

	private async Task HandleSlashKeyDown(KeyboardEventArgs e)
	{
		if (_slashMenu is not null && await _slashMenu.HandleKeyAsync(e))
		{
			return;
		}

		if (e.Key == "/" && !_slashOpen)
		{
			_slashOpen = true;
			_slashQuery = string.Empty;
		}
	}

	private void HandleSlashInput(ChangeEventArgs e)
	{
		_slashText = e.Value?.ToString() ?? string.Empty;
		if (!_slashOpen)
		{
			return;
		}

		var slash = _slashText.LastIndexOf('/');
		if (slash < 0)
		{
			_slashOpen = false;
			return;
		}

		_slashQuery = _slashText[(slash + 1)..];
	}

	private void HandleSlashSelect(MokaSlashMenuItem item)
	{
		var slash = _slashText.LastIndexOf('/');
		if (slash >= 0)
		{
			_slashText = _slashText[..slash];
		}

		_slashText += item.Value as string ?? item.Title;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// The menu works out its highlight when it renders, which is after this page has, so a
		// change is picked up here and rendered once more for the textarea's aria-activedescendant.
		if (_slashMenu?.ActiveOptionId != _slashActiveOption)
		{
			_slashActiveOption = _slashMenu?.ActiveOptionId;
			StateHasChanged();
		}

		if (!firstRender)
		{
			return;
		}

		// The textarea's own action for the menu's keys is cancelled in the browser, and only while
		// the menu is on the page: Enter only while a row is highlighted. Without it Enter also typed
		// a newline, and on Blazor Server that newline's input event could land after the insert and
		// overwrite it.
		_slashKeys = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Moka.Red.Core/moka-keys.js");
		await _slashKeys.InvokeVoidAsync("preventKeys", _slashEditor, new object[]
		{
			new { selector = "textarea", keys = new[] { "ArrowUp", "ArrowDown", "Escape" }, when = ".moka-slash-menu" },
			new { selector = "textarea", keys = new[] { "Enter" }, when = ".moka-slash-menu [aria-selected=true]" }
		});
	}

	public async ValueTask DisposeAsync()
	{
		if (_slashKeys is not null)
		{
			try
			{
				await _slashKeys.DisposeAsync();
			}
			catch (JSDisconnectedException)
			{
				// The circuit is gone, and the module with it.
			}
		}
	}

	// Notification Bell demo state
	private static readonly IReadOnlyList<MokaNotificationBellItem> _bellNotifications =
	[
		new(Guid.NewGuid(), "Build succeeded", "Pipeline #42 completed.", DateTime.Now.AddMinutes(-5)),
		new(Guid.NewGuid(), "New comment", "Alice replied to your review.", DateTime.Now.AddMinutes(-15), true),
		new(Guid.NewGuid(), "Deploy started", "Production deploy in progress.", DateTime.Now.AddHours(-1))
	];

	// Wizard demo state
	private string _wizardStatus = "";

	// Cookie consent demo state
	private bool _cookieConsentVisible;

	// Onboarding demo state
	private bool _onboardingActive;

	private static readonly MokaOnboardingStep[] _onboardingSteps =
	[
		new() { Title = "Welcome", Description = "Click here to start the tour anytime.", TargetSelector = "#onboard-demo-1" },
