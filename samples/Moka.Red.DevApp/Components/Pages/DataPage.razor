<DemoSection Id="Pagination" Title="Pagination" Description="Page links for a long list, on their own.">
	<MokaPagination TotalItems="247" PageSize="10" CurrentPage="_demoPaginationPage"
	                CurrentPageChanged="p => _demoPaginationPage = p"/>
	<p style="font-size: var(--moka-font-size-xs); margin-top: var(--moka-spacing-xs);">Current page: @_demoPaginationPage</p>
</DemoSection>

<DemoSection Id="VirtualList" Title="Virtual list" Description="Draws only the rows in view, from a list or loaded on demand.">
	<MokaVirtualList Items="_virtualItems" ItemHeight="36" Height="300px" TItem="string">
		<ItemTemplate>
			<span>@context</span>
		</ItemTemplate>
	</MokaVirtualList>

	<h3>Loaded on demand (400K items)</h3>
	<p>Each scroll asks for only the rows in view, after a simulated 150 ms round trip. Scroll fast to see the placeholders.</p>
	<MokaVirtualList TItem="string" ItemsProvider="LoadRemoteRows" ItemHeight="36" Height="300px"
	                 OnItemClick="item => _remoteClicked = item" aria-label="Remote rows">
		<ItemTemplate>
			<span>@context</span>
		</ItemTemplate>
	</MokaVirtualList>
	<p>Requests so far: @_remoteRequests. Last clicked: @(_remoteClicked ?? "none").</p>
</DemoSection>

<DemoSection Id="InfiniteScroll" Title="Infinite scroll" Description="Scrolls to load 10 items at a time, up to 50.">
	<div style="height: 250px; overflow-y: auto; border: 1px solid var(--moka-color-outline-variant); border-radius: var(--moka-radius-md);">
		<MokaInfiniteScroll OnLoadMore="LoadMoreItems" Loading="_infiniteLoading" HasMore="_infiniteHasMore">
			@foreach (var item in _infiniteItems)
			{
				<MokaText Style="padding: var(--moka-spacing-xs) var(--moka-spacing-sm); border-bottom: 1px solid var(--moka-color-outline-variant);">@item</MokaText>
			}
		</MokaInfiniteScroll>
	</div>
</DemoSection>

<DemoGroup Id="Charts" Title="Charts" Description="Pure SVG, token-themed, no charting dependency: sparkline, line, bar and donut.">
	<DemoSection Id="Sparkline" Title="Sparkline" Description="A small line without axes, for a trend beside a number.">
		<MokaFlexbox Gap="MokaSpacingScale.Lg" Align="MokaAlign.Center">
			<MokaSparkline Values="_sparkValues" Size="MokaSize.Sm"/>
			<MokaSparkline Values="_sparkValues" Color="MokaColor.Success"/>
			<MokaSparkline Values="_sparkValues2" Color="MokaColor.Warning" ShowArea="false" Size="MokaSize.Lg"/>
		</MokaFlexbox>
	</DemoSection>

	<DemoSection Id="LineChart" Title="Line chart" Description="Lines over labelled points, with an area if you want one.">
		<MokaLineChart Labels="_monthLabels" Series="_lineSeries" ShowArea="true"/>
	</DemoSection>

	<LiveChartDemo/>

	<DemoSection Id="BarChart" Title="Bar chart" Description="Bars side by side or stacked.">
		<MokaFlexbox Direction="MokaDirection.Column" Gap="MokaSpacingScale.Lg">
			<MokaBarChart Labels="_monthLabels" Series="_barSeries"/>
