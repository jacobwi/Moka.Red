@page "/charts/small"
@using System.Globalization
@using Moka.Red.Layout.Card
@using Moka.Red.Layout.Grid
@using Moka.Red.Primitives.SegmentedControl
@using Moka.Red.Primitives.Typography

<PageTitle>Small charts and wholes - Moka.Red</PageTitle>

<div style="display: flex; flex-direction: column; gap: var(--moka-page-gap);">
	<MokaCard Title="Chart look">
		<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--moka-spacing-md);">
			<MokaSegmentedControl @bind-Value="_look" AriaLabel="Chart look">
				<MokaSegment Value="" Text="Theme's"/>
				@foreach (MokaChartLook look in Enum.GetValues<MokaChartLook>())
				{
					<MokaSegment Value="@look.ToString()" Text="@look.ToString()"/>
				}
			</MokaSegmentedControl>
			<MokaSegmentedControl @bind-Value="_texture" AriaLabel="Texture">
				<MokaSegment Value="" Text="Theme's"/>
				<MokaSegment Value="on" Text="Hatched"/>
			</MokaSegmentedControl>
		</div>
	</MokaCard>

	<MokaGrid MinColumn="20rem" Gap="MokaSpacingScale.Md">
		<MokaCard Title="Ring (T4A, S1)" data-demo="ring">
			<MokaDonutChart Title="Traffic share" Subtitle="Today" Segments="@Services" Look="@Look" Texture="@Texture"
			                Formatter="Compact" Label="Traffic share today">
				<b>@Compact(Services.Sum(s => s.Value))</b>
			</MokaDonutChart>
		</MokaCard>

		<MokaCard Title="Tall segmented bar (T4A)" data-demo="segbar">
			<MokaDonutChart Shape="MokaDonutShape.Bar" Title="Storage on nas-01" Subtitle="2 TB volume, by what fills it"
			                Segments="@Storage" Total="2000" Look="@Look" Texture="@Texture" Formatter="Gb">
				<b>1.62 TB</b> used of 2 TB
			</MokaDonutChart>
		</MokaCard>

		<MokaCard Title="Waffle (T4C)" data-demo="waffle">
			<MokaDonutChart Shape="MokaDonutShape.Waffle" Title="Traffic by protocol on the LAN"
			                Subtitle="Share of bytes today. Each square is 1%" Segments="@Protocols" Look="@Look"
			                Texture="@Texture"/>
		</MokaCard>

		<MokaCard Title="Classic ring" data-demo="classic">
			<MokaDonutChart Segments="@Services" Label="Classic donut" Formatter="Compact"/>
		</MokaCard>

		<MokaCard Title="A link in the center" data-demo="center-link">
			<MokaDonutChart Title="Traffic share" Subtitle="The center's link and button take clicks" Segments="@Services"
			                Look="@Look" Texture="@Texture" Formatter="Compact" Label="Traffic share with a link">
				<MokaLink OnClick="() => _centerShowsShare = !_centerShowsShare">
					@(_centerShowsShare ? "53% web" : Compact(Services.Sum(s => s.Value)))
				</MokaLink>
			</MokaDonutChart>
			<MokaDonutChart Segments="@Services" Label="Classic donut with a link" Formatter="Compact">
				<a href="/charts/small#center-link" @onclick="() => _centerClicks++" @onclick:preventDefault>Clicked @_centerClicks</a>
			</MokaDonutChart>
			<p class="demo-center-clicks">The classic ring's link was clicked @_centerClicks times.</p>
		</MokaCard>
	</MokaGrid>

	<MokaCard Title="Treemap (T4B)" data-demo="treemap">
		<MokaTreemap Title="@(_drill is null ? "Disk use by folder on nas-01" : $"Inside {_drill.Name}")"
		             Subtitle="1.62 TB used, colored by top folder" Nodes="@TreeShown" Formatter="Gb" Look="@Look"
		             OnNodeClick="Drill"/>
		@if (_drill is not null)
		{
			<MokaButton Variant="MokaVariant.Text" OnClick="() => _drill = null">Back to every folder</MokaButton>
		}
	</MokaCard>

	<MokaGrid MinColumn="22rem" Gap="MokaSpacingScale.Md">
		<MokaCard Title="Sankey (T4E)" data-demo="sankey">
			<MokaSankey Title="Where requests went" Subtitle="Thousands of requests a minute, last hour" Links="@Requests"
			            Nodes="@RequestNames" Formatter="Thousands" Look="@Look"/>
		</MokaCard>

		<MokaCard Title="Sankey, too many a side" data-demo="sankey-fold">
			<MokaSankey Title="WAN to devices" Subtitle="Folds past four a side" Links="@Fan" MaxNodesPerSide="4"
			            Formatter="Gb" Look="@Look"/>
		</MokaCard>

		<MokaCard Title="Sankey, three columns" data-demo="sankey-three">
			<MokaSankey Title="Through the router" Links="@Router" Formatter="Gb" Look="@Look"/>
		</MokaCard>

		<MokaCard Title="Sankey, flows in their own colors" data-demo="sankey-links">
			<MokaSankey Title="Where the traffic goes" Subtitle="Click a flow or a node" Links="@Traffic" Formatter="Gb"
			            Look="@Look" Tooltip="MokaChartTooltip.Auto" Keyboard="true" OnPointClick="Picked"/>
			<MokaCaption data-demo-picked>@_picked</MokaCaption>
		</MokaCard>
	</MokaGrid>

	<MokaCard Title="Matrix heatmap (T6B)" data-demo="heatmap">
		<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Blocked" RowLabels="@Days" ColumnLabels="MokaHeatmap.HourNames"
		             ShowScale="true" Label="Blocked connections by hour and weekday" Look="@Look"
		             CellText="BlockedText"/>
	</MokaCard>

	<MokaCard Title="Heatmap filling the card, with totals, today and now" data-demo="heatmap-fill">
		<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Presence" RowLabels="@PresenceDays" RowFigures="@PresenceTotals"
		             ColumnLabels="MokaHeatmap.HourNames" Fill="true" MarkedRows="@([6])" MarkedCells="@([new MokaHeatmapCell(6, NowHour)])"
		             MaxGridValue="60" UnknownText="later today" CellText="PresenceText" ShowScale="true"
		             ScalePlacement="MokaHeatmapScalePlacement.GridEnd" LessText="A few minutes" MoreText="The whole hour"
		             Label="On the network this week" Look="@Look"/>
	</MokaCard>

	<MokaCard Title="Heatmap with larger cells, key under the cells" data-demo="heatmap-size">
		<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Blocked" RowLabels="@Days" ColumnLabels="MokaHeatmap.HourNames"
		             CellSize="1.75rem" ShowScale="true" ScalePlacement="MokaHeatmapScalePlacement.GridEnd"
		             Label="Blocked connections by hour and weekday" Look="@Look" CellText="BlockedText"/>
	</MokaCard>

	<MokaCard Title="In a centred flex parent" data-demo="centred">
		<div style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--moka-spacing-md);">
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Presence" RowLabels="@PresenceDays" RowFigures="@PresenceTotals"
			             ColumnLabels="MokaHeatmap.HourNames" Fill="true" MaxGridValue="60" Label="Presence, centred"/>
			<MokaSankey Links="@Traffic" Formatter="Gb" Label="Traffic, centred"/>
			<MokaMeter Label="Office" Value="62" ColorValue="var(--moka-label-teal, var(--moka-color-info))" Figure="62%"/>
		</div>
	</MokaCard>

	<MokaCard Title="Calendar heatmap with the five-step ramp" data-demo="calendar">
		<MokaHeatmap Data="@Commits" Weeks="26" Ramp="MokaHeatmapRamp.Steps" ShowScale="true" Label="Commits"/>
	</MokaCard>

	<MokaCard Title="Heatmap as a chart: its own tooltip, keys, pin, table and export" data-demo="heatmap-chart">
		<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Presence" RowLabels="@PresenceDays" RowFigures="@PresenceTotals"
		             ColumnLabels="MokaHeatmap.HourNames" Fill="true" MarkedRows="@([6])" MarkedCells="@([new MokaHeatmapCell(6, NowHour)])"
		             MaxGridValue="60" UnknownText="later today" CellText="PresenceText" ShowScale="true"
		             ScalePlacement="MokaHeatmapScalePlacement.GridEnd" LessText="A few minutes" MoreText="The whole hour"
		             Title="On the network this week" Subtitle="Minutes in each hour. Arrow keys walk the cells"
		             Tooltip="MokaChartTooltip.Auto" Keyboard="true" Pinnable="true" Formatter="Minutes"
		             Controls="MokaChartControls.View | MokaChartControls.Export" OnPointClick="PickedCell" Look="@Look"/>
		<MokaCaption data-demo-cell>@_cell</MokaCaption>
	</MokaCard>

	<MokaCard Title="Calendar heatmap as a chart: Up and Down a day, Left and Right a week" data-demo="calendar-chart">
		<MokaHeatmap Data="@Commits" Weeks="26" Ramp="MokaHeatmapRamp.Steps" ShowScale="true" Title="Commits"
		             Subtitle="The last 26 weeks" Tooltip="MokaChartTooltip.Auto" Keyboard="true"
		             Unknown="@CollectorDown" UnknownText="Collector down" ActiveChanged="DayActive" Look="@Look"/>
		<MokaCaption data-demo-day>@_day</MokaCaption>
	</MokaCard>

	<MokaGrid MinColumn="22rem" Gap="MokaSpacingScale.Md">
		<MokaCard Title="This week, in a sync group" data-demo="heatmap-sync-a">
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Blocked" RowLabels="@Days" ColumnLabels="MokaHeatmap.HourNames"
			             Title="Blocked this week" SyncGroup="blocked" Tooltip="MokaChartTooltip.Auto" CellText="BlockedText"
			             Look="@Look"/>
		</MokaCard>
		<MokaCard Title="Last week, the same cell lights" data-demo="heatmap-sync-b">
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@BlockedBefore" RowLabels="@Days" ColumnLabels="MokaHeatmap.HourNames"
			             Title="Blocked last week" SyncGroup="blocked" Tooltip="MokaChartTooltip.Auto" CellText="BlockedText"
			             Look="@Look"/>
		</MokaCard>
	</MokaGrid>

	<MokaCard Title="Heatmap chart in a centred flex parent" data-demo="centred-chart">
		<div style="display: flex; justify-content: center; align-items: center;">
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@Blocked" RowLabels="@Days" ColumnLabels="MokaHeatmap.HourNames"
			             Title="Blocked, centred" Tooltip="MokaChartTooltip.Auto" Keyboard="true" Look="@Look"/>
		</div>
	</MokaCard>

	<MokaCard Title="Large heatmaps" data-demo="heatmap-large">
		<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-sm);">
			<MokaButton Variant="MokaVariant.Outlined" OnClick="ToggleLarge" data-demo-large>@(_large ? "Hide" : "Draw a 53-week calendar and a 100 by 100 grid")</MokaButton>
			@if (_large)
			{
				<MokaButton Variant="MokaVariant.Outlined" OnClick="ChangeLarge" data-demo-change>Change the data</MokaButton>
				<MokaSegmentedControl @bind-Value="_largeAs" AriaLabel="Drawn as">
					<MokaSegment Value="chart" Text="As a chart"/>
					<MokaSegment Value="today" Text="As today"/>
				</MokaSegmentedControl>
			}
		</div>
		@if (_large && _largeAs == "today")
		{
			<MokaHeatmap Data="@_year" ShowScale="true" data-demo-year/>
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@_big" CellSize="0.75rem" data-demo-big/>
		}
		else if (_large)
		{
			<MokaHeatmap Data="@_year" Title="A year" Tooltip="MokaChartTooltip.Auto" Keyboard="true" ShowScale="true"
			             Controls="MokaChartControls.View" data-demo-year/>
			<MokaHeatmap Layout="MokaHeatmapLayout.Grid" GridValues="@_big" Title="100 by 100" CellSize="0.75rem"
			             Tooltip="MokaChartTooltip.Auto" Keyboard="true" Controls="MokaChartControls.View" data-demo-big/>
		}
	</MokaCard>

	<MokaGrid MinColumn="20rem" Gap="MokaSpacingScale.Md">
		<MokaCard Title="Bullet (T5A)" data-demo="bullet">
			<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-md);">
				@foreach ((string name, double now, double target) in Load)
				{
					<MokaMeter Label="@name" Value="now" Target="target" Segments="@Ranges" Figure="@($"{now}%")"/>
				}
			</div>
		</MokaCard>

		<MokaCard Title="Meter list (T5D)" data-demo="meters">
			<div class="moka-meter-rows" style="row-gap: var(--moka-spacing-sm); column-gap: var(--moka-spacing-md);">
				@foreach ((string name, double used, double size, string unit) in Volumes)
				{
					<MokaMeter Layout="MokaMeterLayout.Row" Label="@name" Value="used" Max="size" WarnAt="0.8"
					           CriticalAt="0.95" Figure="@($"{used} of {size} {unit}")"/>
				}
			</div>
		</MokaCard>

		<MokaCard Title="Meters in buttons, in each zone's color" data-demo="meter-buttons">
			<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--moka-spacing-sm);">
				@foreach ((string name, double full, string color) in Zones)
				{
					<button type="button" class="devapp-zone" style="@($"--zone: {color}")" @onclick="() => _zone = name"
					        aria-pressed="@(_zone == name ? "true" : "false")">
						<span>@name</span>
						<MokaMeter Value="full" Max="1" ShowValue="false" Size="MokaSize.Sm" ColorValue="var(--zone)"
						           Figure="@($"{full:P0}")" WarnAt="0.8" WarnText="Getting full" CriticalAt="0.95" CriticalText="Nearly full"/>
					</button>
				}
			</div>
			<MokaCaption>@(_zone is null ? "Pick a zone" : $"Picked {_zone}")</MokaCaption>
		</MokaCard>
	</MokaGrid>

	<MokaCard Title="KPI tiles (T5B)" data-demo="kpi">
		<MokaGrid MinColumn="11rem" Gap="MokaSpacingScale.Sm">
			<MokaStat Tile="true" Value="1.28M" Label="Requests today" Trend="4.2" TrendLabel="vs yesterday" Spark="@RequestsByHour"/>
			<MokaStat Tile="true" Value="212 ms" Label="p95 latency" Trend="-8" TrendLabel="vs yesterday" UpIsGood="false"
			          Spark="@LatencyByHour"/>
			<MokaStat Tile="true" Value="0.42%" Label="Error rate" Trend="0.11" TrendLabel="vs yesterday" UpIsGood="false"
			          Spark="@ErrorsByHour"/>
		</MokaGrid>
	</MokaCard>
</div>

@code {
	private bool _centerShowsShare;
	private int _centerClicks;

	private static readonly MokaDonutSegment[] Services =
	[
		new() { Name = "Web", Value = 41200 },
		new() { Name = "API", Value = 23800 },
		new() { Name = "Jobs", Value = 9100 },
		new() { Name = "Admin", Value = 4300 }
	];

	private static readonly MokaDonutSegment[] Storage =
	[
		new() { Name = "Media", Value = 864 },
		new() { Name = "Backups", Value = 476 },
		new() { Name = "Work", Value = 185 },
		new() { Name = "System", Value = 95 }
	];

	private static readonly MokaDonutSegment[] Protocols =
	[
		new() { Name = "HTTPS", Value = 62 },
		new() { Name = "QUIC", Value = 24 },
		new() { Name = "DNS", Value = 4 },
		new() { Name = "Other", Value = 10, ColorValue = "var(--moka-color-on-surface-tertiary)" }
	];

	private static readonly MokaTreemapNode[] Tree =
	[
		new("Media", 0) { Children = [new("Photos", 412) { Children = [new("2024", 180), new("2023", 140), new("Older", 92)] }, new("Videos", 388), new("Music", 64)] },
		new("Backups", 0) { Children = [new("Laptop", 236), new("Server", 142), new("Phone", 98)] },
		new("Work", 0) { Children = [new("Projects", 121), new("Mail", 38), new("Documents", 26)] },
		new("System", 95)
	];

	private static readonly MokaSankeyLink[] Requests =
	[
		new("web", "cache", 3.4), new("web", "db", 1.9), new("web", "storage", 0.5),
		new("api", "cache", 1.1), new("api", "db", 1.5), new("api", "storage", 0.5),
		new("jobs", "cache", 0.1), new("jobs", "db", 0.4), new("jobs", "storage", 0.6)
	];

	private static readonly MokaSankeyNode[] RequestNames =
	[
		new("web", "Web"), new("api", "API"), new("jobs", "Jobs"),
		new("cache", "Cache"), new("db", "Database"), new("storage", "Storage")
	];

	private static readonly MokaSankeyLink[] Fan =
		[.. new[] { "nas-01", "laptop-ana", "phone-bo", "tv", "printer", "camera-front", "thermostat", "doorbell" }
			.Select((name, i) => new MokaSankeyLink("WAN", name, Math.Round(48d / (i + 1), 1)))];

	private static readonly MokaSankeyLink[] Router =
	[
		new("WAN", "Router", 20), new("VPN", "Router", 4), new("Router", "LAN", 12), new("Router", "Wi-Fi", 9),
		new("Router", "Guest", 3)
	];

	private static readonly IReadOnlyList<string> Days = MokaHeatmap.WeekdayNames(CultureInfo.InvariantCulture);

	private static readonly IReadOnlyList<IReadOnlyList<double>> Blocked =
	[
		.. Enumerable.Range(0, 7).Select(d => (IReadOnlyList<double>)
		[
			.. Enumerable.Range(0, 24).Select(h => Math.Round(30 + 360 * Bell(h, 3.5, 1.6) + 120 * Bell(h, 21, 2) * (d >= 5 ? 1.6 : 1)
			                                                + (d == 1 ? 140 * Bell(h, 4, 1) : 0) + (d * 7 + h * 13) % 40))
		])
	];

	private static readonly Dictionary<DateTime, int> Commits = Enumerable.Range(0, 180)
		.Select(i => DateTime.Today.AddDays(-i))
		.Where(day => (day.DayOfYear * 7) % 5 != 0)
		.ToDictionary(day => day, day => (day.DayOfYear * 13) % 9);

	private static readonly (string Name, double Now, double Target)[] Load =
		[("CPU", 62, 70), ("Memory", 71, 80), ("Disk I/O", 48, 85), ("WAN link", 88, 75)];

	private static readonly MokaMeterSegment[] Ranges = [new(0, 60, ""), new(60, 85, ""), new(85, 100, "")];

	private static readonly (string Name, double Used, double Size, string Unit)[] Volumes =
		[("System", 41, 64, "GB"), ("Data", 1.2, 2, "TB"), ("Backups", 3.4, 4, "TB"), ("Scratch", 0.2, 1, "TB"), ("Logs", 19.4, 20, "GB")];

	private static readonly double[] RequestsByHour =
		[.. Enumerable.Range(0, 24).Select(h => Math.Round(18000 + 52000 * Bell(h, 14, 4) + 20000 * Bell(h, 20, 2)))];

	private static readonly double[] LatencyByHour = [.. Enumerable.Range(0, 24).Select(h => Math.Round(180 + 60 * Bell(h, 13, 2.5)))];

	private static readonly double[] ErrorsByHour = [.. Enumerable.Range(0, 24).Select(h => 0.25 + 0.3 * Bell(h, 19, 1.5))];

	private static readonly MokaSankeyLink[] Traffic =
	[
		new("laptop", "web", 14), new("laptop", "video", 6), new("tv", "video", 22), new("phone", "web", 5),
		new("camera", "cloud", 3) { Color = MokaColor.Warning }, new("phone", "cloud", 1),
		new("web", "US", 12), new("web", "DE", 7), new("video", "US", 28), new("cloud", "CN", 4) { Color = MokaColor.Error }
	];

	private const int NowHour = 15;

	private static readonly IReadOnlyList<string> PresenceDays = ["Thu 5", "Fri 6", "Sat 7", "Sun 8", "Mon 9", "Tue 10", "Today"];

	private static readonly IReadOnlyList<IReadOnlyList<double>> Presence =
	[
		.. Enumerable.Range(0, 7).Select(d => (IReadOnlyList<double>)
		[
			.. Enumerable.Range(0, 24).Select(h => d == 6 && h > NowHour
				? double.NaN
				: Math.Min(60, Math.Round(60 * Bell(h, 13, 4.5) * (d is 2 or 3 ? 0.4 : 1) + (d * 11 + h * 7) % 9)))
		])
	];

	private static readonly IReadOnlyList<string> PresenceTotals =
		[.. Presence.Select(row => (row.Where(double.IsFinite).Sum() / 60).ToString("0.0", CultureInfo.InvariantCulture) + " h")];

	private static readonly (string Name, double Full, string Color)[] Zones =
		[("Office", 0.42, "var(--moka-label-teal)"), ("Guest", 0.86, "var(--moka-label-violet)"), ("Cameras", 0.97, "var(--moka-label-pink)"), ("Lab", 0.12, "var(--moka-label-lime)")];

	private static readonly IReadOnlyList<IReadOnlyList<double>> BlockedBefore =
		[.. Blocked.Select(row => (IReadOnlyList<double>)[.. row.Select((value, hour) => Math.Round(value * (0.7 + (hour % 5) * 0.12)))])];

	private static readonly DateTime[] CollectorDown = [DateTime.Today.AddDays(-40), DateTime.Today.AddDays(-39), DateTime.Today.AddDays(-38)];

	private string _look = "";
	private string _texture = "";
	private MokaTreemapNode? _drill;
	private string _picked = "Nothing picked yet";
	private string? _zone;
	private string _cell = "Click a cell, or press Enter on one";
	private string _day = "Point at a day";
	private bool _large;
	private string _largeAs = "chart";
	private int _seed;
	private Dictionary<DateTime, int> _year = [];
	private IReadOnlyList<IReadOnlyList<double>> _big = [];

	private void PickedCell(MokaChartPoint point) =>
		_cell = $"Row {point.Row}, column {point.Column}: {point.Category}, {point.ValueText}";

	private void DayActive(MokaChartPoint? point) =>
		_day = point is null ? "Point at a day" : $"{point.Time:yyyy-MM-dd}, week {point.Column}, weekday {point.Row}: {point.ValueText}";

	private void ToggleLarge()
	{
		_large = !_large;
		if (_large)
		{
			FillLarge();
		}
	}

	private void ChangeLarge()
	{
		_seed++;
		FillLarge();
	}

	private void FillLarge()
	{
		_year = Enumerable.Range(0, 371).Select(i => DateTime.Today.AddDays(-i))
			.ToDictionary(day => day, day => (day.DayOfYear * 7 + _seed * 3) % 11);
		_big = [.. Enumerable.Range(0, 100).Select(r => (IReadOnlyList<double>)[.. Enumerable.Range(0, 100).Select(c => (double)((r * 31 + c * 17 + _seed * 13) % 97))])];
	}

	private static string Minutes(double value) => value.ToString("0", CultureInfo.InvariantCulture) + " min";

	private void Picked(MokaChartPoint point) => _picked = point.ToKey is { } to
		? $"Flow from {point.SeriesKey} to {to} ({point.SeriesName} to {point.ToName}), {point.ValueText}"
		: $"Node {point.SeriesKey}, {point.ValueText}";

	private static string? PresenceText(int row, int hour, double minutes) => double.IsNaN(minutes)
		? $"{PresenceDays[row]}, {MokaHeatmap.HourNames[hour]}:00: later today"
		: $"{PresenceDays[row]}, {MokaHeatmap.HourNames[hour]}:00: {minutes.ToString("0", CultureInfo.InvariantCulture)} min{(row == 6 && hour == NowHour ? " so far" : "")}";

	private MokaChartLook? Look => Enum.TryParse(_look, out MokaChartLook look) ? look : null;

	private bool? Texture => _texture == "on" ? true : null;

	private IReadOnlyList<MokaTreemapNode> TreeShown => _drill?.Children ?? Tree;

	private void Drill(MokaTreemapNode node)
	{
		if (node.Children is { Count: > 0 })
		{
			_drill = node;
		}
	}

	private static double Bell(double x, double mid, double width) => Math.Exp(-Math.Pow((x - mid) / width, 2) / 2);

	private static string Compact(double value) => value >= 1000
		? (value / 1000).ToString("0.#", CultureInfo.InvariantCulture) + "K"
		: value.ToString("0", CultureInfo.InvariantCulture);

	private static string Gb(double value) => value.ToString("#,0.#", CultureInfo.InvariantCulture) + " GB";

	private static string Thousands(double value) => value.ToString("0.0", CultureInfo.InvariantCulture) + "K";

	private string BlockedText(int row, int column, double value) =>
		$"{Days[row]} {MokaHeatmap.HourNames[column]}:00 to {MokaHeatmap.HourNames[(column + 1) % 24]}:00, {value.ToString("#,0", CultureInfo.InvariantCulture)} blocked";
}
