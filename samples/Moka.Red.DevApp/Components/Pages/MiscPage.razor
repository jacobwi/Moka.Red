@page "/misc"

<PageTitle>Misc - Moka.Red</PageTitle>

<h1>Misc</h1>
<p class="page-desc">Ribbon, Toolbar, StatusBar, List, ButtonGroup, and Diagnostics demo.</p>

<DemoSection Id="Ribbon" Title="Ribbon" Description="A ribbon across the corner of a card.">
	<div style="display: flex; gap: var(--moka-spacing-lg); flex-wrap: wrap;">
		<MokaRibbon Text="NEW" Color="MokaColor.Primary">
			<MokaCard Title="Product Card" Subtitle="With ribbon badge" style="width: 200px;">
				<ChildContent>
					<p>This card has a "NEW" ribbon.</p>
				</ChildContent>
			</MokaCard>
		</MokaRibbon>

		<MokaRibbon Text="SALE" Color="MokaColor.Error">
			<MokaCard Title="On Sale" style="width: 200px;">
				<ChildContent>
					<p>50% off everything!</p>
				</ChildContent>
			</MokaCard>
		</MokaRibbon>

		<MokaRibbon Text="BETA" Color="MokaColor.Info" Position="MokaRibbonPosition.TopLeft">
			<MokaCard Title="Beta Feature" style="width: 200px; text-align: right;">
				<ChildContent>
					<p>Try our new beta feature.</p>
				</ChildContent>
			</MokaCard>
		</MokaRibbon>
	</div>
</DemoSection>

<DemoSection Id="Toolbar" Title="Toolbar" Description="A row of grouped controls.">
	<div style="max-width: 600px;">
		<MokaToolbar>
			<MokaToolbarGroup>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">B</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">I</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">U</MokaButton>
			</MokaToolbarGroup>
			<MokaToolbarDivider/>
			<MokaToolbarGroup Label="Align">
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">L</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">C</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm">R</MokaButton>
			</MokaToolbarGroup>
			<MokaToolbarDivider/>
			<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" StartIcon="MokaIcons.Content.Link">Link</MokaButton>
			<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" StartIcon="MokaIcons.Content.Image">Image</MokaButton>
		</MokaToolbar>
	</div>
</DemoSection>

<DemoSection Id="StatusBar" Title="Status bar" Description="Status along the bottom of an app or a panel.">
	<p style="font-size: var(--moka-font-size-sm); color: var(--moka-color-on-surface-variant);">
		A status bar is rendered fixed at the bottom of this page. With <code>Fixed="false"</code> it sits under a panel
		instead:
	</p>
	<div id="inline-statusbar" style="border: 1px solid var(--moka-color-outline-variant); border-radius: var(--moka-radius-md); overflow: hidden;">
		<div style="padding: var(--moka-spacing-lg);">A file list would be here.</div>
		<MokaStatusBar Fixed="false">
			<StartContent>
				<MokaStatusBarItem Text="128 items"/>
				<MokaStatusBarItem Text="3 selected, 4.2 MB"/>
			</StartContent>
			<EndContent>
				<MokaStatusBarItem Icon="MokaIcons.Action.Download" Text="2 transfers" Tooltip="Running transfers"/>
			</EndContent>
		</MokaStatusBar>
	</div>

	<MokaStatusBar>
		<StartContent>
			<MokaStatusBarItem Icon="MokaIcons.File.Code" Text="main" Tooltip="Current branch"/>
			<MokaStatusBarItem Text="Ln 42, Col 18" Tooltip="Cursor position"/>
		</StartContent>
		<EndContent>
			<MokaStatusBarItem Text="UTF-8" Tooltip="File encoding"/>
			<MokaStatusBarItem Text="C#" Tooltip="Language mode"/>
			<MokaStatusBarItem Icon="MokaIcons.Status.CheckCircle" Text="0 Errors" Tooltip="No problems"/>
		</EndContent>
	</MokaStatusBar>
</DemoSection>

<DemoSection Id="StatusBarLooks" Title="Status bar looks" Component="MokaStatusBar" Description="Every Look, each Expandable, so a narrow window folds what doesn't fit behind a +N button.">
	<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm);">
		@foreach (MokaStatusBarLook look in Enum.GetValues<MokaStatusBarLook>())
		{
			<MokaCaption Micro="true">@look</MokaCaption>
			<MokaStatusBar Fixed="false" Look="look" Expandable="true">
				<StartContent>
					<MokaStatusBarItem Icon="MokaIcons.Status.CheckCircle" Text="Connected" Priority="10" OnClick="@(() => { })"/>
					<MokaStatusBarSeparator/>
					<MokaStatusBarItem Text="main" OnClick="@(() => { })"/>
					<MokaStatusBarItem Text="2 problems" Tooltip="Open the problems list" OnClick="@(() => { })"/>
				</StartContent>
				<EndContent>
					<MokaStatusBarItem Text="UTF-8"/>
					<MokaStatusBarItem Text="Ln 12, Col 4" OnClick="@(() => { })"/>
				</EndContent>
			</MokaStatusBar>
		}
	</div>
</DemoSection>

<DemoSection Id="ButtonGroup" Title="Button group" Description="Buttons joined into one control, in a row or a column.">
	<h3>Outlined Row</h3>
	<MokaButtonGroup>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Primary">Left</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Primary">Center</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Primary">Right</MokaButton>
	</MokaButtonGroup>

	<h3>Filled Row</h3>
	<MokaButtonGroup>
		<MokaButton Color="MokaColor.Primary">Save</MokaButton>
		<MokaButton Color="MokaColor.Primary" StartIcon="MokaIcons.Navigation.ChevronDown"/>
	</MokaButtonGroup>

	<h3>Column</h3>
	<MokaButtonGroup Orientation="MokaDirection.Column">
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface">Option A</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface">Option B</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface">Option C</MokaButton>
	</MokaButtonGroup>
</DemoSection>

<DemoSection Id="List" Title="List" Description="Rows with icons, a second line and content at the end. Clickable rows take the keyboard.">
	<h3>Basic List</h3>
	<div style="width: 320px;">
		<MokaList Bordered>
			<MokaListItem Text="Inbox" SecondaryText="5 unread messages" Icon="MokaIcons.Content.Filter"/>
			<MokaListItem Text="Drafts" SecondaryText="2 drafts" Icon="MokaIcons.File.Document" Divider/>
			<MokaListItem Text="Sent" Icon="MokaIcons.Navigation.ArrowRight"/>
			<MokaListItem Text="Trash" Icon="MokaIcons.Action.Delete" Disabled/>
		</MokaList>
	</div>

	<h3>Active + End Content</h3>
	<div style="width: 320px;">
		<MokaList Bordered>
			<MokaListItem Text="Dashboard" Icon="MokaIcons.Navigation.Home" Active/>
			<MokaListItem Text="Settings" Icon="MokaIcons.Action.Settings" EndIcon="MokaIcons.Navigation.ChevronRight"/>
			<MokaListItem Text="Profile" Icon="MokaIcons.Toggle.Eye">
				<EndContent>
					<MokaAttribute Size="MokaSize.Xs" Color="MokaColor.Success" Variant="MokaVariant.Soft">Online</MokaAttribute>
				</EndContent>
			</MokaListItem>
		</MokaList>
	</div>

	<h3>Clickable (Tab to a row, then Enter or Space)</h3>
	<div style="width: 320px;">
		<MokaList Bordered>
			<MokaListItem Text="Inbox" Icon="MokaIcons.Content.Filter" OnClick="@(() => _lastListClick = "Inbox")"/>
			<MokaListItem Text="Drafts" Icon="MokaIcons.File.Document" OnClick="@(() => _lastListClick = "Drafts")">
				<EndContent>
					@* Stops the button's click reaching the row, for mouse and keyboard alike *@
					<span @onclick:stopPropagation="true">
						<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Text"
						            OnClick="@(() => _lastListClick = "Drafts: Archive button")">Archive</MokaButton>
					</span>
				</EndContent>
			</MokaListItem>
			<MokaListItem Text="Trash" Icon="MokaIcons.Action.Delete" Disabled OnClick="@(() => _lastListClick = "Trash")"/>
		</MokaList>
	</div>
	<p>Last activated: <code id="list-last-activated">@(_lastListClick ?? "nothing yet")</code></p>
</DemoSection>

<DemoSection Id="Diagnostics" Title="Diagnostics" Component="DiagnosticComponentBase">
	<p style="font-size: var(--moka-font-size-sm); color: var(--moka-color-on-surface); margin-bottom: var(--moka-spacing-md);">
		These counters extend <code>DiagnosticComponentBase</code>. Click buttons to generate render data,
		then open the Diagnostics panel (M badge or Ctrl+Shift+D) and check the <strong>Render</strong> and <strong>Perf</strong> tabs.
	</p>
	<div class="button-row">
		<DiagDemoCounter Label="Counter A"/>
		<DiagDemoCounter Label="Counter B"/>
		<DiagDemoCounter Label="Counter C"/>
	</div>
</DemoSection>

@code {
	private string? _lastListClick;
}
