@page "/media"
@using Moka.Red.Primitives.Bytes
@inject IWebHostEnvironment Environment

<PageTitle>Media - Moka.Red</PageTitle>

<h1>Media</h1>
<p class="page-desc">Carousel, VideoEmbed, Gallery, Lightbox, Chat, QRCode, Barcode, and Countdown.</p>

<DemoSection Id="Carousel" Title="Carousel" Description="Slides with arrows and dots.">
	<div style="max-width: 600px;">
		<MokaCarousel @bind-ActiveIndex="_carouselIndex">
			<MokaCarouselSlide>
				<div style="display: flex; align-items: center; justify-content: center; height: 240px; background: var(--moka-color-primary); color: var(--moka-color-on-primary); font-size: var(--moka-font-size-xl);">
					Slide 1
				</div>
			</MokaCarouselSlide>
			<MokaCarouselSlide>
				<div style="display: flex; align-items: center; justify-content: center; height: 240px; background: var(--moka-color-secondary); color: var(--moka-color-on-secondary); font-size: var(--moka-font-size-xl);">
					Slide 2
				</div>
			</MokaCarouselSlide>
			<MokaCarouselSlide>
				<div style="display: flex; align-items: center; justify-content: center; height: 240px; background: var(--moka-color-success); color: var(--moka-color-on-success); font-size: var(--moka-font-size-xl);">
					Slide 3
				</div>
			</MokaCarouselSlide>
		</MokaCarousel>
		<p style="margin-top: var(--moka-spacing-sm); font-size: var(--moka-font-size-sm);">Active index: @_carouselIndex</p>
	</div>
</DemoSection>

<DemoSection Id="VideoEmbed" Title="Video embed" Description="A YouTube or Vimeo video, or a plain video file.">
	<div style="max-width: 560px;">
		<MokaVideoEmbed Src="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
		                Title="YouTube Demo"
		                Rounded="MokaRounding.Md"/>
	</div>
</DemoSection>

<DemoSection Id="MediaGallery" Title="Media gallery" Description="Thumbnails that open in a lightbox.">
	<div style="max-width: 500px;">
		<MokaMediaGallery Items="_galleryItems" Columns="3"/>
	</div>
</DemoSection>

<DemoSection Id="MediaGalleryStates" Title="Tile states" Component="MokaMediaGallery"
             Description="A skeleton while a thumbnail is on its way, and a struck-out picture for one that can't be shown.">
	<ChildContent>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-md); max-width: 640px;">
			<MokaMediaGallery Items="_stateItems" Columns="4"/>
			<div style="display: flex; gap: var(--moka-spacing-sm); align-items: center; flex-wrap: wrap;">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" OnClick="ToggleThumbnails">
					@(_thumbnailsArrived ? "Start over" : "Thumbnails arrive")
				</MokaButton>
				<MokaCaption>Tile 1 waits with <code>Loading</code>, tile 2 has no thumbnail yet, tile 3 is <code>Failed</code> and tile 4's thumbnail fails to load.</MokaCaption>
			</div>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="MokaMediaItem.Loading">Draws a skeleton; so does an item with no thumbnail source at all</DemoParam>
		<DemoParam Name="MokaMediaItem.Failed">Draws a struck-out picture and a word, as a thumbnail that fails to load does</DemoParam>
		<DemoParam Name="Text">Every word, read aloud or shown, through MokaMediaText</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="MediaGalleryFill" Title="Columns that fill rows" Component="MokaMediaGallery"
             Description="MinColumn fits as many tiles as the width allows; OnItemOpen says which tile, even among equal items.">
	<ChildContent>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm);">
			<MokaMediaGallery Items="_fillItems" MinColumn="7rem" Gap="MokaSpacingScale.Xs" Lightbox="false"
			                  OnItemOpen="args => _opened = args"/>
			<MokaCaption>
				@if (_opened is { } opened)
				{
					<span>Opened tile @(opened.Index + 1), @(opened.Item.Alt).</span>
				}
				else
				{
					<span>Tiles 1 and 7 are equal items; press either.</span>
				}
			</MokaCaption>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="MinColumn">The narrowest a tile gets; wins over Columns</DemoParam>
		<DemoParam Name="OnItemOpen">The item and its index, for items that compare equal</DemoParam>
		<DemoParam Name="MokaMediaItem.Key">The tile's @@key, and what tells equal items apart</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="Lightbox" Title="Lightbox" Component="MokaLightbox"
             Description="A lightbox of your own over a long list, reading each full image only as it comes near."
             Tip="Each full image here takes 0.7 s. Photo 8 fails to read, photo 13 is marked Failed and photo 21's thumbnail is missing.">
	<ChildContent>
		<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-sm);">
			<MokaMediaGallery @ref="_longGallery" Items="_longItems" MinColumn="5.5rem" Gap="MokaSpacingScale.Xs"
			                  Lightbox="false" OnItemOpen="OpenLightbox"/>
			<MokaCaption>
				<span style="font-family: var(--moka-font-family-mono);">
					@_longItems.Count photos. Holding @_held.Count full images; @_reads read, @_released given back.
				</span>
			</MokaCaption>
			<MokaLightbox Items="_longItems" @bind-Open="_lightboxOpen" @bind-Open:after="LightboxClosedAsync"
			              @bind-Index="_lightboxIndex" LoadSource="LoadFullAsync" ReleaseSource="ReleaseFull">
				<Facts>
					<span style="font-weight: var(--moka-font-weight-semibold);">@context.Alt</span>
					<span style="font-family: var(--moka-font-family-mono); color: var(--moka-color-on-surface-variant);">
						@TakenOn(context).ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
					</span>
					<MokaBytes Value="SizeOf(context)" Style="font-family: var(--moka-font-family-mono); color: var(--moka-color-on-surface-variant);"/>
				</Facts>
			</MokaLightbox>
		</div>
	</ChildContent>
	<Notes>
		<DemoParam Name="Items, @@bind-Index, @@bind-Open">The list it steps through, the image on show, and showing at all</DemoParam>
		<DemoParam Name="LoadSource, ReleaseSource">Reads a full image when it comes near and gives it back when it drops away</DemoParam>
		<DemoParam Name="Preload">How many neighbours on each side are read ahead, 1 by default</DemoParam>
		<DemoParam Name="Facts">A template for facts about the item on show</DemoParam>
		<DemoParam Name="FocusItemAsync">On the gallery: focus goes back to the tile last on show</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="Chat" Title="Chat" Description="A conversation, with a box to send messages.">
	<MokaChat Messages="_chatMessages"
	          OnSend="HandleChatSend"
	          IsTyping="_chatTyping"
	          TypingUser="Alice"
	          Height="350px">
		<HeaderContent>
			<div style="display: flex; align-items: center; gap: 8px;">
				<strong>Chat with Alice</strong>
				<span style="font-size: 11px; color: var(--moka-color-success);">Online</span>
			</div>
		</HeaderContent>
	</MokaChat>
</DemoSection>

<DemoSection Id="Countdown" Title="Countdown" Description="The time left to a date, in boxes, inline or as flip digits.">
	<h3>New Year Countdown (Boxes)</h3>
	<MokaCountdown TargetDate="_newYear" CountdownStyle="MokaCountdownStyle.Boxes"/>

	<h3>5-Minute Countdown (Inline)</h3>
	<MokaCountdown TargetDate="_fiveMinutes" CountdownStyle="MokaCountdownStyle.Inline" Separator=" : " CompletedText="Done!"/>

	<h3>Flip Style (Compact Labels)</h3>
	<MokaCountdown TargetDate="_newYear" CountdownStyle="MokaCountdownStyle.Flip" CompactLabels="true"/>

	<h3>Hours/Minutes Only</h3>
	<MokaCountdown TargetDate="_fiveMinutes" ShowDays="false" ShowSeconds="false" CountdownStyle="MokaCountdownStyle.Boxes"/>
</DemoSection>

<DemoSection Id="QRCode" Title="QR code" Description="A QR code drawn as SVG.">
	<div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">
		<div>
			<h3>URL</h3>
			<MokaQRCode Value="https://example.com" QRSize="180"/>
		</div>
		<div>
			<h3>Text</h3>
			<MokaQRCode Value="Hello, Moka.Red!" QRSize="180" ForegroundColor="#6750a4"/>
		</div>
		<div>
			<h3>Rounded</h3>
			<MokaQRCode Value="https://github.com" QRSize="180" RoundedModules="true"/>
		</div>
		<div>
			<h3>High EC</h3>
			<MokaQRCode Value="Scan me!" QRSize="180" ErrorCorrection="MokaQRErrorCorrection.High" ForegroundColor="#1a7f37"/>
		</div>
	</div>
</DemoSection>

<QRScannerDemo/>

<DemoSection Id="Barcode" Title="Barcode" Description="A barcode drawn as SVG.">
	<div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">
		<div>
			<h3>Product Code</h3>
			<MokaBarcode Value="ABC-12345" BarcodeWidth="250" BarcodeHeight="90"/>
		</div>
		<div>
			<h3>ISBN</h3>
			<MokaBarcode Value="978-3-16-148410-0" BarcodeWidth="300" BarcodeHeight="90"/>
		</div>
		<div>
			<h3>No Text</h3>
			<MokaBarcode Value="MOKA-RED" BarcodeWidth="200" BarcodeHeight="60" ShowText="false"/>
		</div>
		<div>
			<h3>Colored</h3>
			<MokaBarcode Value="COLOR-01" BarcodeWidth="220" BarcodeHeight="80" ForegroundColor="#6750a4" BackgroundColor="#f3edf7"/>
		</div>
	</div>
</DemoSection>

@code {
	private int _carouselIndex;

	private static readonly IReadOnlyList<MokaMediaItem> _galleryItems =
	[
		new() { Src = "samples/photo-1.svg", Alt = "Dusk" },
		new() { Src = "samples/photo-2.svg", Alt = "Forest" },
		new() { Src = "samples/photo-3.svg", Alt = "Lake" },
		new() { Src = "samples/photo-4.svg", Alt = "Bloom" },
		new() { Src = "samples/photo-5.svg", Alt = "Fog" },
		new() { Src = "samples/photo-6.svg", Alt = "Dunes" }
	];

	private static readonly string[] Names = ["Dusk", "Forest", "Lake", "Bloom", "Fog", "Dunes"];

	private bool _thumbnailsArrived;

	private IReadOnlyList<MokaMediaItem> _stateItems = WaitingItems();

	private static IReadOnlyList<MokaMediaItem> WaitingItems() =>
	[
		new() { Key = 1, Src = "samples/photo-1.svg", Alt = "Dusk", Loading = true },
		new() { Key = 2, Alt = "Forest" },
		new() { Key = 3, Src = "samples/photo-3.svg", Alt = "Lake", Failed = true },
		new() { Key = 4, Src = "samples/photo-4.svg", ThumbnailSrc = "samples/missing.svg", Alt = "Bloom" }
	];

	private static IReadOnlyList<MokaMediaItem> ArrivedItems() =>
	[
		new() { Key = 1, Src = "samples/photo-1.svg", Alt = "Dusk" },
		new() { Key = 2, Src = "samples/photo-2.svg", Alt = "Forest" },
		new() { Key = 3, Src = "samples/photo-3.svg", Alt = "Lake", Failed = true },
		new() { Key = 4, Src = "samples/photo-4.svg", ThumbnailSrc = "samples/missing.svg", Alt = "Bloom" }
	];

	private void ToggleThumbnails()
	{
		_thumbnailsArrived = !_thumbnailsArrived;
		_stateItems = _thumbnailsArrived ? ArrivedItems() : WaitingItems();
	}

	// Two equal items, as a folder with the same picture twice gives: only the index tells them apart.
	private static readonly IReadOnlyList<MokaMediaItem> _fillItems =
	[
		.. Enumerable.Range(0, 12).Select(i => new MokaMediaItem
		{
			Src = $"samples/photo-{i % 6 + 1}.svg",
			Alt = Names[i % 6]
		})
	];

	private MokaMediaItemOpenArgs? _opened;

	// A long list whose full images are read on demand, as a photo library would.
	private static readonly IReadOnlyList<MokaMediaItem> _longItems =
	[
		.. Enumerable.Range(0, 40).Select(i => new MokaMediaItem
		{
			Key = $"photo-{i + 1}",
			ThumbnailSrc = i == 20 ? "samples/missing.svg" : $"samples/photo-{i % 6 + 1}.svg",
			Alt = $"{Names[i % 6]} {i + 1}",
			Caption = i % 5 == 0 ? $"Roll {i / 5 + 1}" : null,
			Failed = i == 12
		})
	];

	private readonly Dictionary<string, string> _fullImages = [];
	private readonly HashSet<string> _held = [];
	private MokaMediaGallery? _longGallery;
	private bool _lightboxOpen;
	private int _lightboxIndex;
	private int _reads;
	private int _released;

	private void OpenLightbox(MokaMediaItemOpenArgs args)
	{
		_lightboxIndex = args.Index;
		_lightboxOpen = true;
	}

	private async Task LightboxClosedAsync()
	{
		if (!_lightboxOpen && _longGallery is not null)
		{
			await _longGallery.FocusItemAsync(_lightboxIndex);
		}
	}

	// Stands in for reading a photo's bytes from storage: a delay, one photo that can't be read, and an SVG drawn four
	// times larger than its thumbnail as a data URL.
	private async Task<string?> LoadFullAsync(MokaMediaItem item, CancellationToken cancellationToken)
	{
		await Task.Delay(700, cancellationToken);
		if (Equals(item.Key, "photo-8"))
		{
			throw new IOException("The photo could not be read.");
		}

		string file = $"samples/photo-{NumberOf(item) % 6 + 1}.svg";
		if (!_fullImages.TryGetValue(file, out string? url))
		{
			string svg = await File.ReadAllTextAsync(Path.Combine(Environment.WebRootPath, file), cancellationToken);
			svg = svg.Replace("width='400' height='400'", "width='1600' height='1600'", StringComparison.Ordinal);
			url = "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
			_fullImages[file] = url;
		}

		_reads++;
		_held.Add((string)item.Key!);
		StateHasChanged();
		return url;
	}

	private Task ReleaseFull(MokaMediaItem item, string url)
	{
		_released++;
		_held.Remove((string)item.Key!);
		StateHasChanged();
		return Task.CompletedTask;
	}

	private static int NumberOf(MokaMediaItem item) =>
		int.Parse(((string)item.Key!)["photo-".Length..], System.Globalization.CultureInfo.InvariantCulture) - 1;

	private static DateTime TakenOn(MokaMediaItem item) =>
		new DateTime(2026, 6, 1, 9, 0, 0, DateTimeKind.Utc).AddHours(NumberOf(item) * 37);

	private static long SizeOf(MokaMediaItem item) => 1_200_000 + NumberOf(item) * 73_421L;

	// Chat demo
	private readonly List<MokaChatMessage> _chatMessages =
	[
		new() { Id = "1", Text = "Chat started", Author = "System", IsSystem = true, Timestamp = DateTime.UtcNow.AddMinutes(-10) },
		new() { Id = "2", Text = "Hey! How's the project going?", Author = "Alice", AvatarInitials = "AL", Timestamp = DateTime.UtcNow.AddMinutes(-8) },
		new() { Id = "3", Text = "Pretty good! Almost done with the new components.", Author = "Me", IsOwn = true, Timestamp = DateTime.UtcNow.AddMinutes(-7), Status = MokaChatMessageStatus.Read },
		new() { Id = "4", Text = "That's great to hear. Need any help with testing?", Author = "Alice", AvatarInitials = "AL", Timestamp = DateTime.UtcNow.AddMinutes(-5) },
		new() { Id = "5", Text = "I'll let you know once I'm ready for review!", Author = "Me", IsOwn = true, Timestamp = DateTime.UtcNow.AddMinutes(-4), Status = MokaChatMessageStatus.Delivered }
	];

	private bool _chatTyping;

	private async Task HandleChatSend(string text)
	{
		_chatMessages.Add(new MokaChatMessage
		{
			Id = Guid.NewGuid().ToString(),
			Text = text,
			Author = "Me",
			IsOwn = true,
			Timestamp = DateTime.UtcNow,
			Status = MokaChatMessageStatus.Sent
		});
		StateHasChanged();

		_chatTyping = true;
		StateHasChanged();
		await Task.Delay(1500);
		_chatTyping = false;
		_chatMessages.Add(new MokaChatMessage
		{
			Id = Guid.NewGuid().ToString(),
			Text = "Got it, thanks!",
			Author = "Alice",
			AvatarInitials = "AL",
			Timestamp = DateTime.UtcNow
		});
	}

	// Countdown demos
	private static readonly DateTime _newYear = new(DateTime.Now.Year + 1, 1, 1, 0, 0, 0);
	private readonly DateTime _fiveMinutes = DateTime.Now.AddMinutes(5);
}
