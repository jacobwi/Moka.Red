	<MokaGridBackground Pattern="MokaGridPattern.Lines" MinHeight="300px" Highlighted Padding="MokaSpacingScale.Xl">
		<MokaFlexbox Justify="MokaJustify.Center" Align="MokaAlign.Center" Gap="MokaSpacingScale.Lg" Style="min-height: 260px;" Wrap>
			<MokaGlassCard Title="Glassmorphism" Subtitle="Translucent card" Style="width: 220px;">
				<MokaText>Backdrop blur with grid visible through the frosted glass.</MokaText>
			</MokaGlassCard>
			<MokaGlassCard Title="With Glow" Glow Style="width: 220px;">
				<MokaText>Subtle red glow ring around the card edges.</MokaText>
			</MokaGlassCard>
			<MokaGlassCard Title="Clickable" Clickable Glow Style="width: 220px;">
				<MokaText>Hover and click to see interaction effects.</MokaText>
			</MokaGlassCard>
		</MokaFlexbox>
	</MokaGridBackground>

	<h3>Custom Tint</h3>
	<MokaGridBackground Pattern="MokaGridPattern.Dots" MinHeight="200px" CellSize="24" Padding="MokaSpacingScale.Xl">
		<MokaFlexbox Justify="MokaJustify.Center" Align="MokaAlign.Center" Gap="MokaSpacingScale.Lg" Style="min-height: 160px;" Wrap>
			<MokaGlassCard Title="Blue Tint" Tint="#42a5f5" BackgroundOpacity="12" GlowColor="#42a5f5" Glow Style="width: 200px;">
				<MokaText>Custom blue tint glass.</MokaText>
			</MokaGlassCard>
