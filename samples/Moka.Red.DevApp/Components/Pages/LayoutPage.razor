			<MokaHeading Level="3">Blue Meteors</MokaHeading>
		</MokaFlexbox>
	</MokaMeteors>
</DemoSection>

<DemoSection Id="OrbitingIcons" Title="Orbiting icons" Description="Icons circling a center.">
	<h3>Default</h3>
	<MokaFlexbox Justify="MokaJustify.Center" Padding="MokaSpacingScale.Xl">
		<MokaOrbitingIcons Icons="_orbitIcons" Radius="100" Duration="15">
			<div style="width: 48px; height: 48px; background: var(--moka-color-primary); color: var(--moka-color-on-primary); border-radius: var(--moka-radius-md); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px;">M</div>
