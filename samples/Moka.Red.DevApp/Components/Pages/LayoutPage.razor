			<MokaIcon Icon="MokaIcons.Action.Settings" SizeValue="32px" />
		</MokaOrbitingIcons>
	</MokaFlexbox>
</DemoSection>

<DemoSection Id="GlassCard" Title="Glass card" Description="A translucent card that blurs what is behind it.">
