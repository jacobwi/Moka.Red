	private sealed record LogLine(int Number, DateTimeOffset At, string Level, string Message);

	private static readonly string[] LogLevels = ["Info", "Info", "Info", "Debug", "Warning", "Info", "Error"];

	private static readonly string[] LogMessages =
	[
		"Request served", "Cache refreshed", "Job queued", "Connection opened", "Slow response", "User signed in", "Retrying upload"
	];

	private IAsyncEnumerable<LogLine>? _logStream;

	private bool _breakLog;

	private bool _logBroke;

	private void ReadLogAgain()
	{
		_logBroke = false;
		_logStream = ReadLogAsync();
	}

	// Breaks once at line 900 while the switch is on, so Retry reads the whole log the second time.
	private async IAsyncEnumerable<LogLine> ReadLogAsync([EnumeratorCancellation] CancellationToken cancellationToken = default)
	{
		DateTimeOffset start = new(2026, 11, 14, 8, 0, 0, TimeSpan.Zero);
		for (int i = 1; i <= 3000; i++)
		{
			if (i % 20 == 0)
			{
				await Task.Delay(40, cancellationToken);
			}

			if (i == 900 && _breakLog && !_logBroke)
			{
				_logBroke = true;
				throw new IOException("The log file went away at line 900.");
			}

			yield return new LogLine(i, start.AddMilliseconds(i * 137), LogLevels[i * 3 % LogLevels.Length], LogMessages[i * 5 % LogMessages.Length]);
		}
	}

	private static MokaColor? LogTone(LogLine line) => line.Level switch
	{
		"Error" => MokaColor.Error,
		"Warning" => MokaColor.Warning,
		"Debug" => MokaColor.Secondary,
		_ => MokaColor.Info
	};
