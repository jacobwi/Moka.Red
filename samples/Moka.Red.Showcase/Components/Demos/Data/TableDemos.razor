	private sealed record LedgerEntry(int Entry, string Account, string Memo, decimal Amount, DateTimeOffset Posted)
	{
		private static readonly string[] Accounts = ["Sales", "Rent", "Payroll", "Supplies", "Travel", "Utilities"];

		private static readonly string[] Memos = ["Invoice paid", "Monthly charge", "Refund", "Card payment", "Transfer", "Adjustment"];

		private static readonly DateTimeOffset Opened = new(2020, 1, 1, 8, 0, 0, TimeSpan.Zero);

		// Every value comes from the entry's number, so any window is made on the spot.
		public static LedgerEntry At(int index) => new(
			index + 1,
			Accounts[index * 7 % Accounts.Length],
			Memos[index * 5 % Memos.Length],
			Math.Round((index * 7919 % 200000 - 100000) / 100m, 2),
			Opened.AddMinutes(index * 3));
	}

	private const int LedgerSize = 400_000;

	private readonly DemoLedger _ledgerSource = new();

	private bool _groupLedger;

	private MokaTableSelection<DemoLedgerLine>? _ledgerPicked;

	private void PickLedgerLines(MokaTableSelection<DemoLedgerLine> picked) => _ledgerPicked = picked;

	// Every matching line is the request the table hands back, run without its paging, less the lines unticked.
	private void ArchiveLedgerLines() => Toast.ShowInfo(_ledgerPicked switch
	{
		{ AllMatching: true, Matching: { } request } all => string.Create(CultureInfo.CurrentCulture,
			$"Would archive {all.Count:N0} lines{(request.Search is { } search ? $" matching \"{search}\"" : "")} in {(request.Filters.Count == 0 ? "every account" : string.Join(", ", request.Filters[0].Values))}, leaving out the {all.Except.Count:N0} unticked."),
		{ Items.Count: > 0 } some => string.Create(CultureInfo.CurrentCulture, $"Would archive {some.Items.Count:N0} lines."),
		_ => "Nothing to archive."
	});

	private int _ledgerAsked;

	private int _ledgerCancelled;

	private string _ledgerNote = "No window asked for yet.";

	private async Task<MokaTableResult<LedgerEntry>> LoadLedgerAsync(MokaTableRequest request)
	{
		_ledgerAsked++;
		try
		{
			await Task.Delay(150, request.CancellationToken);
		}
		catch (OperationCanceledException)
		{
			_ledgerCancelled++;
			throw;
		}

		bool newestFirst = request.Sorts is [{ Column: "Entry", Direction: MokaSortDirection.Descending }, ..];
		int count = Math.Clamp(LedgerSize - request.StartIndex, 0, request.PageSize);
		List<LedgerEntry> window =
			[.. Enumerable.Range(request.StartIndex, count).Select(i => LedgerEntry.At(newestFirst ? LedgerSize - 1 - i : i))];
		_ledgerNote = string.Create(CultureInfo.CurrentCulture,
			$"The last window held rows {request.StartIndex + 1:N0} to {request.StartIndex + count:N0} of {LedgerSize:N0}. Windows asked for: {_ledgerAsked}, cancelled: {_ledgerCancelled}.");
		StateHasChanged();
		return new MokaTableResult<LedgerEntry> { Items = window, TotalItems = LedgerSize };
	}

