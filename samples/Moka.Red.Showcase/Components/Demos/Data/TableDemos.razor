	private static string DescribeServerRequest(MokaTableRequest request)
	{
		string groups = request.Groups.Count > 0 ? string.Join(", ", request.Groups) : "nothing";
		string totals = request.Aggregates.Count > 0 ? string.Join(", ", request.Aggregates.Select(total => $"{total.Column} {total.Type}")) : "nothing";
		string facets = request.Facets.Count > 0 ? string.Join(", ", request.Facets) : "none";
		string quick = request.QuickFilter?.Name ?? "All";
		return $"page {request.Page}, grouped by {groups}, totals of {totals}, facets for {facets}, {request.QuickFilterCounts.Count} quick filter counts, quick filter {quick}, {request.Filters.Count} filter(s)";
	}

