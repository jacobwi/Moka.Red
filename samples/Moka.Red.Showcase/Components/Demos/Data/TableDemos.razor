		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="values-on-one-line" Title="Values on one line" Description="NoWrap keeps a column's values on one line; with a Width a longer value ends in an ellipsis. Drag a heading's edge to narrow a column. Below 720 px the rows become a list, and the values stay on one line there too.">
	<div style="max-width: 36rem;">
		<MokaTable TItem="AuditEntry" Items="_audit" ShowPagination="false">
			<MokaColumn TItem="AuditEntry" Title="Event" Field="x => x.Id" Mono NoWrap Width="7rem" Phone="MokaColumnPhone.Trailing"/>
			<MokaColumn TItem="AuditEntry" Title="Who" Field="x => x.Who" NoWrap Phone="MokaColumnPhone.Primary"/>
			<MokaColumn TItem="AuditEntry" Title="Action" Field="x => x.Action" Mono NoWrap Phone="MokaColumnPhone.Secondary"/>
			<MokaColumn TItem="AuditEntry" Title="Detail" Field="x => x.Detail"/>
		</MokaTable>
	</div>
</DemoSection>

<DemoSection Id="everything-together" Title="Everything together" Description="Tick two boxes for the bulk bar, then shift-click a third for a run. Pick a zone, then &quot;Save this view&quot;. The foot shows more rows. Columns opens the chooser. Drag a heading to move it (Name is fixed), or Tab to its right edge and press Left, Right or Home. Below 720 px each row is a list item from its columns' Phone slots.">
	<MokaSegmentedControl TValue="string" Value="@_zone" ValueChanged="PickZone" AriaLabel="Zone">
		<MokaSegment Value="@("All")" Text="All zones"/>
		<MokaSegment Value="@("Home")" Text="Home"/>
		<MokaSegment Value="@("Guests")" Text="Guests"/>
		<MokaSegment Value="@("Things")" Text="Things"/>
	</MokaSegmentedControl>

	@DevicesTable

	<MokaCard Inner>
		<MokaLabel Micro>What the table raised</MokaLabel>
		<MokaCode Block="true">@_log</MokaCode>
		<MokaLabel Micro>State, kept by this page, not the table</MokaLabel>
		<MokaCode Block="true">@DevicesStateText</MokaCode>
	</MokaCard>
</DemoSection>

<DemoSection Id="a-device-list-in-a-card" Title="A device list in a card" Description="The toolbar inside the card, the detail toggle at each row's end with one row open at a time, the rows called devices, Rate sorting largest first and never clearing, an icon Clear on the bulk bar and a foot under the rows. Nothing around the rows scrolls, so the header sticks to the page under the app bar. The Zone column hides below 1100 px, header and all. &quot;Show older&quot; adds rows to the same list and asks for them to be drawn.">
	<MokaSwitch @bind-Value="_minWidth" Label="MinWidth 900px, so the rows scroll sideways instead"/>
	<MokaTable TItem="Device" Items="_older" ItemKey="d => d.Name" Label="Devices" ItemsName="devices" ItemName="d => d.Name"
	           Framed="true" ToolbarInFrame="true" Title="Devices" Searchable="true" Text="SearchDevicesText"
	           Responsive="false" MinWidth="@(_minWidth ? "900px" : null)"
	           Expandable="true" ExpandTogglePosition="MokaTableTogglePosition.End" SingleExpand="true"
	           Selectable="true" BulkClearIcon="true" PageSize="5" AllowUnsort="false"
	           @ref="_olderTable">
		<BulkActions Context="picked">
			<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" OnClick="() => Note(picked)">Limit</MokaButton>
		</BulkActions>
		<DetailTemplate Context="d">
			<MokaText>@d.Name is in @d.Zone at @d.Address, last seen @d.Seen.</MokaText>
		</DetailTemplate>
		<FootContent>
			<span>All @_older.Count.ToString(CultureInfo.CurrentCulture) devices</span>
			<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary" OnClick="ShowOlderAsync">Show older</MokaButton>
		</FootContent>
		<ChildContent>
			<MokaColumn TItem="Device" Title="Name" Field="d => d.Name" Phone="MokaColumnPhone.Primary"/>
			<MokaColumn TItem="Device" Title="Address" Field="d => d.Address" Mono="true" Phone="MokaColumnPhone.Secondary"/>
			<MokaColumn TItem="Device" Title="Zone" Field="d => d.Zone" Class="demo-hide-narrow" Phone="MokaColumnPhone.Secondary"/>
			<MokaColumn TItem="Device" Title="Rate" Field="d => d.BytesPerSecond" Mono="true" Align="MokaTextAlign.Right"
			            SortDescendingFirst="true" Phone="MokaColumnPhone.Trailing">
				<CellTemplate Context="d">@d.Rate</CellTemplate>
			</MokaColumn>
			<MokaTablePager Look="MokaPagerLook.LoadMore"/>
		</ChildContent>
	</MokaTable>
</DemoSection>

<DemoSection Id="inside-a-card" Title="Inside a card" Description="Bleed runs the rows to the card's edges and its bottom corners.">
	<MokaTable TItem="Device" Items="FourDevices" Bleed="true" ItemKey="d => d.Name">
		<MokaColumn TItem="Device" Title="Name" Field="d => d.Name" Phone="MokaColumnPhone.Primary"/>
		<MokaColumn TItem="Device" Title="Address" Field="d => d.Address" Mono="true" Phone="MokaColumnPhone.Secondary"/>
		<MokaColumn TItem="Device" Title="Seen" Field="d => d.Seen" Phone="MokaColumnPhone.Trailing"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="loading-in-the-real-columns" Title="Loading, in the real columns">
	<MokaSwitch @bind-Value="_loading" Label="Loading"/>
	<MokaTable TItem="Device" Items="ThreeDevices" Loading="_loading" LoadingRows="3" Selectable="true" Framed="true" ItemKey="d => d.Name">
		<MokaColumn TItem="Device" Title="Name" Field="d => d.Name" Phone="MokaColumnPhone.Primary"/>
		<MokaColumn TItem="Device" Title="Address" Field="d => d.Address" Mono="true" Width="30%" Phone="MokaColumnPhone.Secondary"/>
		<MokaColumn TItem="Device" Title="Rate" Field="d => d.Rate" Mono="true" Width="20%" Align="MokaTextAlign.Right" Phone="MokaColumnPhone.Trailing"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="empty-2" Title="Empty">
	<MokaGrid MinColumn="300px" Style="gap: var(--moka-grid-gap);">
		<MokaTable TItem="Device" Items="NoDevices" Framed="true"
		           EmptyIcon="MokaIcons.Action.Search" EmptyTitle="No device matches" EmptyText="Try another zone, or clear the search.">
			<MokaColumn TItem="Device" Title="Name" Field="d => d.Name"/>
			<MokaColumn TItem="Device" Title="Address" Field="d => d.Address"/>
		</MokaTable>
		<MokaTable TItem="Device" Items="NoDevices" Framed="true">
			<Empty>
				<MokaEmptyState Framed="true" Title="An Empty fragment" Description="Your own content, with room for a button.">
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Secondary">Add a device</MokaButton>
				</MokaEmptyState>
			</Empty>
			<ChildContent>
				<MokaColumn TItem="Device" Title="Name" Field="d => d.Name"/>
				<MokaColumn TItem="Device" Title="Address" Field="d => d.Address"/>
			</ChildContent>
		</MokaTable>
		<MokaTable TItem="Device" Items="NoDevices">
			<MokaColumn TItem="Device" Title="Name" Field="d => d.Name"/>
			<MokaColumn TItem="Device" Title="Address" Field="d => d.Address"/>
		</MokaTable>
	</MokaGrid>
	<MokaCaption>The last one sets none of them, and says what it always said.</MokaCaption>
</DemoSection>

<DemoSection Id="a-list-that-ticks" Title="A list that ticks" Description="A new list every second, with a new rate on one row. Rows keep their DOM and their state, so a ticked box, a hover and focus stay where they are, and only the cell that moved goes to the browser.">
	<MokaTable TItem="Device" Items="_ticking" ItemKey="d => d.Name" Selectable="true" ItemName="d => d.Name" Framed="true"
	           ShowPagination="false">
		<BulkActions Context="picked">
			<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" OnClick="() => Note(picked, ticking: true)">Limit</MokaButton>
		</BulkActions>
		<ChildContent>
			<MokaColumn TItem="Device" Title="Name" Field="d => d.Name" Phone="MokaColumnPhone.Primary"/>
			<MokaColumn TItem="Device" Title="Zone" Field="d => d.Zone" Phone="MokaColumnPhone.Secondary"/>
			<MokaColumn TItem="Device" Title="Rate" Field="d => d.Rate" Mono="true" Align="MokaTextAlign.Right" Phone="MokaColumnPhone.Trailing"/>
		</ChildContent>
	</MokaTable>
</DemoSection>

<DemoSection Id="editing-cells-and-rows" Title="Editing cells and rows" Description="Every editor the table has: text, a number that can be empty, money, a list, a choice from an enum, a date, a check box, a switch and stars. In Cell mode Enter, F2 or a double click opens one cell, Tab saves it and opens the next, and a click elsewhere saves it. In Row mode the whole row opens, with Save and Cancel at its end.">
	<DemoChoice TValue="MokaTableEditMode" Label="EditMode" Options="EditModes" @bind-Value="_editMode"/>
	<MokaTable TItem="StockLine" Items="_stock" ItemKey="s => s.Id" EditMode="_editMode" OnRowSave="SaveStock" ShowPagination="false"
	           MinWidth="1100px" Title="Stock">
		<MokaColumn TItem="StockLine" Title="Name" Field="s => s.Name" Editable SetField="@((s, v) => s with { Name = (string?)v ?? string.Empty })"/>
		<MokaStatusColumn TItem="StockLine" Title="Category" Status="s => s.Category" EditOptions="StockCategories" Editable
		                  SetStatus="@((s, v) => s with { Category = v ?? s.Category })"/>
		<MokaColumn TItem="StockLine" Title="Shelf" Field="s => s.Shelf" Editable SetField="@((s, v) => s with { Shelf = v is StockShelf shelf ? shelf : s.Shelf })"/>
		<MokaNumberColumn TItem="StockLine" Title="Stock" Value="s => s.Stock" Format="N0" Editable SetValue="@((s, v) => s with { Stock = v })"/>
		<MokaMoneyColumn TItem="StockLine" Title="Price" Value="s => s.Price" Currency="EUR" Editable SetValue="@((s, v) => s with { Price = v ?? 0m })"/>
		<MokaDateColumn TItem="StockLine" Title="Checked" Value="s => s.Checked" Format="d" Editable SetValue="@((s, v) => s with { Checked = v ?? s.Checked })"/>
		<MokaYesNoColumn TItem="StockLine" Title="Active" Value="s => s.Active" Editable SetValue="@((s, v) => s with { Active = v ?? false })"/>
		<MokaYesNoColumn TItem="StockLine" Title="Reorder" Value="s => s.Reorder" Look="MokaYesNoLook.Switch" Editable SetValue="@((s, v) => s with { Reorder = v ?? false })"/>
		<MokaRatingColumn TItem="StockLine" Title="Rating" Value="s => s.Rating" Editable SetValue="@((s, v) => s with { Rating = v ?? 0 })"/>
		<MokaEditColumn TItem="StockLine" ShowDelete="false"/>
	</MokaTable>
