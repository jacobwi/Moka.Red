@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Runtime.CompilerServices
@using System.Text.Json
@using System.Text.Json.Nodes
@using Moka.Red.Showcase.Components.Demos.Data.Table
@inject IMokaContextMenuService ContextMenu
@inject IMokaToastService Toast
@implements IDisposable

<DemoSection Id="basic-table" Title="Basic table" Description="Rows of data with sorting, search, paging, selection, editing and export." Tip="Give ItemKey a stable id, so selection and open detail rows survive sorting and paging.">
	<ChildContent>
		<MokaTable Items="_people" ItemKey="p => p.Id" Title="People">
			<MokaColumn TItem="Person" Title="ID" Field="p => p.Id" Width="60px"/>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Email" Field="p => p.Email" HideOnMobile="true"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
			<MokaColumn TItem="Person" Title="Joined" Field="p => p.JoinDate" Format="d" HideOnMobile="true"/>
			<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
		</MokaTable>
	</ChildContent>
	<Notes>
		<DemoParam Name="Items or ServerData">Rows in memory, or loaded a page at a time</DemoParam>
		<DemoParam Name="ItemKey">Keeps rows matched as they change</DemoParam>
		<DemoParam Name="MokaColumn">Title, Field, Format, Sortable, Width per column</DemoParam>
		<DemoParam Name="Searchable, Selectable">A search box, and check boxes per row</DemoParam>
		<DemoParam Name="Expandable, DetailTemplate">A detail row under each row</DemoParam>
		<DemoParam Name="PageSize, ShowPagination">Paging, on by default</DemoParam>
		<DemoParam Name="State, StorageKey">Everything someone changes, bound or kept</DemoParam>
		<DemoParam Name="OnRowClick, OnRowContextMenu">What a click or right-click on a row does</DemoParam>
	</Notes>
</DemoSection>

<DemoSection Id="row-context-menu" Title="Row context menu">
	<p class="page-desc">Right-click any row. <code>OnRowContextMenu</code> surfaces the item + mouse event; the page opens the shared menu via <code>IMokaContextMenuService</code>.</p>
	<MokaTable TItem="Person" Items="_people.Take(8)" ItemKey="p => p.Id" ShowPagination="false" Title="Right-click a row"
	           OnRowContextMenu="HandleRowContextMenu">
		<MokaColumn TItem="Person" Title="ID" Field="p => p.Id" Width="60px"/>
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="sticky-pager" Title="Sticky pager">
	<p class="page-desc">A <code>MokaTablePager</code> with <code>Sticky</code> keeps the pager in view while the bounded body (<code>Height</code>) scrolls; <code>FixedHeader</code> pins the header.</p>
	<MokaTable Items="_people" ItemKey="p => p.Id" Height="240px" FixedHeader="true" PageSize="8" Title="Sticky Footer">
		<MokaColumn TItem="Person" Title="ID" Field="p => p.Id" Width="60px"/>
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
		<MokaTablePager Sticky PageSizeOptions="StickyPageSizes"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="searchable-and-sortable" Title="Searchable and sortable" Description="Text holds every word the table writes, the search box's placeholder among them.">
	<MokaTable Items="_people" ItemKey="p => p.Id" Searchable="true" Title="Searchable People" Text="FilterPeopleText">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="selectable-rows" Title="Selectable rows">
	<p style="font-size: var(--moka-font-size-xs); margin-bottom: var(--moka-spacing-xs);">Selected: @_tableSelectedItems.Count item(s)</p>
	<MokaTable TItem="Person" Items="_people.Take(20)" ItemKey="p => p.Id" Selectable="true"
	           SelectedItems="_tableSelectedItems" SelectedItemsChanged="HandleSelectionChanged"
	           Title="Select Rows">
		<ToolbarContent>
			<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Outlined" OnClick="() => _tableSelectedItems = []">Clear</MokaButton>
		</ToolbarContent>
		<ChildContent>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
		</ChildContent>
	</MokaTable>
</DemoSection>

<DemoSection Id="expandable-rows" Title="Expandable rows" Description="A detail template under each row.">
	<MokaTable Items="_people.Take(10)" ItemKey="p => p.Id" Expandable="true" ShowPagination="false" Title="Expandable">
		<ChildContent>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
			<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
		</ChildContent>
		<DetailTemplate>
			<div style="display: flex; gap: var(--moka-spacing-lg); font-size: var(--moka-font-size-xs);">
				<div>
					<strong>Email:</strong> @context.Email
				</div>
				<div>
					<strong>Joined:</strong> @context.JoinDate.ToString("D")
				</div>
				<div>
					<strong>ID:</strong> @context.Id
				</div>
			</div>
		</DetailTemplate>
	</MokaTable>
</DemoSection>

<DemoSection Id="footer-row" Title="Footer row" Description="Your own totals row in the footer.">
	<MokaTable Items="_people.Take(10)" ItemKey="p => p.Id" ShowPagination="false" Title="With Footer">
		<ChildContent>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
		</ChildContent>
		<FooterContent>
			<tr>
				<td colspan="2">
					<strong>Total</strong>
				</td>
				<td style="text-align: right;">@_people.Take(10).Sum(p => p.Salary).ToString("C0")</td>
			</tr>
		</FooterContent>
	</MokaTable>
</DemoSection>

<DemoSection Id="everything-on" Title="Everything on" Description="Search, selection, export, the column chooser, density, detail rows, selection and row actions.">
	<MokaTable Items="_people" ItemKey="p => p.Id" Searchable="true" Selectable="true" Exportable="true"
	           ShowColumnToggle="true" ShowRefresh="true" ShowDensityToggle="true"
	           Title="Team Members" Striped="true" Expandable="true"
	           SelectedItems="_tableSelectedItems" SelectedItemsChanged="@((HashSet<Person> items) => HandleSelectionChanged(items))">
		<ChildContent>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Email" Field="p => p.Email" HideOnMobile="true"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Status" Field="p => p.Status">
				<CellTemplate>
					@{
						var statusColor = context.Status switch
						{
							"Active" => MokaColor.Success,
							"Pending" => MokaColor.Warning,
							_ => MokaColor.Error
						};
					}
					<MokaAttribute Variant="MokaVariant.Soft" Color="statusColor" Size="MokaSize.Xs">
						@context.Status
					</MokaAttribute>
				</CellTemplate>
			</MokaColumn>
		</ChildContent>
		<DetailTemplate>
			<div style="padding: var(--moka-spacing-sm);">
				<p>
					<strong>ID:</strong> @context.Id
				</p>
				<p>
					<strong>Email:</strong> @context.Email
				</p>
				<p>
					<strong>Joined:</strong> @context.JoinDate.ToString("MMM dd, yyyy")
				</p>
				<p>
					<strong>Salary:</strong> @context.Salary.ToString("C0")
				</p>
			</div>
		</DetailTemplate>
		<SelectionActions Context="selected">
			<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="MokaColor.Error">
				Delete @selected.Count
			</MokaButton>
			<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="MokaColor.Info">
				Export @selected.Count
			</MokaButton>
		</SelectionActions>
		<RowActions Context="person">
			<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Text" StartIcon="MokaIcons.Action.Edit">Edit</MokaButton>
			<MokaButton Size="MokaSize.Xs" Variant="MokaVariant.Text" Color="MokaColor.Error" StartIcon="MokaIcons.Action.Delete">Delete</MokaButton>
		</RowActions>
	</MokaTable>
</DemoSection>

<DemoSection Id="keyboard" Title="Keyboard">
	<p>Click a cell, then use the arrows, Home and End. Enter edits a Name, and raises the row click on an Email. Keys in the Note box stay in it.</p>
	<MokaTable Items="_people.Take(5)" ItemKey="p => p.Id" ShowPagination="false" Title="@($"Rows clicked: {_rowClicks}, cells edited: {_cellEdits}")"
	           OnRowClick="@((Person _) => _rowClicks++)" OnRowSave="@((MokaTableRowSave<Person> _) => _cellEdits++)">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name" Editable="true"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email"/>
		<MokaColumn TItem="Person" Title="Note">
			<CellTemplate>
				<input aria-label="Note" @onclick:stopPropagation="true"/>
			</CellTemplate>
		</MokaColumn>
	</MokaTable>
</DemoSection>

<DemoSection Id="kept-state" Title="Kept state" Description="StorageKey keeps the sort, search, page, page size, density and columns from visit to visit, in the browser's local storage. Sort a column, hide one or pick a density, then reload the page. Reset puts the table back as its parameters set it." Tip="Register an IMokaTableStateStore to keep the state per person on the server instead.">
	<MokaTable @ref="_keptTable" TItem="Person" Items="_people" ItemKey="p => p.Id" StorageKey="showcase-people"
	           Title="People" Searchable ShowColumnChooser ShowDensityToggle @bind-State="_keptState">
		<ToolbarContent>
			<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" OnClick="ResetKeptAsync">Reset</MokaButton>
		</ToolbarContent>
		<ChildContent>
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name" Fixed/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
			<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
			<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
		</ChildContent>
	</MokaTable>
	<MokaCaption>@KeptSummary</MokaCaption>
</DemoSection>

<DemoSection Id="densities" Title="Densities" Description="Compact, Standard and Comfortable. Density sets where a table starts, and the density someone picks with ShowDensityToggle is part of the state.">
	<MokaGrid MinColumn="18rem" Style="gap: var(--moka-grid-gap);">
		<MokaTable TItem="Person" Items="FourPeople" ItemKey="p => p.Id" Density="MokaTableDensity.Compact" Title="Compact" ShowPagination="false">
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		</MokaTable>
		<MokaTable TItem="Person" Items="FourPeople" ItemKey="p => p.Id" Density="MokaTableDensity.Standard" Title="Standard" ShowPagination="false">
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		</MokaTable>
		<MokaTable TItem="Person" Items="FourPeople" ItemKey="p => p.Id" Density="MokaTableDensity.Comfortable" Title="Comfortable" ShowPagination="false">
			<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
			<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		</MokaTable>
	</MokaGrid>
</DemoSection>

<DemoSection Id="looks" Title="Looks" Description="Seven ways to draw the rows. Lined is the table as it has always looked. The looks draw on the new design; MokaTheme.Dark and Light draw Lined, except List, which is markup and works on both.">
	<DemoChoice TValue="MokaTableLook" Label="Look" Options="TableLooks" @bind-Value="_tableLook"/>
	<MokaTable TItem="Person" Items="SixPeople" ItemKey="p => p.Id" Look="_tableLook" ShowPagination="false">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name" Phone="MokaColumnPhone.Primary"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email" Phone="MokaColumnPhone.Secondary"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role" Phone="MokaColumnPhone.Secondary"/>
		<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right" Phone="MokaColumnPhone.Trailing"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="no-header-row" Title="No header row">
	<MokaTable Items="_people.Take(4)" ItemKey="p => p.Id" ShowHeader="false" ShowPagination="false" Label="People, no header row">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="striped-and-bordered" Title="Striped and bordered">
	<MokaTable Items="_people.Take(8)" ItemKey="p => p.Id" Striped="true" Bordered="true" ShowPagination="false">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="cell-templates" Title="Cell templates" Description="Your own cell content. For people, statuses, money and the other common cells, the column kinds draw them for you.">
	<MokaTable Items="_people.Take(10)" ItemKey="p => p.Id" ShowPagination="false" Title="Custom Cells">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status">
			<CellTemplate>
				@{
					var statusColor = context.Status switch
					{
						"Active" => MokaColor.Success,
						"Inactive" => MokaColor.Error,
						_ => MokaColor.Warning
					};
				}
				<MokaAttribute Color="statusColor" Variant="MokaVariant.Soft" Size="MokaSize.Xs">@context.Status</MokaAttribute>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Align="MokaTextAlign.Right">
			<CellTemplate>
				<strong>@context.Salary.ToString("C0")</strong>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="Person" Title="Joined" Field="p => p.JoinDate" Format="d"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="server-data" Title="Server data" Description="Loaded a page at a time through ServerData, with skeleton rows while it waits. The search, the sort and the filter row reach the source as a MokaTableRequest.">
	<MokaTable TItem="Person" ServerData="LoadServerDataAsync" ItemKey="p => p.Id" Searchable="true" Title="Server Data">
		<MokaColumn TItem="Person" Title="ID" Field="p => p.Id" Width="60px"/>
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name" Filterable="true"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role" Filterable="true" FilterType="MokaColumnFilterType.Select"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status" Filterable="true" FilterType="MokaColumnFilterType.Select"/>
	</MokaTable>
	<MokaCaption>The source received: @_serverRequest</MokaCaption>
</DemoSection>

<DemoSection Id="typed-filters" Title="Typed filters" Description="Filters are part of the state, each a column, an operator and values written in the invariant culture. Pick one: it goes to the source, which applies it, and the caption shows the request the source received.">
	<div class="button-row">
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => FilterBy(new MokaTableFilter("Salary", MokaFilterOperator.AtLeast, "150000")))">Salary at least 150,000</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => FilterBy(new MokaTableFilter("Role", MokaFilterOperator.IsAnyOf, ["Admin", "Editor"])))">Admins or editors</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="FilterJoinedThisYear">Joined in the last year</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => FilterBy(new MokaTableFilter("Name", MokaFilterOperator.EndsWith, "7")))">Name ends with 7</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary" OnClick="ClearTypedFilters">Clear</MokaButton>
	</div>
	<MokaTable TItem="Person" ServerData="LoadTypedAsync" ItemKey="p => p.Id" @bind-State="_typedState" Title="Filtered on the server">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Joined" Field="p => p.JoinDate" Format="d"/>
		<MokaColumn TItem="Person" Title="Salary" Field="p => p.Salary" Format="C0" Align="MokaTextAlign.Right"/>
	</MokaTable>
	<MokaCaption>The source received: @_typedRequest</MokaCaption>
</DemoSection>

<DemoSection Id="pinned-columns-and-heading-groups" Title="Pinned columns and heading groups" Description="The number and the customer stay at the start and the actions at the end while the rows scroll sideways. Shipping and Amounts are headings over their columns, and a heading splits where a pinned column leaves it. The column menu pins and unpins any column.">
	<MokaTable TItem="DemoOrder" Items="DemoOrders.Recent" ItemKey="o => o.Number" MinWidth="1400px" ColumnMenu PageSize="8" Title="Orders">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap Pin="MokaColumnPin.Start"/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer" NoWrap Pin="MokaColumnPin.Start"/>
		<MokaColumnGroup Title="Shipping">
			<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region"/>
			<MokaColumn TItem="DemoOrder" Title="Carrier" Field="o => o.Carrier"/>
			<MokaColumn TItem="DemoOrder" Title="Address" Field="o => o.Address" NoWrap/>
			<MokaDateColumn TItem="DemoOrder" Title="Placed" Value="o => o.Placed" Format="g"/>
		</MokaColumnGroup>
		<MokaColumnGroup Title="Amounts">
			<MokaNumberColumn TItem="DemoOrder" Title="Items" Value="o => o.Items" Format="N0"/>
			<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR"/>
		</MokaColumnGroup>
		<MokaStatusColumn TItem="DemoOrder" Title="Status" Status="o => o.Status" Tone="DemoOrders.StatusTone" Look="MokaStatusLook.Dot"/>
		<MokaActionsColumn TItem="DemoOrder" Actions="OrderActions" Pin="MokaColumnPin.End"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="filter-controls" Title="Filter controls" Description="Five ways to filter the same rows, and every one reads and writes the same filters. Set a filter in one mode and switch: the chips, the menus and the builder show it. Quick filters count the rows each keeps.">
	<DemoControl Label="Filter controls">
		<MokaSegmentedControl TValue="string" Value="@_filterMode.ToString()" ValueChanged="PickFilterMode" AriaLabel="Filter controls">
			<MokaSegment Value="@nameof(FilterMode.Row)" Text="Filter row"/>
			<MokaSegment Value="@nameof(FilterMode.Menus)" Text="Menus and chips"/>
			<MokaSegment Value="@nameof(FilterMode.Quick)" Text="Quick filters"/>
			<MokaSegment Value="@nameof(FilterMode.Facets)" Text="Facets"/>
			<MokaSegment Value="@nameof(FilterMode.Builder)" Text="Builder"/>
		</MokaSegmentedControl>
	</DemoControl>
	<MokaTable TItem="DemoOrder" Items="DemoOrders.All" ItemKey="o => o.Number" PageSize="8" Title="Orders"
	           FilterControls="FilterControlsOf(_filterMode)" QuickFilters="@(_filterMode == FilterMode.Quick ? DemoOrders.QuickFilters : null)">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer" Filterable/>
		<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region" Filterable FilterType="MokaColumnFilterType.MultiSelect"/>
		<MokaColumn TItem="DemoOrder" Title="Carrier" Field="o => o.Carrier" Filterable FilterType="MokaColumnFilterType.MultiSelect"/>
		<MokaStatusColumn TItem="DemoOrder" Title="Status" Status="o => o.Status" Tone="DemoOrders.StatusTone" Filterable/>
		<MokaDateColumn TItem="DemoOrder" Title="Placed" Value="o => o.Placed" Format="d" Filterable/>
		<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR" Filterable/>
	</MokaTable>
</DemoSection>

<DemoSection Id="search-highlight" Title="Search highlight" Description="HighlightSearch marks what the search found in the cells that write their text. The search binds, so the buttons below search from outside the table and the line under it shows what someone typed.">
	<div class="button-row">
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => _fileSearch = "report")">Find reports</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => _fileSearch = "log")">Find logs</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" Color="MokaColor.Secondary" OnClick="@(() => _fileSearch = null)">Clear</MokaButton>
	</div>
	<MokaTable TItem="DemoFileEntry" Items="DemoOrders.Files" ItemKey="f => f.Name" Searchable HighlightSearch @bind-Search="_fileSearch"
	           Debounce="TimeSpan.FromMilliseconds(150)" ShowPagination="false" Title="Files">
		<MokaColumn TItem="DemoFileEntry" Title="Name" Field="f => f.Name"/>
		<MokaColumn TItem="DemoFileEntry" Title="Folder" Field="f => f.Folder"/>
		<MokaColumn TItem="DemoFileEntry" Title="Owner" Field="f => f.Owner"/>
		<MokaBytesColumn TItem="DemoFileEntry" Title="Size" Value="f => f.Size"/>
	</MokaTable>
	<MokaCaption>Search: @(string.IsNullOrEmpty(_fileSearch) ? "nothing" : $"\"{_fileSearch}\"")</MokaCaption>
</DemoSection>

<DemoSection Id="column-menu" Title="Column menu" Description="ColumnMenu puts a menu in each heading: sort, filter, pin, group by, hide and fit the column. Group by a column to see the group bar, and pick it again to stop grouping.">
	<MokaTable TItem="DemoOrder" Items="DemoOrders.Recent" ItemKey="o => o.Number" ColumnMenu MultiSort PageSize="8"
	           FilterControls="MokaTableFilterControls.Chips" Title="Orders">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer" Filterable/>
		<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region" Filterable FilterType="MokaColumnFilterType.MultiSelect"/>
		<MokaStatusColumn TItem="DemoOrder" Title="Status" Status="o => o.Status" Tone="DemoOrders.StatusTone" Filterable/>
		<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR" Aggregate="MokaAggregateType.Sum"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="server-facets-and-totals" Title="Server facets and totals" Description="A ServerData source that answers the whole request: the facet panel's values and the quick filters' counts under FacetsFromServer, the footer's totals over every page, and each region's count and total in its heading. The line under the table shows what the source was asked.">
	<MokaTable TItem="DemoOrder" ServerData="LoadOrdersAsync" ItemKey="o => o.Number" PageSize="10" Title="Orders" Searchable
	           FacetsFromServer FilterControls="MokaTableFilterControls.Facets | MokaTableFilterControls.Chips"
	           QuickFilters="DemoOrders.QuickFilters" GroupBy="Region" ItemsName="orders">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap Aggregate="MokaAggregateType.Count"/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer"/>
		<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region" Filterable FilterType="MokaColumnFilterType.MultiSelect"/>
		<MokaColumn TItem="DemoOrder" Title="Carrier" Field="o => o.Carrier" Filterable FilterType="MokaColumnFilterType.MultiSelect"/>
		<MokaStatusColumn TItem="DemoOrder" Title="Status" Status="o => o.Status" Tone="DemoOrders.StatusTone" Filterable/>
		<MokaDateColumn TItem="DemoOrder" Title="Placed" Value="o => o.Placed" Format="d"/>
		<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR" Aggregate="MokaAggregateType.Sum"/>
	</MokaTable>
	<MokaCaption>The source was asked for: @_ordersRequest</MokaCaption>
</DemoSection>

<DemoSection Id="nested-groups" Title="Nested groups" Description="Grouped by region, then by status, across every page: a page that starts inside a group draws its headings again, and each heading counts and totals its whole group. The group bar folds and opens every group.">
	<MokaTable TItem="DemoOrder" Items="DemoOrders.All" ItemKey="o => o.Number" ColumnMenu PageSize="12" State="NestedGroups" Title="Orders by region and status">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap Aggregate="MokaAggregateType.Count"/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer"/>
		<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region"/>
		<MokaColumn TItem="DemoOrder" Title="Status" Field="o => o.Status"/>
		<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR" Aggregate="MokaAggregateType.Sum"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="row-clicks-and-pinned-rows" Title="Row clicks and pinned rows" Description="A click picks a row the way a file list does: Ctrl or Cmd adds one, Shift picks a run. A double click opens it. The watched order stays at the top and the totals at the bottom whatever the sort and the page. The button over the toggles, or the two below, open and close every detail row.">
	<div class="button-row">
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="ExpandAllRowsAsync">Expand all</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="CollapseAllRowsAsync">Collapse all</MokaButton>
	</div>
	<MokaTable @ref="_clickTable" TItem="DemoOrder" Items="DemoOrders.Recent" ItemKey="o => o.Number" PageSize="8" Title="Orders"
	           Selectable SelectOnRowClick @bind-SelectedItems="_clickPicked" OnRowDoubleClick="OpenOrder"
	           PinnedTop="WatchedOrders" PinnedBottom="RecentTotals" Expandable ShowExpandAll>
		<ChildContent>
			<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap/>
			<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer"/>
			<MokaNumberColumn TItem="DemoOrder" Title="Items" Value="o => o.Items" Format="N0"/>
			<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR"/>
		</ChildContent>
		<DetailTemplate Context="order">
			<MokaText Size="MokaSize.Sm">@order.Customer ordered @order.Items items on @order.Placed.ToString("D", CultureInfo.CurrentCulture), sent by @order.Carrier to @order.Address.</MokaText>
		</DetailTemplate>
	</MokaTable>
	<MokaCaption>@_clickPicked.Count picked. @_opened</MokaCaption>
</DemoSection>

<DemoSection Id="owned-selection" Title="Owned selection" Description="The page passes SelectedItems and handles SelectedItemsChanged, so it owns the selection. It takes up to three rows and hands back nothing for a fourth, and the table undoes that pick.">
	<MokaTable TItem="DemoOrder" Items="DemoOrders.Few" ItemKey="o => o.Number" Selectable ShowPagination="false"
	           SelectedItems="_ownedPicked" SelectedItemsChanged="PickOwned" Title="Pick up to three">
		<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap/>
		<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer"/>
		<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR"/>
	</MokaTable>
	<MokaCaption>@_ownedPicked.Count of 3 picked. @_ownedNote</MokaCaption>
</DemoSection>

<DemoSection Id="no-results-and-a-failed-load" Title="No results and a failed load" Description="A search that leaves no row says so, with a button that clears it. A ServerData load that throws shows inside the table with Try again, and stays out of the error boundary: turn the switch off, then press Try again.">
	<MokaGrid MinColumn="20rem" Gap="MokaSpacingScale.Md">
		<div class="table-demo-stack">
			<div class="button-row">
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="@(() => _missingSearch = "no such file")">Search for a file nobody has</MokaButton>
			</div>
			<MokaTable TItem="DemoFileEntry" Items="DemoOrders.Files" ItemKey="f => f.Name" Searchable @bind-Search="_missingSearch" PageSize="5" Title="Files">
				<MokaColumn TItem="DemoFileEntry" Title="Name" Field="f => f.Name"/>
				<MokaColumn TItem="DemoFileEntry" Title="Folder" Field="f => f.Folder"/>
			</MokaTable>
		</div>
		<div class="table-demo-stack">
			<MokaSwitch @bind-Value="_failLoads" Label="Fail the loads"/>
			<MokaTable TItem="DemoOrder" ServerData="LoadFlakyAsync" ItemKey="o => o.Number" PageSize="5" ItemsName="orders" ShowRefresh
			           OnLoadFailed="NoteFailure" Title="Orders">
				<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap/>
				<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer"/>
				<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR"/>
			</MokaTable>
			<MokaCaption>@_failureNote</MokaCaption>
		</div>
	</MokaGrid>
</DemoSection>

<DemoSection Id="app-wide-look-and-density" Title="App-wide look and density" Description="MokaTheme.WithTables and WithTableDensity set the look and the density of every table that doesn't set its own, here on a nested MokaThemeProvider. They are style choices of the new design: on MokaTheme.Dark and Light the theme stays as it is and tables draw Lined.">
	<DemoChoice TValue="MokaTableLook" Label="WithTables" Options="TableLooks" Value="_themeLook" ValueChanged="PickThemeLook"/>
	<DemoChoice TValue="MokaTableDensity" Label="WithTableDensity" Options="TableDensities" Value="_themeDensity" ValueChanged="PickThemeDensity"/>
	<MokaThemeProvider Theme="_tableTheme">
		<MokaTable TItem="DemoOrder" Items="DemoOrders.Few" ItemKey="o => o.Number" ShowPagination="false" Title="Orders">
			<MokaColumn TItem="DemoOrder" Title="Number" Field="o => o.Reference" Mono NoWrap Phone="MokaColumnPhone.Trailing"/>
			<MokaColumn TItem="DemoOrder" Title="Customer" Field="o => o.Customer" Phone="MokaColumnPhone.Primary"/>
			<MokaColumn TItem="DemoOrder" Title="Region" Field="o => o.Region" Phone="MokaColumnPhone.Secondary"/>
			<MokaMoneyColumn TItem="DemoOrder" Title="Total" Value="o => o.Total" Currency="EUR" Phone="MokaColumnPhone.Secondary"/>
		</MokaTable>
	</MokaThemeProvider>
</DemoSection>

<DemoSection Id="pagers" Title="Pagers" Description="A MokaTablePager among the columns says which of the seven pagers the table draws. Without one it draws Numbered.">
	<DemoChoice TValue="MokaPagerLook" Label="Pager" Options="PagerLooks" @bind-Value="_pagerLook"/>
	<MokaTable TItem="Device" Items="Devices" PageSize="5" ItemKey="d => d.Name">
		<MokaColumn TItem="Device" Title="Name" Field="d => d.Name"/>
		<MokaColumn TItem="Device" Title="Address" Field="d => d.Address" Mono="true"/>
		<MokaColumn TItem="Device" Title="Rate" Field="d => d.BytesPerSecond" Mono="true" Align="MokaTextAlign.Right" DefaultSort="MokaSortDirection.Descending">
			<CellTemplate Context="d">@d.Rate</CellTemplate>
		</MokaColumn>
		<MokaTablePager Look="_pagerLook" PageSizeOptions="DevicePageSizes"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="pager-at-both-ends" Title="Pager at both ends" Description="Position puts the numbered pager under the rows, above them or both, here with the sizes someone can pick.">
	<MokaTable Items="_people" ItemKey="p => p.Id" PageSize="5">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaTablePager Position="MokaTablePaginationPosition.Both" PageSizeOptions="PeoplePageSizes" MaxVisiblePages="3"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="cursor-paging" Title="Cursor paging" Description="A source that hands out a cursor for the next and the previous page, and never counts the rows. The cursor pager draws Newer and Older and passes the cursor back in MokaTableRequest.Cursor.">
	<MokaTable TItem="FeedEvent" ServerData="LoadFeedAsync" ItemKey="e => e.Number" PageSize="6" Title="Activity">
		<MokaColumn TItem="FeedEvent" Title="Number" Field="e => e.Number" Width="5rem" Mono="true" Sortable="false"/>
		<MokaColumn TItem="FeedEvent" Title="When" Field="e => e.At" Format="g" Sortable="false"/>
		<MokaColumn TItem="FeedEvent" Title="Message" Field="e => e.Message" Sortable="false"/>
		<MokaTablePager Look="MokaPagerLook.Cursor"/>
	</MokaTable>
	<MokaCaption>Last cursor asked for: @(_feedCursor ?? "none, the newest page")</MokaCaption>
</DemoSection>

<DemoSection Id="empty" Title="Empty">
	<MokaTable Items="Enumerable.Empty<Person>()" ItemKey="p => p.Id" ShowPagination="false" Title="Empty Table">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="fixed-height" Title="Fixed height" Description="A bounded body that scrolls under a fixed header.">
	<MokaTable Items="_people.Take(50)" ItemKey="p => p.Id" Height="250px" FixedHeader="true" ShowPagination="false" Title="Scrollable">
		<MokaColumn TItem="Person" Title="ID" Field="p => p.Id" Width="60px"/>
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
		<MokaColumn TItem="Person" Title="Email" Field="p => p.Email"/>
		<MokaColumn TItem="Person" Title="Role" Field="p => p.Role"/>
		<MokaColumn TItem="Person" Title="Status" Field="p => p.Status"/>
	</MokaTable>
</DemoSection>

<DemoSection Id="sort-by-several-columns" Title="Sort by several columns" Description="DefaultSort sets the sort a table starts with: here Role, then Salary from the top.">
	<MokaTable Items="_people.Take(30)" ItemKey="p => p.Id" MultiSort="true" ShowPagination="false"
	           Title="Multi-Sort Table" Searchable="true">
		<MokaColumn TItem="Person" Title="Name" Field="p => p.Name"/>
