		int Id,
		[property: Required(ErrorMessage = "Give a name.")]
		[property: StringLength(24, ErrorMessage = "A name is at most 24 letters.")]
		string Name,
		[property: Range(18.0, 120.0, ErrorMessage = "Age is 18 to 120.")]
		double? Age,
		[property: Required(ErrorMessage = "Give an email address.")]
		[property: EmailAddress(ErrorMessage = "That isn't an email address.")]
		string Email);

	private List<Signup> _signups =
	[
		new(1, "Ada", 34, "ada@example.com"),
		new(2, "Lena", 27, "lena@example.com"),
		new(3, "Omar", null, "omar@example.com")
	];

	private string _signupNote = "Nothing saved yet.";

	private void SaveSignup(MokaTableRowSave<Signup> save)
	{
		Signup signup = save.Updated;
		if (_signups.Exists(other => other.Id != signup.Id && string.Equals(other.Name, signup.Name, StringComparison.OrdinalIgnoreCase)))
		{
			save.AddError("Name", $"{signup.Name} is taken.");
		}

		if (signup.Email.EndsWith("@example.org", StringComparison.OrdinalIgnoreCase))
		{
			save.AddError("The mail server refuses example.org addresses.");
		}

		if (save.Errors.Count > 0)
		{
			_signupNote = $"Refused: {string.Join(" ", save.Errors.Select(error => error.Value))}";
			return;
		}

		_signups = [.. _signups.Select(other => other.Id == signup.Id ? signup : other)];
		_signupNote = $"Saved {signup.Name}: {DescribeChanges(save.Changes)}.";
	}

