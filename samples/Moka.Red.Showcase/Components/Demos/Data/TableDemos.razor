@code {
	private record Person(int Id, string Name, string Email, string Role, string Status, DateTime JoinDate, decimal Salary);

	private static readonly List<Person> _people = Enumerable.Range(1, 247).Select(i => new Person(
		i,
		$"Person {i}",
		$"person{i}@example.com",
		new[] { "Admin", "User", "Editor", "Viewer" }[i % 4],
		new[] { "Active", "Inactive", "Pending" }[i % 3],
		DateTime.Today.AddDays(-i * 7),
		50000m + i * 500m
	)).ToList();

	private static readonly Person[] FourPeople = [.. _people.Take(4)];

	private static readonly Person[] SixPeople = [.. _people.Take(6)];

	private static readonly MokaTableText FilterPeopleText = MokaTableText.Default with { SearchPlaceholder = "Filter people..." };

	private static readonly MokaTableText SearchDevicesText = MokaTableText.Default with { SearchPlaceholder = "Search devices" };

	private static readonly MokaTableLook[] TableLooks = Enum.GetValues<MokaTableLook>();

	private static readonly MokaPagerLook[] PagerLooks = Enum.GetValues<MokaPagerLook>();

	private static readonly int[] DevicePageSizes = [5, 10];

	private static readonly int[] PeoplePageSizes = [5, 10, 25];

	private static readonly int[] StickyPageSizes = [8, 16, 32];

	private void HandleRowContextMenu(MokaItemContextMenuArgs<Person> args)
	{
		Person p = args.Item;
		ContextMenu.Show(args.MouseEvent,
		[
			new MokaContextMenuItem { Text = $"Open {p.Name}", Icon = MokaIcons.Toggle.Eye, OnClickSync = () => Toast.ShowInfo($"Open {p.Name}") },
			new MokaContextMenuItem { Text = "Edit", Icon = MokaIcons.Action.Edit, OnClickSync = () => Toast.ShowInfo($"Edit {p.Name}") },
			new MokaContextMenuItem { Text = "Copy email", OnClickSync = () => Toast.ShowSuccess(p.Email) },
			new MokaContextMenuItem { Text = "Delete", Icon = MokaIcons.Action.Delete, DividerBefore = true, OnClickSync = () => Toast.ShowError($"Delete {p.Name}") }
		]);
	}

	private HashSet<Person> _tableSelectedItems = [];

	private void HandleSelectionChanged(HashSet<Person> items)
	{
		_tableSelectedItems = items;
	}

	private int _rowClicks;

	private int _cellEdits;

	private MokaTable<Person>? _keptTable;

	private MokaTableState? _keptState;

	private string KeptSummary => _keptState is null
		? "Nothing changed yet."
		: $"Sorted by {DescribeSorts(_keptState.Sorts)}, page {_keptState.Page}, {_keptState.Density}, {_keptState.Columns.Count(column => column.Hidden)} hidden.";

	private async Task ResetKeptAsync()
	{
		if (_keptTable is not null)
		{
			await _keptTable.ResetStateAsync();
		}
	}

	private MokaTableLook _tableLook = MokaTableLook.Sheet;

	private MokaPagerLook _pagerLook = MokaPagerLook.Numbered;

	private string _serverRequest = "nothing yet";

	private async Task<MokaTableResult<Person>> LoadServerDataAsync(MokaTableRequest request)
	{
		_serverRequest = DescribeRequest(request);
		StateHasChanged();
		await Task.Delay(400, request.CancellationToken);
		return PeopleQuery.Run(request);
	}

	private MokaTableState? _typedState;

	private string _typedRequest = "nothing yet";

	private async Task<MokaTableResult<Person>> LoadTypedAsync(MokaTableRequest request)
	{
		_typedRequest = DescribeRequest(request);
		StateHasChanged();
		await Task.Delay(250, request.CancellationToken);
		return PeopleQuery.Run(request);
	}

	private void FilterBy(MokaTableFilter filter) =>
		_typedState = (_typedState ?? new MokaTableState()) with { Filters = [filter], Page = 1 };

	private void FilterJoinedThisYear() =>
		FilterBy(new MokaTableFilter("Joined", MokaFilterOperator.Between,
			[DateTime.Today.AddYears(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)]));

	private void ClearTypedFilters() =>
		_typedState = (_typedState ?? new MokaTableState()) with { Filters = [], Page = 1 };

	private static readonly DemoQuery<Person> PeopleQuery = new(_people,
	[
		new DemoColumn<Person>("ID", p => p.Id.ToString(CultureInfo.InvariantCulture)) { Number = p => p.Id },
		new DemoColumn<Person>("Name", p => p.Name) { Searched = true },
		new DemoColumn<Person>("Role", p => p.Role) { Searched = true },
		new DemoColumn<Person>("Status", p => p.Status),
		new DemoColumn<Person>("Joined", p => p.JoinDate.ToString("d", CultureInfo.CurrentCulture)) { Date = p => new DateTimeOffset(p.JoinDate) },
		new DemoColumn<Person>("Salary", p => p.Salary.ToString("C0", CultureInfo.CurrentCulture)) { Number = p => (double)p.Salary }
	]);

	private static string DescribeRequest(MokaTableRequest request)
	{
		string filters = request.Filters.Count == 0
			? "no filters"
			: string.Join("; ", request.Filters.Select(filter => $"{filter.Column} {filter.Operator} {string.Join(", ", filter.Values)}"));
		return $"page {request.Page} of {request.PageSize}, search \"{request.Search}\", sorted by {DescribeSorts(request.Sorts)}, {filters}";
	}

	private static string DescribeSorts(IReadOnlyList<MokaTableSort>? sorts) =>
		sorts is { Count: > 0 } ? string.Join(", ", sorts.Select(sort => $"{sort.Column} {sort.Direction}")) : "nothing";

	private sealed record FeedEvent(int Number, DateTime At, string Message);

	private static readonly FeedEvent[] _feed =
	[
		.. Enumerable.Range(1, 40).Reverse().Select(i => new FeedEvent(i, DateTime.Today.AddHours(-41 + i), $"Backup {i} finished"))
	];

	private string? _feedCursor;

	// A source that pages by cursor and never counts the rows. The cursor is opaque to the table; this one only
	// remembers where a page starts.
	private async Task<MokaTableResult<FeedEvent>> LoadFeedAsync(MokaTableRequest request)
	{
		_feedCursor = request.Cursor;
		StateHasChanged();
		await Task.Delay(250, request.CancellationToken);
		int start = request.Cursor is { Length: > 1 } cursor ? int.Parse(cursor[1..], CultureInfo.InvariantCulture) : 0;
		int next = start + request.PageSize;
		return new MokaTableResult<FeedEvent>
		{
			Items = [.. _feed.Skip(start).Take(request.PageSize)],
			NextCursor = next < _feed.Length ? FeedCursor(next) : null,
			PreviousCursor = start > 0 ? FeedCursor(Math.Max(0, start - request.PageSize)) : null
		};
	}

	private static string FeedCursor(int start) => string.Create(CultureInfo.InvariantCulture, $"c{start}");

	private static readonly AuditEntry[] _audit =
	[
		new("evt_01HZY3K9Q2W7TX4M", "Grace Hopper", "library.key.rotate", "Started key generation 4 for Photos after a member left."),
		new("evt_01HZY3M1B8D2RZ0Q", "Alan Turing", "share.link.create", "A link to Holiday 2026 that expires in 7 days."),
		new("evt_01HZY3P4C7F9KQ5L", "Barbara Liskov", "device.wipe.order", "Asked Old laptop to remove every file it keeps."),
		new("evt_01HZY3R6D2H8MN3V", "Ada Lovelace", "plugin.install", "Office Preview 1.0.1 from the community catalog.")
	];

	private sealed record AuditEntry(string Id, string Who, string Action, string Detail);

	private static readonly Device[] Devices =
	[
		new("Backup drive", "192.168.1.12", "Home", "2 min ago", 0),
		new("Kitchen speaker", "192.168.1.18", "Things", "Now", 1_200_000),
		new("Living room TV", "192.168.1.31", "Things", "Now", 4_600_000),
		new("Office desktop", "192.168.1.24", "Home", "Now", 12_400_000),
		new("Phone", "192.168.1.52", "Home", "4 min ago", 0),
		new("Printer", "192.168.1.40", "Guests", "20 min ago", 0),
		new("Tablet", "192.168.1.57", "Guests", "1 h ago", 0),
		new("Thermostat", "192.168.1.63", "Things", "Now", 2_000),
		new("Doorbell", "192.168.1.71", "Things", "Now", 48_000),
		new("Guest laptop", "192.168.1.84", "Guests", "6 min ago", 310_000),
		new("Game console", "192.168.1.90", "Home", "1 h ago", 0),
		new("Robot vacuum", "192.168.1.95", "Things", "3 h ago", 0),
		new("Baby monitor", "192.168.1.98", "Things", "Now", 860_000),
		new("Visitor phone", "192.168.1.103", "Guests", "Yesterday", 0)
	];

	private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true };

	private const string ZoneColumn = "Zone";

	private readonly List<MokaTableView> _views =
	[
		new("Everything", new MokaTableState()),
		new("Guests", new MokaTableState { Filters = [new MokaTableFilter(ZoneColumn, MokaFilterOperator.Is, "Guests")] }),
		new("Things", new MokaTableState { Filters = [new MokaTableFilter(ZoneColumn, MokaFilterOperator.Is, "Things")] })
	];

	private IReadOnlyList<MokaTableView> _viewsShown = [];

	private MokaTableState? _devicesState;

	private List<Device> _ticking = [.. Devices.Take(5)];

	private Timer? _timer;

	private string _zone = "All";

	private string _log = "Nothing yet.";

	[SupplyParameterFromQuery(Name = "phone")]
	private bool Phone { get; set; }

	private string DevicesStateText => _devicesState is null
		? "Nothing arranged yet."
		: JsonNode.Parse(_devicesState.ToJson())?.ToJsonString(Indented) ?? string.Empty;

	private RenderFragment DevicesTable =>
		@<MokaTable TItem="Device" Items="Devices" ItemKey="d => d.Name" Framed="true"
		            Searchable="true" Text="SearchDevicesText"
		            Views="_viewsShown" ViewSaved="SaveView" ViewForgotten="ForgetView"
		            ShowColumnChooser="true" ColumnReorderable="true" State="_devicesState" StateChanged="DevicesStateChanged"
		            Selectable="true" ItemName="d => d.Name" PageSize="8">
			<BulkActions Context="picked">
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" OnClick="() => Note(picked)">Limit</MokaButton>
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" Color="MokaColor.Secondary" OnClick="() => Note(picked)">Block</MokaButton>
			</BulkActions>
			<ChildContent>
				<MokaColumn TItem="Device" Title="Name" Field="d => d.Name" Fixed="true" Width="28%" Phone="MokaColumnPhone.Primary"
				            DefaultSort="MokaSortDirection.Ascending"/>
				<MokaColumn TItem="Device" Title="Address" Field="d => d.Address" Mono="true" Phone="MokaColumnPhone.Secondary">
					<CellTemplate Context="d">
						<MokaCopyable Text="@d.Address" Label="address"/>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="Device" Title="@ZoneColumn" Field="d => d.Zone" Phone="MokaColumnPhone.Secondary">
					<CellTemplate Context="d">
						<MokaTag Text="@d.Zone" Color="ZoneColor(d.Zone)" Pill="true" Size="MokaSize.Sm"/>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="Device" Title="Seen" Field="d => d.Seen" Sortable="false"/>
				<MokaColumn TItem="Device" Title="Rate" Field="d => d.BytesPerSecond" Mono="true" Align="MokaTextAlign.Right" Phone="MokaColumnPhone.Trailing">
					<CellTemplate Context="d">@d.Rate</CellTemplate>
				</MokaColumn>
				<MokaTablePager Look="MokaPagerLook.LoadMore"/>
			</ChildContent>
		</MokaTable>;

	protected override void OnInitialized()
	{
		_viewsShown = [.. _views];
		_logStream = ReadLogAsync();
		if (!Phone)
		{
			_timer = new Timer(_ => InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
		}
	}

	public void Dispose() => _timer?.Dispose();

	private static MokaColor ZoneColor(string zone) => zone switch
