<DemoSection Id="asymmetric-layout" Title="Asymmetric layout" Description="Tiles of different sizes in one grid.">
	<MokaBentoGrid Columns="4" GapValue="12px">
		<MokaBentoItem ColSpan="2" RowSpan="2" Title="Featured">
			<MokaFlexbox Direction="MokaDirection.Column" Justify="MokaJustify.Center" Align="MokaAlign.Center" Style="height: 100%;">
				<MokaIcon Icon="MokaIcons.Toggle.Heart" SizeValue="48px" Style="color: var(--moka-color-primary);" />
				<MokaHeading Level="3" Style="margin-top: var(--moka-spacing-md);">Hero Cell</MokaHeading>
				<MokaText Size="MokaSize.Sm">Spans 2 columns and 2 rows</MokaText>
			</MokaFlexbox>
		</MokaBentoItem>
		<MokaBentoItem Title="Performance">
			<MokaText Size="MokaSize.Sm">Zero JS where possible</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Theming">
			<MokaText Size="MokaSize.Sm">CSS custom properties</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Accessible" Clickable>
			<MokaText Size="MokaSize.Sm">Keyboard-first design</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Responsive">
			<MokaText Size="MokaSize.Sm">Breakpoint-aware</MokaText>
		</MokaBentoItem>
		<MokaBentoItem ColSpan="4" Title="Full Width">
			<MokaText Size="MokaSize.Sm">This item spans all 4 columns - perfect for banners or CTAs.</MokaText>
		</MokaBentoItem>
	</MokaBentoGrid>
</DemoSection>

<DemoSection Id="columns-that-follow-the-width" Title="Columns that follow the width" Description="MinColumn fits as many columns as the width holds. Spans are capped at the columns that fit, so a wide tile never pushes the grid past its edge. Narrow the window to watch the hero drop from three columns to two and then one.">
	<MokaBentoGrid MinColumn="12rem" GapValue="12px" MinRowHeight="80px">
		<MokaBentoItem ColSpan="3" Title="Hero">
			<MokaText Size="MokaSize.Sm">Three columns where three fit</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Uptime">
			<MokaText Size="MokaSize.Sm">99.98%</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Devices">
			<MokaText Size="MokaSize.Sm">42 online</MokaText>
		</MokaBentoItem>
		<MokaBentoItem ColSpan="2" Title="Traffic">
			<MokaText Size="MokaSize.Sm">Two columns where two fit</MokaText>
		</MokaBentoItem>
		<MokaBentoItem Title="Alerts">
			<MokaText Size="MokaSize.Sm">None</MokaText>
		</MokaBentoItem>
	</MokaBentoGrid>
</DemoSection>

<DemoSection Id="cards-of-one-height" Title="Cards of one height" Description="On a board, StretchCards makes every card in a row as tall as the tallest, so their edges line up.">
	<MokaSwitch @bind-Value="_stretch" Label="Stretch cards"/>
	<MokaBentoGrid Board="_board" BoardChanged="board => _board = board" StretchCards="_stretch">
		<CardTemplate Context="card">
			<MokaBentoItem Card="card" Title="@card.Id">
				@if (card.Id == "Traffic")
				{
					<MokaText Size="MokaSize.Sm">A taller card, with more to say than the ones beside it, so they are shorter unless they stretch.</MokaText>
					<MokaText Size="MokaSize.Sm">Second line.</MokaText>
					<MokaText Size="MokaSize.Sm">Third line.</MokaText>
				}
				else
				{
					<MokaText Size="MokaSize.Sm">Short</MokaText>
				}
			</MokaBentoItem>
		</CardTemplate>
	</MokaBentoGrid>
</DemoSection>

<DemoSection Id="cards-in-their-order" Title="Cards in their order" Description="Flow Rows keeps a board's cards in the order they were put in, and the cards of a row grow to fill it, so a hidden card or a wide one that doesn't fit leaves no hole. Dense, the default, fills a hole by moving a later card up: there Uptime jumps ahead of Traffic. Customize the board, hide a card or change its size, and switch the flow to compare.">
	<DemoChoice TValue="MokaBoardFlow" Label="Flow" Options="Flows" @bind-Value="_flow"/>
	<MokaSwitch @bind-Value="_orderCustomizing" Label="Customize"/>
	<MokaBentoGrid Board="_orderBoard" BoardChanged="board => _orderBoard = board" Flow="_flow"
	               @bind-Customizing="_orderCustomizing" DefaultBoard="OrderDefaults">
		<CardTemplate Context="card">
			<MokaBentoItem Card="card" Title="@card.Id">
				<MokaText Size="MokaSize.Sm">@card.Size</MokaText>
			</MokaBentoItem>
		</CardTemplate>
	</MokaBentoGrid>
</DemoSection>

<DemoSection Id="head-slots" Title="Head slots" Description="IconContent draws a picture, an identicon or an emoji in the icon's place, and EndContent puts a count, a status dot or a button at the end of the head. On a clickable card a click on that button only runs the button; a click anywhere else, the count included, clicks the card.">
	<MokaSwitch @bind-Value="_slotsCustomizing" Label="Customize"/>
	<MokaBentoGrid Board="_slotsBoard" BoardChanged="board => _slotsBoard = board" @bind-Customizing="_slotsCustomizing">
		<CardTemplate Context="card">
			<MokaBentoItem Card="card" Title="@card.Id" Clickable OnClick="() => _clickedCard = card.Id">
				<IconContent>
					@switch (card.Id)
					{
						case "Team":
							<MokaIdenticon Value="team" SizeValue="16px" Rounded="MokaRounding.Sm"/>
							break;
						case "Uptime":
							<span>&#x1F4C8;</span>
							break;
						default:
							<span>&#x1F514;</span>
							break;
					}
				</IconContent>
				<EndContent>
					@switch (card.Id)
					{
						case "Team":
							<MokaBadge Content="3" Tone="MokaBadgeTone.NeedsYou"/>
							break;
						case "Uptime":
							<MokaStatusDot Color="MokaColor.Success" Label="Live" Pulse/>
							break;
						default:
							<MokaTooltip Text="@(_muted ? "Unmute" : "Mute")" Position="MokaTooltipPosition.BottomEnd">
								<MokaButton Quiet StartIcon="@(_muted ? MokaIcons.Toggle.VolumeOff : MokaIcons.Toggle.Volume)"
								            aria-label="@(_muted ? "Unmute" : "Mute")" OnClick="() => _muted = !_muted"/>
							</MokaTooltip>
							break;
					}
				</EndContent>
				<ChildContent>
					<MokaText Size="MokaSize.Sm">@card.Size</MokaText>
				</ChildContent>
			</MokaBentoItem>
		</CardTemplate>
	</MokaBentoGrid>
	<MokaText Size="MokaSize.Sm">Last card clicked: @(_clickedCard ?? "none"). Alerts are @(_muted ? "muted" : "on").</MokaText>
</DemoSection>

@code {
	private static readonly MokaBoardFlow[] Flows = Enum.GetValues<MokaBoardFlow>();

	private IReadOnlyList<MokaBoardCard> _slotsBoard =
	[
		new("Team", MokaBoardSize.Small),
		new("Uptime", MokaBoardSize.Small),
		new("Alerts", MokaBoardSize.Wide)
	];

	private bool _slotsCustomizing;
	private string? _clickedCard;
	private bool _muted;

	private static readonly IReadOnlyList<MokaBoardCard> OrderDefaults =
	[
		new("Internet", MokaBoardSize.Wide),
		new("Devices", MokaBoardSize.Small, Hidden: true),
		new("Security", MokaBoardSize.Small),
		new("Traffic", MokaBoardSize.Wide),
		new("Alerts", MokaBoardSize.Wide),
		new("Uptime", MokaBoardSize.Small),
		new("Plugins", MokaBoardSize.Small)
	];

	private MokaBoardFlow _flow = MokaBoardFlow.Rows;
	private bool _orderCustomizing;
	private IReadOnlyList<MokaBoardCard> _orderBoard = OrderDefaults;

	private bool _stretch = true;

	private IReadOnlyList<MokaBoardCard> _board =
	[
		new("Traffic", MokaBoardSize.Wide),
		new("Devices", MokaBoardSize.Small),
		new("Alerts", MokaBoardSize.Small)
	];
}
