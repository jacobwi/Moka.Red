<DemoSection Id="basics" Title="Basics" Description="One line of text, with a label, a hint or error, icons and a clear button." Tip="A bound Value updates on every key. Set DebounceDelay when each change costs a search.">
	<ChildContent>
		<EditForm Model="@_model" style="display: flex; flex-direction: column; gap: var(--moka-spacing-lg); max-width: 480px;">
			<MokaTextField @bind-Value="_model.Name" Label="Name" Placeholder="Enter your name" HelperText="Your full name"/>
			<MokaTextField @bind-Value="_model.Email" Label="Email" Placeholder="user@example.com" StartIcon="MokaIcons.Action.Search"/>
			<MokaTextField @bind-Value="_model.Name" Label="Clearable" Placeholder="Type something..." Clearable="true"/>
			<MokaTextField @bind-Value="_model.Name" Label="With Error" Placeholder="Invalid input" ErrorText="This field is required."/>
			<MokaTextField @bind-Value="_model.Name" Label="Disabled" Placeholder="Cannot edit" Disabled="true"/>

			<h3>TextField Sizes</h3>
			<MokaTextField @bind-Value="_model.Name" Label="Small" Size="MokaSize.Sm" Placeholder="Small input"/>
			<MokaTextField @bind-Value="_model.Name" Label="Medium" Size="MokaSize.Md" Placeholder="Medium input"/>
			<MokaTextField @bind-Value="_model.Name" Label="Large" Size="MokaSize.Lg" Placeholder="Large input"/>
		</EditForm>
	</ChildContent>
	<Notes>
		<DemoParam Name="Label, HelperText">The name above and the hint under it</DemoParam>
		<DemoParam Name="ErrorText">Shows the error state in place of the hint</DemoParam>
		<DemoParam Name="StartIcon, EndIcon">Icons inside the box</DemoParam>
		<DemoParam Name="Clearable">A button that empties it</DemoParam>
		<DemoParam Name="Suffix">A unit inside the box, read out with the value</DemoParam>
		<DemoParam Name="DebounceDelay">Waits this many ms after the last key</DemoParam>
	</Notes>
	<Playground>
		<TextFieldPlayground/>
	</Playground>
</DemoSection>

<DemoSection Id="suggestions" Title="Suggestions" Description="Suggestions lists values to offer while the person types anything. The value is what's in the box: a suggestion is one way to type it, and text that matches none is kept. Down or Up opens the list, Enter or a click picks, Escape or Tab closes.">
	<div style="display: flex; flex-direction: column; gap: var(--moka-spacing-md); max-width: 480px;">
		<MokaTextField @bind-Value="_modelName" Label="Model" Mono Clearable="true" Suggestions="Models"
		               HelperText="Any model the server serves. These are the ones it lists."/>
		<span class="page-desc">Value: @(string.IsNullOrEmpty(_modelName) ? "(empty)" : _modelName)</span>
	</div>
</DemoSection>

@code {
	private static readonly string[] Models =
	[
		"gpt-5", "gpt-5-mini", "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5", "llama-4-scout", "mistral-large"
	];

	private readonly FormModel _model = new();
	private string _modelName = "";

	private sealed class FormModel
	{
		public string Name { get; set; } = "";
		public string Email { get; set; } = "";
		public string Password { get; set; } = "";
		public int Age { get; set; }
		public string Bio { get; set; } = "";
		public bool AgreeTerms { get; set; }
		public bool DarkMode { get; set; }
		public string Country { get; set; } = "";
	}
}
