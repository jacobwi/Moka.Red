<DemoSection Id="basics" Title="Basics" Description="A text area for code or settings, with line numbers. The coloring and the checks come from the app: this demo passes a small highlighter for an INI file and a checker that wants a number for every port.">
	<div class="code-demo">
		<MokaCodeEditor @bind-Value="_text"
		                Label="settings.ini"
		                HelperText="Try a letter in a port, or a line without an equals sign."
		                Rows="10"
		                Highlighter="IniHighlighter.Spans"
		                Diagnose="IniHighlighter.Check"/>
		<MokaCodeEditor Value="@ReadOnlyText" Label="Read only" ReadOnly="true" Rows="4" Highlighter="IniHighlighter.Spans"/>
	</div>
</DemoSection>

<DemoSection Id="autofill" Title="Beside a sign-in" Description="The editor tells browsers and password managers to leave it alone, so a saved password or address never lands in the code. Only the two fields above it are offered for filling.">
	<div class="code-demo">
		<MokaTextField @bind-Value="_user" Label="User name" autocomplete="username"/>
		<MokaPasswordField @bind-Value="_password" Label="Password" autocomplete="current-password"/>
		<MokaCodeEditor @bind-Value="_script" Label="Start-up script" Rows="4"/>
	</div>
</DemoSection>

@code {
	private const string ReadOnlyText = "[server]\nhost = 10.0.0.1\nport = 8080";

	private string? _user;
	private string? _password;
	private string _script = "echo \"Starting\"\nsleep 2";

	private string _text = string.Join('\n',
		"; Moka demo settings",
		"[server]",
		"host = 192.168.1.10",
		"port = 8080x",
		"name = \"Living room\"",
		"",
		"[backup]",
		"enabled = true",
		"every");
}
