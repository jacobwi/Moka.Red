<DemoSection Id="search-with-button" Title="Search with button" Description="A field and buttons joined into one control.">
	<div style="max-width: 400px;">
		<MokaInputGroup>
			<MokaTextField @bind-Value="_groupSearchValue" Placeholder="Search..."/>
			<MokaButton StartIcon="MokaIcons.Action.Search">Search</MokaButton>
		</MokaInputGroup>
	</div>
</DemoSection>

<DemoSection Id="url-input-with-protocol" Title="URL input with protocol">
	<div style="max-width: 400px;">
		<MokaInputGroup>
			<MokaButton Variant="MokaVariant.Outlined" Disabled>https://</MokaButton>
			<MokaTextField @bind-Value="_groupUrlValue" Placeholder="example.com"/>
		</MokaInputGroup>
	</div>
</DemoSection>

<DemoSection Id="small-size" Title="Small size">
	<div style="max-width: 350px;">
		<MokaInputGroup Size="MokaSize.Sm">
			<MokaTextField @bind-Value="_groupSmallValue" Placeholder="Enter value..."/>
			<MokaButton Color="MokaColor.Primary" Size="MokaSize.Sm">Go</MokaButton>
		</MokaInputGroup>
	</div>
</DemoSection>

<DemoSection Id="a-labeled-field" Title="A labeled field">
	<div style="max-width: 400px;">
		<MokaInputGroup>
			<MokaTextField @bind-Value="_groupLabeledValue" Label="Folder name" HelperText="Letters, digits and dashes."/>
			<MokaButton Color="MokaColor.Primary">Create</MokaButton>
		</MokaInputGroup>
	</div>
</DemoSection>

<DemoSection Id="a-button-beside-the-box" Title="A button beside the box">
	<div style="max-width: 400px;">
		<MokaTextField @bind-Value="_actionValue" Label="Short name" HelperText="One letter or emoji." EmojiButton="true">
			<Actions>
				<MokaButton Variant="MokaVariant.Outlined" OnClick="UseShortName">Use it</MokaButton>
			</Actions>
		</MokaTextField>
		@if (_usedShortName is not null)
		{
			<p style="margin-top: 8px;">Using @_usedShortName</p>
		}
	</div>
</DemoSection>

@code {
	private string _groupSearchValue = "";

	private string _groupUrlValue = "";

	private string _groupSmallValue = "";

	private string _groupLabeledValue = "";

	private string _actionValue = "";

	private string? _usedShortName;

	private void UseShortName() => _usedShortName = _actionValue;
}
