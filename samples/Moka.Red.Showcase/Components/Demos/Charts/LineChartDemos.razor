@using Moka.Red.Core.Charts
@using System.Globalization
@using System.Diagnostics
@implements IDisposable

<DemoSection Id="basics" Title="Basics" Description="Lines over labelled points, with an area if you want one.">
	<MokaLineChart Labels="_monthLabels" Series="_lineSeries" ShowArea="true"/>
</DemoSection>

<DemoSection Id="line-chart-live" Title="Line chart, live"
             Description="A rate fed once a second into a 110 second window: the lines slide, the legend shows the latest values and the peak, and the ticks stay round in the unit shown.">
	<MokaLineChart Series="_series"
	               Labels="Labels"
	               Label="Throughput"
	               Formatter="Rate"
	               AutoScale="true"
	               ScaleUnits="Units"
	               SuggestedMax="4096"
	               ShowArea="true"
	               ShowPoints="false"
	               ShowLastPoint="true"
	               ShowCurrent="true"
	               ShowPeak="true"
	               Smooth="true"
	               Live="true"
	               Height="230px"
	               EmptyText="Waiting for traffic"/>
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.Center">
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="Toggle">@(_running ? "Pause" : "Resume")</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" OnClick="Reset">Reset</MokaButton>
	</MokaFlexbox>
</DemoSection>

<DemoSection Id="stacked-area" Title="Stacked area" Description="The top edge is the total.">
	<MokaLineChart Title="Bandwidth by zone" Subtitle="Mbit/s, today by the hour" Look="MokaChartLook.Quiet" Stacked="true"
	               Labels="Hours" Series="Zones" Unit="Mbps"/>
</DemoSection>

<DemoSection Id="range-band" Title="Range band" Description="The median inside the 5th to 95th percentile.">
	<MokaLineChart Title="Response time" Look="MokaChartLook.Quiet" Labels="Hours" Series="Latency" Unit="MokaChartUnit.Milliseconds"/>
</DemoSection>

<DemoSection Id="step-line" Title="Step line" Description="Counts that jump rather than drift.">
	<MokaLineChart Title="Instances running" Look="MokaChartLook.Quiet" Curve="MokaLineCurve.Step" Times="StepTimes" Series="Instances"
	               DirectLabels="MokaDirectLabels.Values"/>
</DemoSection>

<DemoSection Id="slope-chart" Title="Slope chart" Description="Before and after, the ones that got worse in color.">
	<MokaLineChart Title="Error rate around release 2.4" Look="MokaChartLook.Quiet" Labels="BeforeAfter" Series="Slopes"
	               HighlightSeries="Worse" DirectLabels="MokaDirectLabels.Both" Formatter="Percent"
	               Points="MokaChartPoints.Always"/>
</DemoSection>

<DemoSection Id="target-band" Title="Target band" Description="Inside 100 to 250 ms is fine.">
	<MokaLineChart Title="p95 today" Look="MokaChartLook.Quiet" Labels="Hours" Series="P95" TargetLow="100" TargetHigh="250"
	               Unit="MokaChartUnit.Milliseconds"/>
</DemoSection>

<DemoSection Id="emphasis" Title="Emphasis" Description="Search is the story, the rest stay quiet.">
	<MokaLineChart Title="p95 latency by service" Look="MokaChartLook.Quiet" Labels="Hours" Series="Services" Highlight="Search"
	               Unit="MokaChartUnit.Milliseconds"/>
</DemoSection>

<DemoSection Id="indexed-to-100" Title="Indexed to 100" Description="Users and sessions compare by growth.">
	<MokaLineChart Title="Users and sessions" Look="MokaChartLook.Quiet" Labels="Days" Series="Growth" IndexTo="100"
	               DirectLabels="MokaDirectLabels.Both"/>
</DemoSection>

<DemoSection Id="names-at-the-line-ends" Title="Names at the line ends" Description="Ends that crowd get leaders.">
	<MokaLineChart Title="Traffic by zone" Look="MokaChartLook.Quiet" Labels="Hours" Series="Crowded" DirectLabels="MokaDirectLabels.Both"
	               Unit="Mbps"/>
</DemoSection>

<DemoSection Id="small-multiples-synced" Title="Small multiples, synced" Description="One panel per zone on one scale, one crosshair through all.">
	<MokaLineChart Title="Bandwidth by zone" Look="MokaChartLook.Quiet" Split="true" Labels="Hours" Series="Zones" Unit="Mbps"
	               Tooltip="MokaChartTooltip.Crosshair" Keyboard="true" SplitColumns="2"/>
</DemoSection>

<DemoSection Id="points-and-areas" Title="Points and areas">
	<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-lg); align-items: center;">
		<MokaSegmentedControl Value="@_points.ToString()" ValueChanged="@(v => _points = Enum.Parse<MokaChartPoints>(v))" AriaLabel="Points">
			@foreach (MokaChartPoints option in Enum.GetValues<MokaChartPoints>())
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@_area.ToString()" ValueChanged="@(v => _area = Enum.Parse<MokaChartArea>(v))" AriaLabel="Area">
			@foreach (MokaChartArea option in Enum.GetValues<MokaChartArea>())
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@_curve.ToString()" ValueChanged="@(v => _curve = Enum.Parse<MokaLineCurve>(v))" AriaLabel="Curve">
			@foreach (MokaLineCurve option in Enum.GetValues<MokaLineCurve>())
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
	</div>
	<MokaLineChart Title="Traffic today" Look="MokaChartLook.Quiet" Labels="Hours" Series="Pair" Points="_points" Area="_area" Curve="_curve"
	               Unit="Mbps"/>
</DemoSection>

<DemoSection Id="tooltips-and-keys" Title="Tooltips and keys" Description="Point, or Tab in and use the arrows; Enter pins.">
	<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-lg); align-items: center;">
		<MokaSegmentedControl Value="@_tooltip.ToString()" ValueChanged="@(v => _tooltip = Enum.Parse<MokaChartTooltip>(v))" AriaLabel="Tooltip">
			@foreach (MokaChartTooltip option in Enum.GetValues<MokaChartTooltip>())
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
		<MokaSwitch @bind-Value="_pinnable" Label="Pins"/>
	</div>
	<MokaLineChart Title="Traffic today" Look="MokaChartLook.Quiet" Labels="Hours" Series="Crowded" Tooltip="_tooltip" Pinnable="_pinnable"
	               Keyboard="true" Unit="Mbps" Annotations="Limit" Controls="MokaChartControls.All"/>
</DemoSection>

<DemoSection Id="gaps-that-break-the-line" Title="Gaps that break the line" Description="Maintenance and a sample gap over 20 minutes.">
	<MokaLineChart Title="Response time today" Look="MokaChartLook.Quiet" Times="QuarterTimes" Series="Gappy" Annotations="Maintenance"
	               BreakGapsOver="TimeSpan.FromMinutes(20)" Unit="MokaChartUnit.Milliseconds"/>
</DemoSection>

<DemoSection Id="live-paused-while-you-point" Title="Live, paused while you point" Description="Once a second; point at it and it holds still.">
	<MokaLineChart Title="Throughput" Look="MokaChartLook.Quiet" Live="true" PauseWhilePointing="true" Labels="_liveLabels" Series="_live"
	               Unit="Mbps" Tooltip="MokaChartTooltip.Crosshair" Points="MokaChartPoints.Hover"/>
</DemoSection>

<DemoSection Id="scale" Title="Scale" Description="A day of samples per series: zoom by brush, Ctrl and the wheel, or the strip.">
	<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-lg); align-items: center;">
		<MokaSegmentedControl Value="@_size.ToString(CultureInfo.InvariantCulture)" ValueChanged="SizeChosen" AriaLabel="Points per series">
			@foreach (int size in Sizes)
			{
				<MokaSegment Value="@size.ToString(CultureInfo.InvariantCulture)" Text="@size.ToString("N0", CultureInfo.InvariantCulture)"/>
			}
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@(_labelled ? "labels" : "times")" ValueChanged="AxisChosen" AriaLabel="X axis">
			<MokaSegment Value="times" Text="Times"/>
			<MokaSegment Value="labels" Text="Labels"/>
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@_downsample.ToString()" ValueChanged="@(v => _downsample = Enum.Parse<MokaDownsample>(v))" AriaLabel="Downsample">
			<MokaSegment Value="Auto" Text="MinMax"/>
			<MokaSegment Value="Lttb" Text="LTTB"/>
		</MokaSegmentedControl>
		<span style="font-family: var(--moka-font-family-mono); font-size: var(--moka-font-size-xs);">@_timing</span>
	</div>
	<MokaLineChart Title="Requests" Look="MokaChartLook.Quiet" Times="@(_labelled ? null : _bigTimes)" Labels="@(_labelled ? _bigLabels : null)"
	               Series="_big" DataVersion="_bigVersion" Downsample="_downsample"
	               Zoom="MokaChartZoom.All" Controls="MokaChartControls.All" RangePresets="Presets" @bind-Range="_range"
	               Tooltip="MokaChartTooltip.Crosshair" Keyboard="true"/>
</DemoSection>

<DemoSection Id="compared-with-last-week-with-a-trend" Title="Compared with last week, with a trend" Description="CompareTo draws last week faint and dashed in this week's color; Trend adds a moving average or a straight line.">
	<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-lg); align-items: center;">
		<MokaSegmentedControl Value="@_trend.ToString()" ValueChanged="@(v => _trend = Enum.Parse<MokaChartTrend>(v))" AriaLabel="Trend">
			@foreach (MokaChartTrend option in Enum.GetValues<MokaChartTrend>())
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@_trendWindow.ToString(CultureInfo.InvariantCulture)" ValueChanged="@(v => _trendWindow = int.Parse(v, CultureInfo.InvariantCulture))" AriaLabel="Average over">
			<MokaSegment Value="6" Text="6 hours"/>
			<MokaSegment Value="24" Text="A day"/>
		</MokaSegmentedControl>
	</div>
	<MokaLineChart Title="Requests this week" Subtitle="Per hour" Look="MokaChartLook.Quiet" Times="WeekTimes" Series="ThisAndLastWeek"
	               Trend="_trend" TrendWindow="_trendWindow" Tooltip="MokaChartTooltip.Crosshair" Keyboard="true"
	               Controls="MokaChartControls.View"/>
</DemoSection>

<DemoSection Id="streaming" Title="Streaming" Description="One sample a second into a long window: only what arrived is read.">
	<div style="display: flex; flex-wrap: wrap; gap: var(--moka-spacing-lg); align-items: center;">
		<MokaSegmentedControl Value="@_streamSize.ToString(CultureInfo.InvariantCulture)" ValueChanged="StreamSizeChosen" AriaLabel="Window">
			@foreach (int size in StreamSizes)
			{
				<MokaSegment Value="@size.ToString(CultureInfo.InvariantCulture)" Text="@size.ToString("N0", CultureInfo.InvariantCulture)"/>
			}
		</MokaSegmentedControl>
		<MokaSegmentedControl Value="@(_streamSlides ? "slide" : "grow")" ValueChanged="@(v => _streamSlides = v == "slide")" AriaLabel="Window moves">
			<MokaSegment Value="slide" Text="Slides"/>
			<MokaSegment Value="grow" Text="Grows"/>
		</MokaSegmentedControl>
		<span style="font-family: var(--moka-font-family-mono); font-size: var(--moka-font-size-xs);">@_streamTiming</span>
	</div>
	<MokaLineChart Title="Samples" Look="MokaChartLook.Quiet" Live="true" Times="_streamTimes" Series="_stream" DataVersion="_streamVersion"
	               Tooltip="MokaChartTooltip.Crosshair" Points="MokaChartPoints.Hover" Zoom="MokaChartZoom.All"/>
</DemoSection>

<DemoSection Id="title-toolbar-and-actions" Title="Title, toolbar and actions" Description="Controls All adds the view, export, range presets and reset zoom; State shows loading, empty and error in the frame.">
	<MokaLineChart @ref="_traffic" Series="ZoneTraffic" Times="Week" Title="Traffic this week" Subtitle="Mbps, every hour"
	               Look="MokaChartLook.Quiet" Controls="MokaChartControls.All" Zoom="MokaChartZoom.Strip"
	               RangePresets="FramePresets" @bind-RangePreset="_preset" @bind-Range="_range"
	               @bind-View="_view" @bind-HiddenSeries="_hidden" ExportName="traffic"
	               State="State" OnRetry="Retry" EmptyText="No traffic in this range"
	               ErrorText="The router didn't answer within 10 seconds.">
		<Actions>
			<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" OnClick="Retry">Refresh</MokaButton>
		</Actions>
	</MokaLineChart>
	<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--moka-spacing-md);">
		<MokaSegmentedControl @bind-Value="_state" AriaLabel="State to show" Size="MokaSize.Sm">
			<MokaSegment Value="Auto" Text="Data"/>
			<MokaSegment Value="Loading" Text="Loading"/>
			<MokaSegment Value="Empty" Text="Empty"/>
			<MokaSegment Value="Error" Text="Error"/>
		</MokaSegmentedControl>
		<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Sm" OnClick="ExportCsv">Save the values from outside the chart</MokaButton>
		<span style="font-family: var(--moka-font-family-mono); font-size: var(--moka-font-size-xs);">
			View @_view, preset @(_preset ?? "none"), range @(_range is null ? "all" : "zoomed"), hidden @HiddenText
		</span>
	</div>
</DemoSection>

<DemoSection Id="own-toolbar-controls" Title="Own toolbar controls" Description="ToolbarControl replaces or wraps each control the frame draws.">
	<MokaLineChart @ref="_requests" Series="ZoneTraffic" Labels="WeekHourLabels" Title="Requests" Look="MokaChartLook.Quiet"
	               Controls="MokaChartControls.View | MokaChartControls.Export" ToolbarControl="OwnControl"/>
</DemoSection>

<DemoSection Id="legend-on-top" Title="Legend on top" Description="Toggles that hide and isolate a series.">
	<MokaLineChart Series="ZoneTraffic" Labels="WeekHourLabels" Title="Top" Legend="MokaChartLegendPosition.Top"
	               LegendKey="MokaChartLegendKey.Mark" LegendActions="MokaChartLegendActions.All"/>
</DemoSection>

<DemoSection Id="legend-at-the-right" Title="Legend at the right" Description="It moves under the plot below 36em.">
	<MokaLineChart Series="ZoneTraffic" Labels="WeekHourLabels" Title="Right" Legend="MokaChartLegendPosition.Right"
	               LegendKey="MokaChartLegendKey.Pill"/>
</DemoSection>

<DemoSection Id="legend-in-the-title-row" Title="Legend in the title row" Description="The Dense look puts it beside the title, with values.">
	<MokaLineChart Series="ZoneTraffic" Labels="WeekHourLabels" Title="Title row" Look="MokaChartLook.Dense"/>
</DemoSection>

<DemoSection Id="twelve-series" Title="Twelve series" Description="One row of entries, the rest behind +N.">
	<MokaLineChart Series="ServiceRequests" Labels="WeekHourLabels" Title="Requests by service" LegendActions="MokaChartLegendActions.Hide"/>
</DemoSection>

<DemoSection Id="the-strip-lines-up-with-the-plot" Title="The strip lines up with the plot" Description="Its track runs from the plot's left edge to its right whatever sits beside it, and on a time axis the overview places each value at its time.">
	<MokaGrid MinColumn="min(100%, 420px)" Style="gap: var(--moka-grid-gap);">
		<MokaLineChart Series="ZoneTraffic" Times="Week" Title="Value axis at the end, names at the line ends" Look="MokaChartLook.Quiet"
		               Zoom="MokaChartZoom.Strip" ValueSide="MokaAxisSide.End" DirectLabels="MokaDirectLabels.Names"/>
		<MokaLineChart Series="ZoneTraffic" Times="Week" Title="Ticks inside the plot" Look="MokaChartLook.Quiet"
		               Zoom="MokaChartZoom.Strip" TickLabels="MokaTickPlacement.Inside"/>
		<MokaLineChart Series="ZoneTraffic" Labels="WeekHourLabels" Title="Categories that scroll" Look="MokaChartLook.Quiet"
		               Zoom="MokaChartZoom.Strip" LabelFit="MokaAxisLabelFit.Scroll"/>
		<MokaLineChart Series="Uneven" Times="UnevenTimes" Title="Uneven times: a quiet day in the middle" Look="MokaChartLook.Quiet"
		               Zoom="MokaChartZoom.Strip" BreakGapsOver="TimeSpan.FromHours(3)"/>
	</MokaGrid>
</DemoSection>

<DemoSection Id="tooltip-modes" Title="Tooltip modes" Description="Point at the chart, or Tab to it and use the arrow keys.">
	<div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--moka-spacing-lg);">
		<MokaSegmentedControl Value="@_tooltip.ToString()" ValueChanged="@(v => _tooltip = Enum.Parse<MokaChartTooltip>(v))"
		                      AriaLabel="Tooltip">
			@foreach (MokaChartTooltip option in Modes)
			{
				<MokaSegment Value="@option.ToString()" Text="@option.ToString()"/>
			}
		</MokaSegmentedControl>
		<MokaSwitch @bind-Value="_pinnable" Label="Click or Enter pins"/>
		<MokaSwitch @bind-Value="_keyboard" Label="Keyboard"/>
		<MokaSwitch @bind-Value="_template" Label="Own tooltip"/>
	</div>
	<MokaLineChart Label="Traffic today" Look="MokaChartLook.Quiet" Tooltip="@_tooltip" Pinnable="@_pinnable"
	               Keyboard="@_keyboard" Labels="@Day" Series="@_halfHourTraffic" Formatter="MbpsText"
	               TooltipTemplate="@(_template ? OwnTooltip : null)" ActiveChanged="Heard"/>
	<span style="font-family: var(--moka-font-family-mono); font-size: var(--moka-font-size-xs);">@_heard</span>
</DemoSection>

<DemoSection Id="one-crosshair-through-two-charts" Title="One crosshair through two charts" Description="A sync group in place of a second y axis.">
	<MokaLineChart Label="Requests per second today" Look="MokaChartLook.Quiet" Tooltip="MokaChartTooltip.Readout"
	               SyncGroup="today" Labels="@Day" Series="@_halfHourRequests" Height="120px"/>
	<MokaLineChart Label="p95 response time today" Look="MokaChartLook.Quiet" Tooltip="MokaChartTooltip.Readout"
	               SyncGroup="today" Labels="@Day" Series="@_latency" Height="120px"/>
</DemoSection>

<DemoSection Id="the-standard-look-asked-for-a-click" Title="The Standard look, asked for a click" Description="OnPointClick and ActiveChanged bind the script; the browser's titles stay.">
	<MokaLineChart Label="Traffic today" Look="MokaChartLook.Standard" Labels="@Day" Series="@_halfHourTraffic"
	               OnPointClick="PickedPoint" ActiveChanged="Heard"/>
	<span>@_pickedPoint</span>
</DemoSection>

<DemoSection Id="the-standard-look-with-your-own-tooltip" Title="The Standard look, with your own tooltip" Description="A TooltipTemplate turns on a tooltip to draw it in.">
	<MokaLineChart Label="Traffic today" Look="MokaChartLook.Standard" Labels="@Day" Series="@_halfHourTraffic"
	               TooltipTemplate="SumTooltip"/>
</DemoSection>

<DemoSection Id="zoom" Title="Zoom" Description="Drag across, or Ctrl and the wheel; double click or 0 goes back.">
	<MokaLineChart Label="Traffic this week" Look="MokaChartLook.Quiet" Zoom="MokaChartZoom.Brush | MokaChartZoom.Wheel"
	               Labels="@WeekLabels" Series="@_week" @bind-Range="_range"/>
	<span>@(_range is { } range ? $"Showing {range.From.Value:0} to {range.To.Value:0}" : "Showing the whole week")</span>
</DemoSection>

<DemoSection Id="linked-zoom" Title="Linked zoom" Description="SyncZoom: brush, wheel, strip or a preset on one chart zooms the others with the same x axis; panning moves them together.">
	<MokaGrid MinColumn="min(100%, 360px)" Style="gap: var(--moka-grid-gap);">
		<MokaLineChart Title="Download this week" Look="MokaChartLook.Quiet" Times="@LinkedWeekTimes" Series="@_weekDown" SyncGroup="linked"
		               SyncZoom="true" Zoom="MokaChartZoom.All" RangePresets="@LinkedPresets" Controls="MokaChartControls.Ranges | MokaChartControls.ResetZoom"
		               Range="_linkedA" RangeChanged="@(range => Linked(ref _linkedA, ref _changesA, range))"
		               Tooltip="MokaChartTooltip.Crosshair" Height="140px"/>
		<MokaLineChart Title="Upload this week" Look="MokaChartLook.Quiet" Times="@LinkedWeekTimes" Series="@_weekUp" SyncGroup="linked"
		               SyncZoom="true" Zoom="MokaChartZoom.Brush | MokaChartZoom.Wheel"
		               Range="_linkedB" RangeChanged="@(range => Linked(ref _linkedB, ref _changesB, range))"
		               Tooltip="MokaChartTooltip.Crosshair" Height="140px"/>
	</MokaGrid>
	<MokaLineChart Title="By hour of the week, labels not times" Look="MokaChartLook.Quiet" Labels="@WeekHours" Series="@_week"
	               SyncGroup="linked" SyncZoom="true" Tooltip="MokaChartTooltip.Crosshair" Height="140px"/>
	<span style="font-family: var(--moka-font-family-mono); font-size: var(--moka-font-size-xs);">
		Download @RangeText(_linkedA) (@_changesA changes), upload @RangeText(_linkedB) (@_changesB changes). The chart of labels counts in hours of the week, not times, so it doesn't follow.
	</span>
</DemoSection>

<DemoSection Id="labels-that-dont-fit" Title="Labels that don't fit" Description="Narrow the window: the labels stagger, turn, wrap, cut or thin by the axis's own width, with no script.">
	<MokaSegmentedControl @bind-Value="_fitName" AriaLabel="What labels that don't fit do">
		@foreach (string fit in Enum.GetNames<MokaAxisLabelFit>())
		{
			<MokaSegment Value="@fit" Text="@fit"/>
		}
	</MokaSegmentedControl>
	<MokaBarChart Series="@_domainSeries" Labels="@Domains" LabelFit="@Fit" Look="MokaChartLook.Quiet"
	              Label="DNS queries by domain"/>
	<MokaLineChart Series="@_hourSeries" Labels="@_manyDates" LabelFit="@Fit" Look="MokaChartLook.Quiet"
	               Label="Requests by day"/>
</DemoSection>

<DemoSection Id="time-axis" Title="Time axis" Description="Times, not strings: steps by the clock, marks each day.">
	<MokaSegmentedControl @bind-Value="_span" AriaLabel="Span">
		<MokaSegment Value="6h" Text="6 h"/>
		<MokaSegment Value="48h" Text="48 h"/>
		<MokaSegment Value="30d" Text="30 d"/>
	</MokaSegmentedControl>
	<MokaLineChart Series="@TimeSeries" Times="@TimesFor" Unit="MokaChartUnit.BitsPerSecond" Look="MokaChartLook.Quiet"
	               Label="Download"/>
</DemoSection>

<DemoSection Id="log-scale-and-units" Title="Log scale and units" Description="Job durations from 40 ms to 90 s.">
	<MokaLineChart Series="@_jobs" Labels="@_hours" Look="MokaChartLook.Quiet" Label="Job durations today"
	               YAxis="@(new MokaChartAxis { Scale = MokaAxisScale.Log, Unit = MokaChartUnit.Milliseconds })"/>
</DemoSection>

<DemoSection Id="grid-and-value-axis" Title="Grid and value axis" Description="Hairlines, ticks inside, on the right.">
	<MokaLineChart Series="@_hourSeries" Labels="@_hours" Grid="MokaChartGrid.Hairlines" TickLabels="MokaTickPlacement.Inside"
	               ValueSide="MokaAxisSide.End" Label="Requests per hour"/>
</DemoSection>

<DemoSection Id="threshold-and-target" Title="Threshold and target" Description="The axis always reaches them; the tooltip says how far over.">
	<MokaLineChart Series="@_responseTime" Labels="@_quarters" Unit="MokaChartUnit.Milliseconds" Look="MokaChartLook.Quiet"
	               Annotations="@_limits" TargetLow="100" TargetHigh="250" Label="Response time today"/>
</DemoSection>

<DemoSection Id="events-and-a-window" Title="Events and a window" Description="Point at or Tab to a marker; the line breaks across maintenance.">
	<MokaLineChart Series="@_responseTime" Times="@_quarterTimes" Unit="MokaChartUnit.Milliseconds" Look="MokaChartLook.Quiet"
	               Annotations="@_events" Label="Response time today"/>
</DemoSection>

<DemoSection Id="a-pinned-hour" Title="A pinned hour" Description="A router that started a minute ago: the axis spans the last hour, the minute sits at its end.">
	<MokaLineChart Series="@_minute" Times="@_minuteTimes" TimeZone="TimeZoneInfo.Utc" Look="MokaChartLook.Quiet"
	               XAxis="@_hourAxis" Label="Processor use in the last hour"/>
</DemoSection>

<DemoSection Id="a-minute-hh-mm-12-hour-tooltips" Title="A minute, HH:mm, 12-hour tooltips" Description="The ticks never repeat; the tooltip writes seconds on a 12-hour clock.">
	<MokaLineChart Series="@_minute" Times="@_minuteTimes" TimeZone="TimeZoneInfo.Utc" Look="MokaChartLook.Quiet"
	               XAxis="@_minuteAxis" Label="Processor use in the last minute"/>
</DemoSection>

@code {
	private static readonly string[] _monthLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

	private static readonly MokaLineSeries[] _lineSeries =
	[
		new() { Name = "Revenue", Values = [24, 31, 28, 39, 44, 41, 52, 58, 55, 63, 69, 74] },
		new() { Name = "Costs", Values = [18, 19, 22, 21, 25, 24, 27, 29, 28, 31, 33, 35], Color = MokaColor.Warning }
	];

	// 111 samples put a label every ten seconds: the chart draws every ceil(count / 12)th one.
	private const int Window = 111;

	private static readonly double[] Units = [1, 1024, 1024 * 1024];

	private static readonly IReadOnlyList<string> Labels =
		[.. Enumerable.Range(0, Window).Select(i => Window - 1 - i == 0 ? "now" : $"-{Window - 1 - i}s")];

	private readonly double[] _down = new double[Window];

	private readonly double[] _up = new double[Window];

	private readonly Random _random = new(7);

	private IReadOnlyList<MokaLineSeries> _series = [];

	private Timer? _timer;

	private bool _running = true;

	private double _phase;

	protected override void OnInitialized()
	{
		Reset();
		_timer = new Timer(_ => _ = InvokeAsync(Tick), null, 1000, 1000);

		MakeBig(_size);
		MakeStream(_streamSize);
		_liveLabels = [.. Enumerable.Range(0, 60).Select(i => $"-{60 - i}s")];
		_live = [Live("Down", 0), Live("Up", 1)];

