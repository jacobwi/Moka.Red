<DemoSection Id="basics" Title="Basics" Description="A menu of actions from a button.">
	<MokaFlexbox Gap="MokaSpacingScale.Md" Wrap="true">
		<MokaDropdown>
			<ChildContent>
				<MokaButton EndIcon="MokaIcons.Navigation.ChevronDown">Actions</MokaButton>
			</ChildContent>
			<Items>
				<MokaDropdownItem Text="Edit" Icon="MokaIcons.Action.Edit"/>
				<MokaDropdownItem Text="Duplicate" Icon="MokaIcons.Content.Copy"/>
				<MokaDropdownItem Divider/>
				<MokaDropdownItem Text="Delete" Icon="MokaIcons.Action.Delete"/>
			</Items>
		</MokaDropdown>

		<MokaDropdown Position="MokaPopoverPosition.BottomEnd">
			<ChildContent>
				<MokaButton Variant="MokaVariant.Outlined" EndIcon="MokaIcons.Navigation.ChevronDown">More</MokaButton>
			</ChildContent>
			<Items>
				<MokaDropdownItem Text="Settings" Icon="MokaIcons.Action.Settings"/>
				<MokaDropdownItem Text="Help" Icon="MokaIcons.Status.HelpCircle"/>
				<MokaDropdownItem Divider/>
				<MokaDropdownItem Text="Logout" Disabled/>
			</Items>
		</MokaDropdown>
	</MokaFlexbox>
</DemoSection>

<DemoSection Id="links" Title="Links" Description="An item with Href is a link with role menuitem, so a middle click opens it in a new tab, the browser's link menu works, and a download attribute downloads. A disabled link has no address.">
	<MokaDropdown>
		<ChildContent>
			<MokaButton Variant="MokaVariant.Outlined" EndIcon="MokaIcons.Navigation.ChevronDown">Go to</MokaButton>
		</ChildContent>
		<Items>
			<MokaDropdownItem Text="Button" Href="/components/button" Icon="MokaIcons.Navigation.ChevronRight"/>
			<MokaDropdownItem Text="Progress in a new tab" Href="/components/progress" Target="_blank" Icon="MokaIcons.Content.ExternalLink"/>
			<MokaDropdownItem Text="Download the icon" Href="/favicon.svg" download="favicon.svg" Icon="MokaIcons.Action.Download"/>
			<MokaDropdownItem Divider/>
			<MokaDropdownItem Text="Archived" Href="/components/dropdown" Disabled/>
		</Items>
	</MokaDropdown>
</DemoSection>

<DemoSection Id="danger" Title="Danger items" Description="Danger draws an item and its icon in the error color, on a red tint while it is hovered or focused. The context menu and the menu bar draw it the same way.">
	<MokaDropdown>
		<ChildContent>
			<MokaButton EndIcon="MokaIcons.Navigation.ChevronDown">File</MokaButton>
		</ChildContent>
		<Items>
			<MokaDropdownItem Text="Rename" Icon="MokaIcons.Action.Edit"/>
			<MokaDropdownItem Text="Duplicate" Icon="MokaIcons.Content.Copy"/>
			<MokaDropdownItem Divider/>
			<MokaDropdownItem Text="Delete" Icon="MokaIcons.Action.Delete" Danger="true"/>
			<MokaDropdownItem Text="Delete forever" Icon="MokaIcons.Action.Delete" Danger="true" Disabled="true"/>
		</Items>
	</MokaDropdown>
</DemoSection>

<DemoSection Id="shortcuts" Title="Shortcuts" Description="Shortcut draws the keys that run the same action as key caps at the end of the row, as the context menu and the menu bar do. Mod reads Ctrl, and Cmd on a Mac. A hint only: the hotkey registry binds the keys.">
	<MokaDropdown>
		<ChildContent>
			<MokaButton EndIcon="MokaIcons.Navigation.ChevronDown">File</MokaButton>
		</ChildContent>
		<Items>
			<MokaDropdownItem Text="Save" Icon="MokaIcons.Action.Save" Shortcut="Mod+S"/>
			<MokaDropdownItem Text="Save as" Shortcut="Mod+Shift+S"/>
			<MokaDropdownItem Divider/>
			<MokaDropdownItem Text="Close" Shortcut="Mod+W"/>
		</Items>
	</MokaDropdown>
</DemoSection>

<DemoSection Id="checked" Title="Checked items" Description="Checked makes an item an option that is on or off: a menuitemcheckbox with aria-checked, and a check in the icon's place while it is on. Off, it shows its icon or keeps the check's width, so the names line up.">
	<MokaDropdown>
		<ChildContent>
			<MokaButton Variant="MokaVariant.Outlined" EndIcon="MokaIcons.Navigation.ChevronDown">View</MokaButton>
		</ChildContent>
		<Items>
			<MokaDropdownItem Text="Show grid" Checked="_grid" OnClick="() => _grid = !_grid"/>
			<MokaDropdownItem Text="Show rulers" Checked="_rulers" OnClick="() => _rulers = !_rulers"/>
			<MokaDropdownItem Text="Pin the toolbar" Icon="MokaIcons.Toggle.Pin" Checked="_pinned" OnClick="() => _pinned = !_pinned"/>
			<MokaDropdownItem Divider/>
			<MokaDropdownItem Text="Reset view" Icon="MokaIcons.Action.Refresh"/>
		</Items>
	</MokaDropdown>
</DemoSection>

<DemoSection Id="radio" Title="One choice of several" Description="Radio makes a Checked item one choice of several, such as which version of a document is open: a menuitemradio with the same check. Keep exactly one checked, with a divider between the choices and other items.">
	<MokaDropdown>
		<ChildContent>
			<MokaButton Variant="MokaVariant.Outlined" EndIcon="MokaIcons.Navigation.ChevronDown">@_version</MokaButton>
		</ChildContent>
		<Items>
			@foreach (string version in Versions)
			{
				<MokaDropdownItem Text="@version" Checked="version == _version" Radio OnClick="() => _version = version"/>
			}
			<MokaDropdownItem Divider/>
			<MokaDropdownItem Text="New version" Icon="MokaIcons.Action.Add"/>
		</Items>
	</MokaDropdown>
</DemoSection>

@code {
	private static readonly string[] Versions = ["Original", "For a design role", "For a lead role"];

	private string _version = Versions[0];
	private bool _grid = true;
	private bool _pinned;
	private bool _rulers;
}
