<DemoSection Id="basics" Title="Basics" Description="A glowing dot with a short status label.">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Lg" Align="MokaAlign.Center" Wrap="true">
		<MokaStatusDot Label="ONLINE"/>
		<MokaStatusDot Label="saving..." Color="MokaColor.Warning" Pulse="true" Uppercase="false"/>
		<MokaStatusDot Label="OFFLINE" Color="MokaColor.Error" Glow="false"/>
		<MokaStatusDot Label="SYNCING" Color="MokaColor.Info" Pulse="true" Size="MokaSize.Sm"/>
		<MokaStatusDot Label="IDLE" Color="MokaColor.Surface"/>
		<MokaStatusDot Size="MokaSize.Lg"/>
	</MokaFlexbox>
</DemoSection>
