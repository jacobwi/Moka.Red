<DemoSection Id="identicon-avatars" Title="Identicon avatars" Description="A pattern drawn from any string, so the same value always looks the same.">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Wrap>
		<MokaAvatar IdenticonValue="john@example.com" Size="MokaSize.Lg"/>
		<MokaAvatar IdenticonValue="jane@example.com" Size="MokaSize.Lg"/>
		<MokaAvatar IdenticonValue="bob@example.com" Size="MokaSize.Lg"/>
		<MokaAvatar IdenticonValue="alice@example.com" Size="MokaSize.Lg"/>
		<MokaAvatar IdenticonValue="charlie@example.com" Size="MokaSize.Lg"/>
	</MokaFlexbox>
</DemoSection>

<DemoSection Id="standalone-identicons" Title="Standalone identicons">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Wrap>
		<MokaIdenticon Value="user123" SizeValue="48px"/>
		<MokaIdenticon Value="admin" SizeValue="48px" Rounded="MokaRounding.Full"/>
		<MokaIdenticon Value="test@test.com" SizeValue="48px" Background="#f5f5f5"/>
		<MokaIdenticon Value="moka.red" SizeValue="48px" IdenticonSize="7"/>
	</MokaFlexbox>
</DemoSection>
