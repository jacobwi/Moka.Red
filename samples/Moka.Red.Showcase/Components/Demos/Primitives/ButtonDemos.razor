<DemoSection Id="basics" Title="Basics" Description="Runs an action. Variant sets how loud it is, Color what it means." Tip="Put the main action last in a row. An icon-only button needs an aria-label and a MokaTooltip saying the same.">
	<ChildContent>
		<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Wrap>
			<MokaButton Variant="MokaVariant.Filled">Filled</MokaButton>
			<MokaButton Variant="MokaVariant.Outlined">Outlined</MokaButton>
			<MokaButton Variant="MokaVariant.Text">Text</MokaButton>
			<MokaButton Variant="MokaVariant.Soft">Soft</MokaButton>
		</MokaFlexbox>
	</ChildContent>
	<Notes>
		<DemoParam Name="Variant">Filled, Outlined, Soft or Text: how loud it is</DemoParam>
		<DemoParam Name="Color">What it means. Error for a delete</DemoParam>
		<DemoParam Name="Size">Xs, Sm, Md or Lg</DemoParam>
		<DemoParam Name="StartIcon, EndIcon">A MokaIcons definition beside the label</DemoParam>
		<DemoParam Name="Loading">Busy: a spinner in the icon's place, focus and width kept, presses and form submits ignored</DemoParam>
		<DemoParam Name="LoadingText">What a screen reader hears when it becomes busy. "Loading" by default</DemoParam>
		<DemoParam Name="DisabledLook">Faded, Muted or Outline while disabled, ahead of the theme's WithDisabledButtons</DemoParam>
		<DemoParam Name="Href">Renders a link. javascript: and data: addresses are dropped</DemoParam>
		<DemoParam Name="Quiet">A 32 px icon-only button with no variant</DemoParam>
	</Notes>
	<Playground>
		<ButtonPlayground/>
	</Playground>
</DemoSection>

