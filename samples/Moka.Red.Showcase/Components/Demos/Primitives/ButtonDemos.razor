<DemoSection Id="busy" Title="Busy">
	<p class="page-desc">Each one runs a two-second save. It keeps focus and its width, ignores presses until it's done, and a screen reader hears "Saving". The spinner takes the start icon's place, else the end icon's, else covers the label.</p>
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.Center" Wrap>
		<MokaButton StartIcon="MokaIcons.Action.Save" Loading="@_busyButtons.Contains(1)" LoadingText="Saving"
		            OnClick="() => RunBusyAsync(1)">Save</MokaButton>
		<MokaButton Loading="@_busyButtons.Contains(2)" LoadingText="Saving" OnClick="() => RunBusyAsync(2)">Save changes</MokaButton>
		<MokaButton EndIcon="MokaIcons.Navigation.ArrowRight" Variant="MokaVariant.Outlined" Loading="@_busyButtons.Contains(3)"
		            OnClick="() => RunBusyAsync(3)">Next</MokaButton>
		<MokaTooltip Text="Refresh">
			<MokaButton StartIcon="MokaIcons.Action.Refresh" Variant="MokaVariant.Soft" aria-label="Refresh"
			            Loading="@_busyButtons.Contains(4)" OnClick="() => RunBusyAsync(4)"/>
		</MokaTooltip>
		<MokaTooltip Text="Delete">
			<MokaButton Quiet StartIcon="MokaIcons.Action.Delete" Color="MokaColor.Error" aria-label="Delete"
			            Loading="@_busyButtons.Contains(5)" OnClick="() => RunBusyAsync(5)"/>
		</MokaTooltip>
	</MokaFlexbox>
	<p class="page-desc">Presses that ran: @_busyRuns</p>
</DemoSection>

<DemoSection Id="busy-submit" Title="Busy submit">
	<p class="page-desc">Press Send or Enter in the field, then press again while it's busy: the form is sent once, by a click and by Enter.</p>
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Xl" Align="MokaAlign.End" Wrap>
		<EditForm Model="_busyForm" OnValidSubmit="SendBusyFormAsync">
			<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.End">
				<MokaTextField @bind-Value="_busyForm.Name" Label="Edit form"/>
				<MokaButton Type="submit" Loading="_busyFormSending" LoadingText="Sending">Send</MokaButton>
			</MokaFlexbox>
		</EditForm>
		<form @onsubmit="SendPlainFormAsync">
			<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.End">
				<label class="page-desc" style="display: grid; gap: var(--moka-spacing-xs);">
					Plain form
					<input name="code" style="padding: var(--moka-spacing-sm);"/>
				</label>
				<MokaButton Type="submit" Loading="_plainFormSending" LoadingText="Sending">Send</MokaButton>
			</MokaFlexbox>
		</form>
	</MokaFlexbox>
	<p class="page-desc">Sent: @_busyFormSent from the edit form, @_plainFormSent from the plain form</p>
</DemoSection>

<DemoSection Id="disabled-looks" Title="Disabled looks">
	<p class="page-desc">New design only. Faded is the default, the button's own colors dimmed. Muted and Outline draw every disabled button in neutral colors, so a solid one reads as unavailable rather than broken. Pick one for the app with MokaTheme.WithDisabledButtons, or for a button with DisabledLook.</p>
	@foreach (MokaDisabledButtonLook look in Enum.GetValues<MokaDisabledButtonLook>())
	{
		<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.Center" Wrap>
			<span class="page-desc" style="min-width: 5rem;">@look</span>
			<MokaButton Disabled DisabledLook="look">Create account</MokaButton>
			<MokaButton Disabled DisabledLook="look" Color="MokaColor.Error">Delete</MokaButton>
			<MokaButton Disabled DisabledLook="look" Variant="MokaVariant.Soft" StartIcon="MokaIcons.Action.Download">Download</MokaButton>
			<MokaButton Disabled DisabledLook="look" Variant="MokaVariant.Outlined">Outlined</MokaButton>
			<MokaButton Disabled DisabledLook="look" Variant="MokaVariant.Text">Text</MokaButton>
		</MokaFlexbox>
	}
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Align="MokaAlign.Center" Wrap>
		<span class="page-desc" style="min-width: 5rem;">Enabled</span>
		<MokaButton>Create account</MokaButton>
		<MokaButton Color="MokaColor.Error">Delete</MokaButton>
		<MokaButton Variant="MokaVariant.Soft" StartIcon="MokaIcons.Action.Download">Download</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined">Outlined</MokaButton>
		<MokaButton Variant="MokaVariant.Text">Text</MokaButton>
	</MokaFlexbox>
</DemoSection>

