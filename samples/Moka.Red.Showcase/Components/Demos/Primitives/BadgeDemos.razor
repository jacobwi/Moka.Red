<DemoSection Id="positions" Title="Positions">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Lg" Align="MokaAlign.Center">
		<MokaBadge Content="1" Position="MokaBadgePosition.TopRight">
			<div style="width:40px;height:40px;background:var(--moka-color-surface-variant);border-radius:var(--moka-radius-md);"></div>
		</MokaBadge>
		<MokaBadge Content="2" Position="MokaBadgePosition.TopLeft">
			<div style="width:40px;height:40px;background:var(--moka-color-surface-variant);border-radius:var(--moka-radius-md);"></div>
		</MokaBadge>
		<MokaBadge Content="3" Position="MokaBadgePosition.BottomRight">
			<div style="width:40px;height:40px;background:var(--moka-color-surface-variant);border-radius:var(--moka-radius-md);"></div>
		</MokaBadge>
		<MokaBadge Content="4" Position="MokaBadgePosition.BottomLeft">
			<div style="width:40px;height:40px;background:var(--moka-color-surface-variant);border-radius:var(--moka-radius-md);"></div>
		</MokaBadge>
	</MokaFlexbox>
</DemoSection>

<DemoSection Id="interactive" Title="Interactive">
	<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Lg" Align="MokaAlign.Center">
		<MokaBadge Content="@_badgeCount.ToString()" Visible="@(_badgeCount > 0)">
			<MokaIcon Icon="MokaIcons.Status.Info" Size="MokaSize.Lg"/>
		</MokaBadge>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="() => _badgeCount++">Add</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined" OnClick="() => _badgeCount = Math.Max(0, _badgeCount - 1)">Remove</MokaButton>
		<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text" OnClick="() => _badgeCount = 0">Clear</MokaButton>
	</MokaFlexbox>
</DemoSection>

@code {
	private int _badgeCount = 3;
}
