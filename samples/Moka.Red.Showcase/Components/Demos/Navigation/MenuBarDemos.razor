<DemoSection Id="basics" Title="Basics" Description="Tab into the bar, then the arrow keys: Left and Right between menus, Down to open, Up to open on the last item, letters to jump, Escape to close. The shortcut hints are drawn as key caps.">
	<MokaMenuBar AriaLabel="Demo menu">
		<MokaMenuBarMenu Label="File">
			<MokaMenuBarItem Text="New" Icon="MokaIcons.Action.Add" Shortcut="Ctrl+N" OnClick="@(() => _menuBarRan = "New")"/>
			<MokaMenuBarItem Text="Open" Icon="MokaIcons.File.FileText" Shortcut="Ctrl+O" OnClick="@(() => _menuBarRan = "Open")"/>
			<MokaMenuBarItem Text="Save" Icon="MokaIcons.Action.Save" Shortcut="Ctrl+S" OnClick="@(() => _menuBarRan = "Save")"/>
			<MokaMenuBarDivider/>
			<MokaMenuBarItem Text="Exit" OnClick="@(() => _menuBarRan = "Exit")"/>
		</MokaMenuBarMenu>
		<MokaMenuBarMenu Label="Edit">
			<MokaMenuBarItem Text="Undo" Shortcut="Ctrl+Z" OnClick="@(() => _menuBarRan = "Undo")"/>
			<MokaMenuBarItem Text="Redo" Shortcut="Ctrl+Shift+Z" Disabled OnClick="@(() => _menuBarRan = "Redo")"/>
			<MokaMenuBarDivider/>
			<MokaMenuBarItem Text="Find" Icon="MokaIcons.Action.Search" Shortcut="Ctrl+F" OnClick="@(() => _menuBarRan = "Find")"/>
		</MokaMenuBarMenu>
		<MokaMenuBarMenu Label="View">
			<MokaMenuBarItem Text="Zoom in" Shortcut="Ctrl++" OnClick="@(() => _menuBarRan = "Zoom in")"/>
			<MokaMenuBarItem Text="Zoom out" Shortcut="Ctrl+-" OnClick="@(() => _menuBarRan = "Zoom out")"/>
		</MokaMenuBarMenu>
	</MokaMenuBar>

	<p class="page-desc">Chosen: <code>@(_menuBarRan ?? "nothing yet")</code></p>
</DemoSection>

<DemoSection Id="danger" Title="Danger items" Description="Danger draws a command and its icon in the error color, and a hovered or highlighted item keeps it over a red tint.">
	<MokaMenuBar AriaLabel="Danger demo menu">
		<MokaMenuBarMenu Label="File">
			<MokaMenuBarItem Text="Save" Icon="MokaIcons.Action.Save" Shortcut="Ctrl+S" OnClick="@(() => _dangerRan = "Save")"/>
			<MokaMenuBarItem Text="Close" OnClick="@(() => _dangerRan = "Close")"/>
			<MokaMenuBarDivider/>
			<MokaMenuBarItem Text="Delete file" Icon="MokaIcons.Action.Delete" Danger OnClick="@(() => _dangerRan = "Delete file")"/>
			<MokaMenuBarItem Text="Delete all versions" Danger Disabled/>
		</MokaMenuBarMenu>
	</MokaMenuBar>

	<p class="page-desc">Chosen: <code>@(_dangerRan ?? "nothing yet")</code></p>
</DemoSection>

@code {
	private string? _dangerRan;

	private string? _menuBarRan;
}
