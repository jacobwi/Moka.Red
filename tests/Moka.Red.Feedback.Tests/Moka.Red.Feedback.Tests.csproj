<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Feedback\Moka.Red.Feedback.csproj" />
		<!-- The rest of the packages, for the convention tests that scan all of them. -->
		<ProjectReference Include="..\..\src\Moka.Red\Moka.Red.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Diagnostics\Moka.Red.Diagnostics.csproj" />
	</ItemGroup>

	<!-- The spacing parameter checks every component test project shares. -->
	<ItemGroup>
		<Compile Include="..\Shared\SpacingCase.cs" Link="Shared\SpacingCase.cs" />
		<Compile Include="..\Shared\IconTooltip.cs" Link="Shared\IconTooltip.cs" />
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
		<Compile Include="..\Shared\TopLayerPopup.cs" Link="Shared\TopLayerPopup.cs" />
	</ItemGroup>

	<!-- A JS module and an import that fail the way a circuit ending under them does, for the teardown tests. -->
	<ItemGroup>
		<Compile Include="..\Shared\EndingCircuit.cs" Link="Shared\EndingCircuit.cs" />
	</ItemGroup>

	<!-- Scoped stylesheets whose rules the tests read as text, since bUnit applies no CSS. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Feedback\ActionBar\MokaActionBar.razor.css" Link="Css\MokaActionBar.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Alert\MokaAlert.razor.css" Link="Css\MokaAlert.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\BootScreen\MokaBootScreen.razor.css" Link="Css\MokaBootScreen.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\BottomSheet\MokaBottomSheet.razor.css" Link="Css\MokaBottomSheet.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Cheatsheet\MokaCheatsheet.razor.css" Link="Css\MokaCheatsheet.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Dialog\MokaDialog.razor.css" Link="Css\MokaDialog.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Drawer\MokaDrawer.razor.css" Link="Css\MokaDrawer.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Dropdown\MokaDropdownItem.razor.css" Link="Css\MokaDropdownItem.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\EmptyState\MokaEmptyState.razor.css" Link="Css\MokaEmptyState.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\JobList\MokaJobList.razor.css" Link="Css\MokaJobList.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\JobProgress\MokaJobProgress.razor.css" Link="Css\MokaJobProgress.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Loading\MokaSkeleton.razor.css" Link="Css\MokaSkeleton.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Progress\MokaProgress.razor.css" Link="Css\MokaProgress.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\SlashMenu\MokaSlashMenu.razor.css" Link="Css\MokaSlashMenu.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Toast\MokaToastHost.razor.css" Link="Css\MokaToastHost.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Feedback\Wizard\MokaWizard.razor.css" Link="Css\MokaWizard.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Tooltip\MokaTooltip.razor.css" Link="Css\MokaTooltip.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Core\wwwroot\moka-boot.css" Link="Css\moka-boot.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\BunitWaits.cs" Link="Shared\BunitWaits.cs" />
	</ItemGroup>

</Project>
