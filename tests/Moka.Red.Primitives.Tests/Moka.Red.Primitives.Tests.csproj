<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- CA1707: Allow underscores in test method names -->
	<!-- CA1001: Allow disposable fields in test classes -->
	<!-- CA1034: Allow nested public types (test helper components) -->
	<!-- CA1515: Allow public types in test projects -->
	<!-- CA1307: StringComparison not needed for Assert.Contains -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
		<!-- Decodes generated QR codes, so the encoder is proven against a real reader. -->
		<PackageReference Include="ZXing.Net" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
	</ItemGroup>

	<!-- The spacing parameter checks every component test project shares. -->
	<ItemGroup>
		<Compile Include="..\Shared\SpacingCase.cs" Link="Shared\SpacingCase.cs" />
		<Compile Include="..\Shared\IconTooltip.cs" Link="Shared\IconTooltip.cs" />
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
		<Compile Include="..\Shared\TopLayerPopup.cs" Link="Shared\TopLayerPopup.cs" />
	</ItemGroup>

	<!-- Scoped stylesheets and collocated scripts whose rules the tests read as text, since bUnit applies no CSS. Every
	     one in the package, so a new component's stylesheet is there without touching this file. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Primitives\**\*.razor.css;..\..\src\Moka.Red.Primitives\**\*.razor.js"
		      Exclude="..\..\src\Moka.Red.Primitives\bin\**;..\..\src\Moka.Red.Primitives\obj\**"
		      Link="Css\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Core\wwwroot\moka.css" Link="Css\moka.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Splits a style attribute the way a browser does, for the checks that a value adds no declarations. -->
	<ItemGroup>
		<Compile Include="..\Shared\CssDeclarations.cs" Link="Shared\CssDeclarations.cs" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\BunitWaits.cs" Link="Shared\BunitWaits.cs" />
		<Compile Include="..\Shared\FakeFilePicker.cs" Link="Shared\FakeFilePicker.cs" />
	</ItemGroup>

	<!-- The emoji data generator's parsing, tested on small copies of its sources. -->
	<ItemGroup>
		<Compile Include="..\..\tools\Moka.Red.EmojiGen\EmojiSources.cs" Link="EmojiGen\EmojiSources.cs" />
	</ItemGroup>

</Project>
