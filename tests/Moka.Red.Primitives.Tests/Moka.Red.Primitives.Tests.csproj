		<None Include="..\..\src\Moka.Red.Core\wwwroot\moka.css" Link="Css\moka.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Stat\MokaStat.razor.css" Link="Css\MokaStat.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Meter\MokaMeter.razor.css" Link="Css\MokaMeter.razor.css" CopyToOutputDirectory="PreserveNewest" />
