<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- CA1707: Allow underscores in test method names -->
	<!-- CA1001: Allow disposable fields in test classes -->
	<!-- CA1034: Allow nested public types (test helper components) -->
	<!-- CA1515: Allow public types in test projects -->
	<!-- CA1307: StringComparison not needed for Assert.Contains -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
	</ItemGroup>

	<!-- The spacing parameter checks every component test project shares. -->
	<ItemGroup>
		<Compile Include="..\Shared\SpacingCase.cs" Link="Shared\SpacingCase.cs" />
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
	</ItemGroup>

	<!-- Scoped stylesheets whose rules the tests read as text, since bUnit applies no CSS. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Primitives\SegmentedControl\MokaSegmentedControl.razor.css" Link="Css\MokaSegmentedControl.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\SplitButton\MokaSplitButton.razor.css" Link="Css\MokaSplitButton.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\SelectionBar\MokaSelectionBar.razor.css" Link="Css\MokaSelectionBar.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Notice\MokaNotice.razor.css" Link="Css\MokaNotice.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Carousel\MokaCarousel.razor.css" Link="Css\MokaCarousel.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\InfiniteCarousel\MokaInfiniteCarousel.razor.css" Link="Css\MokaInfiniteCarousel.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Media\MokaMediaGallery.razor.css" Link="Css\MokaMediaGallery.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Media\MokaVideoEmbed.razor.css" Link="Css\MokaVideoEmbed.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Steps\MokaSteps.razor.css" Link="Css\MokaSteps.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Button\MokaButton.razor.css" Link="Css\MokaButton.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Primitives\Meter\MokaMeter.razor.css" Link="Css\MokaMeter.razor.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Splits a style attribute the way a browser does, for the checks that a value adds no declarations. -->
	<ItemGroup>
		<Compile Include="..\Shared\CssDeclarations.cs" Link="Shared\CssDeclarations.cs" />
	</ItemGroup>

</Project>
