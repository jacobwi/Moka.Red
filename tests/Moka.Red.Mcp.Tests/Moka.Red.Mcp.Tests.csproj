<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- CA1707: Allow underscores in test method names -->
	<!-- CA1515: Allow public types in test projects -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
	</PropertyGroup>

	<!-- No bUnit here, so BunitWaits isn't linked: these tests render nothing and wait on nothing. -->
	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\tools\Moka.Red.Mcp\Moka.Red.Mcp.csproj" />
	</ItemGroup>

</Project>
