<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Forms\Moka.Red.Forms.csproj" />
	</ItemGroup>

	<!-- The spacing parameter checks every component test project shares. -->
	<ItemGroup>
		<Compile Include="..\Shared\SpacingCase.cs" Link="Shared\SpacingCase.cs" />
		<Compile Include="..\Shared\IconTooltip.cs" Link="Shared\IconTooltip.cs" />
		<Compile Include="..\Shared\TopLayerPopup.cs" Link="Shared\TopLayerPopup.cs" />
	</ItemGroup>

	<!-- Scoped stylesheets whose rules the tests read as text, since bUnit applies no CSS. -->
	<ItemGroup>
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
		<None Include="..\..\src\Moka.Red.Forms\SearchInput\MokaSearchInput.razor.css" Link="Css\MokaSearchInput.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\TextField\MokaTextField.razor.css" Link="Css\MokaTextField.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\PasswordField\MokaPasswordField.razor.css" Link="Css\MokaPasswordField.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\AutoComplete\MokaAutoComplete.razor.css" Link="Css\MokaAutoComplete.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\SelectField\MokaSelect.razor.css" Link="Css\MokaSelect.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\TreeSelect\MokaTreeSelect.razor.css" Link="Css\MokaTreeSelect.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\TagInput\MokaTagInput.razor.css" Link="Css\MokaTagInput.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\DatePicker\MokaDatePicker.razor.css" Link="Css\MokaDatePicker.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\TimePicker\MokaTimePicker.razor.css" Link="Css\MokaTimePicker.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\Common\MokaFieldWrapper.razor.css" Link="Css\MokaFieldWrapper.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\InputGroup\MokaInputGroup.razor.css" Link="Css\MokaInputGroup.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\NativeSelect\MokaNativeSelect.razor.css" Link="Css\MokaNativeSelect.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\DropOverlay\MokaDropOverlay.razor.css" Link="Css\MokaDropOverlay.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\FileUpload\MokaFileUpload.razor.css" Link="Css\MokaFileUpload.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\ColorPicker\MokaColorPicker.razor.css" Link="Css\MokaColorPicker.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\ColorInput\MokaColorInput.razor.css" Link="Css\MokaColorInput.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\SettingsForm\*.razor.css" Link="Css\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\BunitWaits.cs" Link="Shared\BunitWaits.cs" />
		<Compile Include="..\Shared\FakeFilePicker.cs" Link="Shared\FakeFilePicker.cs" />
	</ItemGroup>

	<!-- More stylesheets read as text, like the ones above. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Forms\TextArea\MokaTextArea.razor.css" Link="Css\MokaTextArea.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\EmojiPicker\MokaEmojiPicker.razor.css" Link="Css\MokaEmojiPicker.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\CountrySelect\MokaCountrySelect.razor.css" Link="Css\MokaCountrySelect.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\Switch\MokaSwitch.razor.css" Link="Css\MokaSwitch.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Forms\Checkbox\MokaCheckbox.razor.css" Link="Css\MokaCheckbox.razor.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
