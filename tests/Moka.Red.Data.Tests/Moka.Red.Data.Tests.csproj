<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TargetFrameworks></TargetFrameworks>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Icons\Moka.Red.Icons.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Primitives\Moka.Red.Primitives.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Forms\Moka.Red.Forms.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Layout\Moka.Red.Layout.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Feedback\Moka.Red.Feedback.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Data\Moka.Red.Data.csproj" />
	</ItemGroup>

	<!-- The spacing parameter checks every component test project shares. -->
	<ItemGroup>
		<Compile Include="..\Shared\SpacingCase.cs" Link="Shared\SpacingCase.cs" />
		<Compile Include="..\Shared\IconTooltip.cs" Link="Shared\IconTooltip.cs" />
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
		<Compile Include="..\Shared\TopLayerPopup.cs" Link="Shared\TopLayerPopup.cs" />
	</ItemGroup>

	<!-- Scoped stylesheets whose rules the tests read as text, since bUnit applies no CSS. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Data\Chart\MokaBarChart.razor.css" Link="Css\MokaBarChart.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Data\Chart\MokaLineChart.razor.css" Link="Css\MokaLineChart.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Data\Chart\MokaSparkline.razor.css" Link="Css\MokaSparkline.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Data\Heatmap\MokaHeatmap.razor.css" Link="Css\MokaHeatmap.razor.css" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Moka.Red.Data\Table\MokaTable.razor.css" Link="Css\MokaTable.razor.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\BunitWaits.cs" Link="Shared\BunitWaits.cs" />
		<Compile Include="..\Shared\FakeFilePicker.cs" Link="Shared\FakeFilePicker.cs" />
	</ItemGroup>

</Project>
