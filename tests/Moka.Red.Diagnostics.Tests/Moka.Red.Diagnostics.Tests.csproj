<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- CA1707: Allow underscores in test method names -->
	<!-- CA1001: Allow disposable fields in test classes -->
	<!-- CA1034: Allow nested public types (test helper components) -->
	<!-- CA1515: Allow public types in test projects -->
	<!-- CA1307: StringComparison not needed for Assert.Contains -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA1707;CA1001;CA1034;CA1515;xUnit1051</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="bunit" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Moka.Red.Diagnostics\Moka.Red.Diagnostics.csproj" />
		<ProjectReference Include="..\..\src\Moka.Red.Core\Moka.Red.Core.csproj" />
	</ItemGroup>

	<!-- Scoped stylesheets whose rules the tests read as text, since bUnit applies no CSS. -->
	<ItemGroup>
		<None Include="..\..\src\Moka.Red.Diagnostics\**\*.razor.css"
		      Exclude="..\..\src\Moka.Red.Diagnostics\bin\**;..\..\src\Moka.Red.Diagnostics\obj\**"
		      Link="Css\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\BunitWaits.cs" Link="Shared\BunitWaits.cs" />
		<Compile Include="..\Shared\ScopedCss.cs" Link="Shared\ScopedCss.cs" />
		<Compile Include="..\Shared\BindingGoldens.cs" Link="Shared\BindingGoldens.cs" />
		<Compile Include="..\Shared\FakeClock.cs" Link="Shared\FakeClock.cs" />
		<Compile Include="..\Shared\IconTooltip.cs" Link="Shared\IconTooltip.cs" />
	</ItemGroup>

</Project>
