<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Moka.Red.Templates</PackageId>
    <Title>Moka.Red Project Templates</Title>
    <Description>dotnet new templates for Blazor Server, WebAssembly, MAUI Hybrid, and RCL projects pre-configured with the Moka.Red UI component library.</Description>
    <PackageVersion>0.1.11</PackageVersion>
    <Authors>jacobwi;BCat;Moka</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jacobwi/Moka.Red</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>dotnet-new;template;blazor;moka;ui;components</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**" />
    <Compile Remove="**/*" />
    <None Include="../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
