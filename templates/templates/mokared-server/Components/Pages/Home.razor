@page "/"

<PageTitle>MokaRedServer</PageTitle>

<MokaGridBackground Pattern="MokaGridPattern.Lines" MinHeight="200px" Highlighted CellSize="32" PatternOpacity="0.5" Rounded="MokaRounding.Xl" Style="margin-bottom: var(--moka-spacing-xl);">
    <MokaFlexbox Direction="MokaDirection.Column" Align="MokaAlign.Center" Justify="MokaJustify.Center" Style="min-height: 200px;" Gap="MokaSpacingScale.Sm">
        <MokaHeading Level="1">MokaRedServer</MokaHeading>
        <MokaText Size="MokaSize.Md" Style="color: var(--moka-color-on-surface-variant);">
            Built with Moka.Red — a lightweight, performance-focused Blazor UI component library.
        </MokaText>
    </MokaFlexbox>
</MokaGridBackground>

<MokaCard Title="Getting Started" Outlined>
    <ChildContent>
        <MokaText>
            Edit this page at <MokaCode>Components/Pages/Home.razor</MokaCode> to get started.
        </MokaText>
    </ChildContent>
</MokaCard>
