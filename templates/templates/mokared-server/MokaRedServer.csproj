<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--#if (UseWebAssembly) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MokaRedServer.Client/**</DefaultItemExcludes>
    <!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moka.Red" Version="0.4.2" />
    <!--#if ((interactivity == "WebAssembly" || interactivity == "Auto") && Framework == "net9.0") -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.22" />
    <!--#elif (interactivity == "WebAssembly" || interactivity == "Auto") -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <!--#endif -->
  </ItemGroup>

  <!--#if (UseWebAssembly) -->
  <ItemGroup>
    <ProjectReference Include="MokaRedServer.Client/MokaRedServer.Client.csproj" />
  </ItemGroup>
  <!--#endif -->

</Project>
