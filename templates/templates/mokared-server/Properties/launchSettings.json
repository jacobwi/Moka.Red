{
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      //#if (UseWebAssembly)
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/{browserInspectUri}",
      //#endif
      "applicationUrl": "http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
    //#if (!noHttps)
    ,
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      //#if (UseWebAssembly)
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/{browserInspectUri}",
      //#endif
      "applicationUrl": "https://localhost:5001;http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
    //#endif
  }
}
