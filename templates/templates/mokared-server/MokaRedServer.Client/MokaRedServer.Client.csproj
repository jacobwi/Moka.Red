<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (Framework == "net9.0") -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.22" />
    <!--#else -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <!--#endif -->
    <PackageReference Include="Moka.Red" Version="0.2.2" />
  </ItemGroup>

</Project>
